---
/**
 * El ÚNICO layout del repositorio (CLAUDE.md §03).
 * No se crea un segundo. Si una vista necesita otra cosa, se le añade
 * una prop aquí; duplicar el layout es cómo empezó el desastre anterior.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';

// Tipografías autoalojadas. Ni una petición a Google Fonts (§07).
// Karla para interfaz y cuerpo; Caveat SOLO para anotaciones de tiza (§06).
import '@fontsource/karla/400.css';
import '@fontsource/karla/500.css';
import '@fontsource/karla/600.css';
import '@fontsource/karla/700.css';
import '@fontsource/karla/800.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

/* Los estilos y las fuentes de KaTeX, autoalojados como el resto: son los que
   dibujan radicales, barras de conjugado y paréntesis a la altura correcta.
   Ni una petición a un CDN (§07). */
import 'katex/dist/katex.min.css';

import { ruta } from '../lib/rutas';

interface Props {
  titulo: string;
  descripcion: string;
  /** Token de acento de la asignatura, p. ej. "--a-calculo". Solo el marco. */
  acento?: string;
  crumb?: string;
  /** Tamaño del titular; cada vista tiene el suyo. */
  h1?: string;
}

const { titulo, descripcion, acento, h1 } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const estilo = [
  acento ? `--acento: var(${acento})` : '--acento: var(--live)',
  h1 ? `--h1: ${h1}` : null,
]
  .filter(Boolean)
  .join('; ');
---

<!doctype html>
<html lang="es" data-theme="claro" style={estilo}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${ruta()}favicon.svg`} />
    <meta name="color-scheme" content="light dark" />

    <script is:inline>
      // Antes del primer pintado, para que no haya destello al recargar.
      try {
        const guardado = localStorage.getItem('tema');
        if (guardado === 'oscuro' || guardado === 'claro') {
          document.documentElement.dataset.theme = guardado;
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'oscuro';
        }
      } catch {}
    </script>
  </head>

  <body>
    <a class="saltar" href="#principal">Saltar al contenido</a>
    <slot />

    <script is:inline>
      /* Marca las fórmulas de bloque que no caben en su columna.
       *
       * `.katex-display` ya se puede desplazar de lado, pero **no lo dice**, y
       * eso es peor que no poder: el 4 de septiembre de 2026, barriendo las
       * 167 páginas, salieron **doce fórmulas cortadas** y la peor era el
       * enunciado de un ejercicio de Álgebra que define tres conjuntos y solo
       * enseñaba dos y medio — con la pregunta pidiendo «cuáles de los tres».
       * El lector ve una fórmula que acaba a media letra y no tiene por qué
       * imaginarse que hay más a la derecha.
       *
       * Se hace aquí, con JavaScript, porque el CSS no sabe si algo desborda.
       * Es lo mínimo: una clase, y el resto lo pinta `base.css`. */
      (() => {
        const marca = () => {
          for (const f of document.querySelectorAll('.katex-display')) {
            const d = f.firstElementChild;
            f.classList.toggle('se-desplaza', !!d && d.scrollWidth > f.clientWidth + 4);
          }
        };
        const cuando = () => requestAnimationFrame(marca);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(cuando);
        else cuando();
        addEventListener('resize', cuando);
        /* Los paneles y los bloques plegables cambian el ancho al abrirse. */
        addEventListener('toggle', cuando, true);
        document.addEventListener('click', cuando);
      })();
    </script>
  </body>
</html>
