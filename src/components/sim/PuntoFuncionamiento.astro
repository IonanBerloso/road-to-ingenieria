---
/**
 * Herramienta incrustada del tema 25.
 *
 * La pregunta que responde, escrita antes de dibujar nada (CLAUDE.md §13):
 *   «Si bajo el régimen de giro un 20 %, ¿el caudal baja también un 20 %?»
 *
 * La respuesta es que no, y por eso hace falta el simulador: el tema ya lo
 * dice en un error típico —los puntos de igual rendimiento están sobre una
 * parábola por el origen, y la instalación solo es una de esas parábolas si
 * $H_{i0} = 0$— pero dicho así se lee y se olvida. Aquí se ve: el punto que
 * predicen las leyes de semejanza y el punto real se separan a la vista, y
 * **el botón «sin desnivel» los vuelve a juntar**. Una afirmación que el
 * lector puede tumbar en dos clics es otra cosa que una advertencia.
 *
 * Dos paneles acoplados, como el ábaco del tema 18. Arriba, el plano Q-H con
 * las dos curvas y los dos puntos. Abajo, los dos NPSH, que es la otra mitad
 * de lo que pregunta el examen: elegida la bomba, ¿cavita?
 *
 * El modelo vive en `src/lib/bombeo.ts` y `tests/fisica/bombeo.test.ts` lo
 * verifica contra los seis resultados publicados de la ordinaria de
 * 2025-2026 (§10). Los tres botones son sus tres bombas.
 *
 * SVG a mano, sin librería de gráficas (§02).
 */
interface Props {
  /** Prefijo de los ids de esta instancia. Único dentro de la página. */
  id?: string;
}
const { id = 'pf' } = Astro.props;
---

<figure class="sim" data-pf id={`sim-${id}`}>
  <figcaption class="sim-head">
    <h3>El punto de funcionamiento, y lo que pasa al tocarlo</h3>
    <span class="rotulo hint">mueve el desnivel, la válvula y el régimen</span>
  </figcaption>

  <div class="stage">
    <svg viewBox="0 0 520 300" role="img" aria-labelledby={`${id}-t1 ${id}-d1`}>
      <title id={`${id}-t1`}>Curva de la bomba y curva de la instalación, con su cruce</title>
      <desc id={`${id}-d1`}>
        Altura en metros de columna de agua frente a caudal en litros por
        segundo. La curva de la instalación arranca de la altura piezométrica y
        sube; la de la bomba baja desde su altura a caudal nulo. Se cortan en el
        punto de funcionamiento, marcado con un círculo relleno. Al bajar el
        régimen de giro aparecen además la curva de la bomba a régimen
        nominal, en trazos, la parábola de puntos de igual rendimiento, y un
        segundo círculo hueco donde las leyes de semejanza predicen que estaría
        el punto: los dos círculos se separan, y solo vuelven a juntarse si la
        altura piezométrica es cero. Todos los valores están en la tabla de
        abajo.
      </desc>

      <g data-rejilla></g>

      <path class="curva iso" data-iso></path>
      <path class="curva bomba-nominal" data-bomba0></path>
      <path class="curva instalacion" data-inst></path>
      <path class="curva bomba" data-bomba></path>

      <line class="guia" data-guia></line>
      <circle class="punto homologo" data-homologo r="5"></circle>
      <circle class="punto real" data-real r="5"></circle>

      <text class="etiqueta chica" data-txt-inst>instalación</text>
      <text class="etiqueta chica" data-txt-bomba>bomba</text>
      <text class="etiqueta chica flag" data-txt-homologo text-anchor="end"
        >la semejanza dice aquí</text
      >

      <text class="etiqueta" transform="rotate(-90 16 133)" x="16" y="133" text-anchor="middle"
        >H (mca)</text
      >
      <text class="etiqueta" x="496" y="288" text-anchor="end">Q (l/s)</text>
    </svg>
  </div>

  <div class="stage npsh">
    <svg viewBox="0 0 520 156" role="img" aria-labelledby={`${id}-t2 ${id}-d2`}>
      <title id={`${id}-t2`}>El NPSH disponible y el requerido, frente al caudal</title>
      <desc id={`${id}-d2`}>
        En el mismo eje de caudales, dos rectas cruzadas: el NPSH disponible,
        que baja porque las pérdidas de la aspiración crecen con el caudal, y
        el requerido por la bomba, que sube. A la derecha de su cruce la bomba
        cavita. Una línea vertical marca dónde cae el punto de funcionamiento,
        y la zona de cavitación se sombrea.
      </desc>

      <rect class="zona-cav" data-zona-cav y="14" height="102"></rect>
      <g data-rejilla-n></g>
      <path class="curva disponible" data-disp></path>
      <path class="curva requerido" data-req></path>
      <line class="guia" data-guia-n y1="14" y2="116"></line>
      <circle class="punto margen" data-punto-n r="4"></circle>

      <text class="etiqueta chica" data-txt-disp>NPSH disponible</text>
      <text class="etiqueta chica" data-txt-req>NPSH requerido</text>
      <text class="etiqueta chica flag" data-txt-cav text-anchor="middle"></text>
      <text class="etiqueta" transform="rotate(-90 16 65)" x="16" y="65" text-anchor="middle"
        >NPSH (mca)</text
      >
    </svg>
  </div>

  <div class="controls">
    <div class="ctrl">
      <label for={`${id}-z`}>desnivel entre depósitos <output data-out-z>40 m</output></label>
      <input id={`${id}-z`} type="range" min="0" max="60" step="1" value="40" data-z />
    </div>
    <div class="ctrl">
      <label for={`${id}-k`}>pérdida de la válvula <output data-out-k>abierta</output></label>
      <input id={`${id}-k`} type="range" min="0" max="2" step="0.02" value="0" data-k />
    </div>
    <div class="ctrl">
      <label for={`${id}-n`}>régimen de giro <output data-out-n>100 %</output></label>
      <input id={`${id}-n`} type="range" min="0.7" max="1.05" step="0.005" value="1" data-n />
    </div>
    <div class="ctrl atajos">
      <span class="rotulo k">la ordinaria de 2025-2026</span>
      <div class="botones">
        <button type="button" data-caso="b1" aria-pressed="false">bomba 1</button>
        <button type="button" data-caso="b2" aria-pressed="false">bomba 2</button>
        <button type="button" data-caso="b3" aria-pressed="true">bomba 3</button>
        <button type="button" class="accion" data-accion="llano">sin desnivel, al 80 %</button>
      </div>
    </div>
  </div>

  <div class="readout">
    <div class="cell">
      <span class="rotulo k">punto de funcionamiento</span>
      <span class="v" data-q>16,6 l/s</span>
      <span class="sub" data-h>a 45,3 mca</span>
    </div>
    <div class="cell">
      <span class="rotulo k">margen de NPSH</span>
      <span class="v" data-margen>+1,9 mca</span>
      <span class="sub" data-cavita>no cavita</span>
    </div>
    <div class="cell">
      <span class="rotulo k">la semejanza predice</span>
      <span class="v" data-pred>16,6 l/s</span>
      <span class="sub" data-error>a régimen nominal no hay nada que predecir</span>
    </div>
    <div class="cell">
      <span class="rotulo k">la instalación pide</span>
      <span class="v chica" data-curva-inst>40 + 0,0276 Q^1,852 + 0,00082 Q²</span>
      <span class="sub" data-curva-bomba>y la bomba da 80 − 0,127 Q²</span>
    </div>
  </div>

  <p class="alarma" data-alarma hidden>
    <span class="rotulo rotulo--flag" data-alarma-tit></span>
    <span data-alarma-txt></span>
  </p>
</figure>

<script>
  import {
    caudalLimite,
    constanteHomologa,
    hBomba,
    hInstalacion,
    homologo,
    npshDisponible,
    npshRequerido,
    puntoDeFuncionamiento,
    type Bomba,
    type Instalacion,
  } from '../../lib/bombeo';

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-pf]')) {
    const $ = <T extends Element>(s: string) => raiz.querySelector<T>(s)!;

    /* Ejes fijos, no ajustados al caso. Que el punto se vaya hacia la esquina
       al cerrar la válvula es información; reencuadrar la borraría. */
    const X0 = 52;
    const X1 = 496;
    const QMAX = 30;
    const HMAX = 90;
    const NMAX = 8;

    const x = (Q: number) => X0 + (Q / QMAX) * (X1 - X0);
    const y = (H: number) => 246 - (Math.max(0, Math.min(HMAX, H)) / HMAX) * 226;
    const yn = (v: number) => 116 - (Math.max(0, Math.min(NMAX, v)) / NMAX) * 102;

    const sZ = $<HTMLInputElement>('[data-z]');
    const sK = $<HTMLInputElement>('[data-k]');
    const sN = $<HTMLInputElement>('[data-n]');

    const num = (v: number, d = 1) => v.toFixed(d).replace('.', ',');

    /* Los datos del enunciado: 850 m de PVC de 150 mm con C = 140, y una
       válvula con k₀ = 5. El corpus publica la curva ya montada. */
    const BASE: Instalacion = { Hi0: 40, a: 0.02758, b: 8.17e-4 };
    const BOMBAS: Record<string, Bomba> = {
      b1: { A: 76.5, B: 0.2108 },
      b2: { A: 83, B: 0.155 },
      b3: { A: 80, B: 0.127 },
    };
    const REQUERIDOS: Record<string, { c: number; e: number }> = {
      b1: { c: 1.8, e: 0.00611 },
      b2: { c: 2, e: 0.0118 },
      b3: { c: 2.2, e: 0.0002 },
    };
    /* 100 m de aspiración, la bomba 5 m por encima de la lámina. */
    const ASP = { pat: 10, pv: 0.2, zasp: 5, aAsp: 3.245e-5 * 100 };

    let cual = 'b3';

    /**
     * Una curva muestreada en el eje de caudales, **cortada donde se sale**.
     *
     * Sin el corte, `y()` satura y la curva se convierte en una recta pegada
     * al borde: parece un tramo horizontal de la instalación que no existe.
     * Devuelve también el último punto dentro, que es donde va su rótulo.
     */
    function traza(f: (Q: number) => number) {
      const p: string[] = [];
      let fin: [number, number] = [X0, y(f(0))];
      const ini: [number, number] = [X0, y(Math.max(0, Math.min(HMAX, f(0))))];
      for (let Q = 0; Q <= QMAX + 1e-9; Q += 0.25) {
        const H = f(Q);
        if (H < 0 || H > HMAX) break;
        fin = [x(Q), y(H)];
        p.push(`${fin[0].toFixed(1)} ${fin[1].toFixed(1)}`);
      }
      return { d: p.length > 1 ? `M${p.join(' L')}` : '', ini, fin };
    }

    {
      const trozos: string[] = [];
      for (let Q = 0; Q <= QMAX; Q += 5) {
        trozos.push(
          `<line class="rej" x1="${x(Q)}" y1="20" x2="${x(Q)}" y2="246"/>`,
          `<text class="etiqueta chica" text-anchor="middle" x="${x(Q)}" y="262">${Q}</text>`,
        );
      }
      for (let H = 0; H <= HMAX; H += 15) {
        trozos.push(
          `<line class="rej" x1="${X0}" y1="${y(H)}" x2="${X1}" y2="${y(H)}"/>`,
          `<text class="etiqueta chica" text-anchor="end" x="${X0 - 6}" y="${y(H) + 3.5}">${H}</text>`,
        );
      }
      $('[data-rejilla]').innerHTML = trozos.join('');

      const trozosN: string[] = [];
      for (let v = 0; v <= NMAX; v += 2) {
        trozosN.push(
          `<line class="rej" x1="${X0}" y1="${yn(v)}" x2="${X1}" y2="${yn(v)}"/>`,
          `<text class="etiqueta chica" text-anchor="end" x="${X0 - 6}" y="${yn(v) + 3.5}">${v}</text>`,
        );
      }
      $('[data-rejilla-n]').innerHTML = trozosN.join('');
    }

    function pinta() {
      const b = BOMBAS[cual];
      const req = REQUERIDOS[cual];
      const n = Number(sN.value);
      /* La válvula solo toca las pérdidas localizadas: la curva se cierra en
         abanico sin mover su arranque, que es exactamente lo que dice §25. */
      const inst: Instalacion = {
        Hi0: Number(sZ.value),
        a: BASE.a,
        b: BASE.b * 10 ** Number(sK.value),
      };

      const real = puntoDeFuncionamiento(b, inst, n);
      const p0 = puntoDeFuncionamiento(b, inst, 1);
      const pred = homologo(p0, n);
      const K = constanteHomologa(p0);

      const cInst = traza((Q) => hInstalacion(Q, inst));
      const cBomba = traza((Q) => hBomba(Q, b, n));
      $('[data-inst]').setAttribute('d', cInst.d);
      $('[data-bomba]').setAttribute('d', cBomba.d);

      const nominal = $('[data-bomba0]');
      nominal.setAttribute('d', traza((Q) => hBomba(Q, b, 1)).d);
      nominal.setAttribute('opacity', n < 0.995 ? '1' : '0');

      const iso = $('[data-iso]');
      iso.setAttribute('d', traza((Q) => K * Q * Q).d);
      iso.setAttribute('opacity', n < 0.995 && p0.Q > 0 ? '1' : '0');

      $('[data-real]').setAttribute('cx', String(x(real.Q)));
      $('[data-real]').setAttribute('cy', String(y(real.H)));
      const hom = $('[data-homologo]');
      hom.setAttribute('cx', String(x(pred.Q)));
      hom.setAttribute('cy', String(y(pred.H)));
      hom.setAttribute('opacity', n < 0.995 && p0.Q > 0 ? '1' : '0');
      /* A la izquierda del punto y anclado por su final: puesto a la derecha
         se metía debajo del rótulo de la instalación en cuanto los dos
         círculos se juntaban, que es justo el momento que hay que mirar. */
      const th = $('[data-txt-homologo]');
      th.setAttribute('opacity', n < 0.995 && p0.Q > 0 ? '1' : '0');
      th.setAttribute('x', String(Math.max(X0 + 120, Math.min(x(pred.Q) - 9, x(QMAX) - 4))));
      th.setAttribute('y', String(Math.max(30, y(pred.H) - 9)));

      const guia = $('[data-guia]');
      for (const [k, v] of [
        ['x1', x(real.Q)],
        ['x2', x(real.Q)],
        ['y1', y(real.H)],
        ['y2', 246],
      ] as const) {
        guia.setAttribute(k, String(v));
      }

      /* La instalación se rotula donde muere, a la derecha. La bomba, donde
         **nace**: su curva muere en el eje de abscisas, y allí el rótulo caía
         encima de los números del eje. */
      const rotula = (sel: string, [px, py]: [number, number], dx: number, ancla: string) => {
        const t = $(sel);
        t.setAttribute('x', String(Math.max(X0 + 2, Math.min(x(QMAX) - 2, px + dx))));
        t.setAttribute('y', String(Math.max(30, Math.min(240, py - 7))));
        t.setAttribute('text-anchor', ancla);
      };
      rotula('[data-txt-inst]', cInst.fin, -4, 'end');
      rotula('[data-txt-bomba]', cBomba.ini, 6, 'start');

      /* ── el panel de abajo: los dos NPSH ── */
      const limite = caudalLimite(ASP, req, QMAX);
      /* Igual que arriba: la curva se corta donde se sale, no se aplasta
         contra el borde. El requerido de la bomba 2 se va de escala a 26 l/s
         y saturado parecía volverse constante, que es lo contrario. */
      const trazaN = (f: (Q: number) => number) => {
        const p: string[] = [];
        let fin: [number, number] = [X0, yn(f(0))];
        for (let Q = 0; Q <= QMAX + 1e-9; Q += 0.25) {
          const v = f(Q);
          if (v < 0 || v > NMAX) break;
          fin = [x(Q), yn(v)];
          p.push(`${fin[0].toFixed(1)} ${fin[1].toFixed(1)}`);
        }
        return { d: p.length > 1 ? `M${p.join(' L')}` : '', fin };
      };
      const cDisp = trazaN((Q) => npshDisponible(Q, ASP));
      const cReq = trazaN((Q) => npshRequerido(Q, req));
      $('[data-disp]').setAttribute('d', cDisp.d);
      $('[data-req]').setAttribute('d', cReq.d);

      const zona = $('[data-zona-cav]');
      const hayLimite = Number.isFinite(limite) && limite < QMAX;
      zona.setAttribute('x', String(x(hayLimite ? limite : QMAX)));
      zona.setAttribute('width', String(Math.max(0, x(QMAX) - x(hayLimite ? limite : QMAX))));
      const cav = $('[data-txt-cav]');
      cav.setAttribute('opacity', hayLimite ? '1' : '0');
      /* Con `limite` infinito —la bomba no cavita en ningún caudal— la media
         sale NaN y el atributo se queda inválido sin avisar de nada. */
      cav.setAttribute('x', String(hayLimite ? (x(limite) + x(QMAX)) / 2 : x(QMAX)));
      /* Abajo de la franja, no arriba: arriba se pisaba con el rótulo del
         requerido cuando su curva se sale por el techo. */
      cav.setAttribute('y', '110');
      cav.textContent = 'cavita';

      const margen = npshDisponible(real.Q, ASP) - npshRequerido(real.Q, req);
      $('[data-guia-n]').setAttribute('x1', String(x(real.Q)));
      $('[data-guia-n]').setAttribute('x2', String(x(real.Q)));
      $('[data-punto-n]').setAttribute('cx', String(x(real.Q)));
      $('[data-punto-n]').setAttribute('cy', String(yn(npshDisponible(real.Q, ASP))));

      const rotulaN = (sel: string, [px, py]: [number, number], dy: number) => {
        const t = $(sel);
        t.setAttribute('x', String(Math.min(x(QMAX) - 4, px - 4)));
        t.setAttribute('y', String(Math.max(16, Math.min(112, py + dy))));
        t.setAttribute('text-anchor', 'end');
      };
      rotulaN('[data-txt-disp]', cDisp.fin, -6);
      rotulaN('[data-txt-req]', cReq.fin, 12);

      raiz.dataset.cavita = margen < 0 ? 'si' : 'no';

      /* ── la tabla ── */
      $('[data-q]').textContent = `${num(real.Q)} l/s`;
      $('[data-h]').textContent = real.Q > 0 ? `a ${num(real.H)} mca` : 'la bomba no arranca';
      $('[data-margen]').textContent = `${margen >= 0 ? '+' : '−'}${num(Math.abs(margen), 2)} mca`;
      $('[data-cavita]').textContent =
        margen < 0
          ? 'cavita: hay que cerrar o bajar la bomba'
          : hayLimite
            ? `cavitaría a partir de ${num(limite)} l/s`
            : 'no cavita en todo el rango';

      $('[data-pred]').textContent = n < 0.995 ? `${num(pred.Q)} l/s` : `${num(real.Q)} l/s`;
      const err = real.Q > 0 ? (pred.Q - real.Q) / real.Q : 0;
      $('[data-error]').textContent =
        n >= 0.995
          ? 'a régimen nominal no hay nada que predecir'
          : real.Q === 0
            ? 'la bomba ya no da ni el desnivel: la semejanza predice un caudal que no existe'
            : Math.abs(err) < 0.01
              ? `coinciden: sin desnivel, la instalación es casi la parábola de puntos (queda un ${num(Math.abs(err) * 100, 2)} % del exponente 1,852)`
              : `se pasa un ${num(Math.abs(err) * 100)} % — y el desnivel es la causa`;

      $('[data-curva-inst]').textContent =
        (inst.Hi0 > 0 ? `${inst.Hi0} + ` : '') +
        `0,0276 Q^1,852 + ${num(inst.b * 1000, 3)}·10⁻³ Q²`;
      $('[data-curva-bomba]').textContent =
        n < 0.995
          ? `y la bomba, al ${num(n * 100, 0)} %, da ${num(n * n * b.A)} − ${num(b.B, 3)} Q²`
          : `y la bomba da ${num(b.A, 1)} − ${num(b.B, 3)} Q²`;

      $<HTMLOutputElement>('[data-out-z]').textContent = `${inst.Hi0} m`;
      const veces = 10 ** Number(sK.value);
      $<HTMLOutputElement>('[data-out-k]').textContent =
        veces < 1.2 ? 'abierta' : `×${num(veces, veces < 10 ? 1 : 0)}`;
      $<HTMLOutputElement>('[data-out-n]').textContent = `${num(n * 100, 0)} %`;

      const alarma = $<HTMLElement>('[data-alarma]');
      const suelta = real.Q > 0 && n < 0.995 && Math.abs(err) > 0.05;
      alarma.hidden = !(margen < 0 || suelta);
      if (margen < 0) {
        $('[data-alarma-tit]').textContent = 'Esta bomba cavita en esta instalación';
        $('[data-alarma-txt]').textContent =
          `A ${num(real.Q)} l/s la aspiración solo ofrece ${num(npshDisponible(real.Q, ASP), 2)} mca ` +
          `y la bomba pide ${num(npshRequerido(real.Q, req), 2)}. El caudal máximo sin cavitar es ` +
          `${num(limite)} l/s: se llega cerrando la válvula, bajando la bomba o eligiendo otra.`;
      } else if (suelta) {
        $('[data-alarma-tit]').textContent = 'La semejanza no se aplica al punto, se aplica a la curva';
        $('[data-alarma-txt]').textContent =
          `Al ${num(n * 100, 0)} % de régimen el caudal real es ${num(real.Q)} l/s, no los ` +
          `${num(pred.Q)} que salen de multiplicar el caudal nominal por ${num(n, 2)}: un ` +
          `${num(Math.abs(err) * 100)} % de diferencia. El punto homólogo está sobre la parábola de ` +
          `puntos, y la instalación solo es esa parábola si el desnivel es cero. Pon el desnivel a ` +
          `cero y verás juntarse los dos círculos.`;
      }
    }

    const botones = [...raiz.querySelectorAll<HTMLButtonElement>('[data-caso]')];
    const marca = (clave: string) => {
      for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.caso === clave));
    };

    for (const s of [sZ, sK, sN]) s.addEventListener('input', pinta);

    /* Los tres primeros botones son las tres bombas del examen y funcionan
       como una elección: uno queda marcado. El cuarto no elige nada, hace
       algo —quitar el desnivel y bajar el régimen— y por eso no se marca. */
    for (const b of botones) {
      b.addEventListener('click', () => {
        cual = b.dataset.caso!;
        sZ.value = '40';
        sK.value = '0';
        sN.value = '1';
        marca(cual);
        pinta();
      });
    }

    $('[data-accion="llano"]').addEventListener('click', () => {
      sZ.value = '0';
      sN.value = '0.8';
      pinta();
    });

    pinta();
  }
</script>

<style>
  .sim {
    margin: 2rem 0 1rem;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
  }

  .sim-head {
    display: flex;
    align-items: baseline;
    gap: .7rem;
    flex-wrap: wrap;
    padding: .85rem 1.1rem;
