---
/**
 * El pie de la edición de una sola asignatura (src/lib/edicion.mjs).
 *
 * Para quién: el alumno que llega a la edición desde el enlace que le da su
 * asignatura, y baja hasta el final de una página larga. Cuándo: en cada
 * página de la edición, y solo en ella; en el sitio completo no se pinta. Qué
 * gana: volver a la entrada, que es donde vive el buscador, sin subir. Cómo se
 * comprueba: `tests/edicion/edicion.test.ts` y `npm run verifica:solo`.
 *
 * No nombra el sitio completo ni dice que sea una edición de nada: hasta el 2
 * de noviembre de 2026 lo decía, y eso era contarle a la clase que hay más.
 */
import { getEntry } from 'astro:content';
import { ruta } from '../../lib/rutas';
import { SOLO, enSolo } from '../../lib/edicion.mjs';

const nombre = enSolo ? (await getEntry('catalogo', SOLO))?.data.nombre : '';

/* Estilo en línea y no en un `<style>`: el CSS de un componente viaja con la
   hoja de la cabecera a TODAS las páginas aunque no se pinte, y eso habría
   cambiado el CSS —y su nombre con hash— del sitio completo. */
const ESTILO =
  'border-top: 1px solid var(--rule); margin-top: 3rem; padding: 1rem 1.25rem 1.5rem; ' +
  'color: var(--faint); font-size: .8rem; text-align: center';
---

{enSolo && (
  <footer class="pie-edicion" style={ESTILO}>
    <p style="margin: 0">
      {nombre}.
      <a href={ruta()} style="margin-left: .6rem; color: inherit; text-decoration: underline; text-underline-offset: .2em">Volver al inicio y buscar</a>
    </p>
  </footer>
)}
