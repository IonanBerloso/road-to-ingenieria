---
/**
 * El pie de la edición de una sola asignatura (src/lib/edicion.mjs).
 *
 * Para quién: quien llega a la edición —el profesor al que Ionan enseña
 * Expresión Gráfica— y tiene que saber qué está mirando: una asignatura del
 * sitio, no el sitio entero. Cuándo: en cada página de la edición, y solo en
 * ella; en el sitio completo no se pinta. Qué gana: que nadie busque aquí las
 * demás asignaturas ni crea que faltan por un error. Cómo se comprueba:
 * `tests/edicion/edicion.test.ts` y `npm run verifica:solo`.
 *
 * No enlaza al sitio entero. El único enlace es a la portada de la propia
 * edición, que es donde vive el buscador.
 */
import { ruta } from '../../lib/rutas';
import { enSolo } from '../../lib/edicion.mjs';

/* Estilo en línea y no en un `<style>`: el CSS de un componente viaja con la
   hoja de la cabecera a TODAS las páginas aunque no se pinte, y eso habría
   cambiado el CSS —y su nombre con hash— del sitio completo. */
const ESTILO =
  'border-top: 1px solid var(--rule); margin-top: 3rem; padding: 1rem 1.25rem 1.5rem; ' +
  'color: var(--faint); font-size: .8rem; text-align: center';
---

{enSolo && (
  <footer class="pie-edicion" style={ESTILO}>
    <p style="margin: 0">
      Edición de una sola asignatura de <strong>Road to Ingeniería</strong>.
      <a href={ruta()} style="margin-left: .6rem; color: inherit; text-decoration: underline; text-underline-offset: .2em">Portada y buscador de esta edición</a>
    </p>
  </footer>
)}

