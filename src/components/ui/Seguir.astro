---
/**
 * «Seguir desde aquí»: las tarjetas del final de una página de estudio. A los
 * lados, lo anterior y lo siguiente; debajo, las otras salidas.
 *
 * Nació dentro de `Tema.astro` el 4 de septiembre de 2026, cuando contar el
 * grafo de enlaces del sitio construido descubrió que una página de tema no
 * llevaba a ninguna parte más que a la portada. Se separó el 28 de septiembre
 * de 2026, cuando la página de cada bloque de ejercicios (fase E4) necesitó
 * las mismas tarjetas: copiadas, habrían sido el mismo marco en dos sitios
 * esperando a desincronizarse, que es como acabó el controlador de pestañas
 * de `Tema` y `Examen` (Regla 0).
 */
interface Enlace {
  href: string;
  /** La línea pequeña de arriba: «← tema 04», «ruta de estudio». */
  rotulo: string;
  titulo: string;
}

interface Props {
  anterior?: Enlace;
  siguiente?: Enlace;
  otros: Enlace[];
}

const { anterior, siguiente, otros } = Astro.props;
---

<nav class="seguir no-imprimir" aria-label="Seguir desde aquí">
  <div class="s-lados">
    {anterior ? (
      <a class="s-tema s-ant" href={anterior.href}>
        <span class="rotulo">{anterior.rotulo}</span>
        <span class="s-t">{anterior.titulo}</span>
      </a>
    ) : <span />}
    {siguiente && (
      <a class="s-tema s-sig" href={siguiente.href}>
        <span class="rotulo">{siguiente.rotulo}</span>
        <span class="s-t">{siguiente.titulo}</span>
      </a>
    )}
  </div>
  {otros.length > 0 && (
    <div class="s-otros">
      {otros.map((o) => (
        <a class="s-otro" href={o.href}>
          <span class="rotulo">{o.rotulo}</span>
          <span class="s-t">{o.titulo}</span>
        </a>
      ))}
    </div>
  )}
</nav>

<style>
  .seguir {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: .8rem;
  }
  .s-lados {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .8rem;
  }
  .s-tema,
  .s-otro {
    display: grid;
    gap: .2rem;
    padding: .75rem .9rem;
    border: 1.5px solid var(--rule);
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    background: var(--panel);
    transition: border-color .15s;
  }
  .s-tema:hover,
  .s-otro:hover { border-color: var(--live); }
  .s-tema .rotulo,
  .s-otro .rotulo { color: var(--live); }
  .s-sig { text-align: right; }
  .s-t { font-size: .94rem; font-weight: 600; line-height: 1.3; }
  .s-otros { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .8rem; }

  @media (max-width: 40rem) {
    .s-lados { grid-template-columns: 1fr; }
    .s-sig { text-align: left; }
  }
</style>
