  }

  .cuenta {
    font-size: .68rem;
    color: var(--faint);
    background: var(--grid);
    border-radius: 99px;
    padding: .05rem .4rem;
  }

  .pestanas a[aria-current='page'] .cuenta { color: var(--acento); }

  /* ── avisos ────────────────────────────────────────────────────── */
  .aviso {
    margin-bottom: 1.6rem;
    padding: .6rem .8rem;
    border-left: 2px solid var(--live);
