  .pregunta summary::-webkit-details-marker { display: none; }
  .pregunta summary:hover { background: var(--live-soft); }

  .p-n { font-size: 1.3rem; color: var(--live); line-height: 1; }

  .p-txt { min-width: 0; }
  .p-tit { display: block; font-size: .95rem; font-weight: 700; line-height: 1.3; }

  .p-demo {
    display: block;
    font-size: .74rem;
    color: var(--flag);
    margin-top: .1rem;
  }

  .p-tema {
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--peso-medio-tinta);
    background: var(--peso-medio-fondo);
    border-radius: 99px;
    padding: .2rem .65rem;
    /* Con `nowrap` + `max-width: 12rem` + puntos suspensivos, cinco de las
       siete pastillas de la ordinaria de 2026 salían cortadas —«FUERZAS SOBRE
       CUERPOS CE…», «APLICACIONES DE LA CANTID…»— y no se podía saber de qué
