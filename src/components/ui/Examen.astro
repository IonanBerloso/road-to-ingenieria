    color: var(--graphite);
    margin: 0;
  }

  /* ── la hoja: filas plegables (brief §6) ───────────────────────── */
  .hoja { list-style: none; }

  .pregunta {
    border: 1.5px solid var(--rule);
    border-radius: 12px;
    background: var(--panel);
