    font-variant-numeric: tabular-nums;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
  }

  .s-letra { font-size: .78rem; color: var(--graphite); margin: 0; max-width: var(--measure); }
  .s-estado { font-size: .82rem; color: var(--live); margin: .5rem 0 0; min-height: 1.2em; }

  /* La nota propia. Aparece al terminar y se queda abajo como historial. */
  .s-nota {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
    margin: .7rem 0 0;
  }

  .s-nota .rotulo { color: var(--live); }

  .s-nota input {
    width: 5rem;
    font: inherit;
    font-family: var(--mono);
    font-size: .9rem;
    padding: .25rem .4rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .s-nota input:focus-visible { border-color: var(--live); }

  .s-historial {
    list-style: none;
