---
/**
 * El armazón de una página de examen. Es hermano de `ui/Tema.astro` y usa el
 * mismo mecanismo de paneles, pero lo que separa no es teoría de ejercicios:
 * es **el examen en blanco** de **sus resoluciones**.
 *
 * Por qué abre en blanco. Un boletín se estudia leyendo la solución; un examen
 * no se prepara así. Lo que entrena es ponerte delante del papel sin ayuda, y
 * para eso la resolución tiene que estar a un clic de distancia pero no antes.
 * Por eso el panel por defecto es la hoja y no las resoluciones.
 *
 * Honestidad sobre lo que esto es y lo que no: el sitio es estático, así que
 * las resoluciones **están en el HTML** desde el primer momento, igual que
 * pasa con cualquier ejercicio guiado. Esto oculta, no cifra. Quien quiera
 * hacer trampas mirando el código fuente puede; el objetivo es que no te la
 * encuentres sin querer, no montar un examen vigilado.
 */
import { mate } from '../../lib/markdown.mjs';
import EjercicioGuiado from '../patrones/EjercicioGuiado.astro';
import Reparto, { type Puntos } from './Reparto.astro';

export type { Puntos };

export interface EjercicioDeExamen {
  id: string;
  titulo: string;
  enunciado: string;
  pide: string;
  /** Título del tema al que pertenece, ya resuelto por la página. */
  tema: string;
  puntos?: Puntos;
}

interface Props {
  eyebrow: string;
  titulo: string;
  fecha: string;
  /** Href al PDF original, ya pasado por `archivo()`. */
  pdf: string;
  /** Tamaño del PDF en KB, para que el enlace diga lo que va a descargar. */
  pdfKb: number;
  ejercicios: EjercicioDeExamen[];
}

const { eyebrow, titulo, fecha, pdf, pdfKb, ejercicios } = Astro.props;

const total = ejercicios.reduce(
  (s, e) => s + (e.puntos ? e.puntos.comp1 + e.puntos.comp2 + e.puntos.comp4 : 0),
  0,
);

/** Los enunciados se dibujan aquí, en la hoja, además de dentro de cada
 *  ejercicio guiado. No es duplicar por descuido: la hoja tiene que poder
 *  imprimirse y leerse como el papel original, sin botones ni pasos.
 *
 *  Y por eso el prefijo de ids es `hoja-` y no el del ejercicio: los dos
 *  renderizados conviven en la misma página, así que las figuras SVG que
 *  traiga un enunciado tendrían el mismo `id` dos veces. Eran 62 de los 309
 *  ids repetidos que se midieron el 23 de agosto de 2026. */
const hoja = await Promise.all(
  ejercicios.map(async (e) => ({
    ...e,
    enunciadoHtml: await mate(e.enunciado, `hoja-${e.id}`),
    pideHtml: await mate(e.pide, `hoja-${e.id}`),
  })),
);

---

<div class="shell" data-armazon>
  <nav class="rail" aria-label="Índice del examen">
    <h2 class="rotulo">Ejercicios</h2>
    <ol>
      {
        ejercicios.map((e) => (
          <li>
            <a href={`#ej-${e.id}`}>{e.titulo}</a>
          </li>
        ))
      }
    </ol>

    <a class="pdf" href={pdf} target="_blank" rel="noopener">
      <span class="pdf-icono" aria-hidden="true">↓</span>
      <span class="pdf-txt">
        <span class="pdf-tit">Enunciado original</span>
        <span class="pdf-meta">PDF · {pdfKb} KB · se abre en otra pestaña</span>
      </span>
    </a>
  </nav>

  <div class="col">
    <p class="rotulo rotulo--live eyebrow">{eyebrow}</p>
    <h1>{titulo}</h1>
    <p class="lede">
      {/* «0 puntos» sería una afirmación falsa: los ocho cuadernillos de
          Álgebra no reparten cero, es que **no publican el reparto**. Cuando
          no lo hay, no se dice nada en vez de decir un número inventado
          (§10). */}
      {fecha} · {ejercicios.length} ejercicios{total > 0 ? ` · ${total} puntos` : ''}
    </p>

    <nav class="pestanas" aria-label="Vistas del examen">
      <a href="#examen" data-pestana="examen" aria-current="page">Hacer el examen</a>
      <a href="#resoluciones" data-pestana="resoluciones">
        Resoluciones
        <span class="cuenta">{ejercicios.length}</span>
      </a>
    </nav>

    <section id="examen" class="panel" aria-label="El examen en blanco">
      <p class="aviso rotulo">
        Empieza sin mirar. Las resoluciones están en la otra pestaña.
      </p>

      <ol class="hoja">
        {
          hoja.map((e) => (
            <li class="pregunta">
              <header class="p-cab">
                <span class="p-n" aria-hidden="true" />
                <span class="p-tema rotulo">{e.tema}</span>
                {e.puntos && (
                  <span class="p-pts rotulo">
                    {e.puntos.comp1 + e.puntos.comp2 + e.puntos.comp4} puntos
                  </span>
                )}
              </header>

              <div class="prosa" set:html={e.enunciadoHtml} />
              <div class="prosa pide" set:html={e.pideHtml} />

              {e.puntos && <Reparto puntos={e.puntos} />}

              <p class="p-ir no-imprimir">
                <a href={`#ej-${e.id}`} data-pestana="resoluciones">Ver la resolución →</a>
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="resoluciones" class="panel" aria-label="Resoluciones">
      <p class="aviso aviso--flag rotulo">
        El examen no publica solución. Todas estas resoluciones son propuesta
        nuestra y están pendientes de revisión.
      </p>
      {ejercicios.map((e) => <EjercicioGuiado id={e.id} />)}
    </section>
  </div>
</div>

<script>
  /* Mismo mecanismo que en `Tema.astro`: sin JavaScript manda `:target`, con él
     no hay salto de scroll y se marca la pestaña activa. */
  const shell = document.querySelector<HTMLElement>('[data-armazon]');

  if (shell) {
    const enlaces = [...shell.querySelectorAll<HTMLAnchorElement>('[data-pestana]')];

    function abre(cual: string, empujarHistorial: boolean) {
      shell!.dataset.panel = cual;
      for (const a of enlaces) {
        if (a.dataset.pestana === cual && a.closest('.pestanas'))
          a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
      if (empujarHistorial) history.replaceState(null, '', `#${cual}`);
    }

    for (const a of enlaces) {
      a.addEventListener('click', (e) => {
        const destino = a.dataset.pestana!;
        /* Los enlaces «ver la resolución» de la hoja cambian de panel Y saltan
           al ejercicio; los de la barra de pestañas solo cambian de panel. */
        const hash = a.getAttribute('href') ?? '';
        if (hash.startsWith('#ej-')) {
          e.preventDefault();
          abre(destino, false);
          document.querySelector(hash)?.scrollIntoView({ block: 'start' });
          history.replaceState(null, '', hash);
        } else {
          e.preventDefault();
          abre(destino, true);
        }
      });
    }

    /** Un enlace a un ejercicio concreto abre las resoluciones. */
    const panelDe = (hash: string) =>
      hash === 'resoluciones' || hash.startsWith('ej-') ? 'resoluciones' : 'examen';

    abre(panelDe(location.hash.slice(1)), false);
    window.addEventListener('hashchange', () => abre(panelDe(location.hash.slice(1)), false));

    /* Al imprimir van los dos: primero la hoja, después las resoluciones. Es
       exactamente cómo se reparte un examen corregido. */
    window.addEventListener('beforeprint', () => (shell.dataset.panel = 'todo'));
    window.addEventListener('afterprint', () =>
      abre(panelDe(location.hash.slice(1)), false),
    );
  }
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  /* ── índice lateral ────────────────────────────────────────────── */
  .rail {
    position: sticky;
    top: 4.2rem;
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    font-size: .82rem;
  }

  .rail h2 { margin-bottom: .9rem; }
  .rail ol { list-style: none; counter-reset: s; }
  .rail li { counter-increment: s; margin-bottom: .15rem; }

  .rail ol a {
    display: flex;
    gap: .6rem;
    padding: .35rem .5rem;
    border-radius: 4px;
    color: var(--graphite);
    text-decoration: none;
    line-height: 1.4;
    transition: background .15s, color .15s;
  }

  .rail ol a::before {
    content: counter(s, decimal-leading-zero);
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    padding-top: .1rem;
  }

  .rail ol a:hover { background: var(--live-soft); color: var(--ink); }

  /* ── el enlace al PDF ──────────────────────────────────────────── */
  .pdf {
    display: flex;
    gap: .7rem;
    align-items: center;
    margin-top: 1.6rem;
    padding: .8rem .75rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color .15s, background .15s;
  }

  .pdf:hover { border-color: var(--live); background: var(--live-soft); }

  .pdf-icono {
    font-family: var(--mono);
    font-size: 1.1rem;
    color: var(--live);
    flex: none;
  }

  .pdf-txt { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .pdf-tit { font-size: .82rem; line-height: 1.25; }

  .pdf-meta {
    font-family: var(--mono);
    font-size: .66rem;
    color: var(--faint);
    letter-spacing: .04em;
  }

  .eyebrow { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }

  /* ── pestañas ──────────────────────────────────────────────────── */
  .pestanas {
    display: flex;
    gap: .3rem;
    margin: 1.6rem 0 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .pestanas a {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--graphite);
    text-decoration: none;
    padding: .55rem .9rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color .15s, border-color .15s;
  }

  .pestanas a:hover { color: var(--ink); }

  .pestanas a[aria-current='page'] {
    color: var(--acento);
    border-bottom-color: var(--acento);
    font-weight: 600;
  }

  .cuenta {
    font-size: .68rem;
    color: var(--faint);
    background: var(--grid);
    border-radius: 99px;
    padding: .05rem .4rem;
  }

  .pestanas a[aria-current='page'] .cuenta { color: var(--acento); }

  /* ── avisos ────────────────────────────────────────────────────── */
  .aviso {
    margin-bottom: 2rem;
    padding: .6rem .8rem;
    border-left: 2px solid var(--live);
    background: var(--live-soft);
    color: var(--ink);
    text-transform: none;
    letter-spacing: .01em;
    max-width: var(--measure);
  }

  .aviso--flag { border-left-color: var(--flag); background: var(--flag-soft); }

  /* ── la hoja de examen ─────────────────────────────────────────── */
  .hoja { list-style: none; counter-reset: p; }

  .pregunta {
    counter-increment: p;
    padding: 1.6rem 0 2rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .pregunta:first-child { border-top: none; padding-top: 0; }

  .p-cab {
    display: flex;
    align-items: baseline;
    gap: .8rem;
    margin-bottom: .9rem;
    flex-wrap: wrap;
  }

  .p-n::before {
    content: counter(p);
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--acento);
    line-height: 1;
  }

  .p-tema { color: var(--graphite); }
  .p-pts { margin-left: auto; color: var(--ink); }

  .pide { color: var(--graphite); margin-top: .5rem; }

  /* El reparto de puntos vive en `ui/Reparto.astro`, con su propio CSS. */

  .p-ir { margin-top: 1.2rem; }

  .p-ir a {
    font-family: var(--mono);
    font-size: .76rem;
    color: var(--live);
    text-decoration: none;
  }

  .p-ir a:hover { text-decoration: underline; }

  /* ── paneles ───────────────────────────────────────────────────
     Sin JavaScript manda `:target`; con él manda `data-panel`. Ojo al orden:
     el panel por defecto es el examen, así que es `#resoluciones` el que
     empieza oculto. */
  #resoluciones { display: none; }
  .shell:has(#resoluciones:target) #examen,
  .shell:has(#resoluciones :target) #examen { display: none; }
  .shell:has(#resoluciones:target) #resoluciones,
  .shell:has(#resoluciones :target) #resoluciones { display: block; }

  .shell[data-panel='resoluciones'] #examen { display: none; }
  .shell[data-panel='resoluciones'] #resoluciones { display: block; }

  .shell[data-panel='examen'] #examen { display: block; }
  .shell[data-panel='examen'] #resoluciones { display: none; }

  .shell[data-panel='todo'] #examen,
  .shell[data-panel='todo'] #resoluciones { display: block; }

  @media (max-width: 820px) {
    /* El `minmax(0, …)` no es decorativo y hay que repetirlo aquí: una
       columna `1fr` a secas conserva `min-width: auto`, así que se niega a
       encogerse por debajo del contenido más ancho que tenga dentro. Con una
       resolución abierta —que trae fórmulas en bloque de KaTeX— eso empujaba
       la página entera a 651 px en un móvil de 360.
       Se descubrió el 24 de agosto de 2026, y llevaba ahí desde que existe la
       página de exámenes: los guardianes comprueban los 360 px pero nunca
       habían abierto una resolución. */
    .shell { grid-template-columns: minmax(0, 1fr); padding-top: 1.5rem; }

    .rail {
      position: static;
      max-height: none;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--rule);
    }

    .rail ol { display: flex; gap: .3rem; overflow-x: auto; padding-bottom: .3rem; }
    .rail ol a { white-space: nowrap; }
    .pdf { margin-top: 1rem; }
  }

  @media print {
    .shell { display: block; }
    .rail, .pestanas, .aviso { display: none; }
    #examen, #resoluciones { display: block !important; }
    .pregunta { break-inside: avoid; }
  }
</style>
