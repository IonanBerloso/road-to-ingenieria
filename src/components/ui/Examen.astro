---
/**
 * El armazón de una página de examen. Es hermano de `ui/Tema.astro` y usa el
 * mismo mecanismo de paneles, pero lo que separa no es teoría de ejercicios:
 * es **el examen en blanco** de **sus resoluciones**.
 *
 * Por qué abre en blanco. Un boletín se estudia leyendo la solución; un examen
 * no se prepara así. Lo que entrena es ponerte delante del papel sin ayuda, y
 * para eso la resolución tiene que estar a un clic de distancia pero no antes.
 * Por eso el panel por defecto es la hoja y no las resoluciones.
 *
 * Desde la fase 2 del rediseño Pizarra (brief §6, tablero «Examen resuelto»)
 * la hoja es una lista de filas plegables: cerrada enseña número, título,
 * tema y reparto; abierta, el enunciado y el paso a las resoluciones. Eso
 * REFUERZA el examen en blanco — ni el enunciado te lo encuentras sin
 * pedirlo — y al imprimir se abren todas solas. Las pestañas se conservan:
 * son el mecanismo que valida el humo y el que funciona sin JavaScript. El
 * tablero no las dibuja; queda anotado como diferencia consciente.
 *
 * Honestidad sobre lo que esto es y lo que no: el sitio es estático, así que
 * las resoluciones **están en el HTML** desde el primer momento, igual que
 * pasa con cualquier ejercicio guiado. Esto oculta, no cifra. Quien quiera
 * hacer trampas mirando el código fuente puede; el objetivo es que no te la
 * encuentres sin querer, no montar un examen vigilado.
 */
import { mate } from '../../lib/markdown.mjs';
import { ejerciciosDelCuadernillo } from '../../lib/cuadernillo';
import EjercicioGuiado from '../patrones/EjercicioGuiado.astro';
import Reparto, { type Puntos } from './Reparto.astro';

export type { Puntos };

export interface EjercicioDeExamen {
  id: string;
  titulo: string;
  enunciado: string;
  pide: string;
  /** Título del tema al que pertenece, ya resuelto por la página. */
  tema: string;
  /** 1 o 2 cuando la asignatura parte en cuatrimestres y el catálogo declara
   *  dónde. Lo calcula la página contra el número del tema; aquí solo se usa
   *  para agrupar las casillas del simulacro. */
  cuatrimestre?: 1 | 2;
  puntos?: Puntos;
  /**
   * El número que tiene **en el cuadernillo**, cuando varias piezas guiadas
   * salen del mismo ejercicio. Solo lo usa Térmica, cuyos exámenes traen tres
   * ejercicios de cinco apartados cada uno; en las demás asignaturas cada
   * pieza es un ejercicio y este campo no viene.
   */
  n?: number;
}

interface Props {
  eyebrow: string;
  titulo: string;
  fecha: string;
  /** Los cuadernillos originales, ya pasados por `archivo()`. Casi siempre es
   *  uno; el examen de mayo-junio de 2020 son dos, y entonces cada uno trae su
   *  `etiqueta` para poder distinguirlos. */
  pdfs: { href: string; kb: number; etiqueta: string | null }[];
  /** Qué es ese PDF. Casi siempre el enunciado que se repartió en el aula;
   *  en Ingeniería Térmica son las veinte resoluciones completas del
   *  profesor, de 14 a 32 páginas, con el enunciado citado arriba. Llamarlas
   *  igual era una afirmación falsa publicada en cinco sitios: ver el campo
   *  `pdfEs` en content.config.ts. */
  pdfEs: 'enunciado' | 'resolucion';
  /** La ruta de estudio que prepara esta convocatoria, si la hay. Sale de
   *  `evaluacion` o de `tambienPrepara` en el YAML de la ruta. */
  ruta: { href: string; titulo: string } | null;
  ejercicios: EjercicioDeExamen[];
  /** Los ejercicios del cuadernillo que no están transcritos, con su motivo.
   *  Va aquí y no en un comentario del YAML porque un comentario no lo lee el
   *  alumno: hasta el 4 de septiembre de 2026 esta página anunciaba «7
   *  ejercicios» de un examen de nueve sin decir una palabra, con el PDF
   *  original enlazado al lado. */
  fuera: { n: number; apartados?: string; motivo: string }[];
  /** Cuántos minutos da la asignatura por ejercicio, si lo ha declarado.
   *  No se recibe la duración ya hecha sino la regla, y se multiplica aquí
   *  por los ejercicios que IMPRIME el cuadernillo — `deCuantos`, que suma los
   *  transcritos y los que se dejaron fuera—. Guardar la duración examen por
   *  examen serían 96 copias de esta multiplicación (§01). */
  minutosPorEjercicio?: number;
}

const { eyebrow, titulo, fecha, pdfs, pdfEs, ruta, ejercicios, fuera, minutosPorEjercicio } =
  Astro.props;

/** ¿Este cuadernillo trae los dos cuatrimestrales? Solo entonces tienen
 *  sentido los preajustes: en el examen de una evaluación suelta, «solo el
 *  primero» sería o todo o nada. */
const hayDosCuatrimestres =
  ejercicios.some((e) => e.cuatrimestre === 1) && ejercicios.some((e) => e.cuatrimestre === 2);
const esResolucion = pdfEs === 'resolucion';
/* Cuántos ejercicios trae el cuadernillo y cuántas resoluciones ofrece el
   sitio no siempre coinciden: en Térmica un ejercicio tiene cinco apartados
   que cruzan tres temas y se parte en varias piezas guiadas. Cuando las
   entradas declaran su `n` manda ese número; si no, las dos cifras son la
   misma y esto se comporta como en las 118 convocatorias anteriores. */
const propios = ejerciciosDelCuadernillo(ejercicios);
const piezas = ejercicios.length;
const enteros = fuera.filter((f) => !f.apartados);
const aMedias = fuera.filter((f) => f.apartados);
const deCuantos = propios + enteros.length;

/* La duración, dicha como se dice en voz alta: «2 h», «2 h 30 min», «30 min».
   Sale de multiplicar, no de una tabla — ver `minutosPorEjercicio` arriba. */
const minutos = minutosPorEjercicio ? minutosPorEjercicio * deCuantos : 0;
const duracion =
  minutos === 0
    ? null
    : minutos < 60
      ? `${minutos} min`
      : minutos % 60 === 0
        ? `${minutos / 60} h`
        : `${Math.floor(minutos / 60)} h ${minutos % 60} min`;

const total = ejercicios.reduce(
  (s, e) => s + (e.puntos ? e.puntos.comp1 + e.puntos.comp2 + e.puntos.comp4 : 0),
  0,
);

/** El reparto agregado de la convocatoria, para la barra apilada del carril.
 *  Solo se pinta si el examen publica reparto (§10): los cuadernillos de
 *  Álgebra no lo publican y ahí no se inventa nada. */
const agregado = ejercicios.reduce(
  (s, e) => ({
    comp1: s.comp1 + (e.puntos?.comp1 ?? 0),
    comp2: s.comp2 + (e.puntos?.comp2 ?? 0),
    comp4: s.comp4 + (e.puntos?.comp4 ?? 0),
  }),
  { comp1: 0, comp2: 0, comp4: 0 },
);

/** Un ejercicio 100 % demostración se señala en la propia fila (§09): es el
 *  caso que nadie espera y el que más suspende. */
const esDemostracion = (p?: Puntos) =>
  !!p && p.comp1 === 0 && p.comp2 === 0 && p.comp4 > 0;

/** Los enunciados se dibujan aquí, en la hoja, además de dentro de cada
 *  ejercicio guiado. No es duplicar por descuido: la hoja tiene que poder
 *  imprimirse y leerse como el papel original, sin botones ni pasos.
 *
 *  Y por eso el prefijo de ids es `hoja-` y no el del ejercicio: los dos
 *  renderizados conviven en la misma página, así que las figuras SVG que
 *  traiga un enunciado tendrían el mismo `id` dos veces. Eran 62 de los 309
 *  ids repetidos que se midieron el 23 de agosto de 2026. */
const hoja = await Promise.all(
  ejercicios.map(async (e) => ({
    ...e,
    enunciadoHtml: await mate(e.enunciado, `hoja-${e.id}`),
    pideHtml: await mate(e.pide, `hoja-${e.id}`),
  })),
);

const fueraHtml = await Promise.all(
  fuera.map(async (f) => ({ ...f, motivoHtml: await mate(f.motivo, `fuera-${f.n}`) })),
);
---

<div class="shell" data-armazon>
  <div class="col">
    <p class="mano honesta">tal cual cayó — sin cambiar un número</p>
    <p class="rotulo rotulo--live eyebrow">{eyebrow}</p>
    <h1>{titulo}</h1>
    <p class="lede">
      {/* «0 puntos» sería una afirmación falsa: los ocho cuadernillos de
          Álgebra no reparten cero, es que **no publican el reparto**. Cuando
          no lo hay, no se dice nada en vez de decir un número inventado
          (§10). */}
      {fecha} · {enteros.length > 0 ? `${propios} de los ${deCuantos} ejercicios` : `${propios} ejercicios`}{aMedias.length > 0 ? `, ${aMedias.length} a medias` : ''}{piezas > propios ? ` · ${piezas} resoluciones` : ''}{total > 0 ? ` · ${total} puntos` : ''}{duracion ? ` · ${duracion} de reloj` : ''}
    </p>

    <nav class="pestanas" aria-label="Vistas del examen">
      <a href="#examen" data-pestana="examen" aria-current="page">Hacer el examen</a>
      <a href="#resoluciones" data-pestana="resoluciones">
        Resoluciones
        <span class="cuenta">{ejercicios.length}</span>
      </a>
    </nav>

    <section id="examen" class="panel" aria-label="El examen en blanco">
      <p class="aviso rotulo">
        Empieza sin mirar: abre cada ejercicio cuando vayas a por él. Las
        resoluciones están en la otra pestaña.
      </p>

      {/* ── el simulacro ──────────────────────────────────────────────
          Nace el 15 de septiembre de 2026. Los siete bloques «enteros» de las
          rutas de Cálculo llevaban meses diciendo «siéntate con el papel en
          blanco y con reloj», y el `falta[]` de cada uno reconocía que el
          reloj lo ponía el alumno porque la página no lo tenía. Ahora lo
          tiene, y la duración no se inventa: sale de la regla que declara el
          catálogo (§10).

          Sale `hidden` y lo enciende el script, que es la única forma honesta
          de hacerlo en un sitio estático: sin JavaScript no hay cronómetro, y
          entonces tampoco hay un mando que prometa uno. Lo demás de la página
          —el enunciado, las resoluciones— sigue funcionando igual.

          Elegir ejercicios no es un adorno: la ordinaria trae los dos
          parciales en el mismo cuadernillo, y quien prepara el segundo quiere
          sentarse con cuatro ejercicios y dos horas, no con ocho y cuatro.
          Quitar los que no entran ajusta el reloj solo. */}
      {duracion && (
        <section
          class="simulacro no-imprimir"
          data-simulacro
          data-minutos={minutosPorEjercicio}
          hidden
        >
          <p class="rotulo s-tit">Hacerlo con reloj</p>
          <p class="s-txt">
            {minutosPorEjercicio} minutos por ejercicio, que para los {deCuantos} de este
            cuadernillo son <strong data-previsto>{duracion}</strong>. Quita los que no
            vayas a hacer y el reloj se ajusta.
          </p>

          {/* Los tres preajustes.
              El cuadernillo de una convocatoria global trae los dos
              cuatrimestrales seguidos —el de 2019-2020 son trece ejercicios y
              seis horas y media—, y quien va a recuperar solo uno de los dos
              no se sienta seis horas y media. Marcar trece casillas a mano
              para quitar cinco es trabajo que el sitio puede hacer, y el dato
              de qué ejercicio va en cada cuatrimestre ya lo tiene.

              Solo salen si de verdad hay ejercicios de los dos lados: en un
              cuadernillo de una sola evaluación no significarían nada. */}
          {hayDosCuatrimestres && (
            <p class="s-preajustes">
              <span class="rotulo s-pre-tit">De golpe</span>
              <button type="button" class="s-pre" data-preajuste="1">Solo el 1.er cuatrimestre</button>
              <button type="button" class="s-pre" data-preajuste="2">Solo el 2.º</button>
              <button type="button" class="s-pre" data-preajuste="0">Entero</button>
            </p>
          )}

          <fieldset class="s-elige">
            <legend class="rotulo">Qué entra</legend>
            {hoja.map((e, i) => (
              <label class="s-uno">
                <input
                  type="checkbox"
                  checked
                  value={String(i + 1)}
                  data-entra
                  data-cuatri={e.cuatrimestre ?? ''}
                />
                <span>{i + 1}</span>
              </label>
            ))}
          </fieldset>

          <p class="s-mandos">
            <button type="button" class="cta" data-empezar>Empezar</button>
            <button type="button" class="cta" data-terminar hidden>He terminado</button>
            <output class="s-reloj" data-reloj hidden aria-hidden="true">--:--</output>
          </p>

          {/* Las soluciones quedan tapadas mientras corre, y esto lo dice
              antes de empezar: un mando que esconde algo sin avisar se vive
              como un fallo. */}
          <p class="s-letra">
            Mientras corre, la pestaña de resoluciones queda cerrada. Se abre al
            pulsar «He terminado» o cuando se acaba el tiempo, y el reloj
            sobrevive a recargar la página.
          </p>
          <p class="s-estado" data-aviso role="status" aria-live="polite"></p>

          {/* La nota que te pones.
              La página no corrige, así que el único que puede poner el número
              eres tú —y ponerlo es la mitad del ejercicio: obliga a decidir si
              lo que escribiste vale, en vez de mirar la resolución y pensar
              «ah, sí, ya lo sabía». Se guarda con fecha para que el segundo
              intento se pueda comparar con el primero. */}
          <form class="s-nota" data-nota hidden>
            <label class="rotulo" for="s-nota-valor">Qué nota te pones</label>
            <input
              id="s-nota-valor"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              maxlength="5"
              size="5"
              placeholder="0–10"
              data-nota-valor
            />
            <button type="submit" class="cta">Guardar</button>
          </form>

          <ul class="s-historial" data-historial hidden></ul>
        </section>
      )}

      {fuera.length > 0 && (
        <div class="aviso aviso--flag faltan">
          {/* Dos huecos distintos y dos frases distintas, desde el 14 de
              septiembre de 2026: el ejercicio que NO está, y el que está a
              medias. Antes solo cabía el primero, y por eso una convocatoria
              con siete de sus trece apartados resueltos podía decir «3
              ejercicios, resueltos enteros» sin mentir en ninguna línea
              concreta y mintiendo en el conjunto. */}
          <p class="rotulo f-tit">
            {enteros.length === 1
              ? `Falta el ejercicio ${enteros[0].n} de los ${deCuantos} del cuadernillo`
              : enteros.length > 1
                ? `Faltan ${enteros.length} de los ${deCuantos} ejercicios del cuadernillo: el ${enteros.map((f) => f.n).join(' y el ')}`
                : aMedias.length === 1
                  ? `El ejercicio ${aMedias[0].n} está resuelto solo en parte`
                  : `${aMedias.length} de los ${deCuantos} ejercicios están resueltos solo en parte: el ${aMedias.map((f) => f.n).join(' y el ')}`}
          </p>
          <ul>
            {/* El motivo se pintaba en crudo, y son dos defectos en uno: el
                de 2020-2021 publicaba `**no contiene ninguna cuenta**` con
                los asteriscos, y sus cuatro párrafos salían corridos porque
                el `>-` de YAML los deja en un solo `\n` que el HTML colapsa.
                Es el mismo arreglo que se le hizo a `invariante.fuente` el 8
                de septiembre de 2026, por el mismo motivo: si el campo es
                prosa, pasa por `mate()` (§01). */}
            {fueraHtml.map((f) => (
              <li>
                <strong>{f.n}.</strong>{' '}
                {f.apartados && (
                  <em>
                    {f.apartados.includes(',') || f.apartados.includes(' y ')
                      ? `Faltan los apartados ${f.apartados}.`
                      : `Falta el apartado ${f.apartados}.`}
                  </em>
                )}{' '}
                <span class="prosa" set:html={f.motivoHtml} />
              </li>
            ))}
          </ul>
          {/* Este pie decía «es que no sabemos resolverlos con lo que el
              examen publica», y era una razón sola puesta a nombre de todas.
              Valía cuando el único motivo de dejar un ejercicio fuera era que
              faltara material. Con Ingeniería Térmica dejó de valer: sus PDF
              traen la resolución oficial del profesor, así que lo que falta
              ahí es trabajo, no material — y **tres convocatorias publicaban
              su motivo diciendo «no falta material» con este pie debajo
              diciendo lo contrario**. Medido el 10 de septiembre de 2026: 4 de
              las 13 cajas. El pie ya no da la razón; la da cada motivo, que es
              donde se sabe cuál es (§10). */}
          <p class="f-pie">
            {esResolucion
              ? 'Están en el PDF de la escuela, que aquí es el examen corregido por el profesor. Si los echas de menos al contrastar, no es un descuido: cada uno dice ahí arriba por qué todavía no está resuelto aquí.'
              : 'Están en el PDF original, que es el mismo que se repartió en el aula. Si los echas de menos al contrastar, no es un descuido: cada uno dice ahí arriba por qué todavía no está resuelto aquí.'}
          </p>
        </div>
      )}

      <ol class="hoja">
        {
          hoja.map((e, i) => (
            <li data-n={i + 1}>
              <details class:list={['pregunta', { demo: esDemostracion(e.puntos) }]}>
                <summary>
                  <span class="mano p-n" aria-hidden="true">{i + 1}</span>
                  <span class="p-txt">
                    <span class="p-tit">{e.titulo}</span>
                    {esDemostracion(e.puntos) && (
                      <span class="p-demo">
                        los {e.puntos!.comp4} puntos son demostración — cero cálculo
                      </span>
                    )}
                  </span>
                  <span class="p-tema">{e.tema}</span>
                  {e.puntos && (
                    <span class="p-pts">
                      {e.puntos.comp1} + {e.puntos.comp2} + {e.puntos.comp4} ={' '}
                      <strong>{e.puntos.comp1 + e.puntos.comp2 + e.puntos.comp4} pts</strong>
                    </span>
                  )}
                  <span class="p-flecha" aria-hidden="true">▾</span>
                </summary>

                <div class="p-cuerpo">
                  <div class="prosa" set:html={e.enunciadoHtml} />
                  <div class="prosa pide" set:html={e.pideHtml} />

                  {e.puntos && <Reparto puntos={e.puntos} />}

                  <p class="p-ir no-imprimir">
                    <a class="cta" href={`#ej-${e.id}`} data-pestana="resoluciones">
                      Resolver guiado →
                    </a>
                    <span class="p-nota">
                      El examen no publica solución: la resolución es propuesta
                      nuestra, pendiente de revisión.
                    </span>
                  </p>
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="resoluciones" class="panel" aria-label="Resoluciones">
      <p class="aviso aviso--flag rotulo">
        El examen no publica solución. Todas estas resoluciones son propuesta
        nuestra y están pendientes de revisión.
      </p>
      {ejercicios.map((e) => <EjercicioGuiado id={e.id} />)}
    </section>
  </div>

  <!-- ── el carril derecho: el original y el reparto (brief §6) ── -->
  <aside class="rail" aria-label="El enunciado original y el reparto">
    {
      pdfs.map((p) => (
        <div class="pdf-caja">
          <p class="mano pdf-tit">
            {esResolucion ? 'El examen corregido' : 'El enunciado original'}
            {p.etiqueta ? ` · ${p.etiqueta}` : ''}
          </p>
          <p class="pdf-sub">
            {esResolucion
              ? 'El PDF de la escuela, y aquí no es el cuadernillo en blanco: es la corrección del profesor, con el enunciado citado arriba y su desarrollo debajo. Ábrelo después de intentarlo, no antes.'
              : 'El PDF de la escuela, tal cual se repartió en el aula. Estudia con lo que cayó, y contrasta cada resolución con su enunciado.'}
          </p>
          <a class="pdf-cta" href={p.href} target="_blank" rel="noopener">
            Abrir el PDF →
          </a>
          <span class="pdf-meta rotulo">PDF · {p.kb} KB · otra pestaña</span>
        </div>
      ))
    }

    {
      total > 0 && (
        <div class="rep-caja">
          <p class="rotulo rep-tit">Reparto por competencias</p>
          <div class="rep-barra" aria-hidden="true">
            <span class="rc1" style={`width:${(agregado.comp1 / total) * 100}%`} />
            <span class="rc2" style={`width:${(agregado.comp2 / total) * 100}%`} />
            <span class="rc4" style={`width:${(agregado.comp4 / total) * 100}%`} />
          </div>
          <p class="rep-fila"><span class="cua rc1" aria-hidden="true"></span>Reconocer — {agregado.comp1} pts</p>
          <p class="rep-fila"><span class="cua rc2" aria-hidden="true"></span>Calcular — {agregado.comp2} pts</p>
          <p class="rep-fila"><span class="cua rc4" aria-hidden="true"></span>Justificar y demostrar — {agregado.comp4} pts</p>
          <p class="rep-nota">
            {total - agregado.comp2} de {total} puntos no son calcular.
            {ejercicios.some((e) => esDemostracion(e.puntos)) &&
              ' Hay un ejercicio que es una demostración entera.'}
          </p>
        </div>
      )
    }

    {
      ruta && (
        <a class="ruta-caja" href={ruta.href}>
          <span class="rotulo">Preparar esta convocatoria</span>
          <span class="ruta-tit">{ruta.titulo} →</span>
        </a>
      )
    }
  </aside>
</div>

<script>
  /* ── el simulacro ────────────────────────────────────────────────────
   *
   * Tres cosas y ninguna más: un reloj que cuenta hacia atrás, unas casillas
   * para dejar fuera los ejercicios que no vas a hacer —la ordinaria trae los
   * dos parciales juntos—, y las resoluciones tapadas mientras corre.
   *
   * Lo que NO hace, dicho aquí para que nadie lo busque: no corrige, no
   * guarda lo que escribes y no impide mirar. El sitio es estático y las
   * resoluciones están en el HTML desde que carga la página; esto oculta, no
   * cifra, igual que dice la cabecera del componente. El objetivo es no
   * encontrártelas sin querer.
   *
   * El reloj sobrevive a recargar porque lo que se guarda no es el tiempo que
   * queda sino **cuándo empezó y cuánto dura**: una cuenta atrás guardada como
   * número se congela al cerrar la pestaña, y entonces el simulacro deja de
   * medir lo que dice medir. */
  const sim = document.querySelector<HTMLElement>('[data-simulacro]');

  if (sim) {
    const armazon = document.querySelector<HTMLElement>('[data-armazon]')!;
    const reloj = sim.querySelector<HTMLOutputElement>('[data-reloj]')!;
    const aviso = sim.querySelector<HTMLElement>('[data-aviso]')!;
    const previsto = sim.querySelector<HTMLElement>('[data-previsto]')!;
    const bEmpezar = sim.querySelector<HTMLButtonElement>('[data-empezar]')!;
    const bTerminar = sim.querySelector<HTMLButtonElement>('[data-terminar]')!;
    const casillas = [...sim.querySelectorAll<HTMLInputElement>('[data-entra]')];
    const filas = [...document.querySelectorAll<HTMLElement>('.hoja > li[data-n]')];
    const porEjercicio = Number(sim.dataset.minutos ?? '0');
    const LLAVE = `simulacro:${location.pathname}`;

    const fNota = sim.querySelector<HTMLFormElement>('[data-nota]')!;
    const iNota = sim.querySelector<HTMLInputElement>('[data-nota-valor]')!;
    const uHist = sim.querySelector<HTMLElement>('[data-historial]')!;
    const LLAVE_NOTAS = 'rti:notas';

    /* Sin JavaScript no hay cronómetro, así que el mando tampoco se enseña. */
    sim.hidden = false;

    const cuantos = () => casillas.filter((c) => c.checked).length;

    /* El historial de notas propias.
     *
     * Una entrada por simulacro terminado: la fecha, el número que te pusiste
     * y sobre cuántos ejercicios, porque un 7 sobre cuatro ejercicios y un 7
     * sobre ocho no son el mismo 7. Vive en el mismo sitio que el resto del
     * progreso —este navegador y nada más (§02)— y al lado de `rti:hechos`
     * para que «borrar mi avance» de la ruta se lo lleve también algún día.
     * Se guarda como texto ISO y se enseña en corto. */
    type Nota = { f: string; n: number; de: number };

    const leeNotas = (): Record<string, Nota[]> => {
      try {
        return JSON.parse(localStorage.getItem(LLAVE_NOTAS) ?? '{}');
      } catch {
        return {};
      }
    };

    const enCorto = (iso: string) => {
      const d = new Date(iso + 'T12:00:00');
      return Number.isNaN(d.getTime())
        ? iso
        : d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
    };

    const pintaHistorial = () => {
      const mias = leeNotas()[location.pathname] ?? [];
      uHist.textContent = '';
      uHist.hidden = mias.length === 0;
      for (const x of mias.slice(-5).reverse()) {
        const li = document.createElement('li');
        li.append(`${enCorto(x.f)} · `);
        const b = document.createElement('b');
        b.textContent = String(x.n).replace('.', ',');
        li.append(b, ` sobre ${x.de} ${x.de === 1 ? 'ejercicio' : 'ejercicios'}`);
        uHist.append(li);
      }
    };

    const enPalabras = (min: number) =>
      min < 60 ? `${min} min` : min % 60 === 0 ? `${min / 60} h` : `${Math.floor(min / 60)} h ${min % 60} min`;

    const pinta = (seg: number) => {
      const s = Math.max(0, Math.ceil(seg));
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      reloj.value = `${h > 0 ? `${h}:` : ''}${String(m).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    };

    let tic: ReturnType<typeof setInterval> | null = null;
    /* Los avisos se dicen UNA vez. Un `aria-live` que repite cada segundo es
       inutilizable con lector de pantalla, y por eso el reloj va
       `aria-hidden` y aquí solo entran los hitos. */
    let dichos = new Set<number>();

    function termina(porTiempo: boolean) {
      if (tic) clearInterval(tic);
      tic = null;
      /* Con el almacenamiento bloqueado esto lanza, y lanzaba ANTES de quitar
         `data-bloqueado`: las resoluciones se quedaban cerradas para
         siempre. §02, regla 3 — auditoría del 26 de septiembre de 2026. */
      try {
        localStorage.removeItem(LLAVE);
      } catch { /* sin almacenamiento no hay nada que olvidar */ }
      armazon.removeAttribute('data-bloqueado');
      bTerminar.hidden = true;
      bEmpezar.hidden = false;
      reloj.hidden = true;
      for (const c of casillas) c.disabled = false;
      for (const f of filas) f.hidden = false;
      aviso.textContent = porTiempo
        ? 'Se acabó el tiempo. Las resoluciones ya están abiertas.'
        : 'Hecho. Las resoluciones ya están abiertas.';
      fNota.hidden = false;
      fNota.dataset.de = String(hechoDe);
    }

    function corre(hasta: number) {
      const queda = () => (hasta - Date.now()) / 1000;
      pinta(queda());
      tic = setInterval(() => {
        const q = queda();
        pinta(q);
        for (const hito of [600, 300, 60]) {
          if (q <= hito && q > hito - 1 && !dichos.has(hito)) {
            dichos.add(hito);
            aviso.textContent = `Quedan ${hito / 60} minutos.`;
          }
        }
        if (q <= 0) termina(true);
      }, 1000);
    }

    /* Cuántos ejercicios entraban en ESTE simulacro. Se apunta al empezar
       porque al terminar las casillas vuelven a ser editables, y la nota tiene
       que quedar anclada a lo que de verdad se hizo. */
    let hechoDe = 0;

    function empieza(minutos: number, desde: number, ocultar: number[]) {
      dichos = new Set();
      hechoDe = cuantos();
      for (const f of filas) f.hidden = ocultar.includes(Number(f.dataset.n));
      for (const c of casillas) c.disabled = true;
      armazon.dataset.bloqueado = 'si';
      bEmpezar.hidden = true;
      bTerminar.hidden = false;
      reloj.hidden = false;
      aviso.textContent = `En marcha: ${enPalabras(minutos)} para ${cuantos()} ejercicios.`;
      corre(desde + minutos * 60000);
    }

    for (const c of casillas) {
      c.addEventListener('change', () => {
        if (cuantos() === 0) { c.checked = true; return; }   // al menos uno
        previsto.textContent = enPalabras(cuantos() * porEjercicio);
      });
    }

    /* Los tres preajustes: marcan de golpe lo que entra y ajustan el reloj.
     *
     * No hacen nada que no se pueda hacer a mano; lo que quitan es marcar
     * trece casillas para quitar cinco, que es justo el trabajo que hace que
     * alguien acabe haciendo el simulacro entero por pereza y con el reloj
     * equivocado. El 0 es «entero», que es volver al estado de partida. */
    for (const b of sim.querySelectorAll<HTMLButtonElement>('[data-preajuste]')) {
      b.addEventListener('click', () => {
        const cual = b.dataset.preajuste;
        for (const c of casillas) {
          c.checked = cual === '0' || c.dataset.cuatri === cual;
        }
        /* Si un preajuste dejara todo sin marcar —no debería, porque solo se
           pintan cuando hay de los dos—, se vuelve al cuadernillo entero en
           vez de arrancar un reloj de cero minutos. */
        if (cuantos() === 0) for (const c of casillas) c.checked = true;
        previsto.textContent = enPalabras(cuantos() * porEjercicio);
        aviso.textContent = `Entran ${cuantos()} de ${casillas.length} ejercicios.`;
      });
    }

    bEmpezar.addEventListener('click', () => {
      const fuera = casillas.filter((c) => !c.checked).map((c) => Number(c.value));
      const minutos = cuantos() * porEjercicio;
      const desde = Date.now();
      /* Recordarlo es un extra: si el navegador no deja escribir, el
         simulacro empieza igual y solo se pierde al cerrar la pestaña. */
      try {
        localStorage.setItem(LLAVE, JSON.stringify({ desde, minutos, fuera }));
      } catch { /* almacenamiento bloqueado: se sigue sin recordar */ }
      empieza(minutos, desde, fuera);
    });

    bTerminar.addEventListener('click', () => termina(false));

    fNota.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const crudo = iNota.value.trim().replace(',', '.');
      const n = Number(crudo);
      if (crudo === '' || !Number.isFinite(n) || n < 0 || n > 10) {
        aviso.textContent = 'La nota va de 0 a 10.';
        iNota.focus();
        return;
      }
      const todas = leeNotas();
      const mias = todas[location.pathname] ?? [];
      const h = new Date();
      const hoy = `${h.getFullYear()}-${String(h.getMonth() + 1).padStart(2, '0')}-${String(h.getDate()).padStart(2, '0')}`;
      mias.push({ f: hoy, n, de: Number(fNota.dataset.de ?? '0') });
      todas[location.pathname] = mias;
      try {
        localStorage.setItem(LLAVE_NOTAS, JSON.stringify(todas));
      } catch {}
      iNota.value = '';
      fNota.hidden = true;
      pintaHistorial();
      aviso.textContent = 'Anotada. La tienes abajo, con la fecha.';
    });

    pintaHistorial();

    /* Retomar uno a medias. Si ya se pasó el tiempo mientras la pestaña estaba
       cerrada, no se reanuda: se dice que se acabó. */
    try {
      const guardado = localStorage.getItem(LLAVE);
      if (guardado) {
        const { desde, minutos, fuera } = JSON.parse(guardado);
        if (Date.now() < desde + minutos * 60000) {
          for (const c of casillas) c.checked = !fuera.includes(Number(c.value));
          previsto.textContent = enPalabras(cuantos() * porEjercicio);
          empieza(minutos, desde, fuera);
          aviso.textContent = `Simulacro retomado, con ${enPalabras(Math.ceil((desde + minutos * 60000 - Date.now()) / 60000))} por delante.`;
        } else {
          localStorage.removeItem(LLAVE);
        }
      }
    } catch { /* localStorage puede estar bloqueado; el simulacro sigue funcionando sin recordar */ }
  }

  /* Mismo mecanismo que en `Tema.astro`: sin JavaScript manda `:target`, con él
     no hay salto de scroll y se marca la pestaña activa. */
  const shell = document.querySelector<HTMLElement>('[data-armazon]');

  if (shell) {
    const enlaces = [...shell.querySelectorAll<HTMLAnchorElement>('[data-pestana]')];

    function abre(cual: string, empujarHistorial: boolean) {
      shell!.dataset.panel = cual;
      for (const a of enlaces) {
        if (a.dataset.pestana === cual && a.closest('.pestanas'))
          a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
      if (empujarHistorial) history.replaceState(null, '', `#${cual}`);
    }

    for (const a of enlaces) {
      a.addEventListener('click', (e) => {
        const destino = a.dataset.pestana!;
        /* Con el simulacro en marcha, las resoluciones no se abren. El CSS ya
           las apaga; esto es lo que impide llegar por teclado o por un enlace
           «resolver guiado» de la propia hoja. */
        if (destino === 'resoluciones' && shell!.dataset.bloqueado) {
          e.preventDefault();
          return;
        }
        /* Los enlaces «resolver guiado» de la hoja cambian de panel Y saltan
           al ejercicio; los de la barra de pestañas solo cambian de panel. */
        const hash = a.getAttribute('href') ?? '';
        if (hash.startsWith('#ej-')) {
          e.preventDefault();
          abre(destino, false);
          document.querySelector(hash)?.scrollIntoView({ block: 'start' });
          history.replaceState(null, '', hash);
        } else {
          e.preventDefault();
          abre(destino, true);
        }
      });
    }

    /** Un enlace a un ejercicio concreto abre las resoluciones. */
    const panelDe = (hash: string) =>
      hash === 'resoluciones' || hash.startsWith('ej-') ? 'resoluciones' : 'examen';

    /* Abrir el panel no basta: hay que **saltar** al ejercicio.
       El navegador lo intentó al cargar, con el panel todavía oculto, y un
       elemento sin caja no se puede desplazar (§17). Aquí faltaban las dos
       ramas —al entrar y al cambiar el ancla—, así que un enlace de una ruta
       a la resolución de un ejercicio de examen abría la pestaña buena y
       dejaba la página arriba. Medido el 4 de septiembre de 2026 abriendo
       treinta enlaces de la ruta de Fluidos: cinco no llegaban. */
    const saltaAlEjercicio = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (!h.startsWith('ej-')) return;
      const ir = () => document.getElementById(h)?.scrollIntoView({ block: 'start' });
      if (document.fonts?.ready) document.fonts.ready.then(() => requestAnimationFrame(ir));
      else requestAnimationFrame(ir);
    };

    abre(panelDe(location.hash.slice(1)), false);
    saltaAlEjercicio();
    window.addEventListener('hashchange', () => {
      abre(panelDe(location.hash.slice(1)), false);
      saltaAlEjercicio();
    });

    /* Al imprimir van los dos paneles Y todas las filas abiertas: el
       contenido de un <details> cerrado no se imprime, así que se abren
       antes y se devuelve cada una a como estaba. */
    const preguntas = [...shell.querySelectorAll<HTMLDetailsElement>('details.pregunta')];
    let abiertasAntes: boolean[] = [];
    window.addEventListener('beforeprint', () => {
      shell.dataset.panel = 'todo';
      abiertasAntes = preguntas.map((d) => d.open);
      for (const d of preguntas) d.open = true;
    });
    window.addEventListener('afterprint', () => {
      preguntas.forEach((d, i) => (d.open = abiertasAntes[i] ?? false));
      abre(panelDe(location.hash.slice(1)), false);
    });
  }
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 25rem);
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
    align-items: start;
  }

  .mano { font-family: var(--mano); }

  /* la línea de honestidad, como apunte de tiza sobre el título */
  .honesta { font-size: 1.25rem; color: var(--live); margin-bottom: .1rem; }

  .eyebrow { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }

  /* ── pestañas ──────────────────────────────────────────────────── */
  .pestanas {
    display: flex;
    gap: .3rem;
    margin: 1.6rem 0 2rem;
    border-bottom: 1px solid var(--rule);
  }

  /* ── el simulacro ───────────────────────────────────────────────── */
  .simulacro {
    background: var(--panel);
    border: 1.5px solid var(--rule);
    border-left: 4px solid var(--live);
    border-radius: 12px;
    padding: 1rem 1.2rem;
    margin-bottom: 1.6rem;
  }

  .s-tit { color: var(--live); margin-bottom: .4rem; }
  .s-txt { font-size: .9rem; margin: 0 0 .8rem; max-width: var(--measure); }

  /* ── los tres preajustes ──────────────────────────────────────── */
  .s-preajustes {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .4rem;
    margin: 0 0 .7rem;
  }

  .s-pre-tit { color: var(--faint); margin-right: .2rem; }

  .s-pre {
    font: inherit;
    font-size: .76rem;
    font-weight: 700;
    padding: .28rem .55rem;
    border: 1.5px solid var(--rule);
    border-radius: 7px;
    background: none;
    color: var(--live);
