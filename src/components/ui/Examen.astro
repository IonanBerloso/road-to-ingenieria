    color: var(--graphite);
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }

  .s-historial b { color: var(--live); font-weight: 500; }

  /* Con el simulacro en marcha, la pestaña de resoluciones se apaga. No se
     esconde: que se vea apagada explica por qué no responde, y esconderla
     movería la barra entera de sitio a media prueba. */
  .shell[data-bloqueado] .pestanas a[data-pestana='resoluciones'],
  .shell[data-bloqueado] .p-ir {
    opacity: .4;
    pointer-events: none;
  }

  .pestanas a {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--graphite);
    text-decoration: none;
