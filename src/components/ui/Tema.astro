---
/**
 * El armazón de una página de tema: índice lateral, titular y las dos
 * pestañas — **Teoría** y **Ejercicios**.
 *
 * Estaba metido dentro de `patrones/Lectura.astro`, que así hacía dos cosas a
 * la vez: el patrón de prosa y la página entera. Al pedir la separación entre
 * teoría y ejercicios se vio el problema, porque el armazón es el mismo lo
 * lleve dentro el patrón que sea (§05: los cinco patrones son el CONTENIDO,
 * no la página).
 *
 * Las dos vistas se renderizan enteras en el servidor y se cambian con `:target`,
 * así que las pestañas funcionan **sin JavaScript** y cada una tiene su enlace
 * propio: `…/t01-complejos/#ejercicios` abre directamente los ejercicios. Con
 * JavaScript no hay recarga ni salto de scroll.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  eyebrow: string;
  titulo: string;
  descripcion: string;
  /** Encabezados de la teoría, para el índice lateral. */
  headings: MarkdownHeading[];
  /** Título de cada ejercicio del tema, para el índice de la otra pestaña. */
  ejercicios: { id: string; titulo: string }[];
  fuente?: string;
  competencias: string[];
}

const { eyebrow, titulo, descripcion, headings, ejercicios, fuente, competencias } = Astro.props;
const indice = headings.filter((h) => h.depth === 2);
---

<div class="shell" data-armazon>
  <nav class="rail" aria-label="Índice del tema">
    <div class="rail-bloque" data-de="teoria">
      <h2 class="rotulo">En este tema</h2>
      <ol>
        {
          indice.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rail-bloque" data-de="ejercicios">
      <h2 class="rotulo">Ejercicios</h2>
      <ol>
        {
          ejercicios.map((e) => (
            <li>
              <a href={`#ej-${e.id}`}>{e.titulo}</a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <div class="col">
    <p class="rotulo rotulo--live eyebrow">{eyebrow}</p>
    <h1>{titulo}</h1>
    <p class="lede">{descripcion}</p>

    <nav class="pestanas" aria-label="Secciones del tema">
      {/* `data-pestana` y no `data-ir`: los botones «anterior / siguiente» de
          la lectura ya usan `data-ir`, y con el mismo atributo el manejador de
          las pestañas se enganchaba también a ellos. */}
      <a href="#teoria" data-pestana="teoria" aria-current="page">
        Teoría
      </a>
      <a href="#ejercicios" data-pestana="ejercicios">
        Ejercicios
        <span class="cuenta">{ejercicios.length}</span>
      </a>
    </nav>

    <section id="teoria" class="panel" aria-label="Teoría">
      <slot name="teoria" />
    </section>

    <section id="ejercicios" class="panel" aria-label="Ejercicios">
      {
        ejercicios.length === 0 && (
          <p class="sin-nada">
            Todavía no hay ejercicios de este tema. La teoría está escrita; los
            ejercicios se añaden de uno en uno, resueltos enteros.
          </p>
        )
      }
      <slot name="ejercicios" />
    </section>

    <footer class="pie">
      <p class="rotulo">Entrena {competencias.join(' · ')}</p>
      {fuente && <p class="rotulo fuente">{fuente}</p>}
    </footer>
  </div>
</div>

<script>
  /* Sin JavaScript esto ya funciona: manda `:target`. Lo que añade el script es
     no saltar el scroll al cambiar de pestaña y marcar cuál está activa. */
  const shell = document.querySelector<HTMLElement>('[data-armazon]');

  if (shell) {
    const enlaces = [...shell.querySelectorAll<HTMLAnchorElement>('[data-pestana]')];

    function abre(cual: string, empujarHistorial: boolean) {
      shell!.dataset.panel = cual;
      for (const a of enlaces) {
        if (a.dataset.pestana === cual) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
      if (empujarHistorial) history.replaceState(null, '', `#${cual}`);
    }

    for (const a of enlaces) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        abre(a.dataset.pestana!, true);
      });
    }

    /** Un enlace a un ejercicio concreto (#ej-…) abre la pestaña de ejercicios. */
    const panelDe = (hash: string) =>
      hash === 'ejercicios' || hash.startsWith('ej-') ? 'ejercicios' : 'teoria';

    // Entrar con el enlace puesto, o volver atrás, deja la misma pestaña.
    abre(panelDe(location.hash.slice(1)), false);
    window.addEventListener('hashchange', () => {
      const h = location.hash.slice(1);
      abre(panelDe(h), false);
      /* El navegador ya intentó saltar al ancla con el panel aún oculto, y
         un elemento sin caja no se puede desplazar (§17). Mismo remedio que
         en Examen.astro: ahora que el panel está visible, se salta a mano. */
      if (h.startsWith('ej-')) document.getElementById(h)?.scrollIntoView({ block: 'start' });
    });

    // Al imprimir va todo: teoría y ejercicios, que es como se repasa (§11).
    window.addEventListener('beforeprint', () => (shell.dataset.panel = 'todo'));
    window.addEventListener('afterprint', () =>
      abre(location.hash.slice(1) === 'ejercicios' ? 'ejercicios' : 'teoria', false),
    );
  }
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  /* ── índice lateral ────────────────────────────────────────────── */
  .rail {
    position: sticky;
    top: 4.2rem;
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    font-size: .82rem;
  }

  .rail h2 { margin-bottom: .9rem; }
  .rail ol { list-style: none; counter-reset: s; }
  .rail li { counter-increment: s; margin-bottom: .15rem; }

  .rail a {
    display: flex;
    gap: .6rem;
    padding: .35rem .5rem;
    border-radius: 4px;
    color: var(--graphite);
    text-decoration: none;
    line-height: 1.4;
    transition: background .15s, color .15s;
  }

  .rail a::before {
    content: counter(s, decimal-leading-zero);
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    padding-top: .1rem;
  }

  .rail a:hover { background: var(--live-soft); color: var(--ink); }
  .rail a[aria-current='true'] { color: var(--live); font-weight: 500; }
  .rail a[aria-current='true']::before { color: var(--live); }

  .eyebrow { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }

  /* ── pestañas ──────────────────────────────────────────────────── */
  .pestanas {
    display: flex;
    gap: .3rem;
    margin: 1.6rem 0 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .pestanas a {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--graphite);
    text-decoration: none;
    padding: .55rem .9rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color .15s, border-color .15s;
  }

  .pestanas a:hover { color: var(--ink); }

  .pestanas a[aria-current='page'] {
    color: var(--acento);
    border-bottom-color: var(--acento);
    font-weight: 600;
  }

  .cuenta {
    font-size: .68rem;
    color: var(--faint);
    background: var(--grid);
    border-radius: 99px;
    padding: .05rem .4rem;
  }

  .pestanas a[aria-current='page'] .cuenta { color: var(--acento); }

  /* ── paneles ───────────────────────────────────────────────────
     Sin JavaScript manda `:target`; con él manda `data-panel`. Las dos
     condiciones van juntas porque las dos tienen que valer. */
  /* `#ejercicios :target` además de `#ejercicios:target`: sin JavaScript, un
     enlace del índice a un ejercicio concreto (#ej-…) también tiene que abrir
     el panel, o el enlace no llevaría a ninguna parte visible. */
  #ejercicios { display: none; }
  .shell:has(#ejercicios:target) #teoria,
  .shell:has(#ejercicios :target) #teoria { display: none; }
  .shell:has(#ejercicios:target) #ejercicios,
  .shell:has(#ejercicios :target) #ejercicios { display: block; }
  .shell:has(#ejercicios:target) .rail-bloque[data-de='teoria'],
  .shell:has(#ejercicios :target) .rail-bloque[data-de='teoria'] { display: none; }
  .rail-bloque[data-de='ejercicios'] { display: none; }
  .shell:has(#ejercicios:target) .rail-bloque[data-de='ejercicios'],
  .shell:has(#ejercicios :target) .rail-bloque[data-de='ejercicios'] { display: block; }

  .shell[data-panel='ejercicios'] #teoria { display: none; }
  .shell[data-panel='ejercicios'] #ejercicios { display: block; }
  .shell[data-panel='ejercicios'] .rail-bloque[data-de='teoria'] { display: none; }
  .shell[data-panel='ejercicios'] .rail-bloque[data-de='ejercicios'] { display: block; }

  .shell[data-panel='teoria'] #teoria { display: block; }
  .shell[data-panel='teoria'] #ejercicios { display: none; }

  /* Al imprimir se sueltan las dos, en orden. */
  .shell[data-panel='todo'] #teoria,
  .shell[data-panel='todo'] #ejercicios { display: block; }

  .sin-nada {
    color: var(--graphite);
    font-size: .95rem;
    max-width: var(--measure);
    padding: 2rem 0;
  }

  /* ── pie ───────────────────────────────────────────────────────── */
  .pie {
    margin-top: 3.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .pie .fuente { margin-left: auto; text-transform: none; letter-spacing: .02em; }

  @media (max-width: 820px) {
    .shell { grid-template-columns: 1fr; padding-top: 1.5rem; }

    .rail {
      position: static;
      max-height: none;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--rule);
    }

    .rail ol { display: flex; gap: .3rem; overflow-x: auto; padding-bottom: .3rem; }
    .rail a { white-space: nowrap; }
  }

  @media print {
    .shell { display: block; }
    .rail, .pestanas { display: none; }
    #teoria, #ejercicios { display: block !important; }
  }
</style>
