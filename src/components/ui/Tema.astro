---
/**
 * El armazón de una página de tema: índice lateral, titular y las dos
 * pestañas — **Teoría** y **Ejercicios**.
 *
 * Estaba metido dentro de `patrones/Lectura.astro`, que así hacía dos cosas a
 * la vez: el patrón de prosa y la página entera. Al pedir la separación entre
 * teoría y ejercicios se vio el problema, porque el armazón es el mismo lo
 * lleve dentro el patrón que sea (§05: los cinco patrones son el CONTENIDO,
 * no la página).
 *
 * Las dos vistas se renderizan enteras en el servidor y se cambian con `:target`,
 * así que las pestañas funcionan **sin JavaScript** y cada una tiene su enlace
 * propio: `…/t01-complejos/#ejercicios` abre directamente los ejercicios. Con
 * JavaScript no hay recarga ni salto de scroll.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  eyebrow: string;
  titulo: string;
  descripcion: string;
  /** Encabezados de la teoría, para el índice lateral. */
  headings: MarkdownHeading[];
  /** Título de cada ejercicio del tema, para el índice de la otra pestaña. */
  ejercicios: { id: string; titulo: string }[];
  fuente?: string;
  competencias: string[];
  /** A dónde se puede ir desde aquí.
   *
   *  POR QUÉ EXISTE. Medido el 4 de septiembre de 2026 sobre el sitio
   *  publicado: una página de tema tenía **un solo enlace de navegación**, el
   *  de la portada. Ni al tema anterior, ni al siguiente, ni a los exámenes de
   *  la asignatura, ni a la ruta que lo prepara. Cuarenta y una páginas de
   *  tema, las tres asignaturas, y todas callejón sin salida: para pasar del
   *  tema 4 al 5 había que volver a la portada y entrar otra vez.
   *
   *  Lo encontró contar el grafo de enlaces del sitio construido, no un
   *  guardián: `verify.mjs` comprueba que ningún enlace esté roto y nadie
   *  comprobaba lo contrario, que es igual de caro. */
  navegacion: {
    anterior?: { href: string; titulo: string; n: number };
    siguiente?: { href: string; titulo: string; n: number };
    examenes: { href: string; cuantos: number; enteras: boolean };
    rutas: { href: string; titulo: string }[];
  };
}

const { eyebrow, titulo, descripcion, headings, ejercicios, fuente, competencias, navegacion } =
  Astro.props;
const indice = headings.filter((h) => h.depth === 2);
---

<div class="shell" data-armazon>
  <nav class="rail" aria-label="Índice del tema">
    <div class="rail-bloque" data-de="teoria">
      <h2 class="rotulo">En este tema</h2>
      <ol>
        {
          indice.map((h) => (
            <li>
              {/* El texto va envuelto: el chip de «simulador» que el script
                  añade a algunos es otro hijo del flex, y con el título como
                  nodo suelto los dos se repartían el ancho y el título se
                  partía en cuatro líneas. */}
              <a href={`#${h.slug}`}>
                <span class="t">{h.text}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rail-bloque" data-de="ejercicios">
      <h2 class="rotulo">Ejercicios</h2>
      <ol>
        {
          ejercicios.map((e) => (
            <li>
              <a href={`#ej-${e.id}`}>{e.titulo}</a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <div class="col">
    <p class="rotulo rotulo--live eyebrow">{eyebrow}</p>
    <h1>{titulo}</h1>
    <p class="lede">{descripcion}</p>

    {/* El acceso a la herramienta del tema, si la hay. Nace oculto y lo
        rellena el script leyendo el DOM: no hay campo en el esquema que diga
        dónde está el simulador, y no debe haberlo — sería un dato que hay que
        mantener a mano al lado de otro que ya lo sabe (Regla 0). */}
    <a class="ir-sim no-imprimir" data-ir-sim href="#" hidden>
      <span class="rotulo rotulo--live">este tema trae un simulador</span>
      <span class="nombre" data-ir-sim-nombre></span>
    </a>

    <nav class="pestanas" aria-label="Secciones del tema">
      {/* `data-pestana` y no `data-ir`: los botones «anterior / siguiente» de
          la lectura ya usan `data-ir`, y con el mismo atributo el manejador de
          las pestañas se enganchaba también a ellos. */}
      <a href="#teoria" data-pestana="teoria" aria-current="page">
        Teoría
      </a>
      <a href="#ejercicios" data-pestana="ejercicios">
        Ejercicios
        <span class="cuenta">{ejercicios.length}</span>
      </a>
    </nav>

    <section id="teoria" class="panel" aria-label="Teoría">
      <slot name="teoria" />
    </section>

    <section id="ejercicios" class="panel" aria-label="Ejercicios">
      {
        ejercicios.length === 0 && (
          <p class="sin-nada">
            Todavía no hay ejercicios de este tema. La teoría está escrita; los
            ejercicios se añaden de uno en uno, resueltos enteros.
          </p>
        )
      }
      <slot name="ejercicios" />
    </section>

    <nav class="seguir no-imprimir" aria-label="Seguir desde aquí">
      <div class="s-lados">
        {navegacion.anterior ? (
          <a class="s-tema s-ant" href={navegacion.anterior.href}>
            <span class="rotulo">← tema {String(navegacion.anterior.n).padStart(2, '0')}</span>
            <span class="s-t">{navegacion.anterior.titulo}</span>
          </a>
        ) : <span />}
        {navegacion.siguiente && (
          <a class="s-tema s-sig" href={navegacion.siguiente.href}>
            <span class="rotulo">tema {String(navegacion.siguiente.n).padStart(2, '0')} →</span>
            <span class="s-t">{navegacion.siguiente.titulo}</span>
          </a>
        )}
      </div>
      <div class="s-otros">
        {navegacion.rutas.map((r) => (
          <a class="s-otro" href={r.href}>
            <span class="rotulo">ruta de estudio</span>
            <span class="s-t">{r.titulo}</span>
          </a>
        ))}
        <a class="s-otro" href={navegacion.examenes.href}>
          <span class="rotulo">exámenes</span>
          <span class="s-t">
            Las {navegacion.examenes.cuantos} convocatorias,{' '}
            {navegacion.examenes.enteras
              ? 'resueltas enteras'
              : 'con su enunciado original y las resueltas que hay'}
          </span>
        </a>
      </div>
    </nav>

    <footer class="pie">
      <p class="rotulo">Entrena {competencias.join(' · ')}</p>
      {fuente && <p class="rotulo fuente">{fuente}</p>}
    </footer>
  </div>
</div>

<script>
  /* Sin JavaScript esto ya funciona: manda `:target`. Lo que añade el script es
     no saltar el scroll al cambiar de pestaña y marcar cuál está activa. */
  const shell = document.querySelector<HTMLElement>('[data-armazon]');

  if (shell) {
    const enlaces = [...shell.querySelectorAll<HTMLAnchorElement>('[data-pestana]')];

    function abre(cual: string, empujarHistorial: boolean) {
      shell!.dataset.panel = cual;
      for (const a of enlaces) {
        if (a.dataset.pestana === cual) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
      if (empujarHistorial) history.replaceState(null, '', `#${cual}`);
    }

    for (const a of enlaces) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        abre(a.dataset.pestana!, true);
      });
    }

    /** Un enlace a un ejercicio concreto (#ej-…) abre la pestaña de ejercicios. */
    const panelDe = (hash: string) =>
      hash === 'ejercicios' || hash.startsWith('ej-') ? 'ejercicios' : 'teoria';

    // Entrar con el enlace puesto, o volver atrás, deja la misma pestaña.
    abre(panelDe(location.hash.slice(1)), false);

    /* Y al ENTRAR con el ancla puesta hay que saltar a mano igual que al
       cambiarla, cosa que este fichero hacía solo en `hashchange`.
       Consecuencia, medida el 4 de septiembre de 2026 abriendo treinta
       enlaces de la ruta de Fluidos: **cinco no llegaban**, y los cinco eran
       enlaces a un ejercicio —los más valiosos de una ruta—. El panel se
       abría bien, el ejercicio estaba a 1.892 px, y la página se quedaba
       arriba. Es el fallo de los 58 enlaces de teoría de agosto con otra
       cara: el destino existe y no llega (§16 punto 2).

       Se espera a las fuentes porque KaTeX cambia la altura de media página
       al dibujar, y sin eso el salto aterriza en el sitio equivocado. */
    {
      const h = location.hash.slice(1);
      if (h.startsWith('ej-')) {
        const salta = () =>
          document.getElementById(decodeURIComponent(h))?.scrollIntoView({ block: 'start' });
        if (document.fonts?.ready) document.fonts.ready.then(() => requestAnimationFrame(salta));
        else requestAnimationFrame(salta);
      }
    }
    window.addEventListener('hashchange', () => {
      const h = location.hash.slice(1);
      abre(panelDe(h), false);
      /* El navegador ya intentó saltar al ancla con el panel aún oculto, y
         un elemento sin caja no se puede desplazar (§17). Mismo remedio que
         en Examen.astro: ahora que el panel está visible, se salta a mano. */
      if (h.startsWith('ej-')) document.getElementById(h)?.scrollIntoView({ block: 'start' });
    });

    // Al imprimir va todo: teoría y ejercicios, que es como se repasa (§11).
    window.addEventListener('beforeprint', () => (shell.dataset.panel = 'todo'));
    window.addEventListener('afterprint', () =>
      abre(location.hash.slice(1) === 'ejercicios' ? 'ejercicios' : 'teoria', false),
    );

    /* ── El simulador del tema, si lo hay ────────────────────────────
       Se descubrió mirando: los cinco simuladores de Fluidos viven dentro de
       un apartado que **no es el primero**, así que en modo guiado están
       `hidden` y no los ve nadie. El sitio los servía correctamente y eran
       invisibles, que es el mismo fallo de los 58 enlaces de teoría de agosto:
       el destino existe y no llega.

       Se resuelve leyendo el DOM y no el esquema. `patron: simulador` está en
       el `.mdx` pero no dice **dónde**, y añadir un campo con el ancla sería
       un dato que hay que mantener a mano al lado de otro que ya lo sabe. */
    const sims = [...shell.querySelectorAll<HTMLElement>('#teoria figure.sim[id]')];
    const sim = sims[0];
    const aviso = shell.querySelector<HTMLAnchorElement>('[data-ir-sim]');

    if (sim && aviso) {
      aviso.href = `#${sim.id}`;
      shell.querySelector('[data-ir-sim-nombre]')!.textContent =
        sim.querySelector('.sim-head h3')?.textContent?.trim() ?? 'ábrelo';
      aviso.hidden = false;

      /* Y el apartado que lo contiene se marca en el índice. Su `h2` es el
         encabezado de nivel 2 que precede al simulador **en orden de
         documento**, que es lo que hay que buscar: para cuando esto corre,
         `Lectura.astro` puede haber envuelto ya cada apartado en su
         `<section class="grupo">`, así que mirar hermanos no basta. */
      const h2s = [...shell.querySelectorAll<HTMLElement>('#teoria h2[id]')];
      /* Se marcan **todos**, no solo el del aviso: si algún día un tema lleva
         dos herramientas, el índice las enseña las dos aunque la cabecera
         nombre la primera. Un comportamiento a medias y silencioso es peor
         que uno incompleto y visible. */
      for (const s of sims) {
        const suyo = h2s
          .filter((h) => h.compareDocumentPosition(s) & Node.DOCUMENT_POSITION_FOLLOWING)
          .pop();
        const destino = suyo && shell.querySelector(`.rail a[href="#${CSS.escape(suyo.id)}"] .t`);
        if (!destino || destino.querySelector('.chip')) continue;
        const chip = document.createElement('span');
        chip.className = 'chip';
        chip.textContent = 'simulador';
        destino.append(chip);
      }

      /* En modo guiado, saltar al simulador tiene que abrir su apartado. De
         eso ya se encarga `abreElAncla()` de Lectura.astro cuando cambia el
         hash, así que aquí basta con dejar que el enlace haga lo suyo — pero
         el navegador no dispara `hashchange` si el hash ya es ese, y entonces
         el segundo clic no hace nada. */
      aviso.addEventListener('click', (e) => {
        if (location.hash === aviso.hash) {
          e.preventDefault();
          sim.scrollIntoView({ block: 'start' });
        }
      });
    }
  }
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  /* ── índice lateral ────────────────────────────────────────────── */
  .rail {
    position: sticky;
    top: 4.2rem;
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    font-size: .82rem;
  }

  .rail h2 { margin-bottom: .9rem; }
  .rail ol { list-style: none; counter-reset: s; }
  .rail li { counter-increment: s; margin-bottom: .15rem; }

  .rail a {
    display: flex;
    gap: .6rem;
    padding: .35rem .5rem;
    border-radius: 4px;
    color: var(--graphite);
    text-decoration: none;
    line-height: 1.4;
    transition: background .15s, color .15s;
  }

  .rail a::before {
    content: counter(s, decimal-leading-zero);
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    padding-top: .1rem;
  }

  .rail a:hover { background: var(--live-soft); color: var(--ink); }
  .rail a[aria-current='true'] { color: var(--live); font-weight: 500; }
  .rail a[aria-current='true']::before { color: var(--live); }

  /* El apartado que lleva la herramienta se distingue de los demás. Antes
     todos se veían iguales y el simulador no aparecía por ninguna parte.

     El chip va **dentro** del texto, no como hermano del número: probado como
     hermano —un `::after` del enlace—, o le robaba el ancho al título y lo
     partía en cuatro líneas, o al forzarlo a su propia línea se llevaba
     también el número. Dentro del texto fluye como una palabra más.

     Y va con `:global` porque **lo crea el script**: Astro acota cada regla
     con un `data-astro-cid-…`, y un elemento nacido en el navegador no lo
     lleva, así que sin `:global` el chip se publica sin ningún estilo —
     pegado a la última palabra y sin caja. */
  .rail a :global(.chip) {
    display: inline-block;
    margin-left: .4rem;
    font-family: var(--mono);
    font-size: .6rem;
    letter-spacing: .06em;
    color: var(--live);
    border: 1px solid var(--live);
    border-radius: 3px;
    padding: 0 .3rem;
    white-space: nowrap;
    vertical-align: 1px;
  }

  /* ── el acceso directo de la cabecera ──────────────────────────── */
  .ir-sim {
    display: inline-flex;
    flex-direction: column;
    gap: .1rem;
    margin: 0 0 1.6rem;
    padding: .6rem .9rem;
    background: var(--live-soft);
    border: 1px solid var(--live);
    border-left-width: 3px;
    border-radius: 0 6px 6px 0;
    text-decoration: none;
    color: var(--ink);
  }

  .ir-sim .nombre { font-size: .88rem; font-weight: 600; }
  .ir-sim:hover .nombre { color: var(--live); }
  .ir-sim:hover { background: var(--panel); }

  .eyebrow { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }

  /* ── pestañas ──────────────────────────────────────────────────── */
  .pestanas {
    display: flex;
    gap: .3rem;
    margin: 1.6rem 0 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .pestanas a {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--graphite);
    text-decoration: none;
    padding: .55rem .9rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color .15s, border-color .15s;
  }

  .pestanas a:hover { color: var(--ink); }

  .pestanas a[aria-current='page'] {
    color: var(--acento);
    border-bottom-color: var(--acento);
    font-weight: 600;
  }

  .cuenta {
    font-size: .68rem;
    color: var(--faint);
    background: var(--grid);
    border-radius: 99px;
    padding: .05rem .4rem;
  }

  .pestanas a[aria-current='page'] .cuenta { color: var(--acento); }

  /* ── paneles ───────────────────────────────────────────────────
     Sin JavaScript manda `:target`; con él manda `data-panel`. Las dos
     condiciones van juntas porque las dos tienen que valer. */
  /* `#ejercicios :target` además de `#ejercicios:target`: sin JavaScript, un
     enlace del índice a un ejercicio concreto (#ej-…) también tiene que abrir
     el panel, o el enlace no llevaría a ninguna parte visible. */
  #ejercicios { display: none; }
  .shell:has(#ejercicios:target) #teoria,
  .shell:has(#ejercicios :target) #teoria { display: none; }
  .shell:has(#ejercicios:target) #ejercicios,
  .shell:has(#ejercicios :target) #ejercicios { display: block; }
  .shell:has(#ejercicios:target) .rail-bloque[data-de='teoria'],
  .shell:has(#ejercicios :target) .rail-bloque[data-de='teoria'] { display: none; }
  .rail-bloque[data-de='ejercicios'] { display: none; }
  .shell:has(#ejercicios:target) .rail-bloque[data-de='ejercicios'],
  .shell:has(#ejercicios :target) .rail-bloque[data-de='ejercicios'] { display: block; }

  .shell[data-panel='ejercicios'] #teoria { display: none; }
  .shell[data-panel='ejercicios'] #ejercicios { display: block; }
  .shell[data-panel='ejercicios'] .rail-bloque[data-de='teoria'] { display: none; }
  .shell[data-panel='ejercicios'] .rail-bloque[data-de='ejercicios'] { display: block; }

  .shell[data-panel='teoria'] #teoria { display: block; }
  .shell[data-panel='teoria'] #ejercicios { display: none; }

  /* Al imprimir se sueltan las dos, en orden. */
  .shell[data-panel='todo'] #teoria,
  .shell[data-panel='todo'] #ejercicios { display: block; }

  .sin-nada {
    color: var(--graphite);
    font-size: .95rem;
    max-width: var(--measure);
    padding: 2rem 0;
  }

  /* ── seguir desde aquí ─────────────────────────────────────────── */
  .seguir {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: .8rem;
  }
  .s-lados {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .8rem;
  }
  .s-tema,
  .s-otro {
    display: grid;
    gap: .2rem;
    padding: .75rem .9rem;
    border: 1.5px solid var(--rule);
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    background: var(--panel);
    transition: border-color .15s;
  }
  .s-tema:hover,
  .s-otro:hover { border-color: var(--live); }
  .s-tema .rotulo,
  .s-otro .rotulo { color: var(--live); }
  .s-sig { text-align: right; }
  .s-t { font-size: .94rem; font-weight: 600; line-height: 1.3; }
  .s-otros { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .8rem; }

  @media (max-width: 40rem) {
    .s-lados { grid-template-columns: 1fr; }
    .s-sig { text-align: left; }
  }

  /* ── pie ───────────────────────────────────────────────────────── */
  .pie {
    margin-top: 3.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .pie .fuente { margin-left: auto; text-transform: none; letter-spacing: .02em; }

  @media (max-width: 820px) {
    .shell { grid-template-columns: 1fr; padding-top: 1.5rem; }

    .rail {
      position: static;
      max-height: none;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--rule);
    }

    .rail ol { display: flex; gap: .3rem; overflow-x: auto; padding-bottom: .3rem; }
    .rail a { white-space: nowrap; }
  }

  @media print {
    .shell { display: block; }
    .rail, .pestanas { display: none; }
    #teoria, #ejercicios { display: block !important; }
  }
</style>
