---
/**
 * El armazón de un bloque de ejercicios de tema: diez ejercicios guiados, la
 * fila de bloques y el camino de vuelta a la teoría (fase E4 de la auditoría
 * del 27 de septiembre de 2026).
 *
 * POR QUÉ EXISTE. Hasta ese día los ejercicios iban dentro de la página del
 * tema, en su segunda pestaña, y la del tema 5 de Cálculo pesaba 11,5 MB: el
 * 97 % eran ellos. La teoría se quedó en `Tema.astro` con el índice de los
 * ejercicios, y cada ejercicio vive aquí, en el bloque de diez que le toca
 * según `lib/ejercicios.ts`.
 *
 * Se parece a `Tema.astro` a propósito —el mismo carril, la misma columna y
 * las mismas tarjetas para seguir—, porque para quien estudia es la misma
 * página partida en dos, no otra sección del sitio. Las tarjetas son el mismo
 * componente, `Seguir.astro`; el CSS del armazón y del carril está copiado de
 * `Tema.astro`, porque allí va enredado con las reglas de sus pestañas, y es
 * deuda apuntada en `tasks/pendiente.md`.
 */
import Seguir from './Seguir.astro';

interface Props {
  eyebrow: string;
  /** El título del tema. */
  titulo: string;
  /** «del 11 al 20». */
  rotulo: string;
  /** Cuántos ejercicios tiene el tema entero. */
  total: number;
  /** El número del primer ejercicio del bloque, para numerar el carril. */
  desde: number;
  /** Los ejercicios de este bloque, para el carril. */
  ejercicios: { id: string; titulo: string }[];
  /** Todos los bloques del tema, para la fila; `actual` es este. */
  bloques: { href: string; tramo: string; actual: boolean }[];
  anterior?: { href: string; rotulo: string };
  siguiente?: { href: string; rotulo: string };
  /** La página del tema, con la teoría y el índice de todos los ejercicios. */
  tema: string;
}

const { eyebrow, titulo, rotulo, total, desde, ejercicios, bloques, anterior, siguiente, tema } =
  Astro.props;

const cuantos =
  bloques.length > 1
    ? `Ejercicios ${rotulo}, de los ${total} del tema.`
    : total === 1
      ? 'El ejercicio del tema.'
      : `Los ${total} ejercicios del tema.`;
---

<div class="shell">
  <nav class="rail" aria-label="Ejercicios de este bloque">
    <h2 class="rotulo">Ejercicios {rotulo}</h2>
    {/* El contador del carril empieza donde empieza el bloque: el tercero
        del bloque 2 es el 13 del tema, que es como lo nombra el índice. */}
    <ol style={`counter-reset: s ${desde - 1}`}>
      {
        ejercicios.map((e) => (
          <li>
            <a href={`#ej-${e.id}`}>{e.titulo}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="col">
    <p class="rotulo rotulo--live eyebrow">{eyebrow}</p>
    <h1>{titulo}</h1>
    <p class="lede">
      {cuantos} La teoría y el índice de todos están en <a href={tema}>la página del tema</a>.
    </p>

    {
      bloques.length > 1 && (
        <nav class="fila no-imprimir" aria-label="Bloques de ejercicios del tema">
          {bloques.map((b) =>
            b.actual ? (
              <a href={b.href} aria-current="page">{b.tramo}</a>
            ) : (
              <a href={b.href}>{b.tramo}</a>
            ),
          )}
        </nav>
      )
    }

    <section class="panel" aria-label={`Ejercicios ${rotulo}`}>
      <slot />
    </section>

    <Seguir
      anterior={anterior && { href: anterior.href, rotulo: '← ejercicios', titulo: anterior.rotulo }}
      siguiente={siguiente && { href: siguiente.href, rotulo: 'ejercicios →', titulo: siguiente.rotulo }}
      otros={[
        { href: tema, rotulo: 'teoría', titulo },
        {
          href: `${tema}#ejercicios`,
          rotulo: 'índice',
          titulo: total === 1 ? 'El ejercicio del tema' : `Los ${total} ejercicios del tema`,
        },
      ]}
    />
  </div>
</div>

<script>
  /* Entrar con el ancla de un ejercicio puesta —`…/ejercicios/2/#ej-…`, que es
     como enlazan las rutas de estudio y la paleta— tiene que dejar la página
     en ese ejercicio.

     Vivía en `Tema.astro` hasta la fase E4, y con su motivo: medido el 4 de
     septiembre de 2026 abriendo treinta enlaces de la ruta de Fluidos, **cinco
     no llegaban**, y los cinco eran enlaces a un ejercicio. El destino estaba a
     1.892 px y la página se quedaba arriba (§16 punto 2).

     Se espera a las fuentes porque KaTeX cambia la altura de media página al
     dibujar, y saltar antes deja el ejercicio en el sitio equivocado. */
  let h = location.hash.slice(1);
  try {
    h = decodeURIComponent(h);
  } catch {}
  if (h.startsWith('ej-')) {
    const salta = () => document.getElementById(h)?.scrollIntoView({ block: 'start' });
    if (document.fonts?.ready) document.fonts.ready.then(() => requestAnimationFrame(salta));
    else requestAnimationFrame(salta);
  }
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  /* ── carril: el de Tema.astro ─────────────────────────────────── */
  .rail {
    position: sticky;
    top: 4.2rem;
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    font-size: .82rem;
  }

  .rail h2 { margin-bottom: .9rem; }
  .rail ol { list-style: none; }
  .rail li { counter-increment: s; margin-bottom: .15rem; }

  .rail a {
    display: flex;
    gap: .6rem;
    padding: .35rem .5rem;
    border-radius: 4px;
    color: var(--graphite);
    text-decoration: none;
    line-height: 1.4;
    transition: background .15s, color .15s;
  }

  .rail a::before {
    content: counter(s, decimal-leading-zero);
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    padding-top: .1rem;
  }

  .rail a:hover { background: var(--live-soft); color: var(--ink); }

  .eyebrow { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }

  /* ── la fila de bloques ───────────────────────────────────────── */
  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin: 1.4rem 0 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .fila a {
    font-family: var(--mono);
    font-size: .76rem;
    font-variant-numeric: tabular-nums;
    color: var(--graphite);
    text-decoration: none;
    padding: .35rem .7rem;
    border: 1.5px solid var(--rule);
    border-radius: 99px;
    transition: border-color .15s, color .15s;
  }

  .fila a:hover { border-color: var(--live); color: var(--ink); }

  .fila a[aria-current='page'] {
    color: var(--acento);
    border-color: var(--acento);
    font-weight: 600;
  }

  .panel { margin-top: 1.6rem; }

  @media (max-width: 820px) {
    .shell { grid-template-columns: 1fr; padding-top: 1.5rem; }

    /* Sin esto la tira de fichas del carril estira la columna hasta caber
       entera y la página se va de lado en un teléfono: es el fallo de los
       428 px de `algebra/t01-espacios-vectoriales`, contado en Tema.astro. */
    .shell > * { min-width: 0; }

    .rail {
      position: static;
      max-height: none;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--rule);
    }

    .rail ol { display: flex; gap: .3rem; overflow-x: auto; padding-bottom: .3rem; }
    .rail a { white-space: nowrap; }
  }

  @media print {
    .shell { display: block; }
    .rail { display: none; }
  }
</style>
