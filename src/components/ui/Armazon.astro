---
/**
 * El armazón de las páginas de estudio que no son la del tema: un carril a la
 * izquierda y la columna. Lo usan cada bloque de ejercicios (fase E4) y la
 * página de las cuestiones de las diapositivas de un tema (fase E3).
 *
 * Nació copiado de `Tema.astro` dentro de `BloqueDeEjercicios.astro`, y se
 * sacó aquí el 28 de septiembre de 2026 al llegar la segunda página que lo
 * necesitaba: tres copias del mismo marco son la Regla 0 esperando a
 * desincronizarse. `Tema.astro` conserva el suyo porque allí va enredado con
 * las reglas de sus pestañas, y eso está apuntado en `tasks/pendiente.md`.
 *
 * El carril y la columna llegan por ranuras, así que los estilos de lo que
 * escribe quien lo usa van con `:global()` dentro de `.rail` y `.col`.
 */
interface Props {
  /** Lo que el lector de pantalla anuncia del carril. */
  carril: string;
}

const { carril } = Astro.props;
---

<div class="shell">
  <nav class="rail" aria-label={carril}>
    <slot name="carril" />
  </nav>
  <div class="col">
    <slot />
  </div>
</div>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  .rail {
    position: sticky;
    top: 4.2rem;
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    font-size: .82rem;
  }

  .rail :global(h2) { margin-bottom: .9rem; }
  .rail :global(ol) { list-style: none; }
  .rail :global(li) { counter-increment: s; margin-bottom: .15rem; }

  .rail :global(a) {
    display: flex;
    gap: .6rem;
    padding: .35rem .5rem;
    border-radius: 4px;
    color: var(--graphite);
    text-decoration: none;
    line-height: 1.4;
    transition: background .15s, color .15s;
  }

  /* El número de cada enlace lo pone un contador: quien lo usa puede hacerlo
     empezar donde quiera (`counter-reset` en su `<ol>`) o quitarlo del todo
     con `data-sin-numero`, cuando lo que enlaza ya lleva el suyo. */
  .rail :global(a::before) {
    content: counter(s, decimal-leading-zero);
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    padding-top: .1rem;
  }

  .rail :global(ol[data-sin-numero] a::before) { content: none; }

  .rail :global(a:hover) { background: var(--live-soft); color: var(--ink); }

  .col :global(.eyebrow) { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }

  @media (max-width: 820px) {
    .shell { grid-template-columns: 1fr; padding-top: 1.5rem; }

    /* Sin esto la tira de fichas del carril estira la columna hasta caber
       entera y la página se va de lado en un teléfono: es el fallo de los
       428 px de `algebra/t01-espacios-vectoriales`, contado en Tema.astro. */
    .shell > * { min-width: 0; }

    .rail {
      position: static;
      max-height: none;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--rule);
    }

    .rail :global(ol) { display: flex; gap: .3rem; overflow-x: auto; padding-bottom: .3rem; }
    .rail :global(a) { white-space: nowrap; }
  }

  @media print {
    .shell { display: block; }
    .rail { display: none; }
  }
</style>
