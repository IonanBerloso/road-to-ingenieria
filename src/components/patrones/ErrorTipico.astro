---
/**
 * El error típico no es un aviso al pie: es contenido principal (CLAUDE.md §08).
 * Por eso ocupa el ancho de la columna de lectura y no el margen.
 *
 * Desde la fase 2 del rediseño Pizarra (brief §2 y §6) es un recuadro de
 * pizarra con el título en tiza amarilla: lo que te suspende se escribe
 * en la pizarra, como lo escribiría el profesor.
 */
interface Props {
  titulo?: string;
}

const { titulo = 'Error típico' } = Astro.props;
---

<div class="error-tipico">
  <p class="titulo">{titulo}</p>
  <div class="cuerpo"><slot /></div>
</div>

<style>
  .error-tipico {
    margin: 1.8rem 0;
    padding: 1rem 1.35rem .9rem;
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(ellipse at 30% 20%, var(--piz-claro), var(--piz-medio) 70%);
    border-radius: 12px;
    box-shadow: var(--piz-vineta-caja), var(--shadow-1);
    color: var(--tiza-suave);
  }

  .titulo {
    font-family: var(--mano);
    font-size: 1.4rem;
    line-height: 1.15;
    color: var(--tiza-amarilla);
    margin-bottom: .35rem;
  }

  .cuerpo { font-size: .94rem; line-height: 1.6; }
  .cuerpo :global(p) { margin-bottom: .6rem; }
  .cuerpo :global(p:last-child) { margin-bottom: 0; }
  .cuerpo :global(strong) { color: var(--tiza); }
  .cuerpo :global(a) { color: var(--tiza-amarilla); }
</style>
