---
/**
 * El error típico no es un aviso al pie: es contenido principal (CLAUDE.md §08).
 * Por eso ocupa el ancho de la columna de lectura y no el margen.
 */
interface Props {
  titulo?: string;
}

const { titulo = 'Error típico' } = Astro.props;
---

<div class="error-tipico">
  <p class="rotulo rotulo--flag">{titulo}</p>
  <div class="cuerpo"><slot /></div>
</div>

<style>
  .error-tipico {
    margin: 1.8rem 0;
    padding: .95rem 1.2rem;
    background: var(--flag-soft);
    border-left: 3px solid var(--flag);
    border-radius: 0 6px 6px 0;
  }

  .rotulo { margin-bottom: .4rem; font-size: .65rem; }

  .cuerpo { font-size: .94rem; line-height: 1.55; }
  .cuerpo :global(p) { margin-bottom: .6rem; }
  .cuerpo :global(p:last-child) { margin-bottom: 0; }
</style>
