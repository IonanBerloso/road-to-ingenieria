  .fb.mal :global(.rotulo) {
    font-family: var(--mano);
    font-size: 1.2rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--tiza-amarilla);
  }

  .fb.mal :global(strong) { color: var(--tiza); }

  /* el campo que ha fallado se pone en rojo mientras el diagnóstico esté
     a la vista */
  .paso:has(.fb.mal:not([hidden])) .respuesta input:not(:disabled) {
    border-color: var(--flag);
    background: var(--flag-soft);
  }

  .fb.pista { border-left: 2px solid var(--alt); background: var(--alt-soft); }
  .fb.pista :global(.rotulo) { color: var(--alt); }
  .fb.bien { border-left: 2px solid var(--live); background: var(--live-soft); }
  .fb.bien :global(.rotulo) { color: var(--live); }

  .solucion {
    margin-top: .9rem;
    padding-top: .8rem;
    border-top: 1px solid var(--rule);
  }

  .solucion > .rotulo { margin-bottom: .5rem; }

  /* ── COMP4 · redactar ──────────────────────────────────────────── */
  .papel {
    display: flex;
    gap: .7rem;
    margin: .8rem 0;
    padding: .7rem .9rem;
