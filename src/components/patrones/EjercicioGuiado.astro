---
/**
 * PATRÓN 3 · EJERCICIO GUIADO (CLAUDE.md §05).
 * Portado de referencia/ejercicio-guiado.html.
 *
 * Este componente es GENÉRICO y se escribe una sola vez: lee el ejercicio de
 * `ejercicios.yaml` y monta la interacción. Si para añadir un ejercicio hay que
 * tocar este fichero, algo está mal diseñado — vuelve atrás y generalízalo (§04).
 *
 * Diagnostica el error concreto: nunca dice «incorrecto» a secas. A los dos
 * intentos aparece la pista; al tercero se abre el desarrollo y se avanza,
 * porque dejar a alguien atascado a las dos de la mañana no enseña nada.
 *
 * Entrena las tres competencias de §09, no solo el número: reconocer (COMP1),
 * calcular (COMP2) y justificar (COMP4).
 */
import { getCollection, getEntry } from 'astro:content';
import { resuelveEjercicio } from '../../lib/construir';
import type { DatosLamina } from '../../lib/lamina';
import { mate } from '../../lib/markdown.mjs';
import Reparto from '../ui/Reparto.astro';
import { archivo } from '../../lib/rutas';
import { enSolo } from '../../lib/edicion.mjs';
import Taller from './Taller.astro';
import Construccion from './Construccion.astro';

interface Props {
  /** `id` del ejercicio dentro de algún ejercicios.yaml. */
  id: string;
}

const { id } = Astro.props;

const ficheros = await getCollection('ejercicios');

/* El id se busca entre TODOS los ficheros, así que tiene que ser único en todo
   el repositorio y no solo dentro del suyo —de esto último ya se encarga el
   esquema—. Hasta hoy la unicidad global salía gratis porque había un fichero
   por tema y los ids llevaban el nombre del tema dentro. Con los exámenes pasan
   a ser catorce ficheros, y dos ejercicios llamados igual en dos de ellos se
   resolverían al primero **en silencio**: la página del examen enseñaría la
   resolución de otro ejercicio sin que nada fallara.
   Se caza aquí, en el build, y no en verify.mjs, porque para cuando hay HTML el
   ejercicio equivocado ya está escrito y parece correcto. */
const encontrados = ficheros.flatMap((f) =>
  f.data.ejercicios.filter((e) => e.id === id).map((e) => ({ e, en: f.id })),
);

if (encontrados.length === 0) {
  throw new Error(
    `No existe el ejercicio "${id}". Búscalo en algún src/content/**/ejercicios.yaml ` +
      `o corrige el id del componente.`,
  );
}

if (encontrados.length > 1) {
  throw new Error(
    `El id "${id}" está repetido en ${encontrados.length} ficheros: ` +
      `${encontrados.map((x) => x.en).join(', ')}. Los ids son únicos en todo el ` +
      `repositorio, porque el componente los busca en todos los ejercicios.yaml a la vez.`,
  );
}

const ejercicio = encontrados[0].e;

/* Expresión Gráfica: la receta del ejercicio, evaluada sobre su lámina aquí,
   en el build. Un objetivo que no compila, un diagnóstico que otro tapa o una
   cifra que no es la de su receta rompen la construcción con el ejercicio y
   el paso delante (`lib/construir`); los demás ejercicios no tienen receta y
   no cuesta nada. */
const datosLamina = ejercicio.receta
  ? ((await getEntry('laminas', ejercicio.receta.lamina))?.data as DatosLamina | undefined)
  : undefined;
const construidos = resuelveEjercicio(ejercicio, datosLamina);

/* ── «¿Esto está mal? Dilo» ───────────────────────────────────────────────
 *
 * POR QUÉ EXISTE, y por qué va en este componente y no en la página. Las
 * 1.192 resoluciones de este sitio las escribimos nosotros, y el 4 de
 * septiembre de 2026 `recalcula` encontró diez desajustes reales en dos
 * asignaturas **ya declaradas terminadas**. Hasta hoy, un alumno que veía uno
 * no tenía forma de decirlo: el sitio es estático, no hay cuentas ni backend.
 * Un enlace a un issue con el ejercicio ya identificado convierte a cada
 * lector en revisor, y es lo único de este proyecto que escala con el número
 * de alumnos en vez de con las horas de quien lo escribe.
 *
 * Va aquí porque las páginas de examen renderizan este mismo componente
 * (`ui/Examen.astro`), así que ponerlo en los dos sitios sería la Regla 0 con
 * otra cara: un enlace escrito dos veces son dos enlaces que se desincronizan.
 *
 * Es un `<a>`, no una petición: sin JavaScript, sin backend y sin cookies. La
 * página no habla con GitHub — es el navegador del alumno cuando pulsa.
 */
const asignaturaDelEjercicio = encontrados[0].en.split('/')[0];
/** En Álgebra y Cálculo un `conjunto` son las raíces de una ecuación, y sus
 *  ayudas hablan de forma exacta y de «grado n». En las demás es una lista de
 *  elementos —los cruces de una lámina de líneas, las cotas que sobran de un
 *  plano—, y esas ayudas no dicen nada. Entra el 1 de octubre de 2026 con los
 *  primeros `conjunto` de Expresión Gráfica (t07 y t10). */
const CONJUNTO_DE_RAICES = new Set(['algebra', 'calculo']);
const sonRaices = CONJUNTO_DE_RAICES.has(asignaturaDelEjercicio);
/** El dibujo original en papel: si el ejercicio es de la colección de su
 *  asignatura («Ejercicio 17 (SD22) · Colección de ejercicios de Geometría
 *  Descriptiva, Sistema Diédrico Directo…», o un apartado del 52 al 55) y la
 *  colección publica su PDF, se enlaza su página. Entra el 8 de octubre de
 *  2026: la lámina del Taller se redibuja, y quien quiera contrastarla con
 *  el papel no tenía cómo (§08: lo que no se puede contrastar pide un acto
 *  de fe). La fuente tiene que **empezar** por el ejercicio («Ejercicio 17
 *  …» o «Apartado 3 · Ejercicio 52 …»), y un ejemplo nuestro no lo lleva
 *  nunca: el del tema 1 cita el Ejercicio 55 porque usa su lámina, y no es
 *  su original. */
const coleccionPropia = (await getCollection('coleccion')).find((c) => c.id === asignaturaDelEjercicio);
const nDeColeccion =
  ejercicio.nivel === 'ejemplo'
    ? undefined
    : ejercicio.fuente.match(/^(?:Apartado [^·]+· )?Ejercicio (\d+)\b[\s\S]*?Colección de ejercicios de Geometría Descriptiva, Sistema Diédrico Directo/)?.[1];
const enColeccion = coleccionPropia?.data.pdf && nDeColeccion
  ? coleccionPropia.data.ejercicios.find((c) => c.n === Number(nDeColeccion))
  : undefined;
const original = enColeccion
  ? { href: `${archivo(`examenes/${asignaturaDelEjercicio}/${coleccionPropia!.data.pdf}`)}#page=${enColeccion.paginas[0]}`, pagina: enColeccion.paginas[0] }
  : null;
const REPO = 'https://github.com/IonanBerloso/road-to-ingenieria';
/* `Astro.url` en un build estático es la URL final de la página, así que el
   aviso llega diciendo desde dónde se mandó sin que haya que pasarlo a mano. */
const paginaDelAviso = new URL(Astro.url.pathname, Astro.site ?? 'https://ionanberloso.github.io').href;
const avisar =
  `${REPO}/issues/new?template=error-ejercicio.yml` +
  `&title=${encodeURIComponent(`[${asignaturaDelEjercicio}] ${id}: `)}` +
  `&ejercicio=${encodeURIComponent(id)}` +
  `&pagina=${encodeURIComponent(paginaDelAviso)}`;
/* Y por correo, para quien no tiene cuenta de GitHub (idea 10 de la
   auditoría de octubre de 2026). Abrir un issue pide registrarse, eso no se
   puede dar por hecho en 1.º, y el repositorio no había recibido ningún
   aviso. Es un `mailto:` con el asunto y el cuerpo ya rellenos —el
   ejercicio y la página—, así que el aviso llega identificado igual que el
   de GitHub. Tampoco es una petición: lo abre el programa de correo de quien
   lo pulsa. La dirección es la de quien mantiene el proyecto, publicada con
   su permiso el 3 de octubre de 2026; vive solo aquí. */
const CORREO = 'ionanberloso@gmail.com';
const avisarPorCorreo =
  `mailto:${CORREO}` +
  `?subject=${encodeURIComponent(`[Road to Ingeniería] [${asignaturaDelEjercicio}] ${id}`)}` +
  `&body=${encodeURIComponent(
    `Ejercicio: ${id}\r\nPágina: ${paginaDelAviso}\r\n\r\n` +
      'Qué está mal, y dónde (el paso, el número o la frase):\r\n\r\n',
  )}`;

/** Barajado estable: el orden de las piezas no puede cambiar entre builds, o
 *  cada despliegue generaría un diff distinto sin que nadie haya tocado nada. */
function baraja<T>(items: T[], semilla: string): T[] {
  let s = [...semilla].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
  const siguiente = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
  const copia = items.map((v, i) => ({ v, i }));
  for (let i = copia.length - 1; i > 0; i--) {
    const j = Math.floor(siguiente() * (i + 1));
    [copia[i], copia[j]] = [copia[j], copia[i]];
  }
  return copia.map((c) => c.v);
}

const COMPETENCIA = {
  reconocer: 'COMP1',
  calcular: 'COMP2',
  justificar: 'COMP4',
  verificar: 'COMP2 · COMP4',
  redactar: 'COMP4',
  /* Dibujar el recinto es COMP4 —representar y explicar— y no COMP2: lo que
     se puntúa no es la cuenta que venga después, es haber entendido la región
     antes de escribir un límite. */
  dibujar: 'COMP4',
  /* En diédrico el cálculo es la construcción: COMP2, como `calcular`. */
  construir: 'COMP2',
} as const;

/* El título del paso `redactar`, según lo que se escribe (`que` en el
   esquema). Decía siempre «Redactar la demostración», que en Mecánica llamaba
   demostración a una definición o a una deducción. */
const TITULO_REDACTAR = {
  demostracion: 'Redactar la demostración',
  deduccion: 'Redactar la deducción',
  definicion: 'Redactar la definición',
  procedimiento: 'Escribir los pasos',
} as const;

/**
 * La coletilla que acompaña al `formato`, según lo que se pueda teclear.
 *
 * POR QUÉ EXISTE. Hasta el 10 de septiembre de 2026 aquí había **una cadena
 * fija**: «— vale la forma exacta: pi/4, sqrt(3)/2, (e^2-1)/2…». Se escribió
 * con Cálculo delante, cuando era la única asignatura, y desde entonces se
 * enseñaba en **todos** los pasos de cálculo del sitio. Medido ese día: de los
 * 2.695 pasos que llevan `formato`, **944 la recibían siendo falsa para su
 * tipo de respuesta** —872 `magnitud`, 49 `vector`, 14 `matriz` y 9
 * `formula`—, es decir el 35 %, y casi todos de Fluidos.
 *
 * No es un detalle de estilo. En una respuesta de tipo `magnitud` la única
 * ayuda que importa es **que hay que escribir la unidad**: el lector la
 * compara por dimensión y diagnostica «número bueno sin unidad» como error
 * propio (§17). Ofrecerle en su lugar `pi/4` es mandarlo al sitio equivocado
 * justo en la asignatura donde la unidad es media nota. Y en `formula`, que no
 * tiene tolerancia ninguna, hablar de «forma exacta» no significa nada.
 *
 * Se arregla aquí y no en los 944 pasos: la Regla 0 con su cara más literal
 * —el script que recorriera los 944 sería la prueba de que el fallo no está en
 * ellos—. No lo cazó ningún guardián; se vio **mirando una captura** de un
 * ejercicio nuevo (§16 punto 1).
 */
function ayudaDelTipo(tipo: string): string {
  switch (tipo) {
    case 'numero':
    case 'complejo':
    case 'conjunto':
      return ' — vale la forma exacta: pi/4, sqrt(3)/2, (e^2-1)/2…';
    case 'magnitud':
      return ' — con su unidad; vale cualquiera de la misma magnitud';
    /* Comprobado contra `lib/algebra.ts` antes de escribirlo (§10): un vector
       separa por comas, salvo que escribas algún punto y coma —entonces manda
       el punto y coma y la coma queda libre como marca decimal—; y una matriz
       separa filas con punto y coma o con salto de línea, y columnas con
       coma. */
    case 'vector':
      return ' — componentes separadas por comas';
    case 'matriz':
      return ' — columnas con comas, filas con punto y coma';
    default:
      return '';
  }
}

/**
 * El `formato` de una respuesta, con la forma exacta **delante** cuando la
 * respuesta es numérica y el formato habla de decimales.
 *
 * §09 lo pide así: «se escribe "en forma exacta, o con cuatro decimales", en
 * ese orden, porque ese es el orden en que el alumno los va a tener». El
 * lector de respuestas acepta la forma exacta en todo paso numérico, así que
 * la oferta se escribe aquí, una vez, y no en cada `formato`.
 *
 * Es la Regla 0 con nombre y fecha: el 28 de septiembre de 2026, con la fase
 * E5 de la auditoría, se reescribieron con un guion 81 formatos de Cálculo que
 * decían «con seis decimales» o «con cuatro decimales» a secas, y se deshizo
 * el mismo día. El guion era la prueba de que esto iba en la capa compartida.
 */
const CON_DECIMALES = /con (una|dos|tres|cuatro|cinco|seis|siete|ocho|\d+) (cifras )?decimales/i;

/**
 * Lo que va entre paréntesis justo detrás de «exacta» no se enseña.
 *
 * En 193 formatos —casi todos de Cálculo— ese paréntesis era **la respuesta**:
 * «en forma exacta (8/5)», con la casilla al lado esperando un 1,6. Lo vio el
 * revisor de la muestra de diagnósticos del 28 de septiembre de 2026 (fase
 * E5), mirando otra cosa. Se quita aquí y no en los 193 (Regla 0): el dato no
 * molesta mientras no se pinte, y así no vuelve a pintarse aunque alguien lo
 * copie. Los paréntesis se cuentan, porque hay respuestas con paréntesis
 * dentro: «(sqrt(2))».
 */
function sinLaRespuesta(formato: string): string {
  const m = /exact\w*\s*\(/i.exec(formato);
  if (!m) return formato;
  const abre = m.index + m[0].length - 1;
  let nivel = 0;
  for (let i = abre; i < formato.length; i++) {
    if (formato[i] === '(') nivel++;
    else if (formato[i] === ')' && --nivel === 0) {
      return sinLaRespuesta(formato.slice(0, abre).replace(/\s+$/, '') + formato.slice(i + 1));
    }
  }
  return formato;
}

function formatoConExacta(tipo: string, formatoDelDato: string, raices = true): string {
  const formato = sinLaRespuesta(formatoDelDato);
  if (tipo === 'conjunto' && !raices) return formato;
  const numerica = tipo === 'numero' || tipo === 'complejo' || tipo === 'conjunto';
  if (!numerica) return formato + ayudaDelTipo(tipo);
  const ejemplos = ' — por ejemplo pi/4, sqrt(3)/2, (e^2-1)/2…';
  if (/exact/i.test(formato)) return formato + ejemplos;
  /* Con una función y no con una cadena de reemplazo: un `$` en el formato no
     se puede leer como un patrón (§17). */
  if (CON_DECIMALES.test(formato)) return formato.replace(CON_DECIMALES, (m) => `en forma exacta o ${m}`) + ejemplos;
  return formato + ayudaDelTipo(tipo);
}

/* Todo el texto del YAML pasa por el mismo procesador que el MDX, así que las
   fórmulas salen en MathML generado en el build (§07). */
/* Prefijo único de esta instancia. Sin él, las treinta resoluciones que
   titulan un apartado «Resultado» producen treinta id="resultado" en la misma
   página; y en un examen, cuyo enunciado se dibuja dos veces, los ids de sus
   figuras SVG salían duplicados. El id de ejercicio ya está validado como
   único en todo el repositorio, unas líneas más arriba. */
const PREFIJO = `ej-${ejercicio.id}`;

const enunciadoHtml = await mate(ejercicio.enunciado, PREFIJO);
/* Las notas que imprime el cuadernillo, aparte del enunciado y tal cual
   (content.config.ts, `notas`): son lo que dice cómo se corrige. */
const notasHtml = await Promise.all((ejercicio.notas ?? []).map((n) => mate(n, PREFIJO)));
const pideHtml = await mate(ejercicio.pide, PREFIJO);
const resolucionHtml = await mate(ejercicio.resolucion, PREFIJO);

const pasos = await Promise.all(
  ejercicio.pasos.map(async (paso, i) => {
    /* `redactar` es el único que no lleva `pregunta`: lo que pide no es una
       respuesta sino un folio escrito, así que su campo se llama `consigna`. */
    if (paso.tipo === 'redactar') {
      /* La rúbrica viene escrita en el paso o, si la misma demostración cae
         en varios ejercicios, es el id de una de `src/content/rubricas/`
         (fase D0). Un id que no existe para la construcción con su nombre:
         una rúbrica vacía publicada sería peor que un error. */
      const puntos =
        typeof paso.rubrica === 'string'
          ? (await getEntry('rubricas', paso.rubrica))?.data.puntos
          : paso.rubrica;
      if (!puntos) {
        throw new Error(`${ejercicio.id}: la rúbrica «${paso.rubrica}» no está en src/content/rubricas`);
      }
      return {
        i,
        tipo: paso.tipo,
        competencia: COMPETENCIA[paso.tipo],
        titulo: TITULO_REDACTAR[paso.que],
        preguntaHtml: await mate(paso.consigna, PREFIJO),
        rubrica: await Promise.all(
          puntos.map(async (r) => ({
            puntoHtml: await mate(r.punto, PREFIJO),
            porqueHtml: await mate(r.porque, PREFIJO),
            minimo: r.minimo === true,
            peso: r.peso ?? 1,
          })),
        ),
        veredictoHtml: await mate(paso.veredicto, PREFIJO),
      };
    }

    /* `dibujar` es el hermano de `redactar`: tampoco lleva `pregunta`, porque
       lo que pide es un folio con un dibujo, no una respuesta que teclear. */
    if (paso.tipo === 'dibujar') {
      return {
        i,
        tipo: paso.tipo,
        competencia: COMPETENCIA[paso.tipo],
        /* Genérico desde el 27 de septiembre de 2026: decía «Dibujarlo antes
           de calcular», que es verdad del recinto de una integral y no de un
           diagrama de flectores, que se dibuja después de las reacciones. Lo
           mismo pasaba con el aviso del papel y con el mensaje de después, que
           hablaban de límites de integración. `dibujar` entró con Cálculo y el
           texto se quedó con su caso. */
        titulo: 'Dibujarlo en papel',
        preguntaHtml: await mate(paso.consigna, PREFIJO),
        comprueba: await Promise.all(
          paso.comprueba.map(async (r) => ({
            puntoHtml: await mate(r.punto, PREFIJO),
            porqueHtml: await mate(r.porque, PREFIJO),
          })),
        ),
        /* Prefijo PROPIO, distinto del del ejercicio, y esto es lo que hace
           posible la migración de las figuras.
           La figura buena de un paso `dibujar` es casi siempre la misma que ya
           está en la resolución del ejercicio, y el esquema decía que había que
           **moverla**. Pero moverla deja colgando la prosa de la resolución,
           que la cita —«como se ve en la figura»—: comprobado el 17 de
           septiembre de 2026 sobre los 77 candidatos, la citan.
           Con un prefijo distinto, el mismo SVG puede estar en los dos sitios
           sin chocar: `mate()` prefija los `id`, el `aria-labelledby`, los
           `href="#…"` y los `url(#…)`, así que cada copia queda con su propio
           juego de identificadores. Copiar en vez de mover deja la resolución
           intacta. */
        figuraHtml: paso.figura ? await mate(paso.figura, `${PREFIJO}-dib${i}`) : null,
        veredictoHtml: await mate(paso.veredicto, PREFIJO),
      };
    }

    /* `construir` tampoco lleva `pregunta`: lo que pide está en la lámina y
       en la lista de puntos, y los dibuja el Taller. */
    if (paso.tipo === 'construir') {
      return {
        i,
        tipo: paso.tipo,
        competencia: COMPETENCIA[paso.tipo],
        titulo: paso.titulo,
        preguntaHtml: '',
        construir: construidos.get(i)!,
        lamina: datosLamina!,
        veredictoHtml: paso.veredicto ? await mate(paso.veredicto, PREFIJO) : null,
      };
    }

    const comun = {
      i,
      tipo: paso.tipo,
      competencia: COMPETENCIA[paso.tipo],
      preguntaHtml: await mate(paso.pregunta, PREFIJO),
    };

    if (paso.tipo === 'reconocer') {
      const mezcladas = baraja(
        paso.opciones.map((o, k) => ({ ...o, k })),
        `${ejercicio.id}-${i}`,
      );
      return {
        ...comun,
        titulo: 'Reconocer el camino',
        opciones: await Promise.all(
          mezcladas.map(async (o) => ({
            textoHtml: await mate(o.texto, PREFIJO),
            mensajeHtml: await mate(o.mensaje, PREFIJO),
            correcta: o.correcta,
          })),
        ),
      };
    }

    if (paso.tipo === 'calcular') {
      return {
        ...comun,
        titulo: paso.titulo,
        respuesta: paso.respuesta,
        distractores: await Promise.all(
          paso.distractores.map(async (d) => ({
            valor: d.valor,
            mensajeHtml: await mate(d.mensaje, PREFIJO),
          })),
        ),
        tambienValen: await Promise.all(
          paso.tambienValen.map(async (t) => ({
            valor: t.valor,
            mensajeHtml: await mate(t.mensaje, PREFIJO),
          })),
        ),
        pistaHtml: await mate(paso.pista, PREFIJO),
        desarrolloHtml: await mate(paso.desarrollo, PREFIJO),
        veredictoHtml: await mate(paso.veredicto, PREFIJO),
      };
    }

    if (paso.tipo === 'verificar') {
      return {
        ...comun,
        titulo: 'Verificar la región',
        condicion: paso.condicion,
        ventana: paso.ventana,
        formato: paso.formato,
        pistaHtml: await mate(paso.pista, PREFIJO),
        desarrolloHtml: await mate(paso.desarrollo, PREFIJO),
        veredictoHtml: await mate(paso.veredicto, PREFIJO),
      };
    }

    // justificar
    const mezcladas = baraja(
      paso.piezas.map((p, k) => ({ ...p, k })),
      `${ejercicio.id}-${i}`,
    );
    return {
      ...comun,
      titulo: 'Justificar el argumento',
      piezas: await Promise.all(
        mezcladas.map(async (p) => ({
          textoHtml: await mate(p.texto, PREFIJO),
          mensajeHtml: await mate(p.mensaje, PREFIJO),
          trampa: p.trampa,
          /** Posición en el razonamiento correcto; -1 si es la trampa. */
          orden: p.trampa ? -1 : p.k,
        })),
      ),
      veredictoHtml: await mate(paso.veredicto, PREFIJO),
    };
  }),
);

/** Lo que necesita el navegador para corregir. Los mensajes NO van aquí:
 *  ya están en el DOM, renderizados en el build. */
const datos = pasos.map((p) => {
  if (p.tipo === 'reconocer') {
    return { tipo: p.tipo, correcta: p.opciones!.findIndex((o) => o.correcta) };
  }
  if (p.tipo === 'calcular') {
    return {
      tipo: p.tipo,
      respuesta: p.respuesta,
      distractores: p.distractores!.map((d) => d.valor),
      tambienValen: (p.tambienValen ?? []).map((t) => t.valor),
      raices: sonRaices,
    };
  }
  if (p.tipo === 'verificar') {
    return { tipo: p.tipo, condicion: p.condicion, ventana: p.ventana };
  }
  /* Ni `redactar` ni `dibujar` se corrigen: el navegador solo tiene que dejar
     pasar al siguiente paso cuando el alumno diga que ya lo ha hecho. Fingir
     que se corrige un folio o un dibujo sería mentir sobre lo que un sitio
     estático puede hacer. */
  if (p.tipo === 'redactar' || p.tipo === 'dibujar') {
    return { tipo: p.tipo };
  }
  /* `construir` corrige dentro del Taller, con sus propios datos; aquí solo
     hace falta saber que el paso existe para escuchar sus eventos. */
  if (p.tipo === 'construir') {
    return { tipo: p.tipo };
  }
  return {
    tipo: p.tipo,
    // Orden correcto expresado sobre las posiciones ya barajadas.
    orden: p.piezas!.map((pieza, k) => ({ k, orden: pieza.orden }))
      .filter((x) => x.orden >= 0)
      .sort((a, b) => a.orden - b.orden)
      .map((x) => x.k),
    trampa: p.piezas!.findIndex((pieza) => pieza.trampa),
  };
});

const total = pasos.filter((p) => p.tipo !== 'reconocer').length + 1;
