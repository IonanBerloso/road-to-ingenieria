  .leyenda-region {
    display: flex;
    align-items: center;
    gap: .4rem;
    margin-top: .4rem;
    font-size: .63rem;
    text-transform: none;
    letter-spacing: .02em;
  }

  .marca { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
  .marca-falta { background: var(--live); opacity: .35; }
  .marca-coincide { background: var(--live); margin-left: .7rem; }
  .marca-sobra { background: var(--flag); margin-left: .7rem; }

  .respuesta input.ancho { width: 16rem; font-size: .88rem; }

  /* ── piezas (COMP4) ────────────────────────────────────────────── */
  .montaje {
    margin: .9rem 0;
    padding-left: 1.2rem;
    font-size: .88rem;
  }

  /* `:global` obligatorio, por lo mismo que el `.fb` de más abajo: los `<li>`
     del montaje los crea `dibujaMontaje` con `createElement`, así que nacen
     SIN el atributo de ámbito de Astro y un selector escopado no los viste
     nunca. Lo encontró la auditoría del 13 de septiembre de 2026 y llevaba
     desde el principio: es el mismo fallo que se corrigió en los nueve
     simuladores, escondido en el patrón más usado del sitio — `justificar`
     aparece una vez por ejercicio. Se veía como el hueco vacío sin sangrar y
     los pasos pegados unos a otros. */
  .montaje :global(li) { margin-bottom: .3rem; }
  .montaje :global(.vacio) { list-style: none; margin-left: -1.2rem; color: var(--faint); font-size: .8rem; }

  .piezas { list-style: none; display: grid; gap: .4rem; }

  .pieza {
    width: 100%;
    text-align: left;
    font-family: var(--body);
    font-size: .88rem;
    color: inherit;
    background: var(--paper);
