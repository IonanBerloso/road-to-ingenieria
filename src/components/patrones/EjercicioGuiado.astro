  /* Las casillas de la rúbrica: la casilla a la izquierda del punto, sin
     quitarle a la lista su número, que dice en qué orden se escribe. */
  .r-como { margin: -.2rem 0 .7rem; font-size: .86rem; color: var(--graphite); }
  .r-fila { display: flex; gap: .55rem; align-items: flex-start; }
  .r-casilla {
