  /* ── prosa que viene del YAML ──────────────────────────────────── */
  .prosa :global(p) { margin-bottom: .7rem; }
  .prosa :global(p:last-child) { margin-bottom: 0; }
  .prosa :global(strong) { font-weight: 600; }
  .prosa :global(ul) { margin: .5rem 0 .7rem 1.1rem; }
