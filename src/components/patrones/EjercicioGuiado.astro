<script>
  import { comparaComplejo, comparaConjunto, leeConjunto } from '../../lib/complejo';
  import { comparaMatriz, comparaVector, leeMatriz, leeVector } from '../../lib/algebra';
  import { analiza, cumple, mismaRegion } from '../../lib/regiones';
  import { leeNumero } from '../../lib/numero';
  import { comparaMagnitud, leeMagnitud, nombreDim } from '../../lib/unidades';
  import { comparaFormula, esFormulaQuimica, leeFormula } from '../../lib/quimica';

  /* Los siete tipos del esquema. Estaba con dos desde antes de Álgebra y se ha
     ido quedando corto sin romper nada, porque el script de un `.astro` no se
     comprueba con TypeScript: las comparaciones contra `magnitud` o `formula`
     funcionaban con un tipo que decía que no existían. Puesto al día. */
  type Respuesta = {
    tipo: 'complejo' | 'numero' | 'conjunto' | 'vector' | 'matriz' | 'magnitud' | 'formula';
    valor: string;
    tolerancia: number;
  };
  type Dato =
    | { tipo: 'reconocer'; correcta: number }
    | { tipo: 'calcular'; respuesta: Respuesta; distractores: string[]; tambienValen?: string[]; raices?: boolean }
    | { tipo: 'justificar'; orden: number[]; trampa: number }
    | { tipo: 'verificar'; condicion: string; ventana: { x: [number, number]; y: [number, number] } }
    | { tipo: 'redactar' | 'dibujar' | 'construir' };

  /** Deja constancia de que este ejercicio está hecho, y de CÓMO.
   *
   *  En el navegador del alumno y en ningún sitio más: el sitio es estático y
   *  no tiene cuentas (§00). Mismo patrón que el modo de lectura y el tema
   *  claro/oscuro, que ya guardan aquí — `try/catch` vacío incluido, porque en
   *  navegación privada `localStorage` puede lanzar al escribir y eso no puede
   *  tumbar un ejercicio.
   *
   *  **Desde el 17 de septiembre de 2026 guarda tres datos más**, y el motivo
   *  es que «hecho» y «dominado» no son lo mismo. Un ejercicio resuelto a la
   *  primera y otro resuelto después de tres fallos y una pista cuentan igual
   *  en la barra de progreso, y no valen igual la noche antes del examen. Se
   *  anota cuántos fallos hubo, si se llegó a enseñar una pista y si se abrió
   *  el desarrollo antes de terminar; con eso la ruta puede decir «a la
   *  primera», «con pista» o «con desarrollo» en cada fila.
   *
   *  **Compatible con lo que ya hubiera guardado**: las entradas antiguas son
   *  `true` a secas y se siguen leyendo como hechas, solo que sin detalle.
   *  Nadie pierde su progreso por esto.
   *
   *  Se avisa además con un evento, para que la ruta de estudio pueda pintar
   *  su progreso sin volver a leer el almacenamiento. */
  function anota(id: string | undefined, como?: { i: number; p: boolean; d: boolean }) {
    if (!id) return;
    try {
      const hechos = JSON.parse(localStorage.getItem('rti:hechos') ?? '{}');
      if (hechos[id]) return;
      hechos[id] = como ? { i: como.i, p: como.p, d: como.d } : true;
      localStorage.setItem('rti:hechos', JSON.stringify(hechos));
    } catch {}
    document.dispatchEvent(new CustomEvent('rti:hecho', { detail: { id } }));
  }

  /* Cada ejercicio se monta por separado: si uno trae un dato que el
     navegador no sabe leer, se queda sin interacción ÉL, no la página
     entera. Hasta el 26 de septiembre de 2026 iban todos en el mismo bucle
     sin protección, y la excepción del primero dejaba muertos los que venían
     detrás. El error se sigue diciendo por consola, que es donde lo escucha
     `humo.mjs`: aislar el fallo no es esconderlo. */
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-ejercicio]')) {
    try {
      montar(raiz);
    } catch (e) {
      console.error(`El ejercicio ${raiz.id || '(sin id)'} no se ha podido montar:`, e);
    }
  }

  function montar(raiz: HTMLElement) {
    const datos: Dato[] = JSON.parse(
      raiz.querySelector<HTMLElement>('[data-datos]')?.textContent ?? '[]',
    );
    const pasos = [...raiz.querySelectorAll<HTMLElement>('[data-paso]')];
    const avance = raiz.querySelector<HTMLElement>('[data-avance]')!;
    const resolucion = raiz.querySelector<HTMLElement>('[data-resolucion]')!;

    /* Sacar la resolución de su `<template>`, una sola vez.
     *
     * Idempotente a propósito: la llaman los tres caminos que enseñan la
     * resolución —terminar el ejercicio, el modo completo e imprimir— y no
     * hay ninguno que pueda dar por hecho que es el primero. La razón de que
     * la resolución viva ahí está en el comentario del marcado, arriba. */
    const materializa = (donde: HTMLElement = resolucion) => {
      for (const tpl of [...donde.querySelectorAll<HTMLTemplateElement>('template[data-cuerpo]')]) {
        tpl.replaceWith(tpl.content.cloneNode(true));
      }
    };
    const modoPista = raiz.querySelector<HTMLElement>('[data-modo-pista]')!;

    const intentos = pasos.map(() => 0);
    const resueltos = pasos.map(() => false);
    let modo: 'guiado' | 'completo' = 'guiado';

    /* ── utilidades ───────────────────────────────────────────────── */

    /* Dos banderas por ejercicio, para que la ruta pueda decir CÓMO se ha
     * resuelto y no solo que se ha resuelto. Ver `anota()`. */
    let pistaVista = false;
    let desarrolloVisto = false;

    const fb = (paso: HTMLElement, clase: string, titulo: string, cuerpo: string) => {
      if (clase === 'pista') pistaVista = true;
      const caja = paso.querySelector<HTMLElement>('[data-fb]')!;
      caja.className = `fb ${clase}`;
      caja.innerHTML = `<p class="rotulo">${titulo}</p>${cuerpo}`;
      caja.hidden = false;
    };

    const limpiaFb = (paso: HTMLElement) => {
      const caja = paso.querySelector<HTMLElement>('[data-fb]')!;
      caja.hidden = true;
      caja.innerHTML = '';
    };

    const html = (paso: HTMLElement, selector: string) =>
      paso.querySelector<HTMLElement>(selector)?.innerHTML ?? '';

    /* Un control deshabilitado con el foco encima lo suelta al <body>, y quien
     * va con teclado o con lector de pantalla pierde el sitio justo cuando le
     * llega el diagnóstico (A6 de la auditoría de octubre de 2026). Así que:
     * - una opción fallada o una pieza ya puesta no se deshabilitan, se marcan
     *   con `aria-disabled`: siguen en el orden de tabulación, se leen como no
     *   disponibles, el clic no hace nada y el foco se queda donde estaba;
     * - una casilla o un botón que se deshabilitan al resolver el paso dicen
     *   si tenían el foco, y entonces `resuelve` lo lleva al paso siguiente.
     *   Solo entonces: con ratón o con el dedo el foco no está en la casilla,
     *   y moverlo abriría el teclado del móvil sin que nadie lo pida. */
    const apaga = (boton: HTMLButtonElement) => boton.setAttribute('aria-disabled', 'true');
    const apagado = (boton: HTMLButtonElement) => boton.getAttribute('aria-disabled') === 'true';
    const desactiva = (control: HTMLInputElement | HTMLButtonElement) => {
      const teniaFoco = document.activeElement === control;
      control.disabled = true;
      return teniaFoco;
    };
    /* Los controles del paso, no sus enlaces: una pregunta que enlaza la
       teoría se llevaría el foco antes que la casilla. */
    const ENFOCABLE =
      'input:not(:disabled), textarea:not(:disabled), select:not(:disabled), button:not(:disabled):not([aria-disabled="true"])';

    function resuelve(i: number, devuelveFoco = false) {
      resueltos[i] = true;
      pasos[i].classList.add('resuelto');
      const sol = pasos[i].querySelector<HTMLElement>('.solucion');
      if (sol) { materializa(sol); sol.removeAttribute('hidden'); }

      const siguiente = pasos[i + 1];
      if (siguiente) {
        siguiente.classList.remove('bloqueado');
        /* El `scroll-behavior: auto !important` de base.css NO anula esto: un
           `behavior` explícito en JavaScript gana a la propiedad CSS. Era la
           única animación del sitio que ignoraba la preferencia de movimiento
           reducido, y encima la que más se dispara —una por paso resuelto, en
           los 7.468 pasos del corpus—. Lo encontró la auditoría del 13 de
           septiembre de 2026; el guardián de §11 no lo veía porque comprueba
           que la cadena `prefers-reduced-motion` aparezca en el CSS, no que
           una animación concreta la respete. */
        if (modo === 'guiado')
          siguiente.scrollIntoView({
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            block: 'center',
          });
        if (devuelveFoco) {
          const destino = siguiente.querySelector<HTMLElement>(ENFOCABLE) ?? siguiente;
          if (destino === siguiente) siguiente.tabIndex = -1;
          destino.focus({ preventScroll: modo === 'guiado' });
        }
      } else {
        materializa();
        resolucion.hidden = false;
        if (devuelveFoco) {
          resolucion.tabIndex = -1;
          resolucion.focus();
        }
      }
      pinta();
    }

    function pinta() {
      const hechos = resueltos.filter(Boolean).length;
      avance.textContent =
        modo === 'completo'
          ? `${pasos.length} pasos`
          : hechos === pasos.length
            ? 'ejercicio completo'
            : `paso ${hechos + 1} de ${pasos.length}`;
      if (hechos === pasos.length) {
        anota(raiz.dataset.ejercicio, {
          i: intentos.reduce((a, b) => a + b, 0),
          p: pistaVista,
          d: desarrolloVisto,
        });
      }
    }

    /* ── COMP1 · reconocer ────────────────────────────────────────── */

    pasos.forEach((paso, i) => {
      const dato = datos[i];
      if (dato.tipo !== 'reconocer') return;

      for (const boton of paso.querySelectorAll<HTMLButtonElement>('[data-opcion]')) {
        boton.addEventListener('click', () => {
          if (resueltos[i] || apagado(boton)) return;
          const k = Number(boton.dataset.opcion);
          const mensaje = html(paso, `[data-msg-opcion="${k}"]`);

          if (k === dato.correcta) {
            boton.classList.add('acertada');
            fb(paso, 'bien', 'Ese es el camino', mensaje);
            resuelve(i);
          } else {
            boton.classList.add('fallada');
            apaga(boton);
            intentos[i]++;
            fb(paso, 'mal', 'Por ahí no', mensaje);
          }
        });
      }
    });

    /* ── COMP2 · calcular ─────────────────────────────────────────── */

    pasos.forEach((paso, i) => {
      const dato = datos[i];
      if (dato.tipo !== 'calcular') return;

      const campo = paso.querySelector<HTMLInputElement>('input')!;
      const { respuesta, distractores } = dato;
      const lista = respuesta.tipo === 'conjunto' && dato.raices === false;

      /** Distancia tolerante: los distractores se reconocen con más holgura que
       *  la respuesta buena, porque lo que importa es identificar el
       *  razonamiento, no el redondeo. */
      const coincide = (escrito: string, objetivo: string, tolerancia: number) => {
        if (respuesta.tipo === 'formula') return comparaFormula(escrito, objetivo).igual;
        if (respuesta.tipo === 'magnitud') {
          const a = leeMagnitud(escrito);
          const b = leeMagnitud(objetivo);
          return a && b ? comparaMagnitud(a, b, tolerancia).igual : false;
        }
        if (respuesta.tipo === 'conjunto') {
          const a = leeConjunto(escrito);
          const b = leeConjunto(objetivo);
          return a && b ? comparaConjunto(a, b, tolerancia).igual : false;
        }
        if (respuesta.tipo === 'vector') {
          const a = leeVector(escrito);
          const b = leeVector(objetivo);
          return a && b ? comparaVector(a, b, tolerancia).igual : false;
        }
        if (respuesta.tipo === 'matriz') {
          const a = leeMatriz(escrito);
          const b = leeMatriz(objetivo);
          return a && b ? comparaMatriz(a, b, tolerancia).igual : false;
        }
        if (respuesta.tipo === 'complejo') {
          const a = lee(escrito);
          const b = lee(objetivo);
          return a && b ? comparaComplejo(a, b, tolerancia) : false;
        }
        const a = lee(escrito);
        const b = lee(objetivo);
        if (!a || !b || Math.abs(a.im) > 1e-9) return false;
        return Math.abs(a.re - b.re) <= tolerancia;
      };

      /* En el examen no se puede usar calculadora, así que una respuesta
         exacta —`pi/4`, `(e^2-1)/2`, `sqrt(3)/2`— tiene que valer igual que
         su decimal. Primero se prueba el lector binómico, que es el que
         entiende `-16-16i`; si no lo reconoce, se evalúa como expresión. */
      const lee = leeNumero;

      const holgura = (objetivo: string) => {
        /* En una magnitud la tolerancia ya ES relativa, así que la holgura del
           2 % que se aplica a los números no tiene sentido aquí: duplicarla
           haría que un distractor al 4 % se comiera la respuesta buena. */
        /* Una fórmula química no tiene escala ni distancia: se acierta o no. */
        if (respuesta.tipo === 'formula') return 0;
        if (respuesta.tipo === 'magnitud') return Math.max(respuesta.tolerancia, 0.02);
        if (respuesta.tipo === 'conjunto') return respuesta.tolerancia;
        /* Un vector o una matriz no tienen «escala» única —cada entrada tiene
           la suya—, así que la holgura del 2 % no se puede calcular sobre el
           conjunto. Se usa la tolerancia declarada, y ya. */
        if (respuesta.tipo === 'vector' || respuesta.tipo === 'matriz') return respuesta.tolerancia;
        const v = lee(objetivo);
        const escala = v ? Math.max(Math.abs(v.re), Math.abs(v.im)) : 1;
        return Math.max(escala * 0.02, respuesta.tolerancia);
      };

      /** Se lee según el tipo: una lista de soluciones no es un solo número. */
      const legible = (texto: string) => {
        if (respuesta.tipo === 'formula') return leeFormula(texto);
        if (respuesta.tipo === 'magnitud') return leeMagnitud(texto);
        if (respuesta.tipo === 'conjunto') return leeConjunto(texto);
        if (respuesta.tipo === 'vector') return leeVector(texto);
        if (respuesta.tipo === 'matriz') return leeMatriz(texto);
        return lee(texto);
      };

      /** Cuántas soluciones faltan o sobran. Sirve para diagnosticar el error
       *  más típico del tema —dar solo la raíz principal— sin necesidad de
       *  declararlo como distractor en cada ejercicio. */
      const balance = (escrito: string) => {
        const a = leeConjunto(escrito);
        const b = leeConjunto(respuesta.valor);
        return a && b ? comparaConjunto(a, b, respuesta.tolerancia) : null;
      };

      function comprueba() {
        if (resueltos[i]) return;
        const escrito = campo.value;

        if (!legible(escrito)) {
          fb(
            paso,
            'mal',
            'No he entendido la respuesta',
            respuesta.tipo === 'magnitud'
              ? '<p>Escribe el <strong>número y la unidad</strong>, por ejemplo ' +
                  '<code>2,5 bar</code> o <code>50 l/s</code>. Vale cualquier unidad de la ' +
                  'misma magnitud: si la respuesta está en pascales, <code>1 bar</code> ' +
                  'también cuenta. Los exponentes se escriben <code>m^3</code> o ' +
                  '<code>m3</code>.</p>'
            : lista
              ? '<p>Escribe <strong>todos</strong> los números separados por comas, ' +
                  'por ejemplo <code>2, 4</code>.</p>'
            : respuesta.tipo === 'conjunto'
              ? '<p>Escribe <strong>todas</strong> las soluciones separadas por comas, ' +
                  'por ejemplo <code>1, -1+i, -1-i</code>.</p>'
              : respuesta.tipo === 'vector'
                ? '<p>Escribe las coordenadas <strong>en orden</strong> y separadas por ' +
                    'comas, por ejemplo <code>(0, 0, -3, 0)</code>. Valen las raíces y las ' +
                    'fracciones: <code>(√6/2, 0, -1/3)</code>. Si necesitas comas decimales, ' +
                    'separa con punto y coma: <code>(2,5; 1)</code>.</p>'
                : respuesta.tipo === 'matriz'
                  ? '<p>Las filas se separan con punto y coma y las columnas con comas, ' +
                      'por ejemplo <code>[1,0,-1; 2,4,0; 0,-2,2]</code>.</p>'
                  : '<p>Escríbela en forma binómica, por ejemplo <code>-3+2i</code>. ' +
                      'Valen las comas decimales y la forma exacta: <code>√2/2</code>, ' +
                      '<code>pi/4</code>, <code>(e^2-1)/2</code>.</p>',
          );
          return;
        }

        intentos[i]++;

        if (coincide(escrito, respuesta.valor, respuesta.tolerancia)) {
          limpiaFb(paso);
          resuelve(i, desactiva(campo));
          return;
        }

        /* Otra respuesta que también vale (`tambienValen`): se resuelve igual,
           y se dice por qué vale y qué otra se da también por buena. Va antes
           que los distractores: el esquema ya impide que uno caiga en su
           ventana. */
        const t = (dato.tambienValen ?? []).findIndex((v) => coincide(escrito, v, respuesta.tolerancia));
        if (t >= 0) {
          resuelve(i, desactiva(campo));
          fb(paso, 'bien', 'También vale', html(paso, `[data-msg-tambien="${t}"]`));
          return;
        }

        const k = distractores.findIndex((d) => coincide(escrito, d, holgura(d)));
        if (k >= 0) {
          fb(paso, 'mal', 'Sé lo que ha pasado', html(paso, `[data-msg-distractor="${k}"]`));
          return;
        }

        /* Los dos diagnósticos de unidades. Van DESPUÉS de los distractores
           —un distractor declarado sabe más del error concreto que una regla
           general— y antes del «no es la respuesta», porque decirle «está mal»
           a quien ha hecho toda la física bien y se ha dejado el «bar» es
           mentirle sobre lo que le falta por aprender. */
        /* Los cuatro errores que el lector químico sabe distinguir, y que no hay
           que declarar como distractor en cada compuesto: son los mismos en
           los veinte del corpus. */
        if (respuesta.tipo === 'formula') {
          const v = comparaFormula(escrito, respuesta.valor);

          if (v.fallo === 'mayusculas') {
            fb(paso, 'mal', 'Cuidado con las mayúsculas',
              '<p>Has escrito las letras correctas con otra caja, y en química eso ' +
                'cambia la sustancia: <code>Co</code> es cobalto y <code>CO</code> es ' +
                'monóxido de carbono.</p>' +
                '<p><strong>Un símbolo de elemento empieza siempre por mayúscula y ' +
                'sigue en minúscula</strong>, nunca al revés y nunca dos mayúsculas ' +
                'seguidas dentro del mismo símbolo.</p>');
            return;
          }

          if (v.fallo === 'parentesis') {
            fb(paso, 'mal', 'Mira los paréntesis',
              '<p>Las letras y los números son los que tocan, y en su orden; lo que ' +
                'no está bien son los paréntesis, que faltan o están en otro sitio.</p>' +
                '<p><strong>Un número detrás de un paréntesis multiplica el grupo ' +
                'entero</strong>; sin paréntesis multiplica solo al símbolo que tiene ' +
                'delante. <code>Cu(OH)₂</code> lleva dos O y dos H; <code>CuOH₂</code> ' +
                'llevaría un O y dos H, que es otra proporción.</p>');
            return;
          }

          if (v.fallo === 'subindices') {
            /* El segundo párrafo decía solo lo de cruzar cargas, y el 29 de
               septiembre de 2026 entró la primera fórmula empírica que se corrige
               con este lector: ahí los subíndices salen de los moles, no de las
               valencias. */
            fb(paso, 'mal', 'Los elementos están bien; la proporción no',
              '<p>Has acertado qué átomos entran y en qué orden, así que el compuesto ' +
                'lo tienes identificado. Lo que falla son los subíndices, es decir ' +
                '<strong>cuántos de cada uno</strong>.</p>' +
                '<p>En un compuesto que se formula por sus cargas, salen de igualarlas: ' +
                'la valencia de uno pasa a ser el subíndice del otro, y después se ' +
                'simplifica si se puede. En una fórmula empírica, salen de dividir los ' +
                'moles de cada elemento entre el menor.</p>');
            return;
          }

          /* Hasta el 28 de septiembre de 2026 este aviso empezaba «Lo que has
             escrito es correcto como compuesto», y el lector no lo comprueba:
             solo sabe que ha llegado un nombre donde se esperaba una fórmula, o
             al revés. A quien escribía «óxido ferroso» por Fe₂O₃ se le decía
             que había acertado el compuesto. */
          if (v.fallo === 'genero-cambiado') {
            const pideFormula = esFormulaQuimica(respuesta.valor);
            fb(paso, 'mal', 'Has contestado en la otra columna',
              (pideFormula
                ? '<p>Aquí te dan el nombre y se pide la <strong>fórmula</strong>, y has escrito un nombre.</p>'
                : '<p>Aquí te dan la fórmula y se pide el <strong>nombre</strong>, y has escrito una fórmula.</p>') +
                '<p>Es un despiste frecuente cuando la lista trae las dos columnas ' +
                'juntas, como en los controles.</p>');
            return;
          }
        }

        if (respuesta.tipo === 'magnitud') {
          const a = leeMagnitud(escrito);
          const b = leeMagnitud(respuesta.valor);
          const v = a && b ? comparaMagnitud(a, b, respuesta.tolerancia) : null;

          if (v?.faltaUnidad) {
            fb(paso, 'mal', 'El número está bien; falta la unidad',
              '<p>Has hecho la física correctamente. Pero una magnitud <strong>no es un ' +
                'número</strong>: sin unidad, ese valor no dice si son pascales, bares o ' +
                'metros de columna de agua, y las tres cifras serían distintas.</p>' +
                '<p>En el examen esto cuesta puntos aunque el desarrollo esté perfecto. ' +
                'Escríbela y vuelve a probar.</p>');
            return;
          }

          if (v?.otraDimension) {
            fb(paso, 'mal', 'Esa unidad es de otra magnitud',
              `<p>Has escrito ${nombreDim(a!.dim)} y aquí se pide ${nombreDim(b!.dim)}. ` +
                'No es un despiste de escritura: si las unidades no cuadran, la fórmula que ' +
                'has usado no es la de esta pregunta.</p>' +
                '<p><strong>Comprueba las dimensiones antes que los números.</strong> Es la ' +
                'forma más rápida de cazar una fórmula mal aplicada, y funciona sin saber ' +
                'cuál es el resultado.</p>');
            return;
          }
        }

        /* Contar cuántas soluciones faltan es un diagnóstico en sí mismo, y
           uno que no hace falta declarar ejercicio por ejercicio: quien da dos
           de las tres raíces no se ha equivocado calculando, se ha equivocado
           creyendo que había menos. */
        /* Y dos diagnósticos que el lector de Álgebra sabe dar solo, sin que
           haya que declararlos como distractor en cada ejercicio: las
           coordenadas correctas en otro orden, y la matriz traspuesta. Los dos
           son errores de método, no de cuenta, y el mensaje tiene que decirlo. */
        if (respuesta.tipo === 'vector') {
          const a = leeVector(escrito);
          const b = leeVector(respuesta.valor);
          const r = a && b ? comparaVector(a, b, respuesta.tolerancia) : null;
          /* Estos mensajes se construyen en JavaScript y NO pasan por el
             procesador de fórmulas, así que van sin LaTeX: un «$n$» aquí se
             publicaría con los dólares y todo. Es la deuda 31 asomando por
             otro sitio, y no lo caza ningún guardián porque el texto no existe
             hasta que el alumno se equivoca. */
          /* Hasta el 28 de septiembre de 2026 los dos avisos hablaban solo de
             coordenadas y de bases, que es de donde salieron. Ese día entraron
             los ajustes redox de Química, que se contestan como la lista de
             coeficientes de la ecuación, y a quien los escribía en otro orden
             se le hablaba de «vectores de la base». Ahora dicen las dos cosas. */
          if (r && r.longitudDistinta) {
            fb(paso, 'mal', 'Faltan o sobran números',
              `<p>La respuesta tiene <strong>${b!.length}</strong> números y has escrito ` +
                `${a!.length}. Cada puesto de la lista es uno —una coordenada por cada vector ` +
                'de la base, un coeficiente por cada especie de la ecuación— y los que valen ' +
                'cero, o uno, también se escriben.</p>');
            return;
          }
          if (r && r.soloOrden) {
            fb(paso, 'mal', 'Los números están bien; el orden, no',
              '<p>Son exactamente los números correctos, pero cambiados de sitio. ' +
                '<strong>El orden es parte de la respuesta</strong>: cada número va con lo que ' +
                'ocupa su mismo puesto —el vector de la base, la especie de la ecuación—, y ' +
                'ese orden te lo han dado escrito.</p>');
            return;
          }
        }
        if (respuesta.tipo === 'matriz') {
          const a = leeMatriz(escrito);
          const b = leeMatriz(respuesta.valor);
          const r = a && b ? comparaMatriz(a, b, respuesta.tolerancia) : null;
          if (r && r.esLaTraspuesta) {
            fb(paso, 'mal', 'Es la traspuesta',
              '<p>Los números son los correctos, pero están puestos del revés. Las ' +
                'coordenadas de la imagen de cada vector van en <strong>columna</strong>, no ' +
                'en fila: así la matriz multiplica por la derecha al vector de coordenadas y ' +
                'las dimensiones encajan.</p>');
            return;
          }
          if (r && r.tamanoDistinto) {
            fb(paso, 'mal', 'El tamaño no es el que debe',
              `<p>La matriz asociada tiene tantas filas como vectores hay en la base de ` +
                'llegada y tantas columnas como vectores hay en la de salida. Cuenta los dos ' +
                'antes de calcular nada.</p>');
            return;
          }
        }

        const cuenta = respuesta.tipo === 'conjunto' ? balance(escrito) : null;
        if (cuenta && cuenta.faltan > 0 && cuenta.sobran === 0) {
          fb(
            paso,
            'mal',
            'Están bien, pero no están todas',
            lista
              ? `<p>Los que has escrito están bien y te ${
                  cuenta.faltan === 1 ? 'falta uno' : `faltan ${cuenta.faltan}`
                }: la respuesta los pide todos.</p>`
              : `<p>Las que has escrito son correctas y te ${
                  cuenta.faltan === 1 ? 'falta una' : `faltan ${cuenta.faltan}`
                }. Una ecuación de grado n tiene n soluciones en los complejos, y ` +
                'todas cuentan en la respuesta.</p>',
          );
          return;
        }

        if (intentos[i] === 1) {
          /* «Ese número» no vale para una fórmula química: la respuesta no es
             un número y el mensaje delataba que el sitio no sabía qué estaba
             corrigiendo. Salió al probarlo a mano con un CaCl₂. */
          fb(
            paso,
            'mal',
            'No es correcto',
            respuesta.tipo === 'formula'
              ? '<p>Ese compuesto no es el que se pide. Vuelve al nombre y sepáralo en sus ' +
                  'dos partes —el anión y el catión— antes de escribir nada.</p>'
              : '<p>Ese número no sale de ninguna vía razonable. Revisa el paso anterior antes de rehacer el cálculo.</p>',
          );
        } else if (intentos[i] === 2) {
          fb(paso, 'pista', 'Pista', html(paso, '[data-msg-pista]'));
        } else {
          fb(
            paso,
            'pista',
            'Vamos juntos',
            '<p>Mira el desarrollo, entiéndelo y sigue con el paso siguiente.</p>',
          );
          resuelve(i);
        }
      }

      paso.querySelector('[data-comprobar]')?.addEventListener('click', comprueba);
      paso.querySelector('[data-pedir-pista]')?.addEventListener('click', () => {
        fb(paso, 'pista', 'Pista', html(paso, '[data-msg-pista]'));
      });
      campo.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          comprueba();
        }
      });
    });

    /* ── PATRÓN VERIFICADOR · comprobar una región ─────────────────
       La figura no explica: comprueba (§05). Se dibuja la región del
       enunciado y, al comprobar, se superpone la que ha escrito el alumno.
       No hay respuesta guardada: se comparan los dos conjuntos de puntos, así
       que cualquier forma equivalente de escribirla vale. */

    pasos.forEach((paso, i) => {
      const dato = datos[i];
      if (dato.tipo !== 'verificar') return;

      const lienzo = paso.querySelector<HTMLCanvasElement>('[data-lienzo]')!;
      const campo = paso.querySelector<HTMLInputElement>('input')!;
      const { ventana } = dato;
      const referencia = analiza(dato.condicion);

      const color = (token: string) =>
        getComputedStyle(document.documentElement).getPropertyValue(token).trim();

      /** Pinta una región muestreando píxel a píxel. Es Canvas y no SVG a
       *  propósito: son cientos de miles de puntos (§02). */
      function pinta(propuesta: ReturnType<typeof analiza> | null) {
        const ctx = lienzo.getContext('2d')!;
        const { width: an, height: al } = lienzo;
        const img = ctx.createImageData(an, al);

        /* Tres colores con significado, no tres colores a secas (§06):
             · la región del enunciado, en el color de «esto se comprueba»;
             · lo que coincide, el mismo color pero sólido;
             · lo que sobra, en el color de «esto te suspende», porque es el
               error que hay que ver de un vistazo. */
        const suya = tinta(color('--live'));
        const sobra = tinta(color('--flag'));

        /* Igual que en mismaRegion: la banda de una igualdad se mide en
           píxeles, no en unidades del enunciado. Si no, una curva se dibuja
           más gruesa donde la expresión varía despacio, o no se dibuja. */
        const epsPixel =
          0.7 *
          Math.max((ventana.x[1] - ventana.x[0]) / an, (ventana.y[1] - ventana.y[0]) / al);

        for (let px = 0; px < an; px++) {
          const x = ventana.x[0] + ((ventana.x[1] - ventana.x[0]) * px) / an;
          for (let py = 0; py < al; py++) {
            const y = ventana.y[1] - ((ventana.y[1] - ventana.y[0]) * py) / al;
            const k = (py * an + px) * 4;

            const enRef = cumple(referencia, x, y, epsPixel);
            const enTuya = propuesta ? cumple(propuesta, x, y, epsPixel) : false;
            if (!enRef && !enTuya) continue;

            const c = enTuya && !enRef ? sobra : suya;
            img.data[k] = c[0];
            img.data[k + 1] = c[1];
            img.data[k + 2] = c[2];
            // Coincide: sólido. Solo el enunciado: pálido, «esto te falta».
            img.data[k + 3] = enRef && enTuya ? 165 : enRef ? 55 : 130;
          }
        }

        ctx.putImageData(img, 0, 0);
        ejes(ctx, an, al);
      }

      function tinta(hex: string): [number, number, number] {
        let h = hex.replace('#', '');
        if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
        return [
          parseInt(h.slice(0, 2), 16) || 0,
          parseInt(h.slice(2, 4), 16) || 0,
          parseInt(h.slice(4, 6), 16) || 0,
        ];
      }

      function ejes(ctx: CanvasRenderingContext2D, an: number, al: number) {
        const cx = ((0 - ventana.x[0]) / (ventana.x[1] - ventana.x[0])) * an;
        const cy = ((ventana.y[1] - 0) / (ventana.y[1] - ventana.y[0])) * al;
        ctx.strokeStyle = color('--rule');
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(0, cy);
        ctx.lineTo(an, cy);
        ctx.moveTo(cx, 0);
        ctx.lineTo(cx, al);
        ctx.stroke();
      }

      /* Pintar cuesta 360.000 evaluaciones por lienzo, y el tema 1 tiene doce:
         cuatro millones de puntos antes de que el alumno vea nada. Medido el
         28 de agosto de 2026 en Chromium a 390 px con la CPU frenada ×4, eso
         eran 5,9 s hasta que la página respondía, contra 2,6 s del tema 5 —que
         pesa MÁS y no tiene lienzos—. Así que se pinta cuando el lienzo se ve,
         no cuando la página carga. */
      let pintado = false;
      const pintaUnaVez = () => { if (!pintado) { pintado = true; pinta(null); } };
      /* En tiempo muerto y no al cargar. No sirve un IntersectionObserver: en
         modo guiado los lienzos viven dentro de paneles ocultos, no intersecan
         nunca y se quedarían en blanco. El escalonado evita que los doce caigan
         en el mismo hueco de inactividad. */
      const enCuanto = window.requestIdleCallback ?? ((f: () => void) => setTimeout(f, 200));
      enCuanto(() => pintaUnaVez(), { timeout: 3000 } as IdleRequestOptions);

      function comprueba() {
        if (resueltos[i]) return;
        const escrito = campo.value.trim();
        if (!escrito) return;

        let propuesta;
        try {
          propuesta = analiza(escrito);
        } catch (e) {
          fb(
            paso,
            'mal',
            'No he podido leer tu condición',
            `<p>${(e as Error).message}. Escríbela con <code>x</code> e <code>y</code>, ` +
              'por ejemplo <code>(x-1)^2 + y^2 &lt; 4</code>. También entiendo ' +
              '<code>|z|</code>, <code>Re(z)</code> e <code>Im(z)</code>.</p>',
          );
          return;
        }

        intentos[i]++;
        const r = mismaRegion(referencia, propuesta, ventana);
        pinta(propuesta);

        if (r.iguales) {
          limpiaFb(paso);
          resuelve(i, desactiva(campo));
          return;
        }

        /* El diagnóstico sale de la propia comparación: sobrar y faltar son
           errores distintos y se nombran distinto. */
        const porcentaje = (n: number) => Math.round((n / r.total) * 100);
        let titulo = 'No es la misma región';
        let cuerpo: string;

        if (r.falta > 0 && r.sobra === 0) {
          titulo = 'Te falta región';
          cuerpo =
            `<p>Tu condición se queda corta: hay puntos del enunciado ` +
            `—un ${porcentaje(r.falta)} % de lo dibujado— que la tuya deja fuera. ` +
            'Suele pasar por una desigualdad al revés o por perder un caso.</p>';
        } else if (r.sobra > 0 && r.falta === 0) {
          titulo = 'Te sobra región';
          cuerpo =
            `<p>Tu condición incluye puntos que no cumplen la del enunciado ` +
            `—un ${porcentaje(r.sobra)} % de lo dibujado—. Repasa si has ` +
            'elevado al cuadrado sin controlar el signo: eso añade soluciones.</p>';
        } else {
          cuerpo =
            `<p>Hay un ${porcentaje(r.falta)} % de la región del enunciado que tu ` +
            `condición no cubre, y un ${porcentaje(r.sobra)} % que añade de más. ` +
            'Compara las dos manchas del dibujo: el desajuste te dice dónde se ha ' +
            'torcido el álgebra.</p>';
        }

        if (intentos[i] >= 3) {
          fb(paso, 'pista', 'Vamos juntos', cuerpo + html(paso, '[data-msg-pista]'));
          resuelve(i);
          return;
        }
        if (intentos[i] === 2) {
          fb(paso, 'pista', titulo, cuerpo + html(paso, '[data-msg-pista]'));
          return;
        }
        fb(paso, 'mal', titulo, cuerpo);
      }

      paso.querySelector('[data-comprobar]')?.addEventListener('click', comprueba);
      paso.querySelector('[data-pedir-pista]')?.addEventListener('click', () => {
        fb(paso, 'pista', 'Pista', html(paso, '[data-msg-pista]'));
      });
      campo.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          comprueba();
        }
      });
    });

    /* ── COMP4 · justificar ───────────────────────────────────────── */

    pasos.forEach((paso, i) => {
      const dato = datos[i];
      if (dato.tipo !== 'justificar') return;

      const montaje = paso.querySelector<HTMLElement>('[data-montaje]')!;
      const botones = [...paso.querySelectorAll<HTMLButtonElement>('[data-pieza]')];
      let puestas = 0;

      const dibujaMontaje = () => {
        montaje.textContent = '';
        if (!puestas) {
          const li = document.createElement('li');
          li.className = 'vacio';
          li.textContent = 'Ve eligiendo las piezas en orden.';
          montaje.appendChild(li);
          return;
        }
        for (let p = 0; p < puestas; p++) {
          const li = document.createElement('li');
          li.innerHTML = botones[dato.orden[p]].innerHTML;
          montaje.appendChild(li);
        }
      };

      for (const boton of botones) {
        boton.addEventListener('click', () => {
          if (resueltos[i] || apagado(boton)) return;
          const k = Number(boton.dataset.pieza);

          if (k === dato.trampa) {
            intentos[i]++;
            boton.classList.add('fallada');
            fb(paso, 'mal', 'Esa pieza no entra', html(paso, '[data-msg-trampa]'));
            return;
          }

          if (k !== dato.orden[puestas]) {
            intentos[i]++;
            fb(
              paso,
              'mal',
              'Esa no es la que sigue',
              '<p>La pieza es válida, pero no en este punto del razonamiento. ' +
                '¿Qué hay que haber establecido antes para poder afirmarla?</p>',
            );
            return;
          }

          apaga(boton);
          boton.classList.add('puesta');
          puestas++;
          dibujaMontaje();
          limpiaFb(paso);

          if (puestas === dato.orden.length) {
            fb(paso, 'bien', 'Razonamiento completo', '');
            resuelve(i);
          }
        });
      }
    });

    /* ── COMP4 · redactar ─────────────────────────────────────────────
       No hay nada que corregir: el sitio es estático y lo que se evalúa está
       en un folio. Lo único que hace el botón es descubrir la rúbrica y dar
       el paso por hecho. Es deliberado que no se pueda «acertar»: la
       comparación la haces tú, y fingir una corrección automática sería
       mentir sobre lo que esta herramienta puede hacer. */

    /* `dibujar` comparte este bloque entero con `redactar`, y a propósito: son
       el mismo trato —tú lo haces en papel, el sitio te enseña contra qué
       compararlo— con distinto objeto. Lo único que cambia es el mensaje. */
    const SIN_CORREGIR = {
      redactar: [
        'Ahora compárala',
        '<p>Punto por punto. Lo que falte en tu folio es lo que el corrector ' +
          'no va a encontrar.</p>',
      ],
      dibujar: [
        'Ahora compáralo',
        '<p>Punto por punto. Lo que falte en tu dibujo es lo que el corrector ' +
          'no va a encontrar, y un dibujo mal hecho se lleva por delante las ' +
          'cuentas que salen de él.</p>',
      ],
    } as const;

    pasos.forEach((paso, i) => {
      const mensaje = SIN_CORREGIR[datos[i].tipo as keyof typeof SIN_CORREGIR];
      if (!mensaje) return;

      const boton = paso.querySelector<HTMLButtonElement>('[data-ya]');
      const rubrica = paso.querySelector<HTMLElement>('[data-rubrica]');
      if (!boton || !rubrica) return;

      boton.addEventListener('click', () => {
        rubrica.hidden = false;
        const foco = desactiva(boton);
        fb(paso, 'bien', mensaje[0], mensaje[1]);
        resuelve(i, foco);
      });
    });

    /* Las casillas de la rúbrica (fase D0 de la auditoría del 27 de
       septiembre de 2026): cuentan lo que tu folio tiene, con el peso de cada
       punto, y avisan de los mínimos que faltan. No corrigen nada —la casilla
       la marca quien compara su folio—, y por eso no tocan el progreso del
       ejercicio: el paso ya queda resuelto al abrir la rúbrica. */
    pasos.forEach((paso) => {
      const casillas = [...paso.querySelectorAll<HTMLInputElement>('[data-casilla]')];
      const cuenta = paso.querySelector<HTMLElement>('[data-cuenta]');
      if (!casillas.length || !cuenta) return;
      const peso = (c: HTMLInputElement) => Number(c.dataset.peso ?? 1);
      const total = casillas.reduce((s, c) => s + peso(c), 0);
      const cifra = (x: number) => (Number.isInteger(x) ? String(x) : x.toFixed(1).replace('.', ','));
      const pinta = () => {
        const llevas = casillas.reduce((s, c) => s + (c.checked ? peso(c) : 0), 0);
        const faltan = casillas.filter((c) => c.dataset.minimo && !c.checked).length;
        let texto = `Llevas ${cifra(llevas)} de ${cifra(total)}.`;
        if (faltan === 1) texto += ' Te falta un mínimo: sin él, el corrector no la da por buena.';
        else if (faltan > 1) texto += ` Te faltan ${faltan} mínimos: sin ellos, el corrector no la da por buena.`;
        else if (llevas > 0) texto += ' Tienes todos los mínimos.';
        cuenta.textContent = texto;
        cuenta.toggleAttribute('data-falta', faltan > 0 && llevas > 0);
      };
      casillas.forEach((c) => c.addEventListener('change', pinta));
      pinta();
    });

    /* ── COMP2 · construir (Expresión Gráfica) ────────────────────── */

    /* El Taller corrige solo y habla con eventos (`Taller.astro`). Aquí se
       traducen a lo que hacen los demás pasos: la caja del diagnóstico, los
       intentos, la pista y el desarrollo vistos, y resolver el paso. */
    const talleres = pasos.map((paso, i) =>
      datos[i].tipo === 'construir' ? paso.querySelector<HTMLElement>('[data-taller]') : null,
    );
    talleres.forEach((taller, i) => {
      if (!taller) return;
      const paso = pasos[i];
      taller.addEventListener('taller:fb', (ev) => {
        const d = (ev as CustomEvent<{ clase: string; titulo: string; html: string }>).detail;
        fb(paso, d.clase, d.titulo, d.html);
      });
      taller.addEventListener('taller:fallo', () => intentos[i]++);
      taller.addEventListener('taller:pista', () => (pistaVista = true));
      taller.addEventListener('taller:desarrollo', () => (desarrolloVisto = true));
      taller.addEventListener('taller:hecho', () => {
        if (!resueltos[i]) resuelve(i);
      });
    });
    /** Que cada Taller dibuje su solución encima: en modo completo y al imprimir. */
    const muestraTalleres = () => {
      for (const t of talleres) t?.dispatchEvent(new CustomEvent('taller:muestra'));
    };

    /* ── modo guiado / completo ───────────────────────────────────── */

    const botonesModo = [...raiz.querySelectorAll<HTMLButtonElement>('[data-modo]')];

    function cambiaModo(nuevo: 'guiado' | 'completo') {
      /* Abrir el modo completo ANTES de terminar es haber mirado el desarrollo.
         Si ya está todo resuelto, no: entonces es repaso. */
      if (nuevo === 'completo' && !resueltos.every(Boolean)) desarrolloVisto = true;
      modo = nuevo;
      raiz.dataset.modo = modo;
      for (const b of botonesModo) b.setAttribute('aria-pressed', String(b.dataset.modo === modo));

      const completo = modo === 'completo';
      if (completo) muestraTalleres();
      const seVe = completo || resueltos.every(Boolean);
      if (seVe) materializa();
      resolucion.hidden = !seVe;
      modoPista.textContent = completo
        ? 'Resolución completa de un tirón. Se imprime bien y sirve para explicárselo a alguien.'
        : 'En modo guiado no verás la solución aunque falles: verás en qué paso te has ido y por qué.';

      pasos.forEach((paso, i) => {
        paso.classList.toggle('bloqueado', !completo && i > 0 && !resueltos[i - 1]);
        const solucion = paso.querySelector<HTMLElement>('.solucion');
        if (solucion) {
          const seVe = completo || resueltos[i];
          if (seVe) materializa(solucion);
          solucion.hidden = !seVe;
        }
      });
      pinta();
    }

    for (const b of botonesModo) {
      b.addEventListener('click', () => cambiaModo(b.dataset.modo as 'guiado' | 'completo'));
    }

    // Al imprimir, siempre la resolución entera: nadie repasa la noche antes
    // haciendo clic (§11).
    window.addEventListener('beforeprint', () => {
      materializa();
      muestraTalleres();
      resolucion.hidden = false;
      for (const s of raiz.querySelectorAll<HTMLElement>('.solucion')) { materializa(s); s.hidden = false; }
    });
    window.addEventListener('afterprint', () => cambiaModo(modo));

    pinta();
  }
</script>

<style>
  .ejercicio {
    border: 1.5px solid var(--rule);
    border-radius: 12px;
    padding: 1.4rem clamp(1rem, 3vw, 1.6rem) 1.6rem;
    margin: 2.5rem 0;
    background: var(--panel);
    box-shadow: var(--shadow-1);

    /* ── por qué esto está aquí ──────────────────────────────────
     *
     * Medido el 16 de septiembre de 2026 sobre `/calculo/t05-integracion/`,
     * la página más pesada del sitio: **284.977 nodos, y 272.606 son de
     * KaTeX**. Son 5.081 fórmulas a 54 nodos cada una — MathML para el lector
     * de pantalla y HTML para el ojo, las dos cosas por fórmula.
     *
     * Y el dato que decide el arreglo: **de esas 5.081, al cargar solo 17 se
     * ven**. Las otras 5.064 están dentro de resoluciones y pasos cerrados.
     * O sea que el navegador maquetaba un cuarto de millón de nodos que nadie
     * estaba mirando, y por eso la página tardaba cinco segundos en un
     * teléfono.
     *
     * `content-visibility: auto` le dice al navegador que se salte el
     * maquetado y el pintado de lo que está fuera de la pantalla, y que lo
     * haga cuando se acerque. Se eligió primero frente a paginar los
     * ejercicios, que rompía los anclajes `#ej-…` de las rutas.
     *
     * Y no bastó: solo compraba medio segundo de cinco, porque el tiempo se
     * iba en construir el DOM y no en maquetarlo. Desde el 16 de septiembre
     * de 2026 lo que empieza cerrado viaja además en un `<template>` —el
     * comentario del marcado de la resolución lo cuenta, y §07—, y esto se
     * queda porque sigue ayudando con lo que sí está en el árbol. Este
     * comentario decía que el `<template>` se había descartado hasta el 26 de
     * septiembre de 2026.
     *
     * `contain-intrinsic-size` es la altura que el navegador supone mientras
     * no lo ha maquetado. Sin ella la barra de desplazamiento salta al
     * acercarse a cada ejercicio; con una estimación razonable, no. */
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }

  /* Al imprimir no vale saltarse nada: el papel no tiene «fuera de la
     pantalla», y sin esto los ejercicios salen en blanco. */
  @media print {
