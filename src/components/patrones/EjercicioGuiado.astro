  /* ── respuesta del sistema ─────────────────────────────────────── */
  .fb {
    margin-top: .9rem;
    padding: .75rem .9rem;
    border-radius: 0 5px 5px 0;
    font-size: .89rem;
  }

  .fb :global(.rotulo) { font-size: .63rem; margin-bottom: .25rem; }

  /* El diagnóstico del error es un recuadro de PIZARRA (brief §2 y §6): lo
     que te suspende se escribe en la pizarra, con el título en tiza. La
     pista y el acierto siguen siendo papel — no son la voz del profesor
     señalando el fallo. */
  .fb.mal {
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(ellipse at 30% 20%, var(--piz-claro), var(--piz-medio) 75%);
    border-radius: 10px;
    color: var(--tiza-suave);
    box-shadow: var(--piz-vineta-caja);
  }

  /* `:global` obligatorio: el contenido del fb lo inyecta el script con
