---
/**
 * PATRÓN 1 · LECTURA — texto con una herramienta incrustada (CLAUDE.md §05).
 * Extraído de referencia/prototipo-tema.html.
 *
 * Todo lo que hay aquí aparece en un único prototipo, así que NO sube a
 * base.css: vive en el patrón. Cuando llegue el segundo prototipo que use
 * la misma rejilla, se extrae; antes no.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  eyebrow: string;
  titulo: string;
  descripcion: string;
  headings: MarkdownHeading[];
  fuente?: string;
  competencias: string[];
}

const { eyebrow, titulo, descripcion, headings, fuente, competencias } = Astro.props;
const indice = headings.filter((h) => h.depth === 2);
---

<div class="shell">
  <nav class="rail" aria-label="Índice del tema">
    <h2 class="rotulo">En este tema</h2>
    <ol>
      {
        indice.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="read" data-lectura>
    <p class="rotulo rotulo--live eyebrow">{eyebrow}</p>
    <h1>{titulo}</h1>
    <p class="lede">{descripcion}</p>

    <div class="modos no-imprimir" role="group" aria-label="Modo de lectura" data-modos hidden>
      <button type="button" data-modo="guiado" aria-pressed="true">guiado</button>
      <button type="button" data-modo="completo" aria-pressed="false">completo</button>
      <span class="rotulo avance" data-avance></span>
    </div>

    <slot />

    <nav class="pasos no-imprimir" data-pasos hidden aria-label="Navegación por apartados">
      <button type="button" data-ir="-1">← anterior</button>
      <button type="button" data-ir="1">siguiente →</button>
    </nav>

    <footer class="pie">
      <p class="rotulo">
        Entrena {competencias.join(' · ')}
      </p>
      {fuente && <p class="rotulo fuente">{fuente}</p>}
    </footer>
  </div>
</div>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  /* ── índice lateral ────────────────────────────────────────────── */
  .rail {
    position: sticky;
    top: 4.2rem;
    align-self: start;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    font-size: .82rem;
  }

  .rail h2 { margin-bottom: .9rem; }
  .rail ol { list-style: none; counter-reset: s; }
  .rail li { counter-increment: s; margin-bottom: .15rem; }

  .rail a {
    display: flex;
    gap: .6rem;
    padding: .35rem .5rem;
    border-radius: 4px;
    color: var(--graphite);
    text-decoration: none;
    line-height: 1.4;
    transition: background .15s, color .15s;
  }

  .rail a::before {
    content: counter(s, decimal-leading-zero);
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    padding-top: .1rem;
  }

  .rail a:hover { background: var(--live-soft); color: var(--ink); }
  .rail a[aria-current='true'] { color: var(--live); font-weight: 500; }
  .rail a[aria-current='true']::before { color: var(--live); }

  /* ── columna de lectura + margen de anotaciones ────────────────── */
  .read {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) var(--margin-col);
    gap: 0 2.2rem;
    align-items: start;
  }

  /* Los apartados del modo guiado no rompen la rejilla: `display: contents`
     deja que sus hijos sigan siendo celdas de `.read`. */
  .read :global(.grupo) { display: contents; }

  .read > :global(*),
  .read :global(.grupo) > :global(*) { grid-column: 1; }

  .read :global(aside) { grid-column: 2; }

  .eyebrow { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }

  /* ── prosa del MDX ─────────────────────────────────────────────── */
  .read :global(h2) {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.6rem;
    letter-spacing: -.015em;
    line-height: 1.2;
    margin: 3.5rem 0 .9rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }

  .read :global(h3) { font-size: 1rem; font-weight: 600; margin: 2rem 0 .5rem; }
  .read :global(p) { margin-bottom: 1.1rem; }
  .read :global(strong) { font-weight: 600; }
  .read :global(ul), .read :global(ol) { margin: 0 0 1.2rem 1.2rem; }
  .read :global(li) { margin-bottom: .35rem; }

  .read :global(code) {
    font-family: var(--mono);
    font-size: .88em;
    background: var(--grid);
    padding: .1em .35em;
    border-radius: 3px;
  }

  /* Fórmulas: MathML generado en el build, sin JavaScript en cliente.
     El bloque llega como <span class="katex"> con un <math display="block">
     dentro; se le da caja aquí. */
  .read :global(span.katex:has(math[display='block'])) {
    display: block;
    margin: 1.6rem 0;
    padding: 1.2rem 1.4rem;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--live);
    border-radius: 0 6px 6px 0;
    overflow-x: auto;
  }

  .read :global(math[display='block']) {
    display: block;
    font-size: 1.2rem;
  }

  .read :global(math) { font-family: var(--body); }

  /* anotaciones al margen */
  .read :global(aside.nota) {
    font-size: .8rem;
    line-height: 1.5;
    color: var(--graphite);
    padding: .7rem 0 .7rem .85rem;
    margin: 1.6rem 0;
    border-left: 2px solid var(--rule);
  }

  /* ── control de modo ───────────────────────────────────────────── */
  .modos {
    display: flex;
    align-items: center;
    gap: .25rem;
    margin-bottom: 2rem;
  }

  .modos button {
    font-family: var(--mono);
    font-size: .71rem;
    border: 1px solid var(--rule);
    background: none;
    color: var(--graphite);
    padding: .35rem .85rem;
    border-radius: 99px;
    cursor: pointer;
  }

  .modos button[aria-pressed='true'] {
    border-color: var(--live);
    color: var(--live);
    font-weight: 600;
  }

  .modos .avance { margin-left: auto; font-size: .66rem; }

  .pasos {
    display: flex;
    gap: .6rem;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }

  .pasos button {
    font-family: var(--mono);
    font-size: .75rem;
    border: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink);
    padding: .5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .pasos button:hover:not(:disabled) { border-color: var(--live); color: var(--live); }
  .pasos button:disabled { opacity: .4; cursor: default; }

  .pie {
    margin-top: 3.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .pie .fuente { margin-left: auto; text-transform: none; letter-spacing: .02em; }

  @media (max-width: 1080px) {
    .read { grid-template-columns: minmax(0, 1fr); }
    .read :global(aside) { grid-column: 1; max-width: var(--measure); }
    .read :global(aside.nota) {
      background: var(--panel);
      padding: .8rem 1rem;
      border-radius: 0 5px 5px 0;
    }
  }

  @media (max-width: 820px) {
    .shell { grid-template-columns: 1fr; padding-top: 1.5rem; }
    .rail {
      position: static;
      max-height: none;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--rule);
    }
    .rail ol { display: flex; gap: .3rem; overflow-x: auto; padding-bottom: .3rem; }
    .rail a { white-space: nowrap; }
  }
</style>

<script>
  /* ── modo guiado / modo completo (CLAUDE.md §11) ──────────────────
     Sin JavaScript la página se ve entera: los modos son una mejora,
     no un requisito para leer. Por eso los controles nacen ocultos y
     los enciende este script. */
  const lectura = document.querySelector<HTMLElement>('[data-lectura]');
  const modos = document.querySelector<HTMLElement>('[data-modos]');
  const pasos = document.querySelector<HTMLElement>('[data-pasos]');

  if (lectura && modos && pasos) {
    // Agrupa cada h2 con todo lo que viene detrás hasta el siguiente h2.
    const hijos = [...lectura.children] as HTMLElement[];
    const grupos: HTMLElement[] = [];
    let actual: HTMLElement | null = null;

    for (const hijo of hijos) {
      // Los controles y el pie no pertenecen a ningún apartado.
      if (hijo.matches('[data-modos], [data-pasos], .pie')) continue;
      if (hijo.tagName === 'H2') {
        actual = document.createElement('section');
        actual.className = 'grupo';
        lectura.insertBefore(actual, hijo);
        grupos.push(actual);
      }
      if (actual && hijo !== actual) actual.appendChild(hijo);
    }

    if (grupos.length > 1) {
      const avance = document.querySelector<HTMLElement>('[data-avance]')!;
      const botones = [...modos.querySelectorAll<HTMLButtonElement>('[data-modo]')];
      let modo: 'guiado' | 'completo' = 'guiado';
      let i = 0;

      function pinta() {
        lectura!.dataset.modo = modo;
        grupos.forEach((g, k) => {
          g.hidden = modo === 'guiado' && k !== i;
        });
        pasos!.hidden = modo !== 'guiado';
        avance.textContent = modo === 'guiado' ? `${i + 1} de ${grupos.length}` : `${grupos.length} apartados`;
        for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.modo === modo));
        for (const b of pasos!.querySelectorAll<HTMLButtonElement>('[data-ir]')) {
          const paso = Number(b.dataset.ir);
          b.disabled = (paso < 0 && i === 0) || (paso > 0 && i === grupos.length - 1);
        }
      }

      for (const b of botones) {
        b.addEventListener('click', () => {
          modo = b.dataset.modo as 'guiado' | 'completo';
          try {
            localStorage.setItem('modo-lectura', modo);
          } catch {}
          pinta();
        });
      }

      for (const b of pasos.querySelectorAll<HTMLButtonElement>('[data-ir]')) {
        b.addEventListener('click', () => {
          i = Math.max(0, Math.min(grupos.length - 1, i + Number(b.dataset.ir)));
          pinta();
          grupos[i].querySelector('h2')?.scrollIntoView({ block: 'start' });
        });
      }

      // Al pulsar en el índice, saltar al apartado también en modo guiado.
      for (const a of document.querySelectorAll<HTMLAnchorElement>('.rail a')) {
        a.addEventListener('click', () => {
          const destino = decodeURIComponent(a.hash.slice(1));
          const k = grupos.findIndex((g) => g.querySelector('h2')?.id === destino);
          if (k >= 0) {
            i = k;
            pinta();
          }
        });
      }

      // Al imprimir, siempre completo.
      window.addEventListener('beforeprint', () => {
        for (const g of grupos) g.hidden = false;
      });
      window.addEventListener('afterprint', pinta);

      try {
        const guardado = localStorage.getItem('modo-lectura');
        if (guardado === 'completo') modo = 'completo';
      } catch {}

      modos.hidden = false;
      pinta();
    }
  }

  // Marca en el índice la sección que se está leyendo.
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('.rail a')];
  const secciones = enlaces
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((s): s is HTMLElement => Boolean(s));

  if (secciones.length) {
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          for (const a of enlaces) a.removeAttribute('aria-current');
          const activo = enlaces.find((a) => decodeURIComponent(a.hash.slice(1)) === e.target.id);
          activo?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    for (const s of secciones) obs.observe(s);
  }
</script>
