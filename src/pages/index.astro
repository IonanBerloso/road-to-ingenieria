  .columna .fila:last-child { border-bottom-color: transparent; }
  .fila:hover, .fila:focus-visible { background: var(--tiza-velo); }

  .fila .pn { font-size: 1.25rem; color: var(--tiza-amarilla); min-width: 2.1rem; }

  /* El nombre es el objeto que viaja al titular del detalle (FLIP). */
  .fila .nm {
