---
/**
 * La portada: un mapa del temario, no un selector (CLAUDE.md §05).
 * Portada de referencia/mapa-temario.html, con dos diferencias:
 *   · el CSS ya no está inline y los colores salen de tokens.css
 *   · los datos salen de la colección `catalogo`, no de un array en el script
 * El buscador hace de paleta de comandos: `/` lo abre, flechas navegan,
 * Enter abre el tema, Escape cierra.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/ui/Cabecera.astro';
import { ruta } from '../lib/rutas';

const asignaturas = (await getCollection('catalogo')).sort(
  (a, b) => a.data.curso - b.data.curso || a.data.orden - b.data.orden,
);

const cursos = [1, 2] as const;
const totalTemas = asignaturas.reduce((n, a) => n + a.data.temas.length, 0);
const totalHechos = asignaturas.reduce(
  (n, a) => n + a.data.temas.filter((t) => t.hecho).length,
  0,
);

const ANCHO_PESO = { alto: '100%', medio: '62%', bajo: '30%' } as const;
const NOMBRE_PATRON: Record<string, string> = {
  lectura: 'lectura',
  'figura-fija': 'figura fija',
  ejercicio: 'ejercicio guiado',
  verificador: 'verificador',
  demostracion: 'demostración',
  simulador: 'simulador',
};
const ORDEN_PATRONES = ['lectura', 'figura-fija', 'ejercicio', 'verificador', 'demostracion', 'simulador'];
---

<Base
  titulo="Road to Ingeniería — mapa del temario"
  descripcion="Plataforma de estudio gratuita para 1.º y 2.º de la Escuela de Ingeniería de Gipuzkoa (UPV/EHU). Cálculo y Mecánica de Fluidos, tema a tema."
  h1="clamp(1.9rem, 5vw, 2.9rem)"
>
  <Cabecera />

  <main class="envoltorio" id="principal">
    <h1>Mapa del temario</h1>
    <p class="lede">
      Todo lo que entra, ordenado y con lo que pesa en el examen. Los temas
      terminados se abren; el resto están ahí para que sepas qué falta.
    </p>

    <div class="buscador">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-4-4"></path>
      </svg>
      <label class="solo-lectores" for="q">Buscar asignatura, tema o concepto</label>
      <input id="q" type="search" autocomplete="off" placeholder="Buscar asignatura, tema o concepto…" />
      <kbd>/</kbd>
    </div>

    <div class="barra">
      <div class="ordena" role="group" aria-label="Ordenar temario">
        <button type="button" data-orden="curso" aria-pressed="true">por curso</button>
        <button type="button" data-orden="peso" aria-pressed="false">por peso</button>
        <button type="button" data-orden="hecho" aria-pressed="false">terminados</button>
      </div>
      <span class="cuenta rotulo" data-cuenta>{totalHechos} de {totalTemas} listos</span>
    </div>

    {
      cursos.map((curso) => (
        <section class="curso">
          <h2 class="rotulo">{curso}.º curso</h2>

          {asignaturas
            .filter((a) => a.data.curso === curso)
            .map((a) => (
              <article class="asig" data-e={a.data.estado} style={`--acento: var(${a.data.acento})`}>
                <div class="asig-h">
                  <h3>{a.data.nombre}</h3>
                  <span class="estado rotulo">
                    {a.data.estado === 'ok' ? 'terminada' : a.data.estado === 'obra' ? 'en obra' : 'prevista'}
                  </span>
                  <span class="meta rotulo">
                    {a.data.temas.length > 0
                      ? `${a.data.temas.filter((t) => t.hecho).length}/${a.data.temas.length} temas`
                      : 'sin temario todavía'}
                  </span>
                </div>

                {!a.data.temarioOficial && a.data.temas.length > 0 && (
                  <p class="aviso">
                    Temario provisional: hay que sustituirlo por el oficial de la asignatura.
                  </p>
                )}

                <ul class="temas">
                  {a.data.temas.map((t) => {
                    const enlace = t.hecho ? ruta(`${a.id}/${t.id}`) : null;
                    const Etiqueta = enlace ? 'a' : 'div';
                    return (
                      <li>
                        <Etiqueta
                          class="tema"
                          data-tema
                          data-hecho={String(t.hecho)}
                          data-peso={t.peso}
                          data-busca={`${a.data.nombre} ${t.titulo} ${t.descripcion}`.toLowerCase()}
                          {...(enlace ? { href: enlace } : { 'aria-disabled': 'true' })}
                        >
                          <span class="n rotulo">{String(t.n).padStart(2, '0')}</span>
                          <span class="txt">
                            <span class="titulo">{t.titulo}</span>
                            <span class="desc">{t.descripcion}</span>
                          </span>
                          <span class="derecha">
                            <span class="peso" title={`Peso estimado en examen: ${t.peso}`}>
                              <span class="rotulo">{t.peso}</span>
                              <span class="pista">
                                <span class="relleno" style={`width:${ANCHO_PESO[t.peso]}`}></span>
                              </span>
                            </span>
                            <span class="patrones">
                              {ORDEN_PATRONES.map((p) => (
                                <span
                                  class:list={['punto', { activo: t.patrones.includes(p as never) }]}
                                  data-p={p}
                                  title={NOMBRE_PATRON[p]}
                                >
                                  <span class="solo-lectores">
                                    {t.patrones.includes(p as never) ? NOMBRE_PATRON[p] : ''}
                                  </span>
                                </span>
                              ))}
                            </span>
                          </span>
                        </Etiqueta>
                      </li>
                    );
                  })}
                </ul>
              </article>
            ))}
        </section>
      ))
    }

    <p class="vacio" data-vacio hidden>
      <strong>Nada con ese nombre.</strong>
      Prueba con el número del tema, con la asignatura, o con una palabra del enunciado.
    </p>

    <footer class="leyenda">
      <span><i class="m-alto"></i> pesa mucho en el examen</span>
      <span><i class="m-hecho"></i> tema terminado</span>
      <span><i class="m-sim"></i> lleva simulador</span>
      <span>Material docente usado con permiso de la UPV/EHU. Enunciados reescritos.</span>
    </footer>
  </main>
</Base>

<script>
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const filas = [...document.querySelectorAll<HTMLElement>('[data-tema]')];
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const cuenta = document.querySelector<HTMLElement>('[data-cuenta]')!;
  const asignaturas = [...document.querySelectorAll<HTMLElement>('.asig')];
  const cursos = [...document.querySelectorAll<HTMLElement>('.curso')];
  const textoCuenta = cuenta.textContent ?? '';

  let foco = -1;

  const visibles = () => filas.filter((f) => !f.hidden && f.offsetParent !== null);

  function filtra() {
    const t = q.value.trim().toLowerCase();
    let n = 0;
    for (const fila of filas) {
      const coincide = !t || (fila.dataset.busca ?? '').includes(t);
      fila.hidden = !coincide;
      if (coincide) n++;
    }
    for (const a of asignaturas) {
      a.hidden = [...a.querySelectorAll<HTMLElement>('[data-tema]')].every((f) => f.hidden);
    }
    for (const c of cursos) {
      c.hidden = [...c.querySelectorAll<HTMLElement>('.asig')].every((a) => a.hidden);
    }
    vacio.hidden = n > 0;
    cuenta.textContent = t ? `${n} coincidencias` : textoCuenta;
    foco = -1;
  }

  function mueve(paso: number) {
    const lista = visibles();
    if (!lista.length) return;
    foco = (foco + paso + lista.length) % lista.length;
    lista[foco].focus({ preventScroll: false });
    lista[foco].scrollIntoView({ block: 'nearest' });
  }

  q.addEventListener('input', filtra);

  document.addEventListener('keydown', (e) => {
    const enCampo = document.activeElement === q;

    if (e.key === '/' && !enCampo) {
      e.preventDefault();
      q.focus();
      q.select();
      return;
    }
    if (e.key === 'Escape') {
      if (q.value) {
        q.value = '';
        filtra();
      }
      q.blur();
      return;
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      mueve(1);
      return;
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      mueve(-1);
    }
  });

  // Ordenar
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-orden]')];
  const peso = { alto: 0, medio: 1, bajo: 2 } as Record<string, number>;

  for (const b of botones) {
    b.addEventListener('click', () => {
      for (const otro of botones) otro.setAttribute('aria-pressed', String(otro === b));
      const modo = b.dataset.orden;

      for (const a of asignaturas) {
        const ul = a.querySelector('ul.temas');
        if (!ul) continue;
        const items = [...ul.children] as HTMLElement[];
        items.sort((x, y) => {
          const fx = x.querySelector<HTMLElement>('[data-tema]')!;
          const fy = y.querySelector<HTMLElement>('[data-tema]')!;
          if (modo === 'peso') return peso[fx.dataset.peso!] - peso[fy.dataset.peso!];
          if (modo === 'hecho') return Number(fy.dataset.hecho === 'true') - Number(fx.dataset.hecho === 'true');
          return 0;
        });
        if (modo === 'curso') items.sort((x, y) => Number(x.dataset.n) - Number(y.dataset.n));
        for (const it of items) ul.appendChild(it);
      }
    });
  }

  // Orden original, para poder volver a él
  for (const a of asignaturas) {
    const items = [...(a.querySelector('ul.temas')?.children ?? [])] as HTMLElement[];
    items.forEach((li, i) => (li.dataset.n = String(i)));
  }
</script>

<style>
  .envoltorio {
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.2rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  /* ── buscador / paleta ─────────────────────────────────────────── */
  .buscador { position: relative; margin-bottom: .9rem; }

  .buscador input {
    width: 100%;
    font-family: var(--body);
    font-size: 1.02rem;
    padding: .85rem 1rem .85rem 2.6rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--panel);
    color: var(--ink);
  }

  .buscador input::placeholder { color: var(--faint); }

  .buscador svg {
    position: absolute;
    left: .9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    stroke: var(--faint);
    fill: none;
    stroke-width: 2;
  }

  .buscador kbd {
    position: absolute;
    right: .8rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--mono);
    font-size: .68rem;
    color: var(--faint);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: .15rem .4rem;
  }

  /* ── barra de orden ────────────────────────────────────────────── */
  .barra {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .ordena {
    display: flex;
    gap: .25rem;
    background: var(--grid);
    padding: .22rem;
    border-radius: 99px;
  }

  .ordena button {
    font-family: var(--mono);
    font-size: .71rem;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--graphite);
    padding: .4rem .85rem;
    border-radius: 99px;
  }

  .ordena button[aria-pressed='true'] {
    background: var(--panel);
    color: var(--ink);
    font-weight: 600;
    box-shadow: var(--shadow-1);
  }

  .cuenta { margin-left: auto; }

  /* ── curso y asignatura ────────────────────────────────────────── */
  .curso > h2 { margin: 2.6rem 0 .9rem; }
  .curso:first-of-type > h2 { margin-top: 0; }

  .asig { margin-bottom: 1.9rem; }

  .asig-h {
    display: flex;
    align-items: baseline;
    gap: .7rem;
    flex-wrap: wrap;
    padding-bottom: .55rem;
    border-bottom: 2px solid var(--acento);
  }

  .asig-h h3 {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -.015em;
  }

  .asig-h .estado {
    border: 1px solid var(--rule);
    border-radius: 99px;
    padding: .12rem .6rem;
    white-space: nowrap;
    font-size: .64rem;
  }

  .asig[data-e='ok'] .estado { color: var(--acento); border-color: var(--acento); }
  .asig[data-e='obra'] .estado { color: var(--alt); border-color: var(--alt); }

  .asig-h .meta { margin-left: auto; font-size: .68rem; }

  .asig[data-e='prev'] { margin-bottom: 1.1rem; }
  .asig[data-e='prev'] .asig-h { border-bottom-color: var(--rule); }
  .asig[data-e='prev'] .asig-h h3 { color: var(--graphite); }

  .aviso {
    font-size: .8rem;
    color: var(--flag);
    background: var(--flag-soft);
    border-left: 2px solid var(--flag);
    padding: .4rem .7rem;
    margin: .6rem 0 .2rem;
  }

  /* ── fila de tema ──────────────────────────────────────────────── */
  ul.temas { list-style: none; }

  .tema {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: .9rem;
    align-items: center;
    padding: .7rem .6rem;
    border-radius: 6px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background .14s;
  }

  a.tema { cursor: pointer; }
  a.tema:hover, a.tema:focus-visible { background: var(--live-soft); }

  .tema[data-hecho='false'] { opacity: .62; cursor: default; }

  .tema .n { text-align: right; font-size: .72rem; letter-spacing: .04em; }

  .txt { display: block; min-width: 0; }
  .txt .titulo { display: block; font-size: .97rem; font-weight: 500; }
  .txt .desc { display: block; font-size: .82rem; color: var(--graphite); line-height: 1.4; }

  .derecha { display: flex; align-items: center; gap: .9rem; }

  .peso { display: flex; align-items: center; gap: .45rem; }
  .peso .rotulo { font-size: .64rem; }

  .peso .pista {
    width: 52px;
    height: 5px;
    background: var(--grid);
    border-radius: 99px;
    overflow: hidden;
    display: block;
  }

  .peso .relleno { height: 100%; background: var(--faint); border-radius: 99px; display: block; }

  .tema[data-peso='alto'] .peso .relleno { background: var(--flag); }
  .tema[data-peso='alto'] .peso .rotulo { color: var(--flag); font-weight: 600; }

  .patrones { display: flex; gap: .28rem; }

  .patrones .punto {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--grid);
    display: block;
  }

  .patrones .punto.activo { background: var(--live); }
  .patrones .punto.activo[data-p='simulador'] { background: var(--alt); }

  /* ── vacío y leyenda ───────────────────────────────────────────── */
  .vacio {
    padding: 2.2rem 1rem;
    text-align: center;
    color: var(--graphite);
    font-size: .95rem;
  }

  .vacio strong {
    display: block;
    font-family: var(--display);
    font-size: 1.15rem;
    color: var(--ink);
    margin-bottom: .3rem;
  }

  .leyenda {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }

  .leyenda span { display: flex; align-items: center; gap: .4rem; }
  .leyenda i { width: 7px; height: 7px; border-radius: 2px; display: block; }
  .leyenda .m-alto { background: var(--flag); }
  .leyenda .m-hecho { background: var(--live); }
  .leyenda .m-sim { background: var(--alt); }

  @media (max-width: 680px) {
    .tema { grid-template-columns: 1.8rem 1fr; gap: .6rem; }
    .derecha { grid-column: 2; justify-content: flex-start; margin-top: .35rem; }
    .buscador kbd { display: none; }
  }
</style>
