---
/**
 * La portada: un mapa del temario, no un selector (CLAUDE.md §05).
 * Portada de referencia/selector-fluido.html, con cuatro diferencias:
 *   · el CSS ya no está inline y los colores salen de tokens.css
 *   · los datos salen de la colección `catalogo`, no de un array en el script
 *   · las dos vistas se renderizan en el servidor y el detalle se abre con
 *     `:target`, así que la portada funciona entera sin JavaScript
 *   · el nombre de la asignatura y el <h1> son el MISMO elemento, no dos:
 *     por eso puede viajar de la fila al titular en vez de aparecer de nuevo
 *
 * El principio de §05: fluido no es tener animaciones, es no perder nunca el
 * sitio. Cada movimiento contesta de dónde ha salido algo.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/ui/Cabecera.astro';
import { ruta } from '../lib/rutas';
import { SUFIJO_CONV, CONVOCATORIAS, ORDEN_CONV } from '../content.config';

const asignaturas = (await getCollection('catalogo')).sort(
  (a, b) => a.data.curso - b.data.curso || a.data.orden - b.data.orden,
);

const cursos = [1, 2] as const;
/* Estados en el lenguaje de la pizarra (brief Pizarra, §06): honestos y sin
 * jerga de obra. «Entera» solo lo dice el catálogo, nunca esta página. */
const ETIQUETA = { ok: 'entera', obra: 'la estamos escribiendo', prev: 'aún no' } as const;
const NOMBRE_PATRON: Record<string, string> = {
  lectura: 'lectura',
  'figura-fija': 'figura fija',
  ejercicio: 'ejercicio guiado',
  verificador: 'verificador',
  demostracion: 'demostración',
  simulador: 'simulador',
};
const ORDEN_PATRONES = ['lectura', 'figura-fija', 'ejercicio', 'verificador', 'demostracion', 'simulador'];
const ANCHO_PESO = { alto: '100%', medio: '62%', bajo: '30%' } as const;

const hechos = (a: (typeof asignaturas)[number]) => a.data.temas.filter((t) => t.hecho).length;

/** Los exámenes de cada asignatura, del más reciente al más antiguo. El panel
 *  solo se dibuja donde hay alguno: una caja vacía prometiendo exámenes es
 *  peor que no tenerla. */
const ABREV_CONV: Record<string, string> = Object.fromEntries(
  Object.entries(CONVOCATORIAS).map(([k, v]) => [k, v.corta]),
);

const examenesPorAsignatura = new Map<
  string,
  { curso: string; conv: string; slug: string }[]
>();
for (const ex of await getCollection('examen')) {
  const lista = examenesPorAsignatura.get(ex.data.asignatura) ?? [];
  lista.push({
    curso: ex.data.curso,
    conv: ex.data.convocatoria,
    slug: `${ex.data.curso}-${SUFIJO_CONV[ex.data.convocatoria]}`,
  });
  examenesPorAsignatura.set(ex.data.asignatura, lista);
}

/** Las rutas de estudio, para poder ofrecerlas antes que los exámenes sueltos:
 *  quien llega a esta pantalla no sabe todavía por dónde empezar.
 *
 *  Este enlace no es solo navegación. `humo.mjs` descubre las páginas que
 *  tiene que probar **leyendo la portada**, así que sin él la ruta se
 *  quedaría sin comprobar y el suelo daría verde igual. */
const rutasPorAsignatura = new Map<string, { titulo: string; sufijo: string }[]>();
const rutasIndice = new Map<string, { titulo: string; sufijo: string; bloques: string }[]>();
for (const r of await getCollection('preparar')) {
  const sufijo = SUFIJO_CONV[r.data.evaluacion];
  const lista = rutasPorAsignatura.get(r.data.asignatura) ?? [];
  lista.push({ titulo: r.data.titulo, sufijo });
  rutasPorAsignatura.set(r.data.asignatura, lista);

  const idx = rutasIndice.get(r.data.asignatura) ?? [];
  idx.push({
    titulo: r.data.titulo,
    sufijo,
    bloques: r.data.bloques.map((b) => b.titulo).join(' '),
  });
  rutasIndice.set(r.data.asignatura, idx);
}
for (const lista of examenesPorAsignatura.values()) {
  lista.sort(
    (a, b) =>
      b.curso.localeCompare(a.curso) ||
      ORDEN_CONV.indexOf(a.conv) - ORDEN_CONV.indexOf(b.conv),
  );
}

/** El índice de la paleta de comandos se arma aquí, no en el cliente:
 *  buscar tiene que funcionar con la primera pulsación, sin recorrer el DOM. */
const indice = asignaturas.flatMap((a, i) => [
  {
    tipo: 'a' as const,
    nombre: a.data.nombre,
    sub: `${a.data.curso === 1 ? '1.er' : '2.º'} curso`,
    clave: `${a.data.nombre} ${a.data.descripcion}`.toLowerCase(),
    destino: `#${a.id}`,
    orden: i,
  },
  ...a.data.temas.map((t) => ({
    tipo: 't' as const,
    nombre: t.titulo,
    sub: a.data.nombre,
    clave: `${t.titulo} ${t.descripcion} ${a.data.nombre}`.toLowerCase(),
    destino: t.hecho ? ruta(`${a.id}/${t.id}`) : `#${a.id}`,
    orden: i,
    n: t.n,
  })),
  /* Las rutas de estudio son lo más buscable del sitio: «regiones»,
     «demostración», «series» son las palabras con las que un alumno llega.
     Por eso la clave incluye los títulos de sus bloques (§05). */
  ...(rutasIndice.get(a.id) ?? []).map((r) => ({
    tipo: 'r' as const,
    nombre: r.titulo,
    sub: `${a.data.nombre} · ruta de estudio`,
    clave: `${r.titulo} ${r.bloques} ${a.data.nombre} preparar ruta estudio`.toLowerCase(),
    destino: ruta(`${a.id}/preparar/${r.sufijo}`),
    orden: i,
  })),
]);

/* ── los números del héroe salen de las colecciones, no de la prosa ──
 * §10: un dato publicado tiene que ser verdad. Si mañana entra un examen
 * más, esta cifra cambia sola; escrita a mano, mentiría en una semana. */
const totalExamenes = [...examenesPorAsignatura.values()].reduce((n, l) => n + l.length, 0);

/* Los dos accesos directos del héroe: las asignaturas terminadas, la de más
 * exámenes primero. La portada no supone itinerario (brief Pizarra): son
 * puertas, no un orden. */
const enteras = asignaturas
  .filter((a) => a.data.estado === 'ok')
  .sort(
    (a, b) =>
      (examenesPorAsignatura.get(b.id)?.length ?? 0) -
      (examenesPorAsignatura.get(a.id)?.length ?? 0),
  );
---

<Base
  titulo="Road to Ingeniería — la clase donde te dicen dónde te equivocas"
  descripcion={`Plataforma de estudio gratuita para 1.º y 2.º de la Escuela de Ingeniería de Gipuzkoa (UPV/EHU). ${totalExamenes} exámenes de verdad resueltos paso a paso, con cada error típico nombrado.`}
>
  <Cabecera crumb="— Escuela de Ingeniería de Gipuzkoa · UPV/EHU">
    <button class="mini" type="button" data-abre-paleta>
      Buscar <kbd>/</kbd>
    </button>
  </Cabecera>

  <main id="principal" class="escena" data-vista="lista">
    <!-- ── A · la pizarra ────────────────────────────────────────────
         La portada del rediseño Pizarra (brief agosto 2026): héroe con el
         subrayado de tiza que se dibuja UNA vez, la figura tocable de la
         tangente, el temario escrito en la pizarra y la repisa. Nada se
         mueve mientras se lee; reduced-motion lo deja todo ya dibujado. -->
    <section class="hero" aria-label="Portada">
      <div class="heroe">
        <div class="mensaje">
          <h1 class="titular apar">
            La clase donde por fin te dicen{' '}
            <span class="frase-tiza">
              dónde te equivocas
              <svg class="sub" height="12" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
                <path class="traza-sub" d="M 4 8 C 80 3 220 3 296 7" fill="none" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <p class="entradilla apar">
            Los apuntes dan el enunciado y la respuesta final. Aquí está todo lo
            de en medio: {totalExamenes} exámenes de verdad resueltos paso a
            paso, con cada error típico nombrado.
          </p>
          <p class="ctas apar">
            {enteras.map((a, i) => (
              <a
                class:list={['cta', i === 0 ? 'llena' : 'borde']}
                href={`#${a.id}`}
                data-fila={a.id}
              >
                Entrar a {a.data.nombre} →
              </a>
            ))}
          </p>
          <p class="mano gratis apar">gratis para siempre · sin cuentas · sin anuncios</p>
        </div>

        <!-- la figura de tiza: se dibuja una vez y luego SE TOCA.
             Decorativa para el lector de pantalla; el juego es del puntero. -->
        <div class="figura" aria-hidden="true">
          <svg id="fig-piz" viewBox="0 0 400 300" data-figura-tiza>
            <line x1="34" y1="258" x2="380" y2="258" class="eje" />
            <line x1="48" y1="34" x2="48" y2="270" class="eje" />
            <path id="curva-piz" class="traza-curva" d="M 48 240 C 128 240 128 84 210 84 C 288 84 280 196 372 154" fill="none" stroke-width="3" stroke-linecap="round" />
            <line id="tang-piz" class="tangente" x1="0" y1="0" x2="0" y2="0" stroke-width="2.5" stroke-dasharray="7 7" opacity="0" />
            <circle id="punto-piz" class="punto-tiza" r="6.5" cx="210" cy="84" />
            <text x="66" y="56" class="mano nota">la tangente te sigue —</text>
            <text x="66" y="80" class="mano nota">prueba a arrastrar el punto</text>
          </svg>
        </div>
      </div>

      <!-- el temario, escrito en la pizarra. Cada fila es un ancla al
           detalle: sin JavaScript la abre `:target`, como siempre. -->
      <div class="temario">
        {
          cursos.map((curso) => (
            <div class="columna">
              <p class="mano curso-h">{curso === 1 ? '1.er' : '2.º'} curso</p>
              {asignaturas
                .filter((a) => a.data.curso === curso)
                .map((a) => (
                  <a
                    class:list={['fila', { prev: a.data.estado === 'prev' }]}
                    href={`#${a.id}`}
                    style={`--acento: var(${a.data.acento})`}
                    data-fila={a.id}
                  >
                    <span class="mano pn">{String(a.data.orden).padStart(2, '0')}</span>
                    <span class="nm" data-nombre>{a.data.nombre}</span>
                    <span class:list={['mano', 'ps', a.data.estado]}>
                      {a.data.estado === 'ok'
                        ? `${a.data.temas.length} temas · ${examenesPorAsignatura.get(a.id)?.length ?? 0} exámenes — entera`
                        : a.data.estado === 'obra' && hechos(a) > 0
                          ? `${hechos(a)} de ${a.data.temas.length} temas — ${ETIQUETA.obra}`
                          : ETIQUETA[a.data.estado]}
                    </span>
                  </a>
                ))}
            </div>
          ))
        }
      </div>

      <!-- la repisa -->
      <div class="repisa" role="presentation">
        <span class="tiza-barra t-blanca"></span>
        <span class="tiza-barra t-amarilla"></span>
        <span class="tiza-barra t-menta"></span>
        <span class="lema">se abre una asignatura cuando la anterior está terminada — pocas excelentes antes que muchas a medias</span>
      </div>
    </section>

    <!-- ── B · el detalle, uno por asignatura ─────────────────────
         Se renderizan los nueve. Sin JavaScript los abre `:target`;
         con JavaScript se abren sin recargar y el nombre viaja. -->
    {
      asignaturas.map((a) => (
        <section
          class="detalle"
          id={a.id}
          style={`--acento: var(${a.data.acento})`}
          aria-labelledby={`h-${a.id}`}
        >
          <nav class="chips" aria-label="Cambiar de asignatura">
            <a class="volver" href="#principal">← todas</a>
            {asignaturas.map((x) => (
              <a class:list={['chip', { act: x.id === a.id }]} href={`#${x.id}`}>
                {x.data.nombre}
              </a>
            ))}
          </nav>

          <div class="cab">
            <span class="n">{String(a.data.orden).padStart(2, '0')}</span>
            {/* tabindex -1: al abrir el detalle el foco aterriza aquí, para que
                el lector de pantalla anuncie dónde ha ido a parar. No lleva
                outline:none — si llegas por teclado, tienes que verlo. */}
            <h2 id={`h-${a.id}`} class="nombre" data-destino tabindex="-1">
              {a.data.nombre}
            </h2>
            <span class="meta">
              {a.data.temas.length > 0 && `${a.data.temas.length} temas · `}
              {ETIQUETA[a.data.estado]}
            </span>
          </div>
          <div class="regla"></div>

          {!a.data.temarioOficial && a.data.temas.length > 0 && (
            <p class="aviso">
              Temario provisional: hay que sustituirlo por el oficial de la asignatura.
            </p>
          )}

          {a.data.temas.length > 0 ? (
            <div class="cuerpo">
            <ul class="temas">
              {a.data.temas.map((t, j) => {
                const enlace = t.hecho ? ruta(`${a.id}/${t.id}`) : null;
                const Etiqueta = enlace ? 'a' : 'div';
                return (
                  <li style={`--i: ${j}`}>
                    <Etiqueta
                      class="tema"
                      data-peso={t.peso}
                      {...(enlace ? { href: enlace } : { 'aria-disabled': 'true' })}
                    >
                      <span class="tn">{String(t.n).padStart(2, '0')}</span>
                      <span class="txt">
                        <span class="t-tit">{t.titulo}</span>
                        <span class="t-desc">{t.descripcion}</span>
                      </span>
                      <span class="der">
                        <span class="peso">
                          <span class="rotulo">{t.peso}</span>
                          <span class="pista" aria-hidden="true">
                            <span class="relleno" style={`width:${ANCHO_PESO[t.peso]}`} />
                          </span>
                        </span>
                        {/* Los seis patrones del tema, uno por casilla. El
                            `title` es lo único que un usuario vidente tiene
                            para saber qué significan: sin él son seis
                            cuadrados de 7 px sin leyenda en ninguna parte,
                            y solo un lector de pantalla se enteraba. */}
                        <span class="tipos">
                          {ORDEN_PATRONES.map((p) => (
                            <span
                              class:list={['punto', { on: t.patrones.includes(p as never) }]}
                              data-p={p}
                              title={`${NOMBRE_PATRON[p]}: ${
                                t.patrones.includes(p as never) ? 'sí' : 'no'
                              }`}
                            >
                              <span class="solo-lectores">
                                {t.patrones.includes(p as never) ? NOMBRE_PATRON[p] : ''}
                              </span>
                            </span>
                          ))}
                        </span>
                      </span>
                    </Etiqueta>
                  </li>
                );
              })}
            </ul>

            {examenesPorAsignatura.has(a.id) && (
              <aside class="examenes">
                {rutasPorAsignatura.has(a.id) &&
                  rutasPorAsignatura.get(a.id)!.map((r) => (
                    <a class="ex-ruta" href={ruta(`${a.id}/preparar/${r.sufijo}`)}>
                      <span class="rotulo">Por dónde empezar</span>
                      <span class="ex-ruta-t">{r.titulo} →</span>
                    </a>
                  ))}

                <p class="rotulo ex-tit">Exámenes</p>
                <p class="ex-sub">
                  {examenesPorAsignatura.get(a.id)!.length === 1
                    ? 'Una convocatoria, con su enunciado original y resuelta entera.'
                    : `${examenesPorAsignatura.get(a.id)!.length} convocatorias, con su enunciado original y resueltas enteras.`}
                </p>
                <ul class="ex-lista">
                  {examenesPorAsignatura
                    .get(a.id)!
                    .slice(0, 4)
                    .map((ex) => (
                      <li>
                        <a href={ruta(`${a.id}/examenes/${ex.slug}`)}>
                          <span>{ex.curso}</span>
                          <span class="ex-conv">{ABREV_CONV[ex.conv]}</span>
                          <span class="ex-go" aria-hidden="true">
                            →
                          </span>
                        </a>
                      </li>
                    ))}
                </ul>
                <a class="ex-todos" href={ruta(`${a.id}/examenes`)}>
                  {examenesPorAsignatura.get(a.id)!.length === 1
                    ? 'Ir al examen →'
                    : `Ver los ${examenesPorAsignatura.get(a.id)!.length} →`}
                </a>
              </aside>
            )}
            </div>
          ) : (
            <div class="pendiente">
              <p class="p-tit">Todavía no</p>
              <p>
                {a.data.estado === 'obra'
                  ? 'Se está construyendo ahora mismo. Los temas irán apareciendo aquí según se terminen.'
                  : 'Esta asignatura está en el plan, pero primero se terminan Cálculo y Mecánica de Fluidos.'}
              </p>
            </div>
          )}
        </section>
      ))
    }
  </main>

  <!-- ── paleta de comandos ─────────────────────────────────────── -->
  <div class="paleta" data-paleta hidden>
    <div class="caja" role="dialog" aria-modal="true" aria-label="Buscar">
      <label class="solo-lectores" for="q">Asignatura, tema o concepto</label>
      <input id="q" type="search" autocomplete="off" placeholder="Asignatura, tema o concepto…" />
      <div class="res" data-res></div>
      <div class="pie">
        <span>↑↓ moverse</span><span>⏎ abrir</span><span>esc cerrar</span>
      </div>
    </div>
  </div>

  <script type="application/json" data-indice set:html={JSON.stringify(indice)} />
</Base>

<script>
  /* La portada ya funciona sin esto: las filas son anclas y `:target` abre el
     detalle. Lo que añade el script es no recargar, que el nombre viaje hasta
     el titular, y la paleta de comandos. */
  const escena = document.querySelector<HTMLElement>('.escena')!;
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── abrir y cerrar el detalle ─────────────────────────────────── */
  const detalles = new Map<string, HTMLElement>(
    [...document.querySelectorAll<HTMLElement>('.detalle')].map((s) => [s.id, s]),
  );

  function abre(id: string, origen: HTMLElement | null) {
    const seccion = detalles.get(id);
    if (!seccion) return;

    for (const s of detalles.values()) s.classList.toggle('activa', s === seccion);
    escena.dataset.vista = 'detalle';

    // El acento de la asignatura sube al documento: manda mientras dure la
    // vista, y solo en el marco (§06).
    document.documentElement.style.setProperty('--acento', seccion.style.getPropertyValue('--acento'));

    viaja(origen, seccion.querySelector<HTMLElement>('[data-destino]'));
    reinicia(seccion.querySelector<HTMLElement>('.regla'));
    window.scrollTo({ top: 0, behavior: reducido ? 'auto' : 'smooth' });
    seccion.querySelector<HTMLElement>('[data-destino]')?.focus({ preventScroll: true });
  }

  function cierra() {
    for (const s of detalles.values()) s.classList.remove('activa');
    escena.dataset.vista = 'lista';
    document.documentElement.style.removeProperty('--acento');
  }

  /** FLIP: se mide dónde estaba, se invierte y se anima hasta donde está.
   *  Sin esto el titular aparecería de la nada y el alumno perdería el hilo. */
  function viaja(desde: HTMLElement | null, hasta: HTMLElement | null) {
    if (reducido || !desde || !hasta) return;
    const a = desde.getBoundingClientRect();
    const b = hasta.getBoundingClientRect();
    if (!a.width || !b.width) return;
    hasta.animate(
      [
        {
          transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.height / b.height})`,
          opacity: 0.75,
        },
        { transform: 'none', opacity: 1 },
      ],
      { duration: 560, easing: 'cubic-bezier(.22,.61,.36,1)' },
    );
  }

  /** Vuelve a lanzar la animación de la regla aunque ya se hubiera reproducido. */
  function reinicia(el: HTMLElement | null) {
    if (!el) return;
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
  }

  for (const fila of document.querySelectorAll<HTMLAnchorElement>('[data-fila]')) {
    fila.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${fila.dataset.fila}`);
      abre(fila.dataset.fila!, fila.querySelector<HTMLElement>('[data-nombre]'));
    });
  }

  for (const chip of document.querySelectorAll<HTMLAnchorElement>('.chip, .volver')) {
    chip.addEventListener('click', (e) => {
      const destino = chip.getAttribute('href') ?? '';
      if (!destino.startsWith('#')) return;
      e.preventDefault();
      if (destino === '#principal') {
        history.replaceState(null, '', location.pathname);
        cierra();
      } else {
        history.replaceState(null, '', destino);
        abre(destino.slice(1), null);
      }
    });
  }

  // Entrar con el enlace ya puesto (o recargar) tiene que dejar la misma vista.
  if (location.hash.length > 1) abre(location.hash.slice(1), null);

  /* ── la figura tocable ─────────────────────────────────────────────
     Un punto amarillo arrastrable por la curva; la tangente le sigue.
     El movimiento es bajo demanda (brief Pizarra): nada se mueve solo.
     Con reduced-motion la curva aparece ya dibujada y el punto queda
     quieto — pero sigue siendo arrastrable. */
  {
    const svg = document.querySelector<SVGSVGElement>('[data-figura-tiza]');
    const path = document.querySelector<SVGPathElement>('#curva-piz');
    const punto = document.querySelector<SVGCircleElement>('#punto-piz');
    const tang = document.querySelector<SVGLineElement>('#tang-piz');
    if (svg && path && punto && tang) {
      const L = path.getTotalLength();
      let s = L * 0.44;
      let arrastra = false;

      const pinta = () => {
        const p = path.getPointAtLength(s);
        const a = path.getPointAtLength(Math.max(0, s - 2));
        const b = path.getPointAtLength(Math.min(L, s + 2));
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const n = Math.hypot(dx, dy) || 1;
        const ux = dx / n;
        const uy = dy / n;
        const e = 52;
        punto.setAttribute('cx', String(p.x));
        punto.setAttribute('cy', String(p.y));
        tang.setAttribute('x1', String(p.x - ux * e));
        tang.setAttribute('y1', String(p.y - uy * e));
        tang.setAttribute('x2', String(p.x + ux * e));
        tang.setAttribute('y2', String(p.y + uy * e));
        tang.setAttribute('opacity', '0.9');
      };

      const acerca = (ev: PointerEvent) => {
        const m = svg.getScreenCTM();
        if (!m) return;
        const c = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
        let mejor = s;
        let md = Infinity;
        for (let i = 0; i <= 90; i++) {
          const q = path.getPointAtLength((L * i) / 90);
          const d = (q.x - c.x) * (q.x - c.x) + (q.y - c.y) * (q.y - c.y);
          if (d < md) {
            md = d;
            mejor = (L * i) / 90;
          }
        }
        s = mejor;
        pinta();
      };

      svg.addEventListener('pointerdown', (ev) => {
        arrastra = true;
        svg.setPointerCapture(ev.pointerId);
        acerca(ev);
      });
      svg.addEventListener('pointermove', (ev) => {
        if (arrastra) acerca(ev);
      });
      svg.addEventListener('pointerup', () => {
        arrastra = false;
      });

      /* La tangente aparece cuando la curva ha terminado de dibujarse;
         si no hay animación, ahora mismo. */
      setTimeout(pinta, reducido ? 0 : 2100);
    }
  }

  /* ── paleta de comandos ────────────────────────────────────────── */
  type Entrada = {
    tipo: 'a' | 't';
    nombre: string;
    sub: string;
    clave: string;
    destino: string;
    n?: number;
  };

  const paleta = document.querySelector<HTMLElement>('[data-paleta]')!;
  const campo = document.querySelector<HTMLInputElement>('#q')!;
  const panel = document.querySelector<HTMLElement>('[data-res]')!;
  const indice: Entrada[] = JSON.parse(
    document.querySelector<HTMLElement>('[data-indice]')?.textContent ?? '[]',
  );

  let visibles: Entrada[] = [];
  let cursor = 0;
  let ultimoFoco: HTMLElement | null = null;

  /* El CSS de esta página tiene ámbito de Astro: solo viste a los elementos
     que llevan el atributo data-astro-cid-*. Los nodos que crea este script
     nacen sin él y saldrían en crudo — se les estampa el de la paleta. */
  const ambito = paleta.getAttributeNames().find((n) => n.startsWith('data-astro-cid'));
  function conAmbito<T extends HTMLElement>(el: T): T {
    if (ambito) {
      el.setAttribute(ambito, '');
      for (const hijo of el.querySelectorAll('*')) hijo.setAttribute(ambito, '');
    }
    return el;
  }

  function pinta() {
    const q = campo.value.trim().toLowerCase();
    visibles = q ? indice.filter((x) => x.clave.includes(q)).slice(0, 12) : indice.filter((x) => x.tipo === 'a');
    panel.textContent = '';

    if (!visibles.length) {
      const p = document.createElement('p');
      p.className = 'nada';
      p.textContent = `Nada con «${campo.value}». Prueba con el número del tema o con una palabra del enunciado.`;
      panel.appendChild(conAmbito(p));
      return;
    }

    if (cursor >= visibles.length) cursor = 0;
    let grupo = '';

    visibles.forEach((x, j) => {
      const cual =
        x.tipo === 'a' ? 'Asignaturas' : x.tipo === 'r' ? 'Rutas de estudio' : 'Temas';
      if (cual !== grupo) {
        grupo = cual;
        const t = document.createElement('p');
        t.className = 'rotulo grp';
        t.textContent = cual;
        panel.appendChild(conAmbito(t));
      }

      const b = document.createElement('button');
      b.type = 'button';
      b.className = j === cursor ? 'hit cur' : 'hit';
      b.innerHTML =
        `<span class="k"></span><span class="nb"></span><span class="sb"></span>`;
      /* La insignia: `##` para una asignatura, `→` para una ruta y el número
         del tema para todo lo demás. Sin la rama de `r` saldría `TUndefined`,
         porque una ruta no tiene `n`. */
      b.querySelector('.k')!.textContent =
        x.tipo === 'a' ? '##' : x.tipo === 'r' ? '→' : `T${String(x.n).padStart(2, '0')}`;
      b.querySelector('.nb')!.textContent = x.nombre;
      b.querySelector('.sb')!.textContent = x.sub;
      b.addEventListener('mouseenter', () => {
        cursor = j;
        pinta();
      });
      b.addEventListener('click', () => ve(x));
      panel.appendChild(conAmbito(b));
    });
  }

  function ve(x: Entrada) {
    cierraPaleta();
    if (x.destino.startsWith('#')) {
      history.replaceState(null, '', x.destino);
      abre(x.destino.slice(1), null);
    } else {
      location.href = x.destino;
    }
  }

  function abrePaleta() {
    ultimoFoco = document.activeElement as HTMLElement;
    paleta.hidden = false;
    campo.value = '';
    cursor = 0;
    pinta();
    campo.focus();
  }

  function cierraPaleta() {
    paleta.hidden = true;
    ultimoFoco?.focus();
  }

  document.querySelector('[data-abre-paleta]')?.addEventListener('click', abrePaleta);
  campo.addEventListener('input', () => {
    cursor = 0;
    pinta();
  });
  paleta.addEventListener('click', (e) => {
    if (e.target === paleta) cierraPaleta();
  });

  document.addEventListener('keydown', (e) => {
    if (paleta.hidden) {
      const enCampo = ['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName);
      if (e.key === '/' && !enCampo) {
        e.preventDefault();
        abrePaleta();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        abrePaleta();
      } else if (e.key === 'Escape' && escena.dataset.vista === 'detalle') {
        history.replaceState(null, '', location.pathname);
        cierra();
      }
      return;
    }

    if (e.key === 'Escape') {
      cierraPaleta();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      cursor = (cursor + 1) % visibles.length;
      pinta();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      cursor = (cursor - 1 + visibles.length) % visibles.length;
      pinta();
    } else if (e.key === 'Enter' && visibles[cursor]) {
      e.preventDefault();
      ve(visibles[cursor]);
    }
  });
</script>

<style>
  /* ── escena ──────────────────────────────────────────────────────
     Dos vistas en la misma página. Con JavaScript manda `data-vista`;
     sin él manda `:target`, y por eso las dos condiciones van juntas.

     La página ENTERA es pizarra (brief Pizarra): el fondo vive en el body
     y una capa fija lleva el gradiente, el polvo de tiza y la viñeta. El
     detalle B se recolorea remapeando los tokens neutros a tiza — una
     regla, no doscientas. */
  :global(body) { background: var(--piz-medio); }

  .escena {
    position: relative;
    padding: 0 clamp(1rem, 4vw, 3rem);

    /* el remapeo: todo lo que dentro de la escena pedía papel habla tiza.
       El `color` hay que REDECLARARLO: el body lo calcula con la tinta
       original y los hijos heredan el valor calculado, no la variable —
       sin esta línea todo lo que no declara color sale oscuro. */
    color: var(--ink);
    --ink: var(--tiza);
    --graphite: var(--tiza-suave);
    --faint: var(--tiza-apagada);
    --rule: var(--tiza-raya);
    --grid: var(--tiza-velo);
    --panel: var(--tiza-panel);
    --live: var(--tiza-amarilla);
    --live-soft: var(--tiza-velo);
    --flag: var(--tiza-flag);
    --flag-soft: var(--tiza-velo);
    --alt: var(--tiza-menta);
    --alt-soft: var(--tiza-velo);
  }

  .escena::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(var(--tiza-polvo-2) 1px, transparent 1px) 5px 7px / 13px 15px,
      var(--pizarra);
    box-shadow: var(--piz-vineta);
  }

  /* Los acentos oscuros de asignatura no se leen sobre pizarra: dentro de
     la escena el acento es siempre la tiza amarilla. `!important` porque
     el valor original va en el atributo style (lo necesita el script). */
  .escena .detalle,
  .escena .fila { --acento: var(--tiza-amarilla) !important; }

  /* La barra superior, en pizarra. Es CSS de página: las interiores no
     cambian hasta la fase 2 del brief. */
  :global(.top) {
    background: color-mix(in srgb, var(--piz-medio) 82%, transparent);
    border-bottom-color: var(--tiza-raya);
  }

  :global(.top .brand) { color: var(--tiza); }
  :global(.top .brand span) { color: var(--tiza-amarilla); }

  /* la escuela, como apunte de tiza al lado del wordmark */
  :global(.top .crumb) {
    font-family: var(--mano);
    font-size: 1.05rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--tiza-apagada);
  }

  /* la portada es pizarra en los dos temas: aquí el conmutador no dice nada */
  :global(.top .toggle) { display: none; }

  /* ── A · la pizarra ────────────────────────────────────────────── */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 4rem);
    transition: opacity .32s var(--ease), transform .42s var(--ease);
  }

  .mano { font-family: var(--mano); }

  .heroe {
    display: flex;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-top: clamp(1.2rem, 4vh, 2.8rem);
  }

  .mensaje { max-width: 40rem; }

  .titular {
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -.015em;
    line-height: 1.12;
    color: var(--tiza);
    margin: 0 0 1.1rem;
  }

  .frase-tiza {
    font-family: var(--mano);
    font-weight: 700;
    font-size: 1.15em;
    color: var(--tiza-amarilla);
    position: relative;
    white-space: nowrap;
  }

  .sub { position: absolute; left: 0; bottom: -8px; width: 100%; }
  .traza-sub { stroke: var(--tiza-amarilla); opacity: .9; }

  .entradilla {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--tiza-suave);
    max-width: 33rem;
    margin: 0 0 1.5rem;
  }

  .ctas { display: flex; flex-wrap: wrap; gap: .65rem; margin: 0; }

  .cta {
    font-size: .95rem;
    font-weight: 700;
