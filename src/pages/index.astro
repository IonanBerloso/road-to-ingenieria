    padding: .5rem clamp(1rem, 4vw, 3rem);
    background: var(--repisa);
    box-shadow: var(--repisa-sombra);
  }

  .tiza-barra { height: 12px; border-radius: 3px; box-shadow: var(--shadow-1); flex: 0 0 auto; }
  .t-blanca { width: 72px; background: var(--tiza); }
  .t-amarilla { width: 44px; background: var(--tiza-amarilla); }
  .t-menta { width: 30px; background: var(--tiza-menta); }
  .lema { margin-left: auto; font-size: .78rem; color: var(--tiza-suave); text-align: right; }

  /* ── el movimiento se ve UNA vez, y solo si el sistema lo permite ──
     El estado por defecto es «ya dibujado»: con reduced-motion no hay
     animación que correr y nada se queda invisible (§17: un forwards
     apagado deja el elemento en su estado inicial). */
  @media (prefers-reduced-motion: no-preference) {
    .apar { opacity: 0; animation: apar .8s var(--ease) forwards; }
    .entradilla.apar { animation-delay: .2s; }
    .ctas.apar { animation-delay: .35s; }
    .gratis.apar { animation-delay: .5s; }

    .traza-curva {
      stroke-dasharray: 560;
      stroke-dashoffset: 560;
      animation: traza 1.6s ease-out .4s forwards;
    }

    .traza-sub {
      stroke-dasharray: 320;
      stroke-dashoffset: 320;
      animation: traza 1.1s ease-out 1.1s forwards;
    }
  }

  @keyframes apar {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes traza { to { stroke-dashoffset: 0; } }

  /* ── B · detalle (brief §5b) ─────────────────────────────────────
     Banda de pizarra con la identidad; el cuerpo, en papel. La sección
     sangra hacia fuera del padding de la escena para que las dos
     superficies lleguen al borde, y cada franja repone el padding. */
  .detalle {
    display: none;
    margin: 0 calc(-1 * var(--pad));
    min-height: 100vh;
    background: var(--paper);
    padding-bottom: 4rem;
    animation: entra-vista .38s var(--ease) both;
  }

  /* `:has(:target)` cubre el ancla interior (#calculo-rutas): sin
     JavaScript, pulsar el CTA de la banda no puede cerrar el detalle. */
  .detalle:target,
  .detalle:has(:target),
  .detalle.activa { display: block; }

  /* Con JavaScript, `data-vista` manda y `:target` se aparta.
     Sin `data-js` —o sea, sin script— estas dos reglas no existen y sigue
     mandando `:target` sola, que es el respaldo documentado arriba.
     Ver el comentario largo del script, donde está el fallo que las trajo. */
  .escena[data-js][data-vista='lista'] .detalle:target,
  .escena[data-js][data-vista='lista'] .detalle:has(:target) { display: none; }
  .escena[data-js][data-vista='detalle'] .detalle:not(.activa) { display: none; }

  .banda {
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(ellipse at 25% 15%, var(--piz-claro), var(--piz-medio) 65%);
    box-shadow: var(--piz-vineta-banda);
    padding: 0 var(--pad) 1.6rem;
  }

  .b-cuerpo {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    padding-top: 1.3rem;
  }

  .b-kicker {
    font-size: 1.25rem;
    color: var(--tiza-amarilla);
    margin: 0 0 .1rem;
  }

  .b-desc {
    font-size: .93rem;
    line-height: 1.5;
    color: var(--tiza-suave);
    max-width: 36rem;
    margin: .5rem 0 0;
  }

  .b-der {
    margin-left: auto;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .65rem;
  }

  .b-meta { font-size: 1.2rem; color: var(--tiza-apagada); margin: 0; }

  .b-cta {
    display: inline-block;
    font-size: .9rem;
    font-weight: 700;
    color: var(--piz-medio);
    background: var(--tiza-amarilla);
    border-radius: 10px;
    padding: .65rem 1.15rem;
    box-shadow: var(--piz-sombra-cta);
    text-decoration: none;
    transition: background .2s, transform .15s;
  }

  .b-cta:hover { background: var(--tiza-amarilla-hover); transform: translateY(-1px); }

  /* Con JavaScript la clase manda; sin él, el ancla. En los dos casos la
     lista se retira en vez de quedarse debajo empujando.

     El `:not([data-js])` es la misma corrección que arriba y hace falta por el
     mismo motivo: `history.replaceState` no actualiza `:target`, así que al
     volver a la lista desde una entrada con almohadilla el `:has(:target)`
