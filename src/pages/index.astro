---
/**
 * La portada: un mapa del temario, no un selector (CLAUDE.md §05).
 * Portada de referencia/selector-fluido.html, con cuatro diferencias:
 *   · el CSS ya no está inline y los colores salen de tokens.css
 *   · los datos salen de la colección `catalogo`, no de un array en el script
 *   · las dos vistas se renderizan en el servidor y el detalle se abre con
 *     `:target`, así que la portada funciona entera sin JavaScript
 *   · el nombre de la asignatura y el <h1> son el MISMO elemento, no dos:
 *     por eso puede viajar de la fila al titular en vez de aparecer de nuevo
 *
 * El principio de §05: fluido no es tener animaciones, es no perder nunca el
 * sitio. Cada movimiento contesta de dónde ha salido algo.
 */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/ui/Cabecera.astro';
import { archivo, ruta } from '../lib/rutas';
import { mate } from '../lib/markdown.mjs';
import {
  SUFIJO_CONV,
  CONVOCATORIAS,
  ORDEN_CONV,
  CON_TEMAS,
  slugExamen,
  type ConTemas,
} from '../content.config';

const asignaturas = (await getCollection('catalogo')).sort(
  (a, b) => a.data.curso - b.data.curso || a.data.orden - b.data.orden,
);

/** Las notas de cada modalidad de evaluación, ya pasadas por `mate()`.
 *  Van indexadas por «asignatura · modalidad» porque el JSX de abajo las
 *  necesita dentro de un `.map()`, donde no se puede esperar a una promesa. */
const notaEvaluacion = new Map<string, string>();
for (const a of asignaturas) {
  for (const m of a.data.evaluacion?.modalidades ?? []) {
    if (m.nota) notaEvaluacion.set(`${a.id}·${m.nombre}`, await mate(m.nota, `eval-${a.id}`));
  }
}

const cursos = [1, 2] as const;
/* Estados en el lenguaje de la pizarra (brief Pizarra, §06): honestos y sin
 * jerga de obra. «Entera» solo lo dice el catálogo, nunca esta página. */
/* Cada estado dice lo mismo en dos sitios y con dos longitudes: `corta` en la
 * fila de la lista, `larga` en el rótulo de tiza de la banda del detalle
 * (brief §5b). Estaban en dos tablas separadas por cuatro líneas, y había una
 * tercera copia todavía peor: la fila de una asignatura `ok` llevaba la
 * palabra «entera» escrita a mano dentro de una plantilla, así que cambiar la
 * tabla habría dejado esa fila diciendo lo de antes. Una tabla, tres usos.
 * (§01, hecho el 15 de septiembre de 2026.) */
const ESTADO = {
  ok: { corta: 'entera', larga: 'asignatura entera' },
  obra: { corta: 'la estamos escribiendo', larga: 'la estamos escribiendo' },
  prev: { corta: 'aún no', larga: 'aún no' },
} as const;

/* Las etiquetas cortas de los botones de ruta. Presentación, no dato:
 * el título completo («Preparar la primera evaluación») no cabe en la
 * retícula de la caja de pizarra.
 *
 * Sale de `CONVOCATORIAS`, que es donde vive la tabla, y no de una copia.
 * Hasta el 15 de septiembre de 2026 era una lista escrita a mano con **siete**
 * de las diecisiete claves, así que las rutas de Química y de Mecánica —que
 * son `1c` y `2c`— caían en el `??` y salían en pantalla con el título largo,
 * «Preparar el examen final del primer cuatrimestre», reventando la retícula.
 * Esa es la razón de que el campo `boton` exista: una clave sin etiqueta corta
 * ahora rompe el tipo, no el diseño. */
const NOMBRE_RUTA: Record<string, string> = Object.fromEntries(
  Object.values(CONVOCATORIAS).map((c) => [c.url, c.boton]),
);

const hechos = (a: (typeof asignaturas)[number]) => a.data.temas.filter((t) => t.hecho).length;

/** Los exámenes de cada asignatura, del más reciente al más antiguo. El panel
 *  solo se dibuja donde hay alguno: una caja vacía prometiendo exámenes es
 *  peor que no tenerla. */
const ABREV_CONV: Record<string, string> = Object.fromEntries(
  Object.entries(CONVOCATORIAS).map(([k, v]) => [k, v.corta]),
);

const examenesPorAsignatura = new Map<
  string,
  { curso: string; conv: string; slug: string }[]
>();
/** Qué asignaturas tienen TODAS sus convocatorias transcritas enteras.
 *
 *  Esta página decía «N convocatorias resueltas enteras» en dos sitios, sin
 *  mirar nada, y era verdad por casualidad: cuando se escribió, ninguna
 *  convocatoria declaraba ejercicios `fuera`. Dejó de serlo dos veces sin que
 *  nadie lo notara — primero cuando la auditoría del 4 de septiembre de 2026
 *  añadió los ejercicios que faltan a 9 de las 16 convocatorias de Fluidos, y
 *  otra vez el 5 de septiembre con Fundamentos Químicos, que abre sus cinco
 *  con 6 ejercicios de 22.
 *
 *  Una frase fija que era cierta por casualidad es §10 esperando su turno: el
 *  corpus cambia, el sitio empieza a afirmar algo falso y no hay guardián que
 *  compare una frase con los datos. Se calcula. */
const enterasPorAsignatura = new Map<string, boolean>();
/** Y por el mismo motivo, qué asignaturas publican como PDF la corrección del
 *  profesor en vez del cuadernillo en blanco. Aquí se decía «con su enunciado
 *  original en PDF» de las seis, y en Ingeniería Térmica los veinte PDF son la
 *  resolución completa —de 14 a 32 páginas—. Ver `pdfEs` en content.config.ts. */
const corregidoPorAsignatura = new Map<string, boolean>();
for (const ex of await getCollection('examen')) {
  const lista = examenesPorAsignatura.get(ex.data.asignatura) ?? [];
  lista.push({
    curso: ex.data.curso,
    conv: ex.data.convocatoria,
    slug: slugExamen(ex.data.curso, ex.data.convocatoria),
  });
  examenesPorAsignatura.set(ex.data.asignatura, lista);

  const entera = (ex.data.fuera ?? []).length === 0;
  enterasPorAsignatura.set(
    ex.data.asignatura,
    (enterasPorAsignatura.get(ex.data.asignatura) ?? true) && entera,
  );
  corregidoPorAsignatura.set(
    ex.data.asignatura,
    (corregidoPorAsignatura.get(ex.data.asignatura) ?? true) && ex.data.pdfEs === 'resolucion',
  );
}

/** Las rutas de estudio, para poder ofrecerlas antes que los exámenes sueltos:
 *  quien llega a esta pantalla no sabe todavía por dónde empezar.
 *
 *  Este enlace no es solo navegación. `humo.mjs` descubre las páginas que
 *  tiene que probar **leyendo la portada**, así que sin él la ruta se
 *  quedaría sin comprobar y el suelo daría verde igual. */
const rutasPorAsignatura = new Map<string, { titulo: string; sufijo: string; conv: string }[]>();
const rutasIndice = new Map<string, { titulo: string; sufijo: string; bloques: string }[]>();
for (const r of await getCollection('preparar')) {
  const sufijo = SUFIJO_CONV[r.data.evaluacion];
  const lista = rutasPorAsignatura.get(r.data.asignatura) ?? [];
  lista.push({ titulo: r.data.titulo, sufijo, conv: r.data.evaluacion });
  rutasPorAsignatura.set(r.data.asignatura, lista);

  const idx = rutasIndice.get(r.data.asignatura) ?? [];
  idx.push({
    titulo: r.data.titulo,
    sufijo,
    bloques: r.data.bloques.map((b) => b.titulo).join(' '),
  });
  rutasIndice.set(r.data.asignatura, idx);
}
/* Los botones de la caja de rutas salen en el orden del curso, no en el
 * orden en que el glob encontró los ficheros. */
for (const lista of rutasPorAsignatura.values()) {
  lista.sort((a, b) => ORDEN_CONV.indexOf(a.conv) - ORDEN_CONV.indexOf(b.conv));
}
for (const lista of examenesPorAsignatura.values()) {
  lista.sort(
    (a, b) =>
      b.curso.localeCompare(a.curso) ||
      ORDEN_CONV.indexOf(a.conv) - ORDEN_CONV.indexOf(b.conv),
  );
}

/** Los **conceptos**: cada apartado de la prosa de cada tema, con su ancla.
 *
 *  §05 promete que la paleta busca «asignaturas, temas, conceptos y rutas a la
 *  vez» y hasta hoy no buscaba conceptos: solo títulos de tema. Y el concepto
 *  es justo con lo que llega un alumno —«arco capaz», «calado crítico»,
 *  «NPSH»— porque el título del tema no lo sabe todavía.
 *
 *  Los anclajes salen de `render()`, que es **el mismo slugger que usa la
 *  página del tema**, así que no pueden desviarse: si un apartado se renombra,
 *  el enlace de la paleta se renombra con él. Copiarlos a mano habría sido la
 *  quinta fuente de verdad de este proyecto (§17).
 *
 *  Solo entran los temas publicados —los que el catálogo marca `hecho`—,
 *  porque un concepto que lleva a una página que no existe es peor que no
 *  encontrarlo. */
const conceptos: { tipo: 'c'; nombre: string; sub: string; destino: string }[] = [];
for (const a of asignaturas) {
  const hechos = a.data.temas.filter((t) => t.hecho);
  if (hechos.length === 0) continue;
  if (!(CON_TEMAS as readonly string[]).includes(a.id)) continue;
  const coleccion = await getCollection(a.id as ConTemas);
  for (const t of hechos) {
    const entrada = coleccion.find((e) => e.id === t.id || e.id.startsWith(`${t.id}/`));
    if (!entrada) continue;
    const { headings } = await render(entrada);
    for (const h of headings) {
      /* Solo apartados y subapartados: el `#` es el título del tema, que ya
         está en el índice por su cuenta y saldría dos veces. */
      if (h.depth < 2 || h.depth > 3) continue;
      /* Sin `clave`: para un concepto sería `nombre` y `sub` otra vez en
         minúscula, y son 382 entradas. La arma el cliente en la primera
         pulsación, que cuesta un milisegundo y ahorra 40 KB en cada visita a
         la portada. Medido: el índice pasa de 145 a 105 KB, y la portada de
         217 a 177 — 27,5 KB una vez comprimida, que es lo que de verdad viaja
         por el cable. */
      conceptos.push({
        tipo: 'c',
        nombre: h.text,
        sub: `${t.titulo} · ${a.data.nombre}`,
        destino: `${ruta(`${a.id}/${t.id}`)}#${h.slug}`,
      });
    }
  }
}

/** Sin tildes y en minúscula, que es como hay que comparar lo que alguien
 *  teclea con prisa.
 *
 *  Hasta el 14 de septiembre de 2026 la paleta comparaba en minúscula y nada
 *  más, así que **«entropia» no encontraba nada y «entropía» encontraba
 *  catorce cosas**. Nadie escribe la tilde en un buscador, y menos en el móvil.
 *  Lo encontró una auditoría externa probando siete palabras en la portada
 *  publicada; seis daban «Nada con…».
 *
 *  Va en las dos puntas —la clave y la consulta— porque normalizar solo una
 *  las separa más todavía. */
const sinTildes = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');

/** El índice de la paleta de comandos se arma aquí, no en el cliente:
 *  buscar tiene que funcionar con la primera pulsación, sin recorrer el DOM. */
const indice = asignaturas.flatMap((a) => [
  {
    tipo: 'a' as const,
    nombre: a.data.nombre,
    sub: `${a.data.curso === 1 ? '1.er' : '2.º'} curso`,
    clave: sinTildes(`${a.data.nombre} ${a.data.descripcion}`),
    destino: `#${a.id}`,
  },
  ...a.data.temas.map((t) => ({
    tipo: 't' as const,
    nombre: t.titulo,
    sub: a.data.nombre,
    clave: sinTildes(`${t.titulo} ${t.descripcion} ${a.data.nombre}`),
    destino: t.hecho ? ruta(`${a.id}/${t.id}`) : `#${a.id}`,
    n: t.n,
  })),
  /* Las rutas de estudio son lo más buscable del sitio: «regiones»,
     «demostración», «series» son las palabras con las que un alumno llega.
     Por eso la clave incluye los títulos de sus bloques (§05). */
  ...(rutasIndice.get(a.id) ?? []).map((r) => ({
    tipo: 'r' as const,
    nombre: r.titulo,
    sub: `${a.data.nombre} · ruta de estudio`,
    clave: sinTildes(`${r.titulo} ${r.bloques} ${a.data.nombre} preparar ruta estudio`),
    destino: ruta(`${a.id}/preparar/${r.sufijo}`),
  })),
]).concat(conceptos);

/* ── los números del héroe salen de las colecciones, no de la prosa ──
 * §10: un dato publicado tiene que ser verdad. Si mañana entra un examen
 * más, esta cifra cambia sola; escrita a mano, mentiría en una semana. */
const totalExamenes = [...examenesPorAsignatura.values()].reduce((n, l) => n + l.length, 0);

/* Los dos accesos directos del héroe: las asignaturas terminadas, la de más
 * exámenes primero. La portada no supone itinerario (brief Pizarra): son
 * puertas, no un orden.
 *
 * Y son DOS, con su `slice`, no «las terminadas»: pintarlas todas hacía que
 * el héroe creciera una fila de botones por cada asignatura que se cerraba
 * —seis el 13 de septiembre de 2026, cuatro filas— y la portada dejó de caber
 * en una pantalla de portátil sin que nadie volviera a medirla. El temario de
 * abajo ya las lista todas: repetirlas aquí era además §01. */
const enteras = asignaturas
  .filter((a) => a.data.estado === 'ok')
  .sort(
    (a, b) =>
      (examenesPorAsignatura.get(b.id)?.length ?? 0) -
      (examenesPorAsignatura.get(a.id)?.length ?? 0),
  );
---

<Base
  titulo="Road to Ingeniería — la clase donde te dicen dónde te equivocas"
  descripcion={`Plataforma de estudio gratuita para 1.º y 2.º de la Escuela de Ingeniería de Gipuzkoa (UPV/EHU). ${totalExamenes} exámenes de verdad resueltos paso a paso, con cada error típico nombrado.`}
>
  <Cabecera crumb="— Escuela de Ingeniería de Gipuzkoa · UPV/EHU">
    <button class="mini" type="button" data-abre-paleta>
      Buscar <kbd>/</kbd>
    </button>
  </Cabecera>

  <main id="principal" class="escena" data-vista="lista">
    <!-- ── A · la pizarra ────────────────────────────────────────────
         La portada del rediseño Pizarra (brief agosto 2026): héroe con el
         subrayado de tiza que se dibuja UNA vez, la figura tocable de la
         tangente, el temario escrito en la pizarra y la repisa. Nada se
         mueve mientras se lee; reduced-motion lo deja todo ya dibujado. -->
    <section class="hero" aria-label="Portada">
      <div class="heroe">
        <div class="mensaje">
          <h1 class="titular apar">
            La clase donde por fin te dicen{' '}
            <span class="frase-tiza">
              dónde te equivocas
              <svg class="sub" height="12" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
                <path class="traza-sub" d="M 4 8 C 80 3 220 3 296 7" fill="none" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <p class="entradilla apar">
            Los apuntes dan el enunciado y la respuesta final. Aquí está todo lo
            de en medio: {totalExamenes} exámenes de verdad resueltos paso a
            paso, con cada error típico nombrado.
          </p>
          <p class="ctas apar">
            {enteras.slice(0, 2).map((a, i) => (
              <a
                class:list={['cta', i === 0 ? 'llena' : 'borde']}
                href={`#${a.id}`}
                data-fila={a.id}
              >
                Entrar a {a.data.nombre} →
              </a>
            ))}
          </p>
          <p class="mano gratis apar">gratis para siempre · sin cuentas · sin anuncios</p>
        </div>

        <!-- la figura de tiza: se dibuja una vez y luego SE TOCA.
             Decorativa para el lector de pantalla; el juego es del puntero. -->
        <div class="figura" aria-hidden="true">
          <svg id="fig-piz" viewBox="0 0 400 300" data-figura-tiza>
            <line x1="34" y1="258" x2="380" y2="258" class="eje" />
            <line x1="48" y1="34" x2="48" y2="270" class="eje" />
            <path id="curva-piz" class="traza-curva" d="M 48 240 C 128 240 128 84 210 84 C 288 84 280 196 372 154" fill="none" stroke-width="3" stroke-linecap="round" />
            <line id="tang-piz" class="tangente" x1="0" y1="0" x2="0" y2="0" stroke-width="2.5" stroke-dasharray="7 7" opacity="0" />
            <circle id="punto-piz" class="punto-tiza" r="6.5" cx="210" cy="84" />
            <text x="66" y="56" class="mano nota">la tangente te sigue —</text>
            <text x="66" y="80" class="mano nota">prueba a arrastrar el punto</text>
          </svg>
        </div>
      </div>

      <!-- el temario, escrito en la pizarra. Cada fila es un ancla al
           detalle: sin JavaScript la abre `:target`, como siempre. -->
      <div class="temario">
        {
          cursos.map((curso) => (
            <div class="columna">
              <p class="mano curso-h">{curso === 1 ? '1.er' : '2.º'} curso</p>
              {asignaturas
                .filter((a) => a.data.curso === curso)
                .map((a) => (
                  <a
                    class:list={['fila', { prev: a.data.estado === 'prev' }]}
                    href={`#${a.id}`}
                    style={`--acento: var(${a.data.acento})`}
                    data-fila={a.id}
                  >
                    <span class="mano pn">{String(a.data.orden).padStart(2, '0')}</span>
                    <span class="nm" data-nombre>{a.data.nombre}</span>
                    <span class:list={['mano', 'ps', a.data.estado]}>
                      {a.data.estado === 'ok'
                        ? `${a.data.temas.length} temas · ${examenesPorAsignatura.get(a.id)?.length ?? 0} exámenes — ${ESTADO.ok.corta}`
                        : a.data.estado === 'obra' && hechos(a) > 0
                          ? `${hechos(a)} de ${a.data.temas.length} temas — ${ESTADO.obra.corta}`
                          : ESTADO[a.data.estado].corta}
                    </span>
                  </a>
                ))}
            </div>
          ))
        }
      </div>

      <!-- la repisa -->
      <div class="repisa" role="presentation">
        <span class="tiza-barra t-blanca"></span>
        <span class="tiza-barra t-amarilla"></span>
        <span class="tiza-barra t-menta"></span>
        <span class="lema">se abre una asignatura cuando la anterior está terminada — pocas excelentes antes que muchas a medias</span>
      </div>
    </section>

    <!-- ── B · el detalle, uno por asignatura ─────────────────────
         Se renderizan los nueve. Sin JavaScript los abre `:target`;
         con JavaScript se abren sin recargar y el nombre viaja. -->
    {
      asignaturas.map((a) => (
        <section
          class="detalle"
          id={a.id}
          style={`--acento: var(${a.data.acento})`}
          aria-labelledby={`h-${a.id}`}
        >
          {/* ── la banda de pizarra: la identidad (brief §5b) ── */}
          <div class="banda">
            <nav class="chips" aria-label="Cambiar de asignatura">
              <a class="volver" href="#principal">← todas</a>
              {asignaturas.map((x) => (
                <a class:list={['chip', { act: x.id === a.id }]} href={`#${x.id}`}>
                  {x.data.nombre}
                </a>
              ))}
            </nav>

            <div class="b-cuerpo">
              <div class="b-izq">
                <p class="mano b-kicker">
                  {String(a.data.orden).padStart(2, '0')} ·{' '}
                  {a.data.curso === 1 ? '1.er curso' : '2.º curso'} ·{' '}
                  {ESTADO[a.data.estado].larga}
                </p>
                {/* tabindex -1: al abrir el detalle el foco aterriza aquí, para
                    que el lector de pantalla anuncie dónde ha ido a parar. No
                    lleva outline:none — si llegas por teclado, tienes que verlo. */}
                <h2 id={`h-${a.id}`} class="nombre" data-destino tabindex="-1">
                  {a.data.nombre}
                </h2>
                {a.data.descripcion && <p class="b-desc">{a.data.descripcion}</p>}
              </div>

              <div class="b-der">
                {a.data.temas.length > 0 && (
                  <p class="mano b-meta">
                    {a.data.temas.length} temas
                    {examenesPorAsignatura.has(a.id) &&
                      ` · ${examenesPorAsignatura.get(a.id)!.length} convocatorias${
                        enterasPorAsignatura.get(a.id) ? ' resueltas enteras' : ' abiertas'
                      }`}
                  </p>
                )}
                {rutasPorAsignatura.has(a.id) && (
                  <a class="b-cta" href={`#${a.id}-rutas`}>
                    Por dónde empezar: elige tu evaluación ↓
                  </a>
                )}
              </div>
            </div>
          </div>

          {/* ── el cuerpo, en papel ── */}
          {!a.data.temarioOficial && a.data.temas.length > 0 && (
            <p class="aviso">
              Temario provisional: hay que sustituirlo por el oficial de la asignatura.
            </p>
          )}

          {a.data.temas.length > 0 ? (
            <div class="cuerpo">
              <div class="temario-col">
                <p class="rotulo t-rotulo">El temario, tema a tema</p>
                <ul class="temas">
                  {a.data.temas.map((t, j) => {
                    const enlace = t.hecho ? ruta(`${a.id}/${t.id}`) : null;
                    const Etiqueta = enlace ? 'a' : 'div';
                    return (
                      <li style={`--i: ${j}`}>
                        <Etiqueta
                          class="tema"
                          data-peso={t.peso}
                          {/* «Todavía no escrito» y «no hay nada que escribir»
                              se veían igual, y no son lo mismo: del segundo no
                              va a llegar nunca nada, y el motivo va en el
                              título para que se pueda leer. */}
                          {...(t.soloEnClase
                            ? { 'data-solo-clase': '', title: t.soloEnClase }
                            : {})}
                          {...(enlace ? { href: enlace } : { 'aria-disabled': 'true' })}
                        >
                          <span class="mano tn">{String(t.n).padStart(2, '0')}</span>
                          <span class="t-tit">{t.titulo}</span>
                          <span class="t-der">
                            {/* Una etiqueta Caveat solo donde informa (§5b);
                                sale del catálogo, no se deriva aquí. */}
                            {t.etiqueta && <span class="mano t-sim">{t.etiqueta}</span>}
                            <span class:list={['pesop', t.peso]}>peso {t.peso}</span>
                          </span>
                        </Etiqueta>
                        {/* Y el motivo, escrito y no en un `title`.
                            Estaba SOLO como atributo, o sea como globito al
                            posarse el ratón: invisible en un móvil, invisible
                            con el teclado y sin leer para quien no sepa que
                            hay algo que mirar. §15 obliga a declarar por qué
                            un tema del temario oficial no tiene material, y
                            un dato declarado donde nadie lo ve no está
                            declarado — es el mismo fallo que los 58 enlaces
                            que existían y no llevaban (§16).
                            Son tres temas en todo el sitio, así que esto no
                            engorda nada: uno en Álgebra y dos en Fluidos. */}
                        {t.soloEnClase && <p class="solo-clase">{t.soloEnClase}</p>}
                      </li>
                    );
                  })}
                </ul>
              </div>

              <aside class="carril">
                {/* Cómo se compone la nota. Lo pidió la auditoría externa del
                    4 de septiembre de 2026 y lo llamó la mejora de más
                    rendimiento de todo el informe: entre un 20 y un 30 % de la
                    nota no es el examen escrito, y la página no lo decía en
                    ningún sitio. Va antes que las rutas y que los exámenes
                    porque es lo que decide qué hay que estudiar. */}
                {a.data.evaluacion && (
                  <div class="nota-caja">
                    <p class="rotulo nc-tit">Cómo se puntúa</p>
                    {a.data.evaluacion.modalidades.map((m) => (
                      <div class="nc-mod">
                        <p class="nc-nombre">{m.nombre}</p>
                        <ul class="nc-partes">
                          {m.partes.map((p) => (
                            <li>
                              <span class="nc-peso">{p.peso} %</span>
                              <span class="nc-que">{p.que}</span>
                            </li>
                          ))}
                        </ul>
                        {/* Por `mate()`, como TODAS las demás `nota` del
                            proyecto: las de material, las de teoría y las de
                            ejercicio de las rutas ya pasaban por él y esta
                            era la única excepción, así que una negrita aquí
                            salía con los asteriscos a la vista. Lo cazó
                            `verify.mjs` el 14 de septiembre de 2026 al
                            escribir los dos umbrales de Cálculo. */}
                        {notaEvaluacion.has(`${a.id}·${m.nombre}`) && (
                          <p class="nc-nota prosa" set:html={notaEvaluacion.get(`${a.id}·${m.nombre}`)} />
                        )}
                      </div>
                    ))}
                    <p class="nc-fuente">{a.data.evaluacion.fuente}</p>
                  </div>
                )}

                {rutasPorAsignatura.has(a.id) && (
                  <div class="rc" id={`${a.id}-rutas`}>
                    <p class="mano rc-tit">Por dónde empezar</p>
                    <p class="rc-sub">
                      No empieces por el tema 1: cada evaluación tiene su ruta,
                      con lo que cae ordenado por lo que rinde.
                    </p>
                    <div class="rc-grid">
                      {rutasPorAsignatura.get(a.id)!.map((r, i) => (
                        <a
                          class:list={['rc-btn', { dest: i === 0 }]}
                          href={ruta(`${a.id}/preparar/${r.sufijo}`)}
                          title={r.titulo}
                        >
                          {NOMBRE_RUTA[r.sufijo] ?? r.titulo}
                          {i === 0 && ' →'}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {examenesPorAsignatura.has(a.id) && (
                  <div class="ex-caja">
                    <p class="rotulo ex-tit">Exámenes</p>
                    <p class="ex-sub">
                      {(() => {
                        const n = examenesPorAsignatura.get(a.id)!.length;
                        const enteras = enterasPorAsignatura.get(a.id);
                        const elPdf = corregidoPorAsignatura.get(a.id)
                          ? 'el PDF corregido de la escuela'
                          : 'su enunciado original en PDF';
                        if (n === 1) {
                          return enteras
                            ? `Una convocatoria, con ${elPdf} y resuelta entera.`
                            : `Una convocatoria, con ${elPdf}. Cada ejercicio que falta lo dice en su página.`;
                        }
                        return enteras
                          ? `${n} convocatorias, con ${elPdf} y resueltas enteras.`
                          : `${n} convocatorias, con ${elPdf}. Los ejercicios que faltan están dichos uno a uno en cada página.`;
                      })()}
                    </p>
                    <ul class="ex-lista">
                      {examenesPorAsignatura
                        .get(a.id)!
                        .slice(0, 4)
                        .map((ex) => (
                          <li>
                            <a href={ruta(`${a.id}/examenes/${ex.slug}`)}>
                              <span>{ex.curso}</span>
                              <span class="ex-conv">{ABREV_CONV[ex.conv]}</span>
                              <span class="ex-go" aria-hidden="true">
                                →
                              </span>
                            </a>
                          </li>
                        ))}
                    </ul>
                    <a class="ex-todos" href={ruta(`${a.id}/examenes`)}>
                      {examenesPorAsignatura.get(a.id)!.length === 1
                        ? 'Ir al examen →'
                        : `Ver las ${examenesPorAsignatura.get(a.id)!.length} convocatorias →`}
                    </a>
                  </div>
                )}

                {a.data.temas.some((t) => t.peso === 'alto') && (
                  <p class="mano nota-rojo">
                    el rojo de «peso alto» significa: esto decide notas
                  </p>
                )}
              </aside>
            </div>
          ) : (
            <div class="pendiente">
              <p class="p-tit">Todavía no</p>
              <p>
                {/* El motivo sale del catálogo, que es quien lo sabe. Aquí
                    estuvo escrito a fuego —«primero se terminan Cálculo y
                    Álgebra»— hasta el 13 de septiembre de 2026, con las dos
                    cerradas desde agosto y seis asignaturas terminadas: la
                    frase que ve quien entra buscando la suya llevaba un mes
                    siendo falsa. Lo encontró una auditoría externa, y se le
                    había escapado a la mía porque `deuda.mjs` §10 persigue
                    cifras caducadas en `docs/` y esta vivía en una plantilla.
                    El texto de reserva es el genérico a propósito: no nombra
                    ninguna asignatura, así que no puede volver a caducar. */}
                {a.data.motivo ??
                  (a.data.estado === 'obra'
                    ? 'Se está construyendo ahora mismo. Los temas irán apareciendo aquí según se terminen.'
                    : 'Está en el plan y todavía no tiene contenido. Se abre cuando le toca: una asignatura a la vez.')}
              </p>
            </div>
          )}
        </section>
      ))
    }
  </main>

  <!-- ── paleta de comandos ─────────────────────────────────────── -->
  <div class="paleta" data-paleta hidden>
    <div class="caja" role="dialog" aria-modal="true" aria-label="Buscar">
      <label class="solo-lectores" for="q">Asignatura, tema o concepto</label>
      <input id="q" type="search" autocomplete="off" placeholder="Asignatura, tema o concepto…" />
      <div class="res" data-res></div>
      <div class="pie">
        <span>↑↓ moverse</span><span>⏎ abrir</span><span>esc cerrar</span>
      </div>
    </div>
  </div>

  <script type="application/json" data-indice set:html={JSON.stringify(indice)} />
  {/* La URL del índice de ejercicios se escribe aquí y no en el script porque
      el script no ve `import.meta.env.BASE_URL` con el prefijo del repositorio
      resuelto, y una URL a mano sería la enésima copia de la base (§01). */}
  {/* `archivo()` y no `ruta()`: esto es un fichero de `public/`, no una página.
      `ruta()` añade barra final —todas las páginas del sitio son directorios— y
      con ella GitHub Pages devuelve 404. Estuvo mal desde que se escribió la
      paleta, y costó **que el sitio no se publicara**: el mismo href lo usa el
      `fetch` del índice, así que la búsqueda de ejercicios no encontraba nada,
      y el guardián de enlaces no lo cazaba en Windows. Lo encontró la
      reauditoría del 15 de septiembre de 2026. */}
  <link rel="prefetch" data-indice-ejercicios href={archivo('indice-ejercicios.json')} />
</Base>

<script>
  /* La portada ya funciona sin esto: las filas son anclas y `:target` abre el
     detalle. Lo que añade el script es no recargar, que el nombre viaje hasta
     el titular, y la paleta de comandos. */
  const escena = document.querySelector<HTMLElement>('.escena')!;
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* A partir de aquí manda `data-vista`, y `:target` se aparta.
   *
   * POR QUÉ HACE FALTA ESTA MARCA. Las dos vías de abrir el detalle no se
   * hablaban: el CSS lo abre con `:target` y el script con `.activa` +
   * `history.replaceState`, y **`replaceState` no actualiza `:target`**. Quien
   * entraba por un enlace compartido con almohadilla —`…/#algebra`— dejaba esa
   * sección abierta por `:target` para siempre: pulsar «Cálculo» añadía la
   * suya encima y se veían **las dos**, con Álgebra tapando a Cálculo por ir
   * antes en el DOM. Ni «← todas» la cerraba. Solo lo arreglaba recargar.
   *
   * Lo encontró la auditoría externa del 4 de septiembre de 2026, y no lo
   * había visto nadie porque **desde la portada sin hash todo funciona**: hay
   * que llegar por un enlace con ancla, que es justo como llega el alumno
   * nuevo al que se lo pasan por WhatsApp.
   *
   * La marca es necesaria y no basta con `data-vista`: ese atributo viene YA
   * en el HTML servido —`data-vista="lista"`—, así que una regla que solo
   * mirara a él se aplicaría también sin JavaScript y rompería el respaldo de
   * `:target`, que es el que hace que la portada funcione sin scripts (§11).
   * `data-js` solo existe cuando el script ha tomado el control. */
  escena.dataset.js = '';

  /* ── abrir y cerrar el detalle ─────────────────────────────────── */
  const detalles = new Map<string, HTMLElement>(
    [...document.querySelectorAll<HTMLElement>('.detalle')].map((s) => [s.id, s]),
  );

  function abre(id: string, origen: HTMLElement | null) {
    const seccion = detalles.get(id);
    if (!seccion) return;

    for (const s of detalles.values()) s.classList.toggle('activa', s === seccion);
    escena.dataset.vista = 'detalle';

    // El acento de la asignatura sube al documento: manda mientras dure la
    // vista, y solo en el marco (§06).
    document.documentElement.style.setProperty('--acento', seccion.style.getPropertyValue('--acento'));

    viaja(origen, seccion.querySelector<HTMLElement>('[data-destino]'));
    window.scrollTo({ top: 0, behavior: reducido ? 'auto' : 'smooth' });
    seccion.querySelector<HTMLElement>('[data-destino]')?.focus({ preventScroll: true });
  }

  function cierra() {
    for (const s of detalles.values()) s.classList.remove('activa');
    escena.dataset.vista = 'lista';
    document.documentElement.style.removeProperty('--acento');
  }

  /** FLIP: se mide dónde estaba, se invierte y se anima hasta donde está.
   *  Sin esto el titular aparecería de la nada y el alumno perdería el hilo. */
  function viaja(desde: HTMLElement | null, hasta: HTMLElement | null) {
    if (reducido || !desde || !hasta) return;
    const a = desde.getBoundingClientRect();
    const b = hasta.getBoundingClientRect();
    if (!a.width || !b.width) return;
    hasta.animate(
      [
        {
          transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.height / b.height})`,
          opacity: 0.75,
        },
        { transform: 'none', opacity: 1 },
      ],
      { duration: 560, easing: 'cubic-bezier(.22,.61,.36,1)' },
    );
  }

  /** Vuelve a lanzar la animación de la regla aunque ya se hubiera reproducido. */
  function reinicia(el: HTMLElement | null) {
    if (!el) return;
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
  }

  for (const fila of document.querySelectorAll<HTMLAnchorElement>('[data-fila]')) {
    fila.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${fila.dataset.fila}`);
      abre(fila.dataset.fila!, fila.querySelector<HTMLElement>('[data-nombre]'));
    });
  }

  for (const chip of document.querySelectorAll<HTMLAnchorElement>('.chip, .volver')) {
    chip.addEventListener('click', (e) => {
      const destino = chip.getAttribute('href') ?? '';
      if (!destino.startsWith('#')) return;
      e.preventDefault();
      if (destino === '#principal') {
        history.replaceState(null, '', location.pathname);
        cierra();
      } else {
        history.replaceState(null, '', destino);
        abre(destino.slice(1), null);
      }
    });
  }

  // Entrar con el enlace ya puesto (o recargar) tiene que dejar la misma vista.
  // Un ancla interior del detalle (#calculo-rutas) abre su asignatura.
  if (location.hash.length > 1) {
    const id = location.hash.slice(1);
    abre(detalles.has(id) ? id : id.replace(/-rutas$/, ''), null);

    /* Y hay que volver a subir cuando la página se ha asentado. El `scrollTo`
       de `abre()` compite con el salto al ancla que hace el propio navegador
       —y con el reflujo de las tipografías—, y quien llegaba por `…/#calculo`
       se quedaba 69 px más abajo: justo lo que mide la barra de asignaturas,
       que quedaba escondida bajo la cabecera pegajosa **con el «← todas»
       dentro**. Medido el 5 de septiembre de 2026; se ve entrando por el
       enlace con almohadilla, nunca desde la portada (§16 punto 6). */
    const arriba = () => window.scrollTo({ top: 0, behavior: 'auto' });
    if (document.fonts?.ready) document.fonts.ready.then(arriba);
    window.addEventListener('load', arriba, { once: true });
  }

  /* Y si el ancla cambia sin recargar, la vista tiene que seguirla.
     No lo disparan los chips —esos usan `replaceState`, que no emite
     `hashchange`— sino el caso que se le escapaba a la página: llegar a
     `…/#calculo` y escribir `…/#fluidos` en la barra de direcciones, o
     cualquier enlace externo que solo cambie la almohadilla. El navegador no
     recarga y hasta hoy no pasaba nada. */
  window.addEventListener('hashchange', () => {
    const id = location.hash.slice(1);
    if (!id) return cierra();
    abre(detalles.has(id) ? id : id.replace(/-rutas$/, ''), null);
  });

  /* ── la figura tocable ─────────────────────────────────────────────
     Un punto amarillo arrastrable por la curva; la tangente le sigue.
     El movimiento es bajo demanda (brief Pizarra): nada se mueve solo.
     Con reduced-motion la curva aparece ya dibujada y el punto queda
     quieto — pero sigue siendo arrastrable. */
  {
    const svg = document.querySelector<SVGSVGElement>('[data-figura-tiza]');
    const path = document.querySelector<SVGPathElement>('#curva-piz');
    const punto = document.querySelector<SVGCircleElement>('#punto-piz');
    const tang = document.querySelector<SVGLineElement>('#tang-piz');
    if (svg && path && punto && tang) {
      const L = path.getTotalLength();
      let s = L * 0.44;
      let arrastra = false;

      const pinta = () => {
        const p = path.getPointAtLength(s);
        const a = path.getPointAtLength(Math.max(0, s - 2));
        const b = path.getPointAtLength(Math.min(L, s + 2));
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const n = Math.hypot(dx, dy) || 1;
        const ux = dx / n;
        const uy = dy / n;
        const e = 52;
        punto.setAttribute('cx', String(p.x));
        punto.setAttribute('cy', String(p.y));
        tang.setAttribute('x1', String(p.x - ux * e));
        tang.setAttribute('y1', String(p.y - uy * e));
        tang.setAttribute('x2', String(p.x + ux * e));
        tang.setAttribute('y2', String(p.y + uy * e));
        tang.setAttribute('opacity', '0.9');
      };

      const acerca = (ev: PointerEvent) => {
        const m = svg.getScreenCTM();
        if (!m) return;
        const c = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
        let mejor = s;
        let md = Infinity;
        for (let i = 0; i <= 90; i++) {
          const q = path.getPointAtLength((L * i) / 90);
          const d = (q.x - c.x) * (q.x - c.x) + (q.y - c.y) * (q.y - c.y);
          if (d < md) {
            md = d;
            mejor = (L * i) / 90;
          }
        }
        s = mejor;
        pinta();
      };

      svg.addEventListener('pointerdown', (ev) => {
        arrastra = true;
        svg.setPointerCapture(ev.pointerId);
        acerca(ev);
      });
      svg.addEventListener('pointermove', (ev) => {
        if (arrastra) acerca(ev);
      });
      svg.addEventListener('pointerup', () => {
        arrastra = false;
      });

      /* La tangente aparece cuando la curva ha terminado de dibujarse;
         si no hay animación, ahora mismo. */
      setTimeout(pinta, reducido ? 0 : 2100);
    }
  }

  /* ── paleta de comandos ────────────────────────────────────────── */
  type Entrada = {
    tipo: 'a' | 't' | 'r' | 'c' | 'e';
    nombre: string;
    sub: string;
    /** Los conceptos no la traen: sería su nombre y su tema otra vez en
     *  minúscula, y son 382 entradas. Se rellena aquí abajo. */
    clave?: string;
    destino: string;
    n?: number;
  };

  /** El orden en que se agrupan los resultados. Es también el orden en que se
   *  desempata cuando dos cosas encajan igual de bien: lo más general primero,
   *  porque quien escribe «complejos» quiere el tema y no sus quince
   *  apartados. */
  const ORDEN_TIPO = { a: 0, t: 1, r: 2, c: 3, e: 4 } as const;
  const ROTULO = {
    a: 'Asignaturas',
    t: 'Temas',
    r: 'Rutas de estudio',
    c: 'Conceptos',
    e: 'Ejercicios',
  } as const;

  const paleta = document.querySelector<HTMLElement>('[data-paleta]')!;
  const campo = document.querySelector<HTMLInputElement>('#q')!;
  const panel = document.querySelector<HTMLElement>('[data-res]')!;
  const indice: Entrada[] = JSON.parse(
    document.querySelector<HTMLElement>('[data-indice]')?.textContent ?? '[]',
  );
  /* Sin tildes en las dos puntas: la clave que se arma aquí y la consulta de
     abajo. Antes se comparaba solo en minúscula y «entropia» no encontraba
     nada mientras «entropía» encontraba catorce cosas. */
  /* `\p{M}`, con la barra. Sin ella el literal es `/p{M}/gu`, que no es «una
     marca diacrítica» sino «una p seguida de un cuantificador incompleto», y
     el navegador lo rechaza AL EVALUARLO: la primera llamada a `sinTildes`
     lanza, y con ella se cae el resto de este script — la paleta de mandos
     entera. Se publicó así hasta el 15 de septiembre de 2026, y lo encontró
     `humo.mjs` el día que se le pusieron escuchas de consola a la pestaña de
     la portada, que hasta entonces se abría sin ellas. */
  const sinTildes = (t: string) => t.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
  for (const x of indice) x.clave ??= sinTildes(`${x.nombre} ${x.sub}`);

  let visibles: Entrada[] = [];
  let cursor = 0;
  let ultimoFoco: HTMLElement | null = null;

  /* El CSS de esta página tiene ámbito de Astro: solo viste a los elementos
     que llevan el atributo data-astro-cid-*. Los nodos que crea este script
     nacen sin él y saldrían en crudo — se les estampa el de la paleta. */
  const ambito = paleta.getAttributeNames().find((n) => n.startsWith('data-astro-cid'));
  function conAmbito<T extends HTMLElement>(el: T): T {
    if (ambito) {
      el.setAttribute(ambito, '');
      for (const hijo of el.querySelectorAll('*')) hijo.setAttribute(ambito, '');
    }
    return el;
  }

  function pinta() {
    const q = sinTildes(campo.value.trim());
    /* Con los conceptos dentro, el índice pasó de 90 entradas a más de 470, y
       un `filter().slice(12)` a pelo dejaba de encontrar los temas: cualquier
       palabra corriente casaba con veinte apartados y los empujaba fuera del
       corte. Así que primero se puntúa —dónde encaja la consulta, y en qué
       tipo de cosa— y solo después se corta. */
    if (!q) {
      visibles = indice.filter((x) => x.tipo === 'a');
    } else {
      const puntua = (x: Entrada) => {
        const n = sinTildes(x.nombre);
        const donde = n.startsWith(q) ? 0 : n.includes(q) ? 1 : 2;
        return donde * 10 + ORDEN_TIPO[x.tipo];
      };
      visibles = indice
        .filter((x) => x.clave!.includes(q))
        .sort((a, b) => puntua(a) - puntua(b))
        .slice(0, 12)
        /* Y se reordenan por tipo para que cada grupo salga de una pieza: el
           rótulo se escribe cuando cambia el tipo, así que sin esto saldría
           «Temas» tres veces en la misma lista. */
        .sort((a, b) => ORDEN_TIPO[a.tipo] - ORDEN_TIPO[b.tipo]);
    }
    panel.textContent = '';

    if (!visibles.length) {
      const p = document.createElement('p');
      p.className = 'nada';
      /* La frase promete lo que la paleta hace, no lo que nos gustaría que
         hiciera. Decía «prueba con una palabra del enunciado» y los
         enunciados no se indexan: se indexan los TÍTULOS de los ejercicios,
         desde el 14 de septiembre de 2026. Prometer de más en la pantalla que
         aparece justo al fallar es la peor de las promesas incumplidas. */
      p.textContent = `Nada con «${campo.value}». Prueba con el número del tema, con el nombre de un concepto o con el título de un ejercicio.`;
      panel.appendChild(conAmbito(p));
      return;
    }

    if (cursor >= visibles.length) cursor = 0;
    let grupo = '';

    visibles.forEach((x, j) => {
      const cual = ROTULO[x.tipo];
      if (cual !== grupo) {
        grupo = cual;
        const t = document.createElement('p');
        t.className = 'rotulo grp';
        t.textContent = cual;
        panel.appendChild(conAmbito(t));
      }

      const b = document.createElement('button');
      b.type = 'button';
      b.className = j === cursor ? 'hit cur' : 'hit';
      b.innerHTML =
        `<span class="k"></span><span class="nb"></span><span class="sb"></span>`;
      /* La insignia: `##` asignatura, `→` ruta, `§` concepto —un apartado
         dentro de un tema—, `ej` ejercicio, y el número para el tema.
         **El tema es el único que usa `x.n`, y por eso no puede ser el caso
         por defecto.** Escrito como cadena de ternarios lo era, y la cola se
         ha roto ya dos veces con el mismo síntoma: la primera al añadir las
         rutas —`TUndefined`, porque una ruta no tiene `n`—, y otra vez al
         añadir los ejercicios, que tampoco lo tienen. La segunda no se vio
         durante semanas porque el índice de ejercicios llegaba con un 404 y
         esa rama no se pintaba nunca; al arreglar el 404, el 15 de septiembre
         de 2026, salió «Tundefined» en cada resultado.
         Ahora es una tabla y el tema es un caso más: un `tipo` nuevo sin
         insignia sale con un interrogante, no con un número inventado. */
      const INSIGNIA: Record<string, string> = { a: '##', r: '→', c: '§', e: 'ej' };
      b.querySelector('.k')!.textContent =
        x.tipo === 't' ? `T${String(x.n).padStart(2, '0')}` : (INSIGNIA[x.tipo] ?? '?');
      b.querySelector('.nb')!.textContent = x.nombre;
      b.querySelector('.sb')!.textContent = x.sub;
      b.addEventListener('mouseenter', () => {
        cursor = j;
        pinta();
      });
      b.addEventListener('click', () => ve(x));
      panel.appendChild(conAmbito(b));
    });
  }

  function ve(x: Entrada) {
    cierraPaleta();
    if (x.destino.startsWith('#')) {
      history.replaceState(null, '', x.destino);
      abre(x.destino.slice(1), null);
    } else {
      location.href = x.destino;
    }
  }

  /* Los ejercicios se piden la PRIMERA vez que se abre la paleta, no al cargar
     la portada.
     Son 1.259 entradas y el fichero pesa **63,6 KB comprimidos** —medido el 17
     de septiembre de 2026, con el número de boletín y el `pide` dentro; antes,
     solo con los títulos, eran 38—. Meter eso en la portada sería triplicar el
     peso de la página más visitada del sitio por una función que usa una
     minoría de las visitas. Se pide al mismo origen, una sola vez, y si la
     petición falla la paleta sigue buscando en lo que ya tiene: es un extra,
     no un requisito. Por eso no hay estado de error, solo un `catch` que no
     hace nada. */
  let ejerciciosPedidos = false;
  async function traeEjercicios() {
    if (ejerciciosPedidos) return;
    ejerciciosPedidos = true;
    const url = document
      .querySelector<HTMLLinkElement>('[data-indice-ejercicios]')
      ?.getAttribute('href');
    if (!url) return;
    try {
      const grupos: { u: string; s: string; e: [string, string, string, string][] }[] =
        await (await fetch(url)).json();
      for (const g of grupos) {
        for (const [titulo, id, ref, pide] of g.e) {
          indice.push({
            tipo: 'e',
            nombre: titulo,
            /* El número del boletín se enseña cuando lo hay: es como se busca
               un ejercicio cuando lo tienes delante en papel. */
            sub: ref ? `${ref} · ${g.s}` : g.s,
            /* Y en la clave entra además lo que el ejercicio PIDE. Un título
               como «La cota del error, que es media pregunta» no contiene la
               palabra que alguien teclearía; su `pide` sí. */
            clave: sinTildes(`${titulo} ${g.s} ${ref} ${pide}`),
            destino: `${g.u}#ej-${id}`,
          });
        }
      }
      /* Repintar por si ya hay algo escrito: entre abrir y que llegue esto
         caben varias pulsaciones, y sin esto la primera búsqueda de cada
         visita se quedaría sin ejercicios sin decir por qué. */
      if (!paleta.hidden) pinta();
    } catch {
      /* Sin ejercicios se busca igual, con lo que ya está cargado. */
    }
  }

  function abrePaleta() {
    ultimoFoco = document.activeElement as HTMLElement;
    paleta.hidden = false;
    campo.value = '';
    cursor = 0;
    pinta();
    campo.focus();
    traeEjercicios();
  }

  function cierraPaleta() {
    paleta.hidden = true;
    ultimoFoco?.focus();
  }

  document.querySelector('[data-abre-paleta]')?.addEventListener('click', abrePaleta);
  campo.addEventListener('input', () => {
    cursor = 0;
    pinta();
  });
  paleta.addEventListener('click', (e) => {
    if (e.target === paleta) cierraPaleta();
  });

  document.addEventListener('keydown', (e) => {
    if (paleta.hidden) {
      const enCampo = ['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName);
      if (e.key === '/' && !enCampo) {
        e.preventDefault();
        abrePaleta();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        abrePaleta();
      } else if (e.key === 'Escape' && escena.dataset.vista === 'detalle') {
        history.replaceState(null, '', location.pathname);
        cierra();
      }
      return;
    }

    if (e.key === 'Escape') {
      cierraPaleta();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      cursor = (cursor + 1) % visibles.length;
      pinta();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      cursor = (cursor - 1 + visibles.length) % visibles.length;
      pinta();
    } else if (e.key === 'Enter' && visibles[cursor]) {
      e.preventDefault();
      ve(visibles[cursor]);
    }
  });
</script>

<style>
  /* ── escena ──────────────────────────────────────────────────────
     Dos vistas en la misma página. Con JavaScript manda `data-vista`;
     sin él manda `:target`, y por eso las dos condiciones van juntas.

     La página ENTERA es pizarra (brief Pizarra): el fondo vive en el body
     y una capa fija lleva el gradiente, el polvo de tiza y la viñeta. El
     detalle B se recolorea remapeando los tokens neutros a tiza — una
     regla, no doscientas. */
  :global(body) { background: var(--piz-medio); }

  .escena {
    position: relative;
    --pad: clamp(1rem, 4vw, 3rem);
    padding: 0 var(--pad);
  }

  /* El remapeo vive SOLO en las superficies de pizarra: el héroe y la
     banda del detalle. Desde el brief §5b el cuerpo del detalle es papel,
     así que remapear la escena entera pintaría tiza sobre claro.
     El `color` hay que REDECLARARLO: el body lo calcula con la tinta y
     los hijos heredan el valor calculado, no la variable — sin esa línea
     todo lo que no declara color sale oscuro sobre la pizarra. */
  .hero,
  .banda {
    color: var(--ink);
    --ink: var(--tiza);
    --graphite: var(--tiza-suave);
    --faint: var(--tiza-apagada);
    --rule: var(--tiza-raya);
    --grid: var(--tiza-velo);
    --panel: var(--tiza-panel);
    --live: var(--tiza-amarilla);
    --live-soft: var(--tiza-velo);
    --flag: var(--tiza-flag);
    --flag-soft: var(--tiza-velo);
    --alt: var(--tiza-menta);
    --alt-soft: var(--tiza-velo);
  }

  .escena::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(var(--tiza-polvo-2) 1px, transparent 1px) 5px 7px / 13px 15px,
      var(--pizarra);
    box-shadow: var(--piz-vineta);
  }

  /* Los acentos oscuros de asignatura no se leen sobre pizarra: dentro de
     las superficies de tiza el acento es siempre la amarilla. `!important`
     porque el valor original va en el atributo style de la sección. */
  .escena .banda,
  .escena .fila { --acento: var(--tiza-amarilla) !important; }

  /* La barra pizarra vive en base.css desde la fase 2 (es de todo el
     sitio). Aquí solo lo propio de la portada: la escuela como apunte
