  :global(.top .crumb) {
    font-family: var(--mano);
    font-size: 1.05rem;
    text-transform: none;
    letter-spacing: 0;
  }

  /* El conmutador de tema hereda ya el estilo de tiza de base.css. */

  /* ── A · la pizarra ────────────────────────────────────────────── */
  .hero {
