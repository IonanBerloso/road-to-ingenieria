    padding-top: clamp(.7rem, 2.4vh, 1.6rem);
  }

  .mensaje { max-width: 40rem; }

  .titular {
    font-size: clamp(1.9rem, 4.2vw, 3.05rem); /* remate §6c: la escala del tablero */
    font-weight: 800;
