    padding: .8rem 1.4rem;
    box-shadow: var(--piz-sombra-cta);
  }

  .cta.llena:hover { background: var(--tiza-amarilla-hover); }

  .cta.borde {
    color: var(--tiza);
    border: 1.5px solid var(--tiza-borde);
    padding: .72rem 1.3rem;
