---
/**
 * La portada: un mapa del temario, no un selector (CLAUDE.md §05).
 * Portada de referencia/selector-fluido.html, con cuatro diferencias:
 *   · el CSS ya no está inline y los colores salen de tokens.css
 *   · los datos salen de la colección `catalogo`, no de un array en el script
 *   · las dos vistas se renderizan en el servidor y el detalle se abre con
 *     `:target`, así que la portada funciona entera sin JavaScript
 *   · el nombre de la asignatura y el <h1> son el MISMO elemento, no dos:
 *     por eso puede viajar de la fila al titular en vez de aparecer de nuevo
 *
 * El principio de §05: fluido no es tener animaciones, es no perder nunca el
 * sitio. Cada movimiento contesta de dónde ha salido algo.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/ui/Cabecera.astro';
import { ruta } from '../lib/rutas';
import { SUFIJO_CONV, CONVOCATORIAS, ORDEN_CONV } from '../content.config';

const asignaturas = (await getCollection('catalogo')).sort(
  (a, b) => a.data.curso - b.data.curso || a.data.orden - b.data.orden,
);

const cursos = [1, 2] as const;
/* Estados en el lenguaje de la pizarra (brief Pizarra, §06): honestos y sin
 * jerga de obra. «Entera» solo lo dice el catálogo, nunca esta página. */
const ETIQUETA = { ok: 'entera', obra: 'la estamos escribiendo', prev: 'aún no' } as const;

/* El detalle (brief §5b): el rótulo de tiza de la banda dice qué es esta
 * asignatura, con el estado en las palabras de la pizarra. */
const FRASE_ESTADO = {
  ok: 'asignatura entera',
  obra: 'la estamos escribiendo',
  prev: 'aún no',
} as const;

/* Las etiquetas cortas de los botones de ruta. Presentación, no dato:
 * el título completo («Preparar la primera evaluación») no cabe en la
 * retícula de la caja de pizarra. */
const NOMBRE_RUTA: Record<string, string> = {
  '1ev': '1.ª evaluación',
  '2ev': '2.ª evaluación',
  '3ev': '3.ª evaluación',
  '4ev': '4.ª evaluación',
  '5ev': '5.ª evaluación',
  ord: 'Ordinaria',
  ext: 'Extraordinaria',
};

const hechos = (a: (typeof asignaturas)[number]) => a.data.temas.filter((t) => t.hecho).length;

/** Los exámenes de cada asignatura, del más reciente al más antiguo. El panel
 *  solo se dibuja donde hay alguno: una caja vacía prometiendo exámenes es
 *  peor que no tenerla. */
const ABREV_CONV: Record<string, string> = Object.fromEntries(
  Object.entries(CONVOCATORIAS).map(([k, v]) => [k, v.corta]),
);

const examenesPorAsignatura = new Map<
  string,
  { curso: string; conv: string; slug: string }[]
>();
/** Qué asignaturas tienen TODAS sus convocatorias transcritas enteras.
 *
 *  Esta página decía «N convocatorias resueltas enteras» en dos sitios, sin
 *  mirar nada, y era verdad por casualidad: cuando se escribió, ninguna
 *  convocatoria declaraba ejercicios `fuera`. Dejó de serlo dos veces sin que
 *  nadie lo notara — primero cuando la auditoría del 4 de septiembre de 2026
 *  añadió los ejercicios que faltan a 9 de las 16 convocatorias de Fluidos, y
 *  otra vez el 5 de septiembre con Fundamentos Químicos, que abre sus cinco
 *  con 6 ejercicios de 22.
 *
 *  Una frase fija que era cierta por casualidad es §10 esperando su turno: el
 *  corpus cambia, el sitio empieza a afirmar algo falso y no hay guardián que
 *  compare una frase con los datos. Se calcula. */
const enterasPorAsignatura = new Map<string, boolean>();
for (const ex of await getCollection('examen')) {
  const lista = examenesPorAsignatura.get(ex.data.asignatura) ?? [];
  lista.push({
    curso: ex.data.curso,
    conv: ex.data.convocatoria,
    slug: `${ex.data.curso}-${SUFIJO_CONV[ex.data.convocatoria]}`,
  });
  examenesPorAsignatura.set(ex.data.asignatura, lista);

  const entera = (ex.data.fuera ?? []).length === 0;
  enterasPorAsignatura.set(
    ex.data.asignatura,
    (enterasPorAsignatura.get(ex.data.asignatura) ?? true) && entera,
  );
}

/** Las rutas de estudio, para poder ofrecerlas antes que los exámenes sueltos:
 *  quien llega a esta pantalla no sabe todavía por dónde empezar.
 *
 *  Este enlace no es solo navegación. `humo.mjs` descubre las páginas que
 *  tiene que probar **leyendo la portada**, así que sin él la ruta se
 *  quedaría sin comprobar y el suelo daría verde igual. */
const rutasPorAsignatura = new Map<string, { titulo: string; sufijo: string; conv: string }[]>();
const rutasIndice = new Map<string, { titulo: string; sufijo: string; bloques: string }[]>();
for (const r of await getCollection('preparar')) {
  const sufijo = SUFIJO_CONV[r.data.evaluacion];
  const lista = rutasPorAsignatura.get(r.data.asignatura) ?? [];
  lista.push({ titulo: r.data.titulo, sufijo, conv: r.data.evaluacion });
  rutasPorAsignatura.set(r.data.asignatura, lista);

  const idx = rutasIndice.get(r.data.asignatura) ?? [];
  idx.push({
    titulo: r.data.titulo,
    sufijo,
    bloques: r.data.bloques.map((b) => b.titulo).join(' '),
  });
  rutasIndice.set(r.data.asignatura, idx);
}
/* Los botones de la caja de rutas salen en el orden del curso, no en el
 * orden en que el glob encontró los ficheros. */
for (const lista of rutasPorAsignatura.values()) {
  lista.sort((a, b) => ORDEN_CONV.indexOf(a.conv) - ORDEN_CONV.indexOf(b.conv));
}
for (const lista of examenesPorAsignatura.values()) {
  lista.sort(
    (a, b) =>
      b.curso.localeCompare(a.curso) ||
      ORDEN_CONV.indexOf(a.conv) - ORDEN_CONV.indexOf(b.conv),
  );
}

/** El índice de la paleta de comandos se arma aquí, no en el cliente:
 *  buscar tiene que funcionar con la primera pulsación, sin recorrer el DOM. */
const indice = asignaturas.flatMap((a, i) => [
  {
    tipo: 'a' as const,
    nombre: a.data.nombre,
    sub: `${a.data.curso === 1 ? '1.er' : '2.º'} curso`,
    clave: `${a.data.nombre} ${a.data.descripcion}`.toLowerCase(),
    destino: `#${a.id}`,
    orden: i,
  },
  ...a.data.temas.map((t) => ({
    tipo: 't' as const,
    nombre: t.titulo,
    sub: a.data.nombre,
    clave: `${t.titulo} ${t.descripcion} ${a.data.nombre}`.toLowerCase(),
    destino: t.hecho ? ruta(`${a.id}/${t.id}`) : `#${a.id}`,
    orden: i,
    n: t.n,
  })),
  /* Las rutas de estudio son lo más buscable del sitio: «regiones»,
     «demostración», «series» son las palabras con las que un alumno llega.
     Por eso la clave incluye los títulos de sus bloques (§05). */
  ...(rutasIndice.get(a.id) ?? []).map((r) => ({
    tipo: 'r' as const,
    nombre: r.titulo,
    sub: `${a.data.nombre} · ruta de estudio`,
    clave: `${r.titulo} ${r.bloques} ${a.data.nombre} preparar ruta estudio`.toLowerCase(),
    destino: ruta(`${a.id}/preparar/${r.sufijo}`),
    orden: i,
  })),
]);

/* ── los números del héroe salen de las colecciones, no de la prosa ──
 * §10: un dato publicado tiene que ser verdad. Si mañana entra un examen
 * más, esta cifra cambia sola; escrita a mano, mentiría en una semana. */
const totalExamenes = [...examenesPorAsignatura.values()].reduce((n, l) => n + l.length, 0);

/* Los dos accesos directos del héroe: las asignaturas terminadas, la de más
 * exámenes primero. La portada no supone itinerario (brief Pizarra): son
 * puertas, no un orden. */
const enteras = asignaturas
  .filter((a) => a.data.estado === 'ok')
  .sort(
    (a, b) =>
      (examenesPorAsignatura.get(b.id)?.length ?? 0) -
      (examenesPorAsignatura.get(a.id)?.length ?? 0),
  );
---

<Base
  titulo="Road to Ingeniería — la clase donde te dicen dónde te equivocas"
  descripcion={`Plataforma de estudio gratuita para 1.º y 2.º de la Escuela de Ingeniería de Gipuzkoa (UPV/EHU). ${totalExamenes} exámenes de verdad resueltos paso a paso, con cada error típico nombrado.`}
>
  <Cabecera crumb="— Escuela de Ingeniería de Gipuzkoa · UPV/EHU">
    <button class="mini" type="button" data-abre-paleta>
      Buscar <kbd>/</kbd>
    </button>
  </Cabecera>

  <main id="principal" class="escena" data-vista="lista">
    <!-- ── A · la pizarra ────────────────────────────────────────────
         La portada del rediseño Pizarra (brief agosto 2026): héroe con el
         subrayado de tiza que se dibuja UNA vez, la figura tocable de la
         tangente, el temario escrito en la pizarra y la repisa. Nada se
         mueve mientras se lee; reduced-motion lo deja todo ya dibujado. -->
    <section class="hero" aria-label="Portada">
      <div class="heroe">
        <div class="mensaje">
          <h1 class="titular apar">
            La clase donde por fin te dicen{' '}
            <span class="frase-tiza">
              dónde te equivocas
              <svg class="sub" height="12" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
                <path class="traza-sub" d="M 4 8 C 80 3 220 3 296 7" fill="none" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <p class="entradilla apar">
            Los apuntes dan el enunciado y la respuesta final. Aquí está todo lo
            de en medio: {totalExamenes} exámenes de verdad resueltos paso a
            paso, con cada error típico nombrado.
          </p>
          <p class="ctas apar">
            {enteras.map((a, i) => (
              <a
                class:list={['cta', i === 0 ? 'llena' : 'borde']}
                href={`#${a.id}`}
                data-fila={a.id}
              >
                Entrar a {a.data.nombre} →
              </a>
            ))}
          </p>
          <p class="mano gratis apar">gratis para siempre · sin cuentas · sin anuncios</p>
        </div>

        <!-- la figura de tiza: se dibuja una vez y luego SE TOCA.
             Decorativa para el lector de pantalla; el juego es del puntero. -->
        <div class="figura" aria-hidden="true">
          <svg id="fig-piz" viewBox="0 0 400 300" data-figura-tiza>
            <line x1="34" y1="258" x2="380" y2="258" class="eje" />
            <line x1="48" y1="34" x2="48" y2="270" class="eje" />
            <path id="curva-piz" class="traza-curva" d="M 48 240 C 128 240 128 84 210 84 C 288 84 280 196 372 154" fill="none" stroke-width="3" stroke-linecap="round" />
            <line id="tang-piz" class="tangente" x1="0" y1="0" x2="0" y2="0" stroke-width="2.5" stroke-dasharray="7 7" opacity="0" />
            <circle id="punto-piz" class="punto-tiza" r="6.5" cx="210" cy="84" />
            <text x="66" y="56" class="mano nota">la tangente te sigue —</text>
            <text x="66" y="80" class="mano nota">prueba a arrastrar el punto</text>
          </svg>
        </div>
      </div>

      <!-- el temario, escrito en la pizarra. Cada fila es un ancla al
           detalle: sin JavaScript la abre `:target`, como siempre. -->
      <div class="temario">
        {
          cursos.map((curso) => (
            <div class="columna">
              <p class="mano curso-h">{curso === 1 ? '1.er' : '2.º'} curso</p>
              {asignaturas
                .filter((a) => a.data.curso === curso)
                .map((a) => (
                  <a
                    class:list={['fila', { prev: a.data.estado === 'prev' }]}
                    href={`#${a.id}`}
                    style={`--acento: var(${a.data.acento})`}
                    data-fila={a.id}
                  >
                    <span class="mano pn">{String(a.data.orden).padStart(2, '0')}</span>
                    <span class="nm" data-nombre>{a.data.nombre}</span>
                    <span class:list={['mano', 'ps', a.data.estado]}>
                      {a.data.estado === 'ok'
                        ? `${a.data.temas.length} temas · ${examenesPorAsignatura.get(a.id)?.length ?? 0} exámenes — entera`
                        : a.data.estado === 'obra' && hechos(a) > 0
                          ? `${hechos(a)} de ${a.data.temas.length} temas — ${ETIQUETA.obra}`
                          : ETIQUETA[a.data.estado]}
                    </span>
                  </a>
                ))}
            </div>
          ))
        }
      </div>

      <!-- la repisa -->
      <div class="repisa" role="presentation">
        <span class="tiza-barra t-blanca"></span>
        <span class="tiza-barra t-amarilla"></span>
        <span class="tiza-barra t-menta"></span>
        <span class="lema">se abre una asignatura cuando la anterior está terminada — pocas excelentes antes que muchas a medias</span>
      </div>
    </section>

    <!-- ── B · el detalle, uno por asignatura ─────────────────────
         Se renderizan los nueve. Sin JavaScript los abre `:target`;
         con JavaScript se abren sin recargar y el nombre viaja. -->
    {
      asignaturas.map((a) => (
        <section
          class="detalle"
          id={a.id}
          style={`--acento: var(${a.data.acento})`}
          aria-labelledby={`h-${a.id}`}
        >
          {/* ── la banda de pizarra: la identidad (brief §5b) ── */}
          <div class="banda">
            <nav class="chips" aria-label="Cambiar de asignatura">
              <a class="volver" href="#principal">← todas</a>
              {asignaturas.map((x) => (
                <a class:list={['chip', { act: x.id === a.id }]} href={`#${x.id}`}>
                  {x.data.nombre}
                </a>
              ))}
            </nav>

            <div class="b-cuerpo">
              <div class="b-izq">
                <p class="mano b-kicker">
                  {String(a.data.orden).padStart(2, '0')} ·{' '}
                  {a.data.curso === 1 ? '1.er curso' : '2.º curso'} ·{' '}
                  {FRASE_ESTADO[a.data.estado]}
                </p>
                {/* tabindex -1: al abrir el detalle el foco aterriza aquí, para
                    que el lector de pantalla anuncie dónde ha ido a parar. No
                    lleva outline:none — si llegas por teclado, tienes que verlo. */}
                <h2 id={`h-${a.id}`} class="nombre" data-destino tabindex="-1">
                  {a.data.nombre}
                </h2>
                {a.data.descripcion && <p class="b-desc">{a.data.descripcion}</p>}
              </div>

              <div class="b-der">
                {a.data.temas.length > 0 && (
                  <p class="mano b-meta">
                    {a.data.temas.length} temas
                    {examenesPorAsignatura.has(a.id) &&
                      ` · ${examenesPorAsignatura.get(a.id)!.length} convocatorias${
                        enterasPorAsignatura.get(a.id) ? ' resueltas enteras' : ' abiertas'
                      }`}
                  </p>
                )}
                {rutasPorAsignatura.has(a.id) && (
                  <a class="b-cta" href={`#${a.id}-rutas`}>
                    Por dónde empezar: elige tu evaluación ↓
                  </a>
                )}
              </div>
            </div>
          </div>

          {/* ── el cuerpo, en papel ── */}
          {!a.data.temarioOficial && a.data.temas.length > 0 && (
            <p class="aviso">
              Temario provisional: hay que sustituirlo por el oficial de la asignatura.
            </p>
          )}

          {a.data.temas.length > 0 ? (
            <div class="cuerpo">
              <div class="temario-col">
                <p class="rotulo t-rotulo">El temario, tema a tema</p>
                <ul class="temas">
                  {a.data.temas.map((t, j) => {
                    const enlace = t.hecho ? ruta(`${a.id}/${t.id}`) : null;
                    const Etiqueta = enlace ? 'a' : 'div';
                    return (
                      <li style={`--i: ${j}`}>
                        <Etiqueta
                          class="tema"
                          data-peso={t.peso}
                          {/* «Todavía no escrito» y «no hay nada que escribir»
                              se veían igual, y no son lo mismo: del segundo no
                              va a llegar nunca nada, y el motivo va en el
                              título para que se pueda leer. */}
                          {...(t.soloEnClase
                            ? { 'data-solo-clase': '', title: t.soloEnClase }
                            : {})}
                          {...(enlace ? { href: enlace } : { 'aria-disabled': 'true' })}
                        >
                          <span class="mano tn">{String(t.n).padStart(2, '0')}</span>
                          <span class="t-tit">{t.titulo}</span>
                          <span class="t-der">
                            {/* Una etiqueta Caveat solo donde informa (§5b);
                                sale del catálogo, no se deriva aquí. */}
                            {t.etiqueta && <span class="mano t-sim">{t.etiqueta}</span>}
                            <span class:list={['pesop', t.peso]}>peso {t.peso}</span>
                          </span>
                        </Etiqueta>
                        {/* Y el motivo, escrito y no en un `title`.
                            Estaba SOLO como atributo, o sea como globito al
                            posarse el ratón: invisible en un móvil, invisible
                            con el teclado y sin leer para quien no sepa que
                            hay algo que mirar. §15 obliga a declarar por qué
                            un tema del temario oficial no tiene material, y
                            un dato declarado donde nadie lo ve no está
                            declarado — es el mismo fallo que los 58 enlaces
                            que existían y no llevaban (§16).
                            Son tres temas en todo el sitio, así que esto no
                            engorda nada: uno en Álgebra y dos en Fluidos. */}
                        {t.soloEnClase && <p class="solo-clase">{t.soloEnClase}</p>}
                      </li>
                    );
                  })}
                </ul>
              </div>

              <aside class="carril">
                {/* Cómo se compone la nota. Lo pidió la auditoría externa del
                    4 de septiembre de 2026 y lo llamó la mejora de más
                    rendimiento de todo el informe: entre un 20 y un 30 % de la
                    nota no es el examen escrito, y la página no lo decía en
                    ningún sitio. Va antes que las rutas y que los exámenes
                    porque es lo que decide qué hay que estudiar. */}
                {a.data.evaluacion && (
                  <div class="nota-caja">
                    <p class="rotulo nc-tit">Cómo se puntúa</p>
                    {a.data.evaluacion.modalidades.map((m) => (
                      <div class="nc-mod">
                        <p class="nc-nombre">{m.nombre}</p>
                        <ul class="nc-partes">
                          {m.partes.map((p) => (
                            <li>
                              <span class="nc-peso">{p.peso} %</span>
                              <span class="nc-que">{p.que}</span>
                            </li>
                          ))}
                        </ul>
                        {m.nota && <p class="nc-nota">{m.nota}</p>}
                      </div>
                    ))}
                    <p class="nc-fuente">{a.data.evaluacion.fuente}</p>
                  </div>
                )}

                {rutasPorAsignatura.has(a.id) && (
                  <div class="rc" id={`${a.id}-rutas`}>
                    <p class="mano rc-tit">Por dónde empezar</p>
                    <p class="rc-sub">
                      No empieces por el tema 1: cada evaluación tiene su ruta,
                      con lo que cae ordenado por lo que rinde.
                    </p>
                    <div class="rc-grid">
                      {rutasPorAsignatura.get(a.id)!.map((r, i) => (
                        <a
                          class:list={['rc-btn', { dest: i === 0 }]}
                          href={ruta(`${a.id}/preparar/${r.sufijo}`)}
                          title={r.titulo}
                        >
                          {NOMBRE_RUTA[r.sufijo] ?? r.titulo}
                          {i === 0 && ' →'}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {examenesPorAsignatura.has(a.id) && (
                  <div class="ex-caja">
                    <p class="rotulo ex-tit">Exámenes</p>
                    <p class="ex-sub">
                      {(() => {
                        const n = examenesPorAsignatura.get(a.id)!.length;
                        const enteras = enterasPorAsignatura.get(a.id);
                        if (n === 1) {
                          return enteras
                            ? 'Una convocatoria, con su enunciado original en PDF y resuelta entera.'
                            : 'Una convocatoria, con su enunciado original en PDF. Cada ejercicio que falta lo dice en su página.';
                        }
                        return enteras
                          ? `${n} convocatorias, con su enunciado original en PDF y resueltas enteras.`
                          : `${n} convocatorias, con su enunciado original en PDF. Los ejercicios que faltan están dichos uno a uno en cada página.`;
                      })()}
                    </p>
                    <ul class="ex-lista">
                      {examenesPorAsignatura
                        .get(a.id)!
                        .slice(0, 4)
                        .map((ex) => (
                          <li>
                            <a href={ruta(`${a.id}/examenes/${ex.slug}`)}>
                              <span>{ex.curso}</span>
                              <span class="ex-conv">{ABREV_CONV[ex.conv]}</span>
                              <span class="ex-go" aria-hidden="true">
                                →
                              </span>
                            </a>
                          </li>
                        ))}
                    </ul>
                    <a class="ex-todos" href={ruta(`${a.id}/examenes`)}>
                      {examenesPorAsignatura.get(a.id)!.length === 1
                        ? 'Ir al examen →'
                        : `Ver las ${examenesPorAsignatura.get(a.id)!.length} convocatorias →`}
                    </a>
                  </div>
                )}

                {a.data.temas.some((t) => t.peso === 'alto') && (
                  <p class="mano nota-rojo">
                    el rojo de «peso alto» significa: esto decide notas
                  </p>
                )}
              </aside>
            </div>
          ) : (
            <div class="pendiente">
              <p class="p-tit">Todavía no</p>
              <p>
                {a.data.estado === 'obra'
                  ? 'Se está construyendo ahora mismo. Los temas irán apareciendo aquí según se terminen.'
                  : 'Esta asignatura está en el plan, pero primero se terminan Cálculo y Álgebra.'}
              </p>
            </div>
          )}
        </section>
      ))
    }
  </main>

  <!-- ── paleta de comandos ─────────────────────────────────────── -->
  <div class="paleta" data-paleta hidden>
    <div class="caja" role="dialog" aria-modal="true" aria-label="Buscar">
      <label class="solo-lectores" for="q">Asignatura, tema o concepto</label>
      <input id="q" type="search" autocomplete="off" placeholder="Asignatura, tema o concepto…" />
      <div class="res" data-res></div>
      <div class="pie">
        <span>↑↓ moverse</span><span>⏎ abrir</span><span>esc cerrar</span>
      </div>
    </div>
  </div>

  <script type="application/json" data-indice set:html={JSON.stringify(indice)} />
</Base>

<script>
  /* La portada ya funciona sin esto: las filas son anclas y `:target` abre el
     detalle. Lo que añade el script es no recargar, que el nombre viaje hasta
     el titular, y la paleta de comandos. */
  const escena = document.querySelector<HTMLElement>('.escena')!;
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* A partir de aquí manda `data-vista`, y `:target` se aparta.
   *
   * POR QUÉ HACE FALTA ESTA MARCA. Las dos vías de abrir el detalle no se
   * hablaban: el CSS lo abre con `:target` y el script con `.activa` +
   * `history.replaceState`, y **`replaceState` no actualiza `:target`**. Quien
   * entraba por un enlace compartido con almohadilla —`…/#algebra`— dejaba esa
   * sección abierta por `:target` para siempre: pulsar «Cálculo» añadía la
   * suya encima y se veían **las dos**, con Álgebra tapando a Cálculo por ir
   * antes en el DOM. Ni «← todas» la cerraba. Solo lo arreglaba recargar.
   *
   * Lo encontró la auditoría externa del 4 de septiembre de 2026, y no lo
   * había visto nadie porque **desde la portada sin hash todo funciona**: hay
   * que llegar por un enlace con ancla, que es justo como llega el alumno
   * nuevo al que se lo pasan por WhatsApp.
   *
   * La marca es necesaria y no basta con `data-vista`: ese atributo viene YA
   * en el HTML servido —`data-vista="lista"`—, así que una regla que solo
   * mirara a él se aplicaría también sin JavaScript y rompería el respaldo de
   * `:target`, que es el que hace que la portada funcione sin scripts (§11).
   * `data-js` solo existe cuando el script ha tomado el control. */
  escena.dataset.js = '';

  /* ── abrir y cerrar el detalle ─────────────────────────────────── */
  const detalles = new Map<string, HTMLElement>(
    [...document.querySelectorAll<HTMLElement>('.detalle')].map((s) => [s.id, s]),
  );

  function abre(id: string, origen: HTMLElement | null) {
    const seccion = detalles.get(id);
    if (!seccion) return;

    for (const s of detalles.values()) s.classList.toggle('activa', s === seccion);
    escena.dataset.vista = 'detalle';

    // El acento de la asignatura sube al documento: manda mientras dure la
    // vista, y solo en el marco (§06).
    document.documentElement.style.setProperty('--acento', seccion.style.getPropertyValue('--acento'));

    viaja(origen, seccion.querySelector<HTMLElement>('[data-destino]'));
    window.scrollTo({ top: 0, behavior: reducido ? 'auto' : 'smooth' });
    seccion.querySelector<HTMLElement>('[data-destino]')?.focus({ preventScroll: true });
  }

  function cierra() {
    for (const s of detalles.values()) s.classList.remove('activa');
    escena.dataset.vista = 'lista';
    document.documentElement.style.removeProperty('--acento');
  }

  /** FLIP: se mide dónde estaba, se invierte y se anima hasta donde está.
   *  Sin esto el titular aparecería de la nada y el alumno perdería el hilo. */
  function viaja(desde: HTMLElement | null, hasta: HTMLElement | null) {
    if (reducido || !desde || !hasta) return;
    const a = desde.getBoundingClientRect();
    const b = hasta.getBoundingClientRect();
    if (!a.width || !b.width) return;
    hasta.animate(
      [
        {
          transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.height / b.height})`,
          opacity: 0.75,
        },
        { transform: 'none', opacity: 1 },
      ],
      { duration: 560, easing: 'cubic-bezier(.22,.61,.36,1)' },
    );
  }

  /** Vuelve a lanzar la animación de la regla aunque ya se hubiera reproducido. */
  function reinicia(el: HTMLElement | null) {
    if (!el) return;
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
  }

  for (const fila of document.querySelectorAll<HTMLAnchorElement>('[data-fila]')) {
    fila.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${fila.dataset.fila}`);
      abre(fila.dataset.fila!, fila.querySelector<HTMLElement>('[data-nombre]'));
    });
  }

  for (const chip of document.querySelectorAll<HTMLAnchorElement>('.chip, .volver')) {
    chip.addEventListener('click', (e) => {
      const destino = chip.getAttribute('href') ?? '';
      if (!destino.startsWith('#')) return;
      e.preventDefault();
      if (destino === '#principal') {
        history.replaceState(null, '', location.pathname);
        cierra();
      } else {
        history.replaceState(null, '', destino);
        abre(destino.slice(1), null);
      }
    });
  }

  // Entrar con el enlace ya puesto (o recargar) tiene que dejar la misma vista.
  // Un ancla interior del detalle (#calculo-rutas) abre su asignatura.
  if (location.hash.length > 1) {
    const id = location.hash.slice(1);
    abre(detalles.has(id) ? id : id.replace(/-rutas$/, ''), null);

    /* Y hay que volver a subir cuando la página se ha asentado. El `scrollTo`
       de `abre()` compite con el salto al ancla que hace el propio navegador
       —y con el reflujo de las tipografías—, y quien llegaba por `…/#calculo`
       se quedaba 69 px más abajo: justo lo que mide la barra de asignaturas,
       que quedaba escondida bajo la cabecera pegajosa **con el «← todas»
       dentro**. Medido el 5 de septiembre de 2026; se ve entrando por el
       enlace con almohadilla, nunca desde la portada (§16 punto 6). */
    const arriba = () => window.scrollTo({ top: 0, behavior: 'auto' });
    if (document.fonts?.ready) document.fonts.ready.then(arriba);
    window.addEventListener('load', arriba, { once: true });
  }

  /* Y si el ancla cambia sin recargar, la vista tiene que seguirla.
     No lo disparan los chips —esos usan `replaceState`, que no emite
     `hashchange`— sino el caso que se le escapaba a la página: llegar a
     `…/#calculo` y escribir `…/#fluidos` en la barra de direcciones, o
     cualquier enlace externo que solo cambie la almohadilla. El navegador no
     recarga y hasta hoy no pasaba nada. */
  window.addEventListener('hashchange', () => {
    const id = location.hash.slice(1);
    if (!id) return cierra();
    abre(detalles.has(id) ? id : id.replace(/-rutas$/, ''), null);
  });

  /* ── la figura tocable ─────────────────────────────────────────────
     Un punto amarillo arrastrable por la curva; la tangente le sigue.
     El movimiento es bajo demanda (brief Pizarra): nada se mueve solo.
     Con reduced-motion la curva aparece ya dibujada y el punto queda
     quieto — pero sigue siendo arrastrable. */
  {
    const svg = document.querySelector<SVGSVGElement>('[data-figura-tiza]');
    const path = document.querySelector<SVGPathElement>('#curva-piz');
    const punto = document.querySelector<SVGCircleElement>('#punto-piz');
    const tang = document.querySelector<SVGLineElement>('#tang-piz');
    if (svg && path && punto && tang) {
      const L = path.getTotalLength();
      let s = L * 0.44;
      let arrastra = false;

      const pinta = () => {
        const p = path.getPointAtLength(s);
        const a = path.getPointAtLength(Math.max(0, s - 2));
        const b = path.getPointAtLength(Math.min(L, s + 2));
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const n = Math.hypot(dx, dy) || 1;
        const ux = dx / n;
        const uy = dy / n;
        const e = 52;
        punto.setAttribute('cx', String(p.x));
        punto.setAttribute('cy', String(p.y));
        tang.setAttribute('x1', String(p.x - ux * e));
        tang.setAttribute('y1', String(p.y - uy * e));
        tang.setAttribute('x2', String(p.x + ux * e));
        tang.setAttribute('y2', String(p.y + uy * e));
        tang.setAttribute('opacity', '0.9');
      };

      const acerca = (ev: PointerEvent) => {
        const m = svg.getScreenCTM();
        if (!m) return;
        const c = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
        let mejor = s;
        let md = Infinity;
        for (let i = 0; i <= 90; i++) {
          const q = path.getPointAtLength((L * i) / 90);
          const d = (q.x - c.x) * (q.x - c.x) + (q.y - c.y) * (q.y - c.y);
          if (d < md) {
            md = d;
            mejor = (L * i) / 90;
          }
        }
        s = mejor;
        pinta();
      };

      svg.addEventListener('pointerdown', (ev) => {
        arrastra = true;
        svg.setPointerCapture(ev.pointerId);
        acerca(ev);
      });
      svg.addEventListener('pointermove', (ev) => {
        if (arrastra) acerca(ev);
      });
      svg.addEventListener('pointerup', () => {
        arrastra = false;
      });

      /* La tangente aparece cuando la curva ha terminado de dibujarse;
         si no hay animación, ahora mismo. */
      setTimeout(pinta, reducido ? 0 : 2100);
    }
  }

  /* ── paleta de comandos ────────────────────────────────────────── */
  type Entrada = {
    tipo: 'a' | 't';
    nombre: string;
    sub: string;
    clave: string;
    destino: string;
    n?: number;
  };

  const paleta = document.querySelector<HTMLElement>('[data-paleta]')!;
  const campo = document.querySelector<HTMLInputElement>('#q')!;
  const panel = document.querySelector<HTMLElement>('[data-res]')!;
  const indice: Entrada[] = JSON.parse(
    document.querySelector<HTMLElement>('[data-indice]')?.textContent ?? '[]',
  );

  let visibles: Entrada[] = [];
  let cursor = 0;
  let ultimoFoco: HTMLElement | null = null;

  /* El CSS de esta página tiene ámbito de Astro: solo viste a los elementos
     que llevan el atributo data-astro-cid-*. Los nodos que crea este script
     nacen sin él y saldrían en crudo — se les estampa el de la paleta. */
  const ambito = paleta.getAttributeNames().find((n) => n.startsWith('data-astro-cid'));
  function conAmbito<T extends HTMLElement>(el: T): T {
    if (ambito) {
      el.setAttribute(ambito, '');
      for (const hijo of el.querySelectorAll('*')) hijo.setAttribute(ambito, '');
    }
    return el;
  }

  function pinta() {
    const q = campo.value.trim().toLowerCase();
    visibles = q ? indice.filter((x) => x.clave.includes(q)).slice(0, 12) : indice.filter((x) => x.tipo === 'a');
    panel.textContent = '';

    if (!visibles.length) {
      const p = document.createElement('p');
      p.className = 'nada';
      p.textContent = `Nada con «${campo.value}». Prueba con el número del tema o con una palabra del enunciado.`;
      panel.appendChild(conAmbito(p));
      return;
    }

    if (cursor >= visibles.length) cursor = 0;
    let grupo = '';

    visibles.forEach((x, j) => {
      const cual =
        x.tipo === 'a' ? 'Asignaturas' : x.tipo === 'r' ? 'Rutas de estudio' : 'Temas';
      if (cual !== grupo) {
        grupo = cual;
        const t = document.createElement('p');
        t.className = 'rotulo grp';
        t.textContent = cual;
        panel.appendChild(conAmbito(t));
      }

      const b = document.createElement('button');
      b.type = 'button';
      b.className = j === cursor ? 'hit cur' : 'hit';
      b.innerHTML =
        `<span class="k"></span><span class="nb"></span><span class="sb"></span>`;
      /* La insignia: `##` para una asignatura, `→` para una ruta y el número
         del tema para todo lo demás. Sin la rama de `r` saldría `TUndefined`,
         porque una ruta no tiene `n`. */
      b.querySelector('.k')!.textContent =
        x.tipo === 'a' ? '##' : x.tipo === 'r' ? '→' : `T${String(x.n).padStart(2, '0')}`;
      b.querySelector('.nb')!.textContent = x.nombre;
      b.querySelector('.sb')!.textContent = x.sub;
      b.addEventListener('mouseenter', () => {
        cursor = j;
        pinta();
      });
      b.addEventListener('click', () => ve(x));
      panel.appendChild(conAmbito(b));
    });
  }

  function ve(x: Entrada) {
    cierraPaleta();
    if (x.destino.startsWith('#')) {
      history.replaceState(null, '', x.destino);
      abre(x.destino.slice(1), null);
    } else {
      location.href = x.destino;
    }
  }

  function abrePaleta() {
    ultimoFoco = document.activeElement as HTMLElement;
    paleta.hidden = false;
    campo.value = '';
    cursor = 0;
    pinta();
    campo.focus();
  }

  function cierraPaleta() {
    paleta.hidden = true;
    ultimoFoco?.focus();
  }

  document.querySelector('[data-abre-paleta]')?.addEventListener('click', abrePaleta);
  campo.addEventListener('input', () => {
    cursor = 0;
    pinta();
  });
  paleta.addEventListener('click', (e) => {
    if (e.target === paleta) cierraPaleta();
  });

  document.addEventListener('keydown', (e) => {
    if (paleta.hidden) {
      const enCampo = ['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName);
      if (e.key === '/' && !enCampo) {
        e.preventDefault();
        abrePaleta();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        abrePaleta();
      } else if (e.key === 'Escape' && escena.dataset.vista === 'detalle') {
        history.replaceState(null, '', location.pathname);
        cierra();
      }
      return;
    }

    if (e.key === 'Escape') {
      cierraPaleta();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      cursor = (cursor + 1) % visibles.length;
      pinta();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      cursor = (cursor - 1 + visibles.length) % visibles.length;
      pinta();
    } else if (e.key === 'Enter' && visibles[cursor]) {
      e.preventDefault();
      ve(visibles[cursor]);
    }
  });
</script>

<style>
  /* ── escena ──────────────────────────────────────────────────────
     Dos vistas en la misma página. Con JavaScript manda `data-vista`;
     sin él manda `:target`, y por eso las dos condiciones van juntas.

     La página ENTERA es pizarra (brief Pizarra): el fondo vive en el body
     y una capa fija lleva el gradiente, el polvo de tiza y la viñeta. El
     detalle B se recolorea remapeando los tokens neutros a tiza — una
     regla, no doscientas. */
  :global(body) { background: var(--piz-medio); }

  .escena {
    position: relative;
    --pad: clamp(1rem, 4vw, 3rem);
    padding: 0 var(--pad);
  }

  /* El remapeo vive SOLO en las superficies de pizarra: el héroe y la
     banda del detalle. Desde el brief §5b el cuerpo del detalle es papel,
     así que remapear la escena entera pintaría tiza sobre claro.
     El `color` hay que REDECLARARLO: el body lo calcula con la tinta y
     los hijos heredan el valor calculado, no la variable — sin esa línea
     todo lo que no declara color sale oscuro sobre la pizarra. */
  .hero,
  .banda {
    color: var(--ink);
    --ink: var(--tiza);
    --graphite: var(--tiza-suave);
    --faint: var(--tiza-apagada);
    --rule: var(--tiza-raya);
    --grid: var(--tiza-velo);
    --panel: var(--tiza-panel);
    --live: var(--tiza-amarilla);
    --live-soft: var(--tiza-velo);
    --flag: var(--tiza-flag);
    --flag-soft: var(--tiza-velo);
    --alt: var(--tiza-menta);
    --alt-soft: var(--tiza-velo);
  }

  .escena::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(var(--tiza-polvo-2) 1px, transparent 1px) 5px 7px / 13px 15px,
      var(--pizarra);
    box-shadow: var(--piz-vineta);
  }

  /* Los acentos oscuros de asignatura no se leen sobre pizarra: dentro de
     las superficies de tiza el acento es siempre la amarilla. `!important`
     porque el valor original va en el atributo style de la sección. */
  .escena .banda,
  .escena .fila { --acento: var(--tiza-amarilla) !important; }

  /* La barra pizarra vive en base.css desde la fase 2 (es de todo el
     sitio). Aquí solo lo propio de la portada: la escuela como apunte
     de tiza al lado del wordmark, en vez del rótulo mono de las migas. */
  :global(.top .crumb) {
    font-family: var(--mano);
    font-size: 1.05rem;
    text-transform: none;
    letter-spacing: 0;
  }

  /* El conmutador de tema hereda ya el estilo de tiza de base.css. */

  /* ── A · la pizarra ────────────────────────────────────────────── */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 4rem);
    transition: opacity .32s var(--ease), transform .42s var(--ease);
  }

  .mano { font-family: var(--mano); }

  .heroe {
    display: flex;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-top: clamp(1.2rem, 4vh, 2.8rem);
  }

  .mensaje { max-width: 40rem; }

  .titular {
    font-size: clamp(2rem, 4.9vw, 3.65rem); /* remate §6c: la escala del tablero */
    font-weight: 800;
    letter-spacing: -.015em;
    line-height: 1.12;
    color: var(--tiza);
    margin: 0 0 1.1rem;
  }

  .frase-tiza {
    font-family: var(--mano);
    font-weight: 700;
    font-size: 1.15em;
    color: var(--tiza-amarilla);
    position: relative;
    white-space: nowrap;
  }

  .sub { position: absolute; left: 0; bottom: -8px; width: 100%; }
  .traza-sub { stroke: var(--tiza-amarilla); opacity: .9; }

  .entradilla {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--tiza-suave);
    max-width: 33rem;
    margin: 0 0 1.5rem;
  }

  .ctas { display: flex; flex-wrap: wrap; gap: .65rem; margin: 0; }

  .cta {
    font-size: .95rem;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    transition: background .15s, border-color .15s;
  }

  .cta.llena {
    color: var(--piz-medio);
    background: var(--tiza-amarilla);
    padding: .8rem 1.4rem;
    box-shadow: var(--piz-sombra-cta);
  }

  .cta.llena:hover { background: var(--tiza-amarilla-hover); }

  .cta.borde {
    color: var(--tiza);
    border: 1.5px solid var(--tiza-borde);
    padding: .72rem 1.3rem;
  }

  .cta.borde:hover, .cta.borde:focus-visible { border-color: var(--tiza); }

  .gratis { font-size: 1.2rem; color: var(--tiza-apagada); margin: .9rem 0 0; }

  /* ── la figura tocable ─────────────────────────────────────────── */
  .figura {
    user-select: none; /* remate §6c: arrastrar el punto seleccionaba el texto */
    -webkit-user-select: none;
    margin-left: auto;
    flex: 0 1 400px;
    min-width: 250px;
  }

  .figura svg {
    display: block;
    width: 100%;
    height: auto;
    cursor: grab;
    touch-action: none;
  }

  .figura svg:active { cursor: grabbing; }
  .eje { stroke: var(--tiza-borde); stroke-width: 2; }
  .traza-curva { stroke: var(--tiza); }
  .tangente { stroke: var(--tiza-amarilla); }
  .punto-tiza { fill: var(--tiza-amarilla); }
  .nota { font-size: 21px; fill: var(--tiza-suave); }

  /* ── el temario ────────────────────────────────────────────────── */
  .temario {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 4rem);
    padding: 1.8rem 0 2.4rem;
    /* remate §6c: el hueco entre listas y repisa se reparte centrado en
       vez de quedarse como banda vacía debajo */
    flex: 1;
    align-content: center;
  }

  .curso-h {
    font-size: 1.5rem;
    color: var(--tiza-amarilla);
    margin: 0 0 .2rem;
  }

  .fila {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: .55rem .35rem;
    border-bottom: 1px dashed var(--tiza-raya);
    text-decoration: none;
    border-radius: 6px;
    transition: background .15s;
  }

  .columna .fila:last-child { border-bottom-color: transparent; }
  .fila:hover, .fila:focus-visible { background: var(--tiza-velo); }

  .fila .pn { font-size: 1.25rem; color: var(--tiza-amarilla); min-width: 2.1rem; }

  /* El nombre es el objeto que viaja al titular del detalle (FLIP). */
  .fila .nm {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: .01em;
    color: var(--tiza);
  }

  .fila.prev .nm { font-weight: 400; color: var(--tiza-apagada); }

  .fila .ps {
    margin-left: auto;
    font-size: 1.1rem;
    color: var(--tiza-apagada);
    text-align: right;
  }

  .fila .ps.ok { color: var(--tiza-menta); }
  .fila .ps.obra { color: var(--tiza-amarilla); }

  /* ── la repisa ─────────────────────────────────────────────────── */
  .repisa {
    margin: auto calc(-1 * clamp(1rem, 4vw, 3rem)) 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: .5rem clamp(1rem, 4vw, 3rem);
    background: var(--repisa);
    box-shadow: var(--repisa-sombra);
  }

  .tiza-barra { height: 12px; border-radius: 3px; box-shadow: var(--shadow-1); flex: 0 0 auto; }
  .t-blanca { width: 72px; background: var(--tiza); }
  .t-amarilla { width: 44px; background: var(--tiza-amarilla); }
  .t-menta { width: 30px; background: var(--tiza-menta); }
  .lema { margin-left: auto; font-size: .78rem; color: var(--tiza-suave); text-align: right; }

  /* ── el movimiento se ve UNA vez, y solo si el sistema lo permite ──
     El estado por defecto es «ya dibujado»: con reduced-motion no hay
     animación que correr y nada se queda invisible (§17: un forwards
     apagado deja el elemento en su estado inicial). */
  @media (prefers-reduced-motion: no-preference) {
    .apar { opacity: 0; animation: apar .8s var(--ease) forwards; }
    .entradilla.apar { animation-delay: .2s; }
    .ctas.apar { animation-delay: .35s; }
    .gratis.apar { animation-delay: .5s; }

    .traza-curva {
      stroke-dasharray: 560;
      stroke-dashoffset: 560;
      animation: traza 1.6s ease-out .4s forwards;
    }

    .traza-sub {
      stroke-dasharray: 320;
      stroke-dashoffset: 320;
      animation: traza 1.1s ease-out 1.1s forwards;
    }
  }

  @keyframes apar {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes traza { to { stroke-dashoffset: 0; } }

  /* ── B · detalle (brief §5b) ─────────────────────────────────────
     Banda de pizarra con la identidad; el cuerpo, en papel. La sección
     sangra hacia fuera del padding de la escena para que las dos
     superficies lleguen al borde, y cada franja repone el padding. */
  .detalle {
    display: none;
    margin: 0 calc(-1 * var(--pad));
    min-height: 100vh;
    background: var(--paper);
    padding-bottom: 4rem;
    animation: entra-vista .38s var(--ease) both;
  }

  /* `:has(:target)` cubre el ancla interior (#calculo-rutas): sin
     JavaScript, pulsar el CTA de la banda no puede cerrar el detalle. */
  .detalle:target,
  .detalle:has(:target),
  .detalle.activa { display: block; }

  /* Con JavaScript, `data-vista` manda y `:target` se aparta.
     Sin `data-js` —o sea, sin script— estas dos reglas no existen y sigue
     mandando `:target` sola, que es el respaldo documentado arriba.
     Ver el comentario largo del script, donde está el fallo que las trajo. */
  .escena[data-js][data-vista='lista'] .detalle:target,
  .escena[data-js][data-vista='lista'] .detalle:has(:target) { display: none; }
  .escena[data-js][data-vista='detalle'] .detalle:not(.activa) { display: none; }

  .banda {
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(ellipse at 25% 15%, var(--piz-claro), var(--piz-medio) 65%);
    box-shadow: var(--piz-vineta-banda);
    padding: 0 var(--pad) 1.6rem;
  }

  .b-cuerpo {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    padding-top: 1.3rem;
  }

  .b-kicker {
    font-size: 1.25rem;
    color: var(--tiza-amarilla);
    margin: 0 0 .1rem;
  }

  .b-desc {
    font-size: .93rem;
    line-height: 1.5;
    color: var(--tiza-suave);
    max-width: 36rem;
    margin: .5rem 0 0;
  }

  .b-der {
    margin-left: auto;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .65rem;
  }

  .b-meta { font-size: 1.2rem; color: var(--tiza-apagada); margin: 0; }

  .b-cta {
    display: inline-block;
    font-size: .9rem;
    font-weight: 700;
    color: var(--piz-medio);
    background: var(--tiza-amarilla);
    border-radius: 10px;
    padding: .65rem 1.15rem;
    box-shadow: var(--piz-sombra-cta);
    text-decoration: none;
    transition: background .2s, transform .15s;
  }

  .b-cta:hover { background: var(--tiza-amarilla-hover); transform: translateY(-1px); }

  /* Con JavaScript la clase manda; sin él, el ancla. En los dos casos la
     lista se retira en vez de quedarse debajo empujando.

     El `:not([data-js])` es la misma corrección que arriba y hace falta por el
     mismo motivo: `history.replaceState` no actualiza `:target`, así que al
     volver a la lista desde una entrada con almohadilla el `:has(:target)`
     seguía siendo cierto y **el héroe entero —el temario, las nueve
     asignaturas— quedaba oculto**. Pulsar «← todas» dejaba la portada en
     blanco. Salió al reproducir el fallo de la auditoría paso a paso; el
     informe señalaba el detalle y esto es su hermano. */
  .escena[data-vista='detalle'] .hero,
  .escena:not([data-js]):has(.detalle:target) .hero,
  .escena:not([data-js]):has(.detalle :target) .hero {
    display: none;
  }

  @keyframes entra-vista {
    from { opacity: 0; transform: translateY(1.2rem); }
    to { opacity: 1; transform: none; }
  }

  /* La barra de asignaturas. Son NUEVE, y midiéndolas resultó que solo caben
     enteras a partir de 1500 px: a 1280 se veían 7, a 768 cuatro y a 360 dos
     —de nueve—. Y el carril lleva la barra de desplazamiento oculta a
     propósito, así que no había **ninguna** pista de que hubiera más: la
     novena asignatura era invisible e indescubrible. Medido el 5 de septiembre
     de 2026 barriendo la portada a cuatro anchos, después de que la auditoría
     externa enseñara a mirar por donde uno no suele entrar (§16 punto 6).

     Dos remedios, según quepan o no:
     - de 1000 px para arriba **se envuelven**: dos filas de pastillas y las
       nueve a la vista, que es mejor que un desplazamiento escondido;
     - por debajo sigue siendo carril —envolver nueve en un móvil se comería
       cinco líneas— pero ahora se ve que sigue: un velo en cada borde,
       enganchado al contenido con `local`, que aparece solo cuando queda algo
       por ese lado y se apaga al llegar al final. Es CSS puro, así que
       funciona igual sin JavaScript. */
  .chips {
    display: flex;
    gap: .3rem;
    overflow-x: auto;
    padding: .55rem 0 .8rem;
    border-bottom: 1px solid var(--rule);
    scrollbar-width: none;
    /* El carril vive sobre la banda de pizarra, no sobre papel: los dos velos
       de arriba tienen que ser del color de la banda —`--piz-medio`, que es
       el mismo en los dos temas (§06)— o se publican dos barras claras en los
       bordes. Se vio mirando la captura, no midiendo. */
    background:
      linear-gradient(to right, var(--piz-medio), transparent) 0 0 / 1.6rem 100% no-repeat,
      linear-gradient(to left, var(--piz-medio), transparent) 100% 0 / 1.6rem 100% no-repeat,
      linear-gradient(to right, var(--piz-oscuro), transparent) 0 0 / 1.4rem 100% no-repeat local,
      linear-gradient(to left, var(--piz-oscuro), transparent) 100% 0 / 1.4rem 100% no-repeat local;
  }

  .chips::-webkit-scrollbar { display: none; }

  @media (min-width: 1000px) {
    .chips {
      flex-wrap: wrap;
      overflow-x: visible;
      background: none;
    }
  }

  .chip,
  .volver {
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    white-space: nowrap;
    padding: .3rem .65rem;
    border-radius: 99px;
    text-decoration: none;
    transition: color .2s, background .2s;
  }

  .chip:hover { color: var(--ink); background: var(--grid); }
  .chip.act { color: var(--acento); background: var(--live-soft); font-weight: 600; }
  .volver { padding-left: 0; }
  .volver:hover { color: var(--acento); }

  .nombre {
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1;
    font-size: clamp(2.1rem, 5.4vw, 3.2rem);
    color: var(--tiza);
    transform-origin: left top;
  }

  .aviso {
    font-size: .8rem;
    color: var(--flag);
    background: var(--flag-soft);
    border-left: 2px solid var(--flag);
    padding: .4rem .7rem;
    margin: 1rem var(--pad) 0;
    max-width: 62rem;
  }

  /* ── el cuerpo: temario a la izquierda, carril a la derecha ────── */
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 25rem);
    gap: clamp(1.4rem, 3vw, 2.75rem);
    align-items: start;
    padding: 1.4rem var(--pad) 0;
  }

  .t-rotulo { color: var(--faint); margin-bottom: .5rem; }

  .temas { list-style: none; }

  .temas li { animation: entra-fila .4s var(--ease) both; animation-delay: calc(var(--i) * 32ms); }

  @keyframes entra-fila {
    from { opacity: 0; transform: translateY(9px); }
    to { opacity: 1; transform: none; }
  }

  .tema {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    gap: .9rem;
    align-items: center;
    padding: .62rem .65rem;
    border-bottom: 1px solid var(--rule);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background .15s, box-shadow .15s;
  }

  a.tema:hover,
  a.tema:focus-visible {
    background: var(--panel);
    box-shadow: var(--shadow-1);
  }

  .tema[aria-disabled='true'] { opacity: .6; }

  /* Un tema del que no hay nada que escribir no está «a medias»: está cerrado
     así a propósito. Se distingue del que aún no se ha escrito por el número
     apagado y la etiqueta, no por estar más gris — apagarlo más lo haría
     parecer más pendiente, que es justo lo contrario. */
  .tema[data-solo-clase] { opacity: 1; }
  .tema[data-solo-clase] .tn { color: var(--faint); }
  .tema[data-solo-clase] .t-tit { font-weight: 500; color: var(--graphite); }

  /* El motivo, leído y no adivinado. Va sangrado a la altura del título —la
     rejilla de `.tema` reserva la primera columna para el número— y con la
     regla lateral que este sitio usa para «esto es una nota al margen, no
     contenido principal». */
  .solo-clase {
    margin: -.15rem 0 .55rem 2.9rem;
    padding-left: .7rem;
    border-left: 2px solid var(--rule);
    font-size: .74rem;
    line-height: 1.55;
    color: var(--faint);
    max-width: 62ch;
  }

  .tn { font-size: 1.2rem; color: var(--live); text-align: right; line-height: 1; }

  .t-tit { font-size: .97rem; font-weight: 700; line-height: 1.25; }

  .t-der { display: flex; align-items: center; gap: .6rem; }

  .t-sim { font-size: 1rem; color: var(--live); }

  /* La fila del tema no cabe en tres columnas cuando su hueco se estrecha.
     Diecinueve de los cuarenta y cuatro temas llevan etiqueta y alguna mide
     42 caracteres; con la tercera columna en `auto`, el título se quedaba con
     sitio para cinco letras, se partía en tres líneas y la etiqueta en Caveat
     acababa pintada por encima.

     No lo cazaba nada, y por dos motivos que conviene tener juntos. Uno: las
     dos cajas no llegan a cruzarse —el título rodea a la etiqueta—, así que
     un guardián de solapes da verde y lo que se ve es ilegible. Y dos: **no
     depende del ancho de la ventana**. La primera versión de este arreglo era
     un `@media (max-width: 560px)` y dejaba el peor caso de todos sin tocar:
     a 960 px entra el carril lateral, la columna del temario se estrecha de
     golpe y el título caía a **52 px y cinco líneas**, peor que en un móvil.
     Medido a diez anchos el 5 de septiembre de 2026: 360 y 420 bien, 600 mal,
     880 bien, 960 el peor, 1120 regular, 1280 bien. Un punto de corte por
     ventana no puede describir eso.

     Lo que manda es el hueco real, así que se mide el contenedor. Por debajo
     de 46rem la etiqueta y el peso bajan a su propia línea. El umbral se midió,
     no se eligió: con tres columnas el título no llega a 300 px cómodos por
     debajo de ahí. */
  .temas {
    container-type: inline-size;
    container-name: temario;
  }

  @container temario (max-width: 46rem) {
    .tema {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      gap: .35rem .9rem;
      align-items: start;
    }

    .t-der {
      grid-column: 2;
      flex-wrap: wrap;
      gap: .3rem .6rem;
    }

    .t-sim { font-size: .95rem; line-height: 1.2; }
  }

  /* Las tres pastillas: el rojo SOLO en «alto» (§5b). */
  .pesop {
    font-family: var(--mono);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    border-radius: 99px;
    padding: .22rem .7rem;
    white-space: nowrap;
  }

  .pesop.alto { color: var(--panel); background: var(--flag); }
  .pesop.medio { color: var(--peso-medio-tinta); background: var(--peso-medio-fondo); }
  .pesop.bajo { color: var(--faint); background: var(--peso-bajo-fondo); }

  /* ── el carril derecho ─────────────────────────────────────────── */
  .carril {
    position: sticky;
    top: 4.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: entra-fila .4s var(--ease) both;
    animation-delay: 160ms;
  }

  /* la caja de pizarra: las rutas son la puerta de estudio */
  .rc {
    background:
      radial-gradient(var(--tiza-polvo-1) 1px, transparent 1px) 0 0 / 7px 9px,
      radial-gradient(ellipse at 30% 20%, var(--piz-claro), var(--piz-medio) 75%);
    border-radius: 12px;
    padding: 1rem 1.15rem .9rem;
    box-shadow: var(--piz-vineta-caja), var(--shadow-1);
    scroll-margin-top: 5rem;
  }

  .rc-tit { font-size: 1.5rem; color: var(--tiza-amarilla); margin: 0 0 .1rem; }

  .rc-sub {
    font-size: .8rem;
    line-height: 1.5;
    color: var(--tiza-suave);
    margin: 0 0 .8rem;
  }

  .rc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .4rem;
  }

  .rc-btn {
    font-size: .78rem;
    font-weight: 700;
    color: var(--tiza);
    border: 1.5px solid var(--tiza-borde);
    border-radius: 8px;
    padding: .42rem .5rem;
    text-align: center;
    text-decoration: none;
    transition: background .15s, color .15s, border-color .15s;
  }

  .rc-btn:hover { background: var(--tiza-velo); border-color: var(--tiza); }

  .rc-btn.dest {
    color: var(--piz-medio);
    background: var(--tiza-amarilla);
    border-color: var(--tiza-amarilla);
  }

  .rc-btn.dest:hover { background: var(--tiza-amarilla-hover); }

  /* la única impar (extraordinaria) ocupa la fila entera */
  .rc-btn:last-child:nth-child(odd) { grid-column: span 2; }

  /* ── la tarjeta de exámenes, en papel ──────────────────────────── */
  /* ── cómo se puntúa ─────────────────────────────────────────────
     Mismo molde que la caja de exámenes: es una tarjeta del carril, no una
     pieza nueva. El peso va en mono y a la izquierda porque es un número que
     se compara de un vistazo entre modalidades. */
  .nota-caja {
    background: var(--panel);
    border: 1.5px solid var(--rule);
    border-radius: 12px;
    padding: 1rem 1.15rem .9rem;
    box-shadow: var(--shadow-1);
    margin-bottom: 1.1rem;
  }

  .nc-tit { color: var(--live); margin-bottom: .6rem; }

  .nc-mod + .nc-mod {
    margin-top: .85rem;
    padding-top: .85rem;
    border-top: 1px solid var(--rule);
  }

  .nc-nombre {
    font-size: .84rem;
    font-weight: 700;
    margin-bottom: .4rem;
  }

  .nc-partes { list-style: none; margin: 0; padding: 0; }

  .nc-partes li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: .5rem;
    align-items: baseline;
    font-size: .8rem;
    line-height: 1.45;
    margin-bottom: .25rem;
  }

  .nc-peso {
    font-family: var(--mono);
    font-size: .78rem;
    font-weight: 700;
    color: var(--ink);
    text-align: right;
  }

  .nc-que { color: var(--graphite); }

  .nc-nota {
    font-size: .76rem;
    line-height: 1.5;
    color: var(--graphite);
    margin-top: .5rem;
    padding-left: .6rem;
    border-left: 2px solid var(--flag);
  }

  .nc-fuente {
    font-family: var(--mono);
    font-size: .64rem;
    line-height: 1.5;
    color: var(--faint);
    margin-top: .8rem;
    padding-top: .6rem;
    border-top: 1px solid var(--rule);
  }

  .ex-caja {
    background: var(--panel);
    border: 1.5px solid var(--rule);
    border-radius: 12px;
    padding: 1rem 1.15rem .9rem;
    box-shadow: var(--shadow-1);
  }

  .ex-tit { color: var(--live); margin-bottom: .35rem; }

  .ex-sub {
    font-size: .78rem;
    line-height: 1.5;
    color: var(--graphite);
    margin-bottom: .7rem;
  }

  .ex-lista { list-style: none; }

  .ex-lista a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .5rem;
    padding: .35rem .5rem;
    border-radius: 6px;
    font-family: var(--mono);
    font-size: .8rem;
    color: var(--ink);
    text-decoration: none;
    transition: background .15s, color .15s;
  }

  .ex-lista li:first-child a { background: var(--grid); }

  .ex-lista a:hover { background: var(--live-soft); color: var(--live); }

  .ex-conv { margin-left: auto; margin-right: .4rem; color: var(--faint); font-size: .72rem; }

  .ex-go { color: var(--faint); transition: transform .15s; }
  .ex-lista a:hover .ex-go { color: var(--live); transform: translateX(2px); }

  .ex-todos {
    display: inline-block;
    margin-top: .6rem;
    padding: .3rem .5rem;
    font-size: .8rem;
    font-weight: 700;
    color: var(--live);
    text-decoration: none;
  }

  .ex-todos:hover { color: var(--live-hover); text-decoration: underline; }

  /* la leyenda del rojo, como apunte al margen */
  .nota-rojo {
    font-size: 1.05rem;
    color: var(--faint);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; }
    .carril { position: static; }
    .b-der { margin-left: 0; text-align: left; align-items: flex-start; }
  }

  .pendiente { padding: 2.6rem var(--pad); max-width: 60ch; }
  .pendiente .p-tit {
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 500;
    margin-bottom: .5rem;
  }
  .pendiente p { color: var(--graphite); font-size: .95rem; }

  /* ── paleta de comandos ────────────────────────────────────────── */
  .mini {
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 99px;
    padding: .3rem .7rem;
    display: flex;
    align-items: center;
    gap: .45rem;
    cursor: pointer;
    transition: border-color .2s, color .2s;
  }

  .mini:hover { border-color: var(--live); color: var(--live); }
  .mini kbd { font-family: var(--mono); font-size: .66rem; opacity: .7; }

  .paleta {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 1rem 1rem;
    background: color-mix(in srgb, var(--ink) 26%, transparent);
    backdrop-filter: blur(3px);
    animation: aparece .18s ease both;
  }

  @keyframes aparece { from { opacity: 0; } to { opacity: 1; } }

  .caja {
    width: min(38rem, 100%);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-2);
    animation: sube .26s var(--ease) both;
  }

  @keyframes sube {
    from { opacity: 0; transform: translateY(-10px) scale(.985); }
    to { opacity: 1; transform: none; }
  }

  .caja input {
    width: 100%;
    font-family: var(--body);
    font-size: 1.05rem;
    padding: 1rem 1.15rem;
    border: none;
    border-bottom: 1px solid var(--rule);
    background: none;
    color: var(--ink);
  }

  .caja input::placeholder { color: var(--faint); }

  .res { max-height: min(52vh, 26rem); overflow-y: auto; padding: .4rem; }
  .res .grp { padding: .6rem .8rem .3rem; font-size: .62rem; }

  .hit {
    display: flex;
    align-items: center;
    gap: .7rem;
    width: 100%;
    text-align: left;
    padding: .55rem .8rem;
    border: none;
    border-radius: 6px;
    background: none;
    color: inherit;
    font-family: var(--body);
    font-size: .92rem;
    cursor: pointer;
  }

  .hit .k { font-family: var(--mono); font-size: .66rem; color: var(--faint); flex: 0 0 auto; }
  .hit .nb { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hit .sb {
    margin-left: auto;
    font-family: var(--mono);
    font-size: .66rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .hit.cur { background: var(--live-soft); }
  .hit.cur .sb { color: var(--live); }

  .pie {
    display: flex;
    gap: 1.1rem;
    padding: .55rem .95rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: .65rem;
    color: var(--faint);
  }

  .nada { padding: 1.6rem .9rem; text-align: center; color: var(--graphite); font-size: .9rem; }

  /* ── pantallas estrechas ───────────────────────────────────────── */
  @media (max-width: 900px) {
    .heroe { flex-direction: column; }
    .figura { margin: 0 auto; width: min(400px, 100%); flex: 0 0 auto; }
  }

  @media (max-width: 760px) {
    .hero { min-height: 0; }
    .temario { grid-template-columns: 1fr; gap: 0; }
    .columna + .columna .curso-h { margin-top: 1.2rem; }
    .cab .meta { display: none; }

    /* la repisa se parte: las tizas arriba y el lema debajo, a lo ancho */
    .repisa { flex-wrap: wrap; row-gap: .15rem; padding-top: .7rem; padding-bottom: .7rem; }
    .lema { text-align: left; margin-left: 0; flex-basis: 100%; }
  }

