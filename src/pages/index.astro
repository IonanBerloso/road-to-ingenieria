  .cta.borde:hover, .cta.borde:focus-visible { border-color: var(--tiza); }

  .gratis { font-size: 1.2rem; color: var(--tiza-apagada); margin: .9rem 0 0; }

  /* ── la figura tocable ─────────────────────────────────────────── */
  .figura {
    margin-left: auto;
    flex: 0 1 400px;
    min-width: 250px;
  }

  .figura svg {
    display: block;
    width: 100%;
    height: auto;
    cursor: grab;
    touch-action: none;
  }

  .figura svg:active { cursor: grabbing; }
  .eje { stroke: var(--tiza-borde); stroke-width: 2; }
  .traza-curva { stroke: var(--tiza); }
  .tangente { stroke: var(--tiza-amarilla); }
  .punto-tiza { fill: var(--tiza-amarilla); }
  .nota { font-size: 21px; fill: var(--tiza-suave); }

  /* ── el temario ────────────────────────────────────────────────── */
  .temario {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 4rem);
    padding: 1.8rem 0 2.4rem;
  }

  .curso-h {
    font-size: 1.5rem;
    color: var(--tiza-amarilla);
    margin: 0 0 .2rem;
  }

  .fila {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: .55rem .35rem;
    border-bottom: 1px dashed var(--tiza-raya);
    text-decoration: none;
    border-radius: 6px;
    transition: background .15s;
  }

  .columna .fila:last-child { border-bottom-color: transparent; }
  .fila:hover, .fila:focus-visible { background: var(--tiza-velo); }

  .fila .pn { font-size: 1.25rem; color: var(--tiza-amarilla); min-width: 2.1rem; }

  /* El nombre es el objeto que viaja al titular del detalle (FLIP). */
  .fila .nm {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: .01em;
    color: var(--tiza);
  }

  .fila.prev .nm { font-weight: 400; color: var(--tiza-apagada); }

  .fila .ps {
    margin-left: auto;
    font-size: 1.1rem;
    color: var(--tiza-apagada);
    text-align: right;
  }

  .fila .ps.ok { color: var(--tiza-menta); }
  .fila .ps.obra { color: var(--tiza-amarilla); }

  /* ── la repisa ─────────────────────────────────────────────────── */
  .repisa {
    margin: auto calc(-1 * clamp(1rem, 4vw, 3rem)) 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: .5rem clamp(1rem, 4vw, 3rem);
    background: var(--repisa);
    box-shadow: var(--repisa-sombra);
  }

  .tiza-barra { height: 12px; border-radius: 3px; box-shadow: var(--shadow-1); flex: 0 0 auto; }
  .t-blanca { width: 72px; background: var(--tiza); }
  .t-amarilla { width: 44px; background: var(--tiza-amarilla); }
  .t-menta { width: 30px; background: var(--tiza-menta); }
  .lema { margin-left: auto; font-size: .78rem; color: var(--tiza-suave); text-align: right; }

  /* ── el movimiento se ve UNA vez, y solo si el sistema lo permite ──
     El estado por defecto es «ya dibujado»: con reduced-motion no hay
     animación que correr y nada se queda invisible (§17: un forwards
     apagado deja el elemento en su estado inicial). */
  @media (prefers-reduced-motion: no-preference) {
    .apar { opacity: 0; animation: apar .8s var(--ease) forwards; }
    .entradilla.apar { animation-delay: .2s; }
    .ctas.apar { animation-delay: .35s; }
    .gratis.apar { animation-delay: .5s; }

    .traza-curva {
      stroke-dasharray: 560;
      stroke-dashoffset: 560;
      animation: traza 1.6s ease-out .4s forwards;
    }

    .traza-sub {
      stroke-dasharray: 320;
      stroke-dashoffset: 320;
      animation: traza 1.1s ease-out 1.1s forwards;
    }
  }

  @keyframes apar {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes traza { to { stroke-dashoffset: 0; } }

  /* ── B · detalle ───────────────────────────────────────────────── */
  .detalle {
    display: none;
    padding-bottom: 5rem;
    animation: entra-vista .38s var(--ease) both;
  }

  .detalle:target,
  .detalle.activa { display: block; }

  /* Con JavaScript la clase manda; sin él, el ancla. En los dos casos la
     lista se retira en vez de quedarse debajo empujando. */
  .escena[data-vista='detalle'] .hero,
  .escena:has(.detalle:target) .hero {
    display: none;
  }

  @keyframes entra-vista {
    from { opacity: 0; transform: translateY(1.2rem); }
    to { opacity: 1; transform: none; }
  }

  .chips {
    display: flex;
    gap: .3rem;
    overflow-x: auto;
    padding: .55rem 0 .8rem;
    border-bottom: 1px solid var(--rule);
    scrollbar-width: none;
  }

  .chips::-webkit-scrollbar { display: none; }

  .chip,
  .volver {
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    white-space: nowrap;
    padding: .3rem .65rem;
    border-radius: 99px;
    text-decoration: none;
    transition: color .2s, background .2s;
  }

  .chip:hover { color: var(--ink); background: var(--grid); }
  .chip.act { color: var(--acento); background: var(--live-soft); font-weight: 600; }
  .volver { padding-left: 0; }
  .volver:hover { color: var(--acento); }

  .cab {
    padding: 1.8rem 0 .5rem;
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cab .n {
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--acento);
    padding-bottom: .55rem;
  }

  .nombre {
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1;
    font-size: clamp(1.9rem, 5.4vw, 3.4rem);
    transform-origin: left top;
  }

  .cab .meta {
    margin-left: auto;
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    padding-bottom: .6rem;
  }

  .regla {
    height: 2px;
    background: var(--acento);
    opacity: .9;
    margin-bottom: 1.6rem;
    transform-origin: left;
    animation: crece .55s var(--ease) both;
  }

  @keyframes crece {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .aviso {
    font-size: .8rem;
    color: var(--flag);
    background: var(--flag-soft);
    border-left: 2px solid var(--flag);
    padding: .4rem .7rem;
    margin-bottom: 1rem;
    max-width: 62rem;
  }

  /* ── temas ─────────────────────────────────────────────────────── */
  /* La lista de temas y, a su derecha, el panel de exámenes. Antes `.temas`
     era una columna suelta; ahora comparte fila con el panel, que en móvil
     cae debajo. */
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 62rem) minmax(13rem, 17rem);
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: start;
  }

  .temas { list-style: none; }

  /* ── panel de exámenes ─────────────────────────────────────────── */
  .examenes {
    position: sticky;
    top: 4.2rem;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    animation: entra-fila .4s var(--ease) both;
    animation-delay: 160ms;
  }

  .ex-tit { color: var(--acento); margin-bottom: .5rem; }

  .ex-sub {
    font-size: .78rem;
    line-height: 1.45;
    color: var(--graphite);
    margin-bottom: .9rem;
  }

  .ex-lista { list-style: none; }

  .ex-lista a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .5rem;
    padding: .35rem .4rem;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: .8rem;
    color: var(--ink);
    text-decoration: none;
    transition: background .15s, color .15s;
  }

  .ex-lista a:hover { background: var(--live-soft); color: var(--live); }

  .ex-conv { margin-left: auto; margin-right: .4rem; color: var(--faint); font-size: .72rem; }

  .ex-go { color: var(--faint); transition: transform .15s; }
  .ex-lista a:hover .ex-go { color: var(--live); transform: translateX(2px); }

  /* La ruta de estudio va antes que la lista de exámenes: quien llega aquí
     todavía no sabe cuál abrir. */
  .ex-ruta {
    display: block;
    margin-bottom: 1.1rem;
    padding: .6rem .7rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--acento);
    border-radius: 5px;
    text-decoration: none;
    color: inherit;
  }

  .ex-ruta:hover { border-color: var(--live); border-left-color: var(--live); }
  .ex-ruta .rotulo { display: block; color: var(--graphite); margin-bottom: .15rem; }
  .ex-ruta-t { font-size: .84rem; font-weight: 600; }

  .ex-todos {
    display: inline-block;
    margin-top: .7rem;
    padding: .3rem .4rem;
    font-family: var(--mono);
    font-size: .74rem;
    color: var(--live);
    text-decoration: none;
  }

  .ex-todos:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; }
    .examenes { position: static; }
  }

  .temas li { animation: entra-fila .4s var(--ease) both; animation-delay: calc(var(--i) * 32ms); }

  @keyframes entra-fila {
    from { opacity: 0; transform: translateY(9px); }
    to { opacity: 1; transform: none; }
  }

  .tema {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: .9rem;
    align-items: center;
    padding: .72rem .5rem;
    border-bottom: 1px solid var(--rule);
    border-radius: 5px;
    text-decoration: none;
    transition: background .15s;
  }

  a.tema:hover, a.tema:focus-visible { background: var(--live-soft); }
  .tema[aria-disabled='true'] { opacity: .62; }

  .tn { font-family: var(--mono); font-size: .71rem; color: var(--faint); text-align: right; }

  .txt { display: block; min-width: 0; }
  .t-tit { display: block; font-size: .96rem; font-weight: 500; }
  .t-desc { display: block; font-size: .81rem; color: var(--graphite); line-height: 1.4; }

  .der { display: flex; align-items: center; gap: .9rem; }

  .peso { display: flex; align-items: center; gap: .45rem; }
  .peso .rotulo { font-size: .63rem; }

  .pista {
    width: 48px;
    height: 5px;
    background: var(--grid);
    border-radius: 99px;
    overflow: hidden;
    display: block;
  }

  .relleno { height: 100%; background: var(--faint); border-radius: 99px; display: block; }

  .tema[data-peso='alto'] .relleno { background: var(--flag); }
  .tema[data-peso='alto'] .rotulo { color: var(--flag); font-weight: 600; }

  .tipos { display: flex; gap: .26rem; }

