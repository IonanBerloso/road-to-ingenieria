  }

  @keyframes entra-vista {
    from { opacity: 0; transform: translateY(1.2rem); }
    to { opacity: 1; transform: none; }
  }

  /* La barra de asignaturas. Son NUEVE, y midiéndolas resultó que solo caben
     enteras a partir de 1500 px: a 1280 se veían 7, a 768 cuatro y a 360 dos
     —de nueve—. Y el carril lleva la barra de desplazamiento oculta a
     propósito, así que no había **ninguna** pista de que hubiera más: la
     novena asignatura era invisible e indescubrible. Medido el 5 de septiembre
     de 2026 barriendo la portada a cuatro anchos, después de que la auditoría
     externa enseñara a mirar por donde uno no suele entrar (§16 punto 6).

     Dos remedios, según quepan o no:
     - de 1000 px para arriba **se envuelven**: dos filas de pastillas y las
       nueve a la vista, que es mejor que un desplazamiento escondido;
     - por debajo sigue siendo carril —envolver nueve en un móvil se comería
       cinco líneas— pero ahora se ve que sigue: un velo en cada borde,
       enganchado al contenido con `local`, que aparece solo cuando queda algo
       por ese lado y se apaga al llegar al final. Es CSS puro, así que
       funciona igual sin JavaScript. */
  .chips {
    display: flex;
    gap: .3rem;
    overflow-x: auto;
    padding: .55rem 0 .8rem;
    border-bottom: 1px solid var(--rule);
    scrollbar-width: none;
    /* El carril vive sobre la banda de pizarra, no sobre papel: los dos velos
       de arriba tienen que ser del color de la banda —`--piz-medio`, que es
       el mismo en los dos temas (§06)— o se publican dos barras claras en los
       bordes. Se vio mirando la captura, no midiendo. */
    background:
      linear-gradient(to right, var(--piz-medio), transparent) 0 0 / 1.6rem 100% no-repeat,
      linear-gradient(to left, var(--piz-medio), transparent) 100% 0 / 1.6rem 100% no-repeat,
      linear-gradient(to right, var(--piz-oscuro), transparent) 0 0 / 1.4rem 100% no-repeat local,
      linear-gradient(to left, var(--piz-oscuro), transparent) 100% 0 / 1.4rem 100% no-repeat local;
  }

  .chips::-webkit-scrollbar { display: none; }

  @media (min-width: 1000px) {
    .chips {
      flex-wrap: wrap;
      overflow-x: visible;
      background: none;
    }
  }

  .chip,
  .volver {
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    white-space: nowrap;
    padding: .3rem .65rem;
    border-radius: 99px;
    text-decoration: none;
    transition: color .2s, background .2s;
  }

  .chip:hover { color: var(--ink); background: var(--grid); }
  .chip.act { color: var(--acento); background: var(--live-soft); font-weight: 600; }
  .volver { padding-left: 0; }
  .volver:hover { color: var(--acento); }

  .nombre {
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1;
    font-size: clamp(2.1rem, 5.4vw, 3.2rem);
    color: var(--tiza);
    transform-origin: left top;
  }

  .aviso {
    font-size: .8rem;
    color: var(--flag);
    background: var(--flag-soft);
    border-left: 2px solid var(--flag);
    padding: .4rem .7rem;
    margin: 1rem var(--pad) 0;
    max-width: 62rem;
  }

  /* ── el cuerpo: temario a la izquierda, carril a la derecha ────── */
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 25rem);
    gap: clamp(1.4rem, 3vw, 2.75rem);
    align-items: start;
    padding: 1.4rem var(--pad) 0;
  }

  .t-rotulo { color: var(--faint); margin-bottom: .5rem; }

  .temas { list-style: none; }

  .temas li { animation: entra-fila .4s var(--ease) both; animation-delay: calc(var(--i) * 32ms); }

  @keyframes entra-fila {
    from { opacity: 0; transform: translateY(9px); }
    to { opacity: 1; transform: none; }
  }

  .tema {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    gap: .9rem;
    align-items: center;
    padding: .62rem .65rem;
    border-bottom: 1px solid var(--rule);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background .15s, box-shadow .15s;
  }

  a.tema:hover,
  a.tema:focus-visible {
    background: var(--panel);
    box-shadow: var(--shadow-1);
  }

  .tema[aria-disabled='true'] { opacity: .6; }

  /* Un tema del que no hay nada que escribir no está «a medias»: está cerrado
     así a propósito. Se distingue del que aún no se ha escrito por el número
     apagado y la etiqueta, no por estar más gris — apagarlo más lo haría
     parecer más pendiente, que es justo lo contrario. */
  .tema[data-solo-clase] { opacity: 1; }
