---
import { statSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cabecera from '../../../components/ui/Cabecera.astro';
import Examen from '../../../components/ui/Examen.astro';
import { archivo } from '../../../lib/rutas';
import { SUFIJO_CONV, CONVOCATORIAS } from '../../../content.config';

/**
 * Una página por convocatoria. Un examen cruza temas, así que no cabe dentro
 * de la página de un tema: vive en su propia área (§08, nota del 20 de agosto
 * de 2026).
 *
 * Aquí se cruzan tres fuentes —el `examen.yaml`, el `ejercicios.yaml` de al
 * lado y el catálogo— y **cualquier descuadre entre ellas rompe el build**. Es
 * la misma regla de `[tema].astro`: los datos no se comprueban a ojo (§03).
 */
export async function getStaticPaths() {
  const examenes = await getCollection('examen');
  const catalogo = await getCollection('catalogo');
  const ficheros = await getCollection('ejercicios');

  return examenes.map((ex) => {
    const { asignatura: idAsig, curso, convocatoria, pdf } = ex.data;

    /* La carpeta ES la URL. Un curso tiene hasta siete exámenes —cinco
       evaluaciones y dos convocatorias—, así que el curso solo ya no
       identifica a ninguno. Se comprueba aquí que la carpeta diga lo mismo
       que el fichero: si alguien copia una carpeta para hacer la siguiente y
       se olvida de cambiar la convocatoria dentro, el build lo caza. */
    /* El id es «calculo/examenes/2015-2016-1ev/examen»: la carpeta es el
       penúltimo segmento, porque el último es el nombre del fichero. */
    const carpeta = ex.id.split('/').at(-2) ?? '';
    const esperado = `${curso}-${SUFIJO_CONV[convocatoria]}`;
    if (carpeta !== esperado) {
      throw new Error(
        `El examen de la carpeta "${carpeta}" declara curso ${curso} y convocatoria ` +
          `"${convocatoria}", así que la carpeta debería llamarse "${esperado}".`,
      );
    }

    const asignatura = catalogo.find((a) => a.id === idAsig);
    if (!asignatura) {
      throw new Error(
        `El examen "${curso}" dice ser de "${idAsig}", que no está en el catálogo.`,
      );
    }

    /* El PDF tiene que existir de verdad. Sin esta comprobación el enlace se
       publica roto y no se nota hasta que alguien lo pulsa, que es justo el
       momento en el que la herramienta pierde credibilidad.

       Un examen puede venir en más de un cuadernillo —el de mayo-junio de 2020
       son dos—, así que se comprueban todos y se mide el tamaño de cada uno. */
    const listaPdf = Array.isArray(pdf) ? pdf : [pdf];
    const cuadernillos = listaPdf.map((nombre) => {
      const enDisco = `public/examenes/${idAsig}/${nombre}`;
      try {
        return { nombre, kb: Math.round(statSync(enDisco).size / 1024) };
      } catch {
        throw new Error(
          `El examen "${idAsig} · ${curso}" enlaza "${nombre}", que no está en ${enDisco}.`,
        );
      }
    });

    const datos = ex.data.ejercicios.map((ref) => {
      const dato = ficheros.flatMap((f) => f.data.ejercicios).find((e) => e.id === ref.id);
      if (!dato) {
        throw new Error(
          `El examen "${idAsig} · ${curso}" nombra el ejercicio "${ref.id}", que no ` +
            `existe en ningún ejercicios.yaml.`,
        );
      }
      return { ref, dato };
    });

    /* ¿Este cuadernillo publica el reparto de puntos?
     *
     * Hasta el 26 de agosto de 2026 esto no era una pregunta: los 425
     * ejercicios de Cálculo lo imprimen, así que la regla era «puntos
     * obligatorios, siempre». Álgebra rompe el supuesto — sus ocho exámenes
     * solo traen una casilla de CALIFICACIÓN, sin reparto por competencias ni
     * por apartado— y exigirlos allí obligaría a inventárselos, que es
     * justo lo que §10 prohíbe.
     *
     * La regla que queda protege lo mismo con un supuesto más flojo: **dentro
     * de un examen, o los declaran todos o no los declara ninguno**. El fallo
     * que esto caza es el de verdad —transcribir un examen y olvidarse de los
     * puntos de un ejercicio—, y sigue cazándolo. Lo que ya no hace es exigir
     * un dato que la hoja no imprime. */
    const conPuntos = datos.filter(({ dato }) => dato.puntos).length;
    if (conPuntos !== 0 && conPuntos !== datos.length) {
      const sinEllos = datos.filter(({ dato }) => !dato.puntos).map(({ ref }) => ref.id);
      throw new Error(
        `El examen "${idAsig} · ${curso}" declara los puntos de ${conPuntos} de sus ` +
          `${datos.length} ejercicios. O los declaran todos —porque la hoja los ` +
          `imprime— o no los declara ninguno. Sin puntos: ${sinEllos.join(', ')}.`,
      );
    }

    const ejercicios = datos.map(({ ref, dato }) => {

      const tema = asignatura.data.temas.find((t) => t.id === ref.tema);
      if (!tema) {
        throw new Error(
          `El ejercicio "${ref.id}" dice ser del tema "${ref.tema}", que no está en el ` +
            `temario de "${idAsig}".`,
        );
      }

      return {
        id: dato.id,
        titulo: dato.titulo,
        enunciado: dato.enunciado,
        pide: dato.pide,
        tema: tema.titulo,
        puntos: dato.puntos,
      };
    });

    return {
      params: { asignatura: idAsig, examen: carpeta },
      props: { asignatura, examen: ex, ejercicios, cuadernillos },
    };
  });
}

const { asignatura, examen, ejercicios, cuadernillos } = Astro.props;

const conv = CONVOCATORIAS[examen.data.convocatoria as keyof typeof CONVOCATORIAS].larga;
const crumb = `${asignatura.data.nombre} · exámenes`;
const titulo = `Examen ${examen.data.curso}`;

/* Casi todos los exámenes son un cuadernillo; el de mayo-junio de 2020 son dos.
   Se les da nombre —«1.er cuatrimestral», «2.º»— solo cuando hay más de uno:
   poner «cuadernillo 1 de 1» en los otros 95 sería ruido. */
const NOMBRES = ['1.er cuatrimestral', '2.º cuatrimestral', '3.er cuadernillo'];
const pdfs = cuadernillos.map((c: { nombre: string; kb: number }, i: number) => ({
  href: archivo(`examenes/${asignatura.id}/${c.nombre}`),
  kb: c.kb,
  etiqueta: cuadernillos.length > 1 ? (NOMBRES[i] ?? `cuadernillo ${i + 1}`) : null,
}));
---

<Base
  titulo={`${titulo} · ${conv} — ${asignatura.data.nombre}`}
  descripcion={`Los ${ejercicios.length} ejercicios de la ${conv} de ${asignatura.data.nombre} del curso ${examen.data.curso}, resueltos enteros${
    ejercicios.some((e) => e.puntos) ? ' y con el reparto de puntos del examen' : ''
  }.`}
  acento={asignatura.data.acento}
  crumb={crumb}
>
  <Cabecera crumb={crumb} />

  <main id="principal">
    <Examen
      eyebrow={`${asignatura.data.nombre} · ${conv}`}
      titulo={titulo}
      fecha={examen.data.fecha}
      pdfs={pdfs}
      ejercicios={ejercicios}
    />
  </main>
</Base>
