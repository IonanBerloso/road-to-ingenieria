---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cabecera from '../../../components/ui/Cabecera.astro';
import { ruta, archivo } from '../../../lib/rutas';
import { SUFIJO_CONV, CONVOCATORIAS, ORDEN_CONV } from '../../../content.config';

/**
 * El índice de exámenes de una asignatura. Solo existe si esa asignatura tiene
 * alguno escrito: una página vacía diciendo «todavía no hay nada» no vale de
 * nada y además habría que enlazarla desde la portada.
 */
export async function getStaticPaths() {
  /* Ojo: Astro extrae esta función a su propio módulo, así que **no ve** las
     constantes del frontmatter. Tiene que vivir aquí dentro. El fallo estuvo
     latente desde que la ruta pasó a ser curso + convocatoria: mientras no
     hubo dos exámenes del mismo curso, este segundo criterio de orden no
     llegaba a evaluarse nunca. */
  const examenes = await getCollection('examen');
  const catalogo = await getCollection('catalogo');
  const rutas = await getCollection('preparar');

  const porAsignatura = new Map<string, typeof examenes>();
  for (const ex of examenes) {
    const lista = porAsignatura.get(ex.data.asignatura) ?? [];
    lista.push(ex);
    porAsignatura.set(ex.data.asignatura, lista);
  }

  return [...porAsignatura].map(([id, lista]) => {
    const asignatura = catalogo.find((a) => a.id === id);
    if (!asignatura) {
      throw new Error(`Hay exámenes de "${id}", que no está en el catálogo.`);
    }
    /* Del más reciente al más antiguo: es el orden en que sirven para
       estudiar, porque el examen que viene se parece al del año pasado. Y
       dentro de un mismo curso, por convocatoria, que es el orden en que se
       hacen: primera en octubre, segunda en diciembre, tercera en enero. */
    lista.sort(
      (a, b) =>
        b.data.curso.localeCompare(a.data.curso) ||
        ORDEN_CONV.indexOf(a.data.convocatoria) - ORDEN_CONV.indexOf(b.data.convocatoria),
    );
    /* Las rutas de estudio de esta asignatura, en el mismo orden de
       convocatoria que los exámenes. Puede no haber ninguna: la sección de
       exámenes existe desde antes y no depende de ellas. */
    const suyas = rutas
      .filter((r) => r.data.asignatura === id)
      .sort(
        (a, b) =>
          ORDEN_CONV.indexOf(a.data.evaluacion) - ORDEN_CONV.indexOf(b.data.evaluacion),
      )
      .map((r) => ({
        titulo: r.data.titulo,
        lede: r.data.lede,
        sufijo: SUFIJO_CONV[r.data.evaluacion],
      }));

    return { params: { asignatura: id }, props: { asignatura, lista, rutas: suyas } };
  });
}

const { asignatura, lista, rutas } = Astro.props;
const crumb = `${asignatura.data.nombre} · exámenes`;

/**
 * Los puntos **de verdad** de cada convocatoria, y cuántos ejercicios traía.
 *
 * POR QUÉ EXISTE. Hasta el 4 de septiembre de 2026 esta página escribía
 * `const puntos = ex.data.ejercicios.length * 10` y lo publicaba como
 * «7 EJERCICIOS · 70 PUNTOS» en cada fila. **Ni Álgebra ni Fluidos publican
 * reparto de puntos**: sus cuadernillos dan el peso porcentual de cada
 * ejercicio y nada más. Esos «70 puntos» eran un número inventado con
 * apariencia de dato, que es lo que §10 prohíbe con todas las letras. En
 * Cálculo acertaba de casualidad —sus ejercicios valen diez— y esa casualidad
 * es justo lo que hizo que nadie lo mirara.
 *
 * Ahora se suman los `puntos` que declara cada ejercicio; si no hay ninguno,
 * no se enseña ningún total. Y de paso se dice cuántos ejercicios traía el
 * cuadernillo, no solo cuántos hemos transcrito.
 */
const ficherosEj = await getCollection('ejercicios');
const puntosPorId = new Map(
  ficherosEj.flatMap((f) => f.data.ejercicios.map((e) => [e.id, e.puntos] as const)),
);
const datos = new Map(
  lista.map((ex) => {
    const total = ex.data.ejercicios.reduce((s, { id }) => {
      const p = puntosPorId.get(id);
      return s + (p ? p.comp1 + p.comp2 + p.comp4 : 0);
    }, 0);
    return [ex.id, { total, fuera: ex.data.fuera.length }];
  }),
);

/* Los nombres salen de CONVOCATORIAS, en minúscula; aquí encabezan un grupo,
   así que se capitaliza la primera letra al pintarlos. */
const NOMBRE_CONV: Record<string, string> = Object.fromEntries(
  Object.entries(CONVOCATORIAS).map(([k, v]) => [k, v.larga[0].toUpperCase() + v.larga.slice(1)]),
);

/** Qué temas entran en cada evaluación y cuánto pesa en la nota final.
 *
 *  No es una estimación: sale de la guía docente 2025/26 de la asignatura,
 *  que lo dice examen por examen. El tercero vale casi tanto como los otros
 *  dos juntos, y eso conviene que se vea antes de abrirlo. */
const ALCANCE_CONV: Record<string, { temas: string; peso: string }> = {
  primera: { temas: 'temas 1–2', peso: '10 %' },
  segunda: { temas: 'temas 3–4', peso: '10 %' },
  tercera: { temas: 'temas 1–5', peso: '17,5 %' },
};
---

<Base
  titulo={`Exámenes — ${asignatura.data.nombre}`}
  descripcion={`Los exámenes de ${asignatura.data.nombre} resueltos enteros, con el enunciado original y el reparto de puntos por competencia.`}
  acento={asignatura.data.acento}
  crumb={crumb}
>
  <Cabecera crumb={crumb} />

  <main id="principal">
    <div class="shell">
      <p class="rotulo rotulo--live eyebrow">{asignatura.data.nombre}</p>
      <h1>Exámenes</h1>
      <p class="lede">
        Los de verdad, con su enunciado original en PDF. Cada uno abre en
        blanco para que te lo hagas antes de mirar nada.
      </p>

      <p class="aviso rotulo">
        Los exámenes no publican solución: las resoluciones son propuesta
        nuestra y están pendientes de revisión.
      </p>

      {
        rutas.length > 0 && (
          <nav class="rutas" aria-label="Rutas de estudio">
            <p class="rotulo">Antes de empezar</p>
            {rutas.map((r) => (
              <a href={ruta(`${asignatura.id}/preparar/${r.sufijo}/`)} class="r">
                <span class="r-t">{r.titulo}</span>
                <span class="r-d">{r.lede}</span>
                <span class="r-ir rotulo" aria-hidden="true">→</span>
              </a>
            ))}
          </nav>
        )
      }

      <ol class="lista">
        {
          lista.map((ex) => {
            const { total, fuera } = datos.get(ex.id)!;
            const cuantos = fuera
              ? `${ex.data.ejercicios.length} de ${ex.data.ejercicios.length + fuera} ejercicios`
              : `${ex.data.ejercicios.length} ejercicios`;
            return (
              <li>
                <a
                  class="ex"
                  href={ruta(
                    `${asignatura.id}/examenes/${ex.data.curso}-${SUFIJO_CONV[ex.data.convocatoria]}`,
                  )}
                >
                  <span class="curso">{ex.data.curso}</span>
                  <span class="txt">
                    <span class="conv">
                      {NOMBRE_CONV[ex.data.convocatoria]}
                      {
                        ALCANCE_CONV[ex.data.convocatoria] && (
                          <>
                            <span class="alcance rotulo">
                              {ALCANCE_CONV[ex.data.convocatoria].temas}
                            </span>
                            <span class="alcance rotulo">
                              {ALCANCE_CONV[ex.data.convocatoria].peso} de la nota
                            </span>
                          </>
                        )
                      }
                    </span>
                    <span class="fecha">{ex.data.fecha}</span>
                  </span>
                  <span class="der">
                    <span class="rotulo pts">
                      {cuantos}
                      {total > 0 && ` · ${total} puntos`}
                    </span>
                    <span class="go" aria-hidden="true">→</span>
                  </span>
                </a>
                {/* Casi todos los exámenes son un cuadernillo; el de
                    mayo-junio de 2020 son dos y hay que enlazar los dos, o el
                    segundo cuatrimestral se queda sin enunciado que
                    contrastar (§08). */}
                {(Array.isArray(ex.data.pdf) ? ex.data.pdf : [ex.data.pdf]).map((f, i, todos) => (
                  <a
                    class="pdf rotulo"
                    href={archivo(`examenes/${asignatura.id}/${f}`)}
                    target="_blank"
                    rel="noopener"
                  >
                    ↓ PDF original{todos.length > 1 ? ` (${i + 1}/${todos.length})` : ''}
                  </a>
                ))}
              </li>
            );
          })
        }
      </ol>
    </div>
  </main>
</Base>

<style>
  .shell {
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  .eyebrow { margin-bottom: .6rem; font-size: .72rem; letter-spacing: .11em; }
  .lede { max-width: var(--measure); }

  /* ── rutas de estudio ──────────────────────────────────────────── */
  .rutas {
    max-width: var(--measure);
    margin: 0 0 2.4rem;
  }

  .rutas > .rotulo { margin-bottom: .6rem; color: var(--graphite); }

  .r {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .2rem .9rem;
    padding: .9rem 1rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--acento);
    border-radius: 5px;
    text-decoration: none;
    color: inherit;
  }

  .r + .r { margin-top: .5rem; }
  .r:hover { border-color: var(--live); border-left-color: var(--live); }

  .r-t { font-weight: 600; }
  .r-d { grid-column: 1; font-size: .85rem; color: var(--graphite); }
  .r-ir { grid-row: 1 / span 2; align-self: center; color: var(--acento); }

  .aviso {
    margin: 1.8rem 0 2.4rem;
    padding: .6rem .8rem;
    border-left: 2px solid var(--flag);
    background: var(--flag-soft);
    color: var(--ink);
    text-transform: none;
    letter-spacing: .01em;
    max-width: var(--measure);
  }

  .lista { list-style: none; }

  .lista li {
    display: flex;
    align-items: stretch;
    gap: .5rem;
    border-top: 1px solid var(--rule);
  }

  .lista li:last-child { border-bottom: 1px solid var(--rule); }

  .ex {
    flex: 1;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem .6rem;
    text-decoration: none;
    color: var(--ink);
    transition: background .15s;
  }

  .ex:hover { background: var(--live-soft); }

  .curso {
    font-family: var(--mono);
    font-size: .92rem;
    color: var(--acento);
    font-weight: 600;
  }

  .txt { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
  .conv { font-size: .95rem; display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }

  .alcance {
    font-size: .68rem;
    color: var(--faint);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: .05rem .3rem;
  }

  .fecha { font-size: .8rem; color: var(--graphite); }

  .der { display: flex; align-items: center; gap: 1rem; }
  .pts { color: var(--faint); white-space: nowrap; }

  .go {
    font-family: var(--mono);
    color: var(--faint);
    transition: transform .15s, color .15s;
  }

  .ex:hover .go { color: var(--live); transform: translateX(3px); }

  .pdf {
    display: flex;
    align-items: center;
    padding: 0 .9rem;
    color: var(--graphite);
    text-decoration: none;
    white-space: nowrap;
    border-left: 1px solid var(--rule);
    transition: color .15s, background .15s;
  }

  .pdf:hover { color: var(--live); background: var(--live-soft); }

  @media (max-width: 640px) {
    .lista li { flex-direction: column; gap: 0; padding-bottom: .6rem; }
    .ex { grid-template-columns: 4.5rem minmax(0, 1fr); gap: .8rem; }
    .der { grid-column: 1 / -1; }
    .pdf { border-left: none; padding: .3rem .6rem; }
  }
</style>
