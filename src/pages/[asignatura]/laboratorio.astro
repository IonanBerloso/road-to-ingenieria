---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/ui/Cabecera.astro';
import { ruta } from '../../lib/rutas';
import { mate, sinMarcas } from '../../lib/markdown.mjs';
import { paginaDeEjercicio } from '../../lib/ejercicios';
import { CONVOCATORIAS, slugExamen, type ConTemas } from '../../content.config';

/**
 * El laboratorio: lo que la asignatura evalúa y esta app no examina.
 *
 * POR QUÉ EXISTE.
 *
 * Todo el sitio está construido sobre los exámenes escritos: se transcriben, se
 * cuentan y se preparan. Pero Cálculo tiene además **siete sesiones de
 * ordenador con GeoGebra** —temas 1, 2, 4, 5, 6, 8 y 11— con sus guiones y sus
 * nueve programas, y eso también se evalúa. Ningún ejercicio de examen sale de
 * ahí, así que el corpus no los tenía; el efecto era que quien preparaba la
 * asignatura aquí podía terminar sin saber que existían. Un sitio que calla una
 * parte de la asignatura miente por omisión, y §10 va justo de eso.
 *
 * LO QUE ESTA PÁGINA NO HACE, y lo dice ella misma arriba del todo:
 *
 *  - **No corrige.** No hay respuesta que teclear ni nada que comprobar. Es un
 *    índice, no una versión de laboratorio.
 *  - **No transcribe el guion.** Lo que se lee en `trabajo` es un resumen
 *    nuestro de lo que la actividad pide (§08). El guion es de la asignatura y
 *    se pide en el aula virtual.
 *  - **No reparte ningún `.ggb`.** Del programa solo se dice el nombre, para
 *    reconocerlo cuando se abra el aula virtual.
 *
 * Y lo que sí hace, que es lo único que este sitio puede aportar aquí: enlazar
 * cada actividad con el apartado del tema donde eso mismo está explicado. La
 * sesión de laboratorio se entiende mucho mejor con el apartado leído antes.
 *
 * CON FLUIDOS Y MATERIALES (fase I, 29 de septiembre de 2026) la página deja de
 * ser solo de ordenador: son prácticas de laboratorio de verdad, con fórmulas
 * en lo que se pide y ejercicios de examen que salen de ellas. Por eso:
 *
 *  - `trabajo` pasa por `mate()`, como cualquier otro texto del sitio.
 *  - Con `practica`, el rótulo es el número de la práctica en el guion y no el
 *    del tema, que es como la busca quien tiene el guion delante.
 *  - Con `sesion`, las prácticas se agrupan por la sesión de la guía en que
 *    se hacen. O la llevan todas o ninguna: media página agrupada no se lee.
 *  - `donde.apartado` enlaza el apartado del tema, validado contra sus
 *    encabezados, y `ejercicios` enlaza cada ejercicio que usa la práctica.
 *    Un id o un apartado que no existe rompe el build, como en las rutas.
 */
export async function getStaticPaths() {
  const catalogo = await getCollection('catalogo');
  const laboratorios = await getCollection('laboratorio');

  const salida = [];
  for (const lab of laboratorios) {
    const asignatura = catalogo.find((a) => a.id === lab.data.asignatura);
    /* Sin asignatura en el catálogo no hay página: el acento, el nombre y la
       miga de pan salen de ahí, y una página sin ellos sería otra cosa. */
    if (!asignatura) continue;
    salida.push({ params: { asignatura: asignatura.id }, props: { asignatura, lab } });
  }
  return salida;
}

const { asignatura, lab } = Astro.props;
const crumb = `${asignatura.data.nombre} · laboratorio`;

/* Los ejercicios de esta asignatura, por id, con la página donde viven: los
   de examen, con el nombre de su convocatoria delante. */
const examenes = (await getCollection('examen')).filter((e) => e.data.asignatura === asignatura.id);
const nombreDeExamen = new Map(
  examenes.map((e) => [
    slugExamen(e.data.curso, e.data.convocatoria),
    `${CONVOCATORIAS[e.data.convocatoria as keyof typeof CONVOCATORIAS].boton} ${e.data.curso}`,
  ]),
);
const ejercicioPorId = new Map<string, { titulo: string; pagina: string; examen?: string }>();
for (const f of await getCollection('ejercicios')) {
  if (!f.id.startsWith(`${asignatura.id}/`)) continue;
  const partes = f.id.split('/');
  const examen = partes[1] === 'examenes' ? nombreDeExamen.get(partes[2]) : undefined;
  for (const [i, e] of f.data.ejercicios.entries())
    ejercicioPorId.set(e.id, { titulo: e.titulo, pagina: paginaDeEjercicio(f.id, i), examen });
}

/* Los apartados de cada tema que la página enlaza, contra sus encabezados de
   verdad (## y ###), como hace la ruta de estudio: `verify.mjs` no mira los
   fragmentos, y un slug mal escrito dejaría al alumno en la cabecera. */
const coleccion = await getCollection(asignatura.id as ConTemas);
const tituloApartado = new Map<string, string>();
for (const t of new Set(lab.data.actividades.filter((a) => a.donde?.apartado).map((a) => a.donde!.tema))) {
  const entrada = coleccion.find((e) => e.id === t || e.id.startsWith(`${t}/`));
  if (!entrada) throw new Error(`El laboratorio de ${asignatura.id} enlaza el tema "${t}", que no tiene index.mdx.`);
  const { headings } = await render(entrada);
  for (const h of headings.filter((h) => h.depth === 2 || h.depth === 3)) tituloApartado.set(`${t}#${h.slug}`, h.text);
}

const conSesion = lab.data.actividades.filter((a) => a.sesion !== undefined).length;
if (conSesion > 0 && conSesion < lab.data.actividades.length)
  throw new Error(
    `El laboratorio de ${asignatura.id} pone «sesion» a ${conSesion} de ${lab.data.actividades.length} actividades: o todas o ninguna.`,
  );

const avisoHtml = await mate(lab.data.aviso, 'lab-aviso');
const fuenteHtml = await mate(lab.data.fuente, 'lab-fuente');

/** El título de verdad del apartado que enlaza una actividad; si no existe, el build falla. */
function tituloDelApartado(actividad: string, tema: string, apartado: string): string {
  const titulo = tituloApartado.get(`${tema}#${apartado}`);
  if (titulo === undefined)
    throw new Error(
      `El laboratorio de ${asignatura.id}, «${actividad}», enlaza el apartado "#${apartado}" de ${tema}, que no existe.`,
    );
  return titulo;
}

const actividades = await Promise.all(
  lab.data.actividades.map(async (a, i) => ({
    ...a,
    id: `lab-${a.tema}-${i}`,
    queHtml: await mate(a.que, `lab-que-${i}`),
    trabajoHtml: await Promise.all(a.trabajo.map((t, j) => mate(t, `lab-trabajo-${i}-${j}`))),
    rotulo: a.practica !== undefined ? `P${String(a.practica).padStart(2, '0')}` : `T${String(a.tema).padStart(2, '0')}`,
    /* Los temas del catálogo son los que están publicados: si uno todavía no
       lo está, la actividad se queda sin enlace en vez de apuntar a un 404. */
    href: a.donde && asignatura.data.temas.some((t) => t.id === a.donde!.tema && t.hecho)
      ? `${ruta(`${asignatura.id}/${a.donde.tema}/`)}${a.donde.apartado ? `#${a.donde.apartado}` : ''}`
      : null,
    apartado: a.donde?.apartado ? tituloDelApartado(a.titulo, a.donde.tema, a.donde.apartado) : undefined,
    usadoEn: (a.ejercicios ?? []).map((id) => {
      const e = ejercicioPorId.get(id);
      if (!e) throw new Error(`El laboratorio de ${asignatura.id}, «${a.titulo}», nombra el ejercicio "${id}", que no existe.`);
      return {
        texto: e.examen ? `${e.examen} · ${sinMarcas(e.titulo)}` : sinMarcas(e.titulo),
        href: `${ruta(e.pagina)}#ej-${id}`,
      };
    }),
  })),
);

const temas = [...new Set(actividades.map((a) => a.tema))];
/* Las sesiones, en el orden en que se hacen; sin `sesion`, un solo grupo. */
const grupos =
  conSesion > 0
    ? [...new Set(actividades.map((a) => a.sesion!))]
        .sort((x, y) => x - y)
        .map((s) => ({ sesion: s as number | null, actividades: actividades.filter((a) => a.sesion === s) }))
    : [{ sesion: null as number | null, actividades }];
---

<Base
  titulo={`Laboratorio — ${asignatura.data.nombre}`}
  descripcion={`Las ${actividades.length} actividades de laboratorio ${lab.data.herramienta} de ${asignatura.data.nombre}: qué pide cada una y dónde está explicado.`}
  acento={asignatura.data.acento}
>
  <Cabecera crumb={crumb} />

  <main id="principal">
    <div class="envoltorio">
      <p class="rotulo rotulo--live eyebrow">{asignatura.data.nombre}</p>
      <h1>El laboratorio</h1>
      <p class="lede">
        {actividades.length} actividades {lab.data.herramienta} repartidas en {temas.length} temas{grupos[0].sesion !== null && ` y ${grupos.length} sesiones`}. {lab.data.entradilla}
      </p>

      {/* El aviso va antes que nada y no en letra pequeña: alguien puede llegar
          aquí buscando «el laboratorio resuelto», y lo honesto es decirle en la
          primera pantalla que aquí no está. */}
      <aside class="aviso aviso--flag lab-aviso">
        <p class="rotulo">Qué es esto y qué no</p>
        <div class="prosa" set:html={avisoHtml} />
      </aside>

      {grupos.map((g) => (
        <section class="lab-grupo">
          {g.sesion !== null && <h2 class="lab-sesion">Sesión {g.sesion}</h2>}
          <ol class="lab-lista">
            {g.actividades.map((a) => (
              <li class="lab" id={a.id}>
                <div class="lab-cab">
                  <span class="lab-n rotulo" aria-hidden="true">{a.rotulo}</span>
                  {g.sesion !== null ? <h3>{a.titulo}</h3> : <h2>{a.titulo}</h2>}
                  {a.programa && <code class="lab-prog">{a.programa}</code>}
                </div>

                <div class="prosa lab-que" set:html={a.queHtml} />

                <p class="rotulo lab-rot">Lo que se pide hacer</p>
                <ul class="lab-trabajo">
                  {a.trabajoHtml.map((h) => <li><div class="prosa" set:html={h} /></li>)}
                </ul>

                {a.donde && (
                  a.href
                    ? <a class="lab-leer" href={a.href}>
                        <span class="rotulo">leer antes</span>
                        <span>{a.apartado ?? a.donde.texto}</span>
                      </a>
                    : <p class="lab-leer lab-leer--sin"><span class="rotulo">leer antes</span> <span>{a.apartado ?? a.donde.texto}</span></p>
                )}

                {a.usadoEn.length > 0 && (
                  <div class="lab-usa">
                    <p class="rotulo lab-rot">Dónde sale</p>
                    <ul>
                      {a.usadoEn.map((u) => <li><a href={u.href}>{u.texto}</a></li>)}
                    </ul>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}

      <p class="fuente rotulo">De dónde sale</p>
      <div class="prosa fuente-cuerpo" set:html={fuenteHtml} />
    </div>
  </main>
</Base>

<style>
  .envoltorio {
    max-width: 58rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  .eyebrow { margin-bottom: .2rem; }
  h1 { max-width: var(--measure); }
  .lede { max-width: 62ch; margin: .6rem 0 1.6rem; }

  .lab-aviso { margin-bottom: 2.4rem; }
  .lab-aviso .rotulo { margin: 0 0 .3rem; }
  .lab-aviso .prosa { font-size: .95rem; }

  .lab-grupo + .lab-grupo { margin-top: 2.4rem; }
  .lab-sesion { font-size: 1.3rem; margin: 0 0 .9rem; }

  .lab-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .lab {
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 1.1rem 1.2rem 1.2rem;
  }

  .lab-cab {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    align-items: baseline;
    gap: .2rem .7rem;
  }

  .lab-n { color: var(--live); }
  .lab-cab h2, .lab-cab h3 { margin: 0; font-size: 1.15rem; line-height: 1.3; }

  /* El nombre del fichero, en mono y sin enlace: no lo repartimos, solo se
     nombra para reconocerlo en el aula virtual. */
  .lab-prog {
    grid-column: 2;
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--faint);
  }

  .lab-que { margin: .7rem 0 0; font-size: .95rem; max-width: var(--measure); }
  .lab-rot { margin: 1rem 0 .3rem; color: var(--live); }

  .lab-trabajo {
    margin: 0;
    padding-left: 1.1rem;
    font-size: .93rem;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    max-width: var(--measure);
  }
  .lab-trabajo .prosa :global(p) { margin: 0; }

  .lab-usa ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: .92rem;
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }

  .lab-leer {
    display: flex;
    align-items: baseline;
    gap: .7rem;
    margin: 1rem 0 0;
    padding: .5rem .7rem;
    border: 1px solid var(--rule);
    border-radius: 5px;
    text-decoration: none;
    color: inherit;
    font-size: .92rem;
  }

  a.lab-leer:hover { border-color: var(--live); }
  .lab-leer .rotulo { color: var(--live); white-space: nowrap; }
  .lab-leer--sin { color: var(--faint); }

  .fuente { margin: 2.6rem 0 .3rem; }
  .fuente-cuerpo { font-size: .86rem; color: var(--graphite); max-width: var(--measure); }

  @media (max-width: 30rem) {
    .envoltorio { padding-inline: .7rem; }
    .lab { padding: .9rem .8rem 1rem; }
    .lab-cab { grid-template-columns: minmax(0, 1fr); }
    .lab-prog { grid-column: 1; }
  }
</style>
