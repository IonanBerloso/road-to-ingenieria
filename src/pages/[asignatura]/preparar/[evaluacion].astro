---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cabecera from '../../../components/ui/Cabecera.astro';
import EjercicioGuiado from '../../../components/patrones/EjercicioGuiado.astro';
import Reparto from '../../../components/ui/Reparto.astro';
import { mate } from '../../../lib/markdown.mjs';
import { ruta } from '../../../lib/rutas';
import { SUFIJO_CONV } from '../../../content.config';

/**
 * La ruta de estudio de una evaluación: qué cae, con qué frecuencia y en qué
 * orden conviene atacarlo.
 *
 * No es un índice del temario. Los bloques son **los huecos del examen**,
 * medidos contando los once últimos años, y van ordenados por lo que rinden.
 *
 * Desde la fase 3 del rediseño Pizarra (brief §6b) la página es un CAMINO
 * de bloques plegables: el primero abre, los demás al pulsarlos — que es el
 * modo guiado hecho estructura. Al imprimir se abren todos (el completo).
 * Ya no usa el patrón Lectura: el acordeón nativo hace su trabajo aquí.
 *
 * **Aquí no se declara ni un dato del examen.** Los porcentajes por
 * competencia se calculan abajo sumando los `puntos` de los ejercicios que la
 * ruta referencia. Escritos a mano en el YAML serían una cuarta fuente de
 * verdad, y acabarían separándose de lo que dicen los exámenes (§01, §10).
 */
export async function getStaticPaths() {
  const rutas = await getCollection('preparar');
  const catalogo = await getCollection('catalogo');
  const ficheros = await getCollection('ejercicios');
  const examenes = await getCollection('examen');

  /* Un solo índice para los 143 ejercicios. `[examen].astro` hace un flatMap
     dentro del bucle, es decir los recorre una vez por referencia; con una
     ruta que apunta a setenta cosas eso se nota. Y de paso, construirlo aquí
     caza ids repetidos entre ficheros distintos. */
  const porId = new Map<
    string,
    {
      titulo: string;
      puntos?: { comp1: number; comp2: number; comp4: number };
      pagina: string;
      nivel?: 'ejemplo' | 'practica' | 'examen';
    }
  >();
  for (const f of ficheros) {
    /* El id del fichero **es** la página donde vive el ejercicio:
       `calculo/t01-complejos/ejercicios` → `/calculo/t01-complejos/`, y
       `calculo/examenes/2025-2026-1ev/ejercicios` → su página de examen. Así
       un ejercicio que la ruta no incrusta se enlaza a donde sí está, en vez
       de a un ancla de esta página que no existiría. */
    const pagina = f.id.replace(/\/ejercicios$/, '');
    for (const e of f.data.ejercicios) {
      if (porId.has(e.id)) {
        throw new Error(
          `Hay dos ejercicios con el id "${e.id}". Los ids son únicos en todo el ` +
            `repositorio porque las rutas y los exámenes los referencian a ciegas.`,
        );
      }
      porId.set(e.id, { titulo: e.titulo, puntos: e.puntos, pagina, nivel: e.nivel });
    }
  }

  return rutas.map((r) => {
    const { asignatura: idAsig, evaluacion, temas, bloques } = r.data;
    const sufijo = SUFIJO_CONV[evaluacion];

    /* El nombre del fichero ES la URL. Si no casan, la ruta se publicaría en
       una dirección que no dice lo que contiene. */
    const esperado = `${idAsig}-${sufijo}`;
    if (r.id !== esperado) {
      throw new Error(
        `La ruta "${r.id}.yaml" declara ${idAsig} · ${evaluacion}, así que tiene ` +
          `que llamarse "${esperado}.yaml". O le cambias el nombre o le cambias lo que declara.`,
      );
    }

    const asignatura = catalogo.find((a) => a.id === idAsig);
    if (!asignatura) {
      throw new Error(
        `La ruta "${r.id}.yaml" es de "${idAsig}", que no está en el catálogo.`,
      );
    }

    /* Una ruta no puede mandarte a un tema que no está escrito. */
    for (const t of temas) {
      const ficha = asignatura.data.temas.find((x) => x.id === t);
      if (!ficha) {
        throw new Error(`La ruta "${r.id}.yaml" nombra el tema "${t}", que no está en el temario.`);
      }
      if (!ficha.hecho) {
        throw new Error(
          `La ruta "${r.id}.yaml" manda al tema "${t}", que el catálogo marca sin hacer. ` +
            `Una ruta de estudio no puede enlazar una página que no existe.`,
        );
      }
    }

    /** Un ejercicio de un escalón, resuelto contra la colección.
     *
     *  El `nivel` se deduce cuando el YAML no lo dice: con reparto oficial de
     *  puntos es de examen; sin él, práctica de boletín. Así los 245
     *  ejercicios ya escritos no hay que tocarlos uno a uno. */
    const resuelveEjercicio = (bid: string, x: { id: string; incrustado: boolean; nota?: string }) => {
      const e = porId.get(x.id);
      if (!e) {
        throw new Error(
          `La ruta "${r.id}.yaml", bloque "${bid}", referencia el ejercicio ` +
            `"${x.id}", que no existe en ningún ejercicios.yaml.`,
        );
      }
      return {
        ...x,
        titulo: e.titulo,
        puntos: e.puntos,
        pagina: e.pagina,
        nivel: e.nivel ?? (e.puntos ? 'examen' : 'practica'),
      };
    };

    /* Cada referencia se resuelve aquí, para que la plantilla no busque nada. */
    const bloquesResueltos = bloques.map((b) => ({
      ...b,
      escalones: (b.escalones ?? []).map((es) => ({
        ...es,
        ejercicios: es.ejercicios.map((x) => resuelveEjercicio(b.id, x)),
      })),
      material: (b.material ?? []).map((m) => {
        if (m.tipo === 'ejercicio') {
          const e = porId.get(m.id);
          if (!e) {
            throw new Error(
              `La ruta "${r.id}.yaml", bloque "${b.id}", referencia el ejercicio ` +
                `"${m.id}", que no existe en ningún ejercicios.yaml.`,
            );
          }
          return { ...m, titulo: e.titulo, puntos: e.puntos, pagina: e.pagina };
        }
        if (m.tipo === 'examen') {
          const ex = examenes.find(
            (x) => x.data.asignatura === idAsig && x.data.curso === m.curso && x.data.convocatoria === m.convocatoria,
          );
          if (!ex) {
            throw new Error(
              `La ruta "${r.id}.yaml", bloque "${b.id}", referencia el examen ` +
                `${m.curso} · ${m.convocatoria}, que no existe.`,
            );
          }
          return { ...m, slug: `${m.curso}-${SUFIJO_CONV[m.convocatoria]}`, fecha: ex.data.fecha };
        }
        const ficha = asignatura.data.temas.find((x) => x.id === m.tema);
        if (!ficha) {
          throw new Error(
            `La ruta "${r.id}.yaml", bloque "${b.id}", enlaza el tema "${m.tema}", ` +
              `que no está en el temario.`,
          );
        }
        return { ...m, tituloTema: ficha.titulo };
      }),
    }));

    return {
      params: { asignatura: idAsig, evaluacion: sufijo },
      props: { asignatura, ruta: r, bloques: bloquesResueltos },
    };
  });
}

const { asignatura, ruta: laRuta, bloques } = Astro.props;
const d = laRuta.data;

/* ── que los apartados existan de verdad ─────────────────────────────────
   `verify.mjs` parte los href por `#`, así que **no valida fragmentos**: un
   apartado mal escrito pasaría el suelo en verde y dejaría al alumno en la
   cabecera de la página. Y son fáciles de escribir mal, porque el generador
   de MDX conserva los acentos: «Raíces n-ésimas…» produce
   `raíces-n-ésimas-cuántas-hay…`. Se comprueba aquí, contra los encabezados
   reales, y el build falla si alguno no está. */
const coleccion = await getCollection(asignatura.id as 'calculo' | 'fluidos');
const slugsPorTema = new Map<string, string[]>();
/* El título de verdad del apartado, indexado por «tema#slug».
   Hasta el 23 de agosto de 2026 el enlace mostraba el slug con los guiones
   cambiados por espacios —«las dos formas y por qué hacen falta las dos»—, en
   minúsculas y sin puntuación. El título ya estaba aquí; solo había que no
   tirarlo. */
const tituloApartado = new Map<string, string>();
for (const t of d.temas) {
  const entrada = coleccion.find((e) => e.id === t || e.id.startsWith(`${t}/`));
  if (!entrada) throw new Error(`No existe el index.mdx de "${t}".`);
  const { headings } = await render(entrada);
  /* Nivel 2 **y 3**. Los `###` son la granularidad que un escalón necesita:
     «Lugares geométricos» es un apartado de diecisiete ejercicios, pero
     dentro tiene Apolonio, el arco capaz, la elipse y la parábola, que son
     cuatro herramientas distintas y cuatro escalones distintos. Enlazarlos
     funciona porque `Lectura` abre el grupo que **contiene** el ancla, no
     solo el que la encabeza. */
  const dos = headings.filter((h) => h.depth === 2 || h.depth === 3);
  slugsPorTema.set(t, dos.map((h) => h.slug));
  for (const h of dos) tituloApartado.set(`${t}#${h.slug}`, h.text);
}
for (const b of bloques) {
  const enlaces = [
    ...b.material.filter((m) => m.tipo === 'teoria' && m.apartado),
    ...b.escalones.flatMap((es) => (es.teoria ? [es.teoria] : [])),
  ] as Array<{ tema: string; apartado?: string }>;
  for (const m of enlaces) {
    if (!m.apartado) continue;
    /* Los dos fallos son distintos y hasta ahora daban el mismo mensaje: si el
       tema no está en `temas[]` no hay anclas que listar, y el error decía
       «no existe. Los que hay son:» seguido de nada. Costó una vuelta el 28 de
       agosto de 2026 al enlazar sucesiones desde la extraordinaria. */
    const slugs = slugsPorTema.get(m.tema);
    if (!slugs) {
      throw new Error(
        `La ruta "${laRuta.id}.yaml", bloque "${b.id}", enlaza el apartado ` +
          `"#${m.apartado}" de ${m.tema}, pero ese tema no está en su lista ` +
          `"temas". Añádelo ahí primero.`,
      );
    }
    if (!slugs.includes(m.apartado)) {
      throw new Error(
        `La ruta "${laRuta.id}.yaml", bloque "${b.id}", enlaza el apartado ` +
          `"#${m.apartado}" de ${m.tema}, que no existe. Los que hay son:\n    ` +
          slugs.join('\n    '),
      );
    }
  }
}

/** El href de un apartado de teoría.
 *
 *  `ruta()` añade siempre una barra final porque todas las páginas del sitio
 *  son directorios, así que el ancla **no puede ir dentro**: producía
 *  `…/t01-complejos/#las-dos-formas…/`, un fragmento que no existe, y el
 *  alumno caía en la cabecera del tema en vez de en el apartado. Estuvo así
 *  hasta el 23 de agosto de 2026 y afectaba a los 58 enlaces de teoría de las
 *  tres rutas. Se construye como ya se hacía con los ejercicios: la página por
 *  `ruta()`, y el ancla concatenada después. */
const hrefTeoria = (tema: string, apartado?: string) =>
  `${ruta(`${asignatura.id}/${tema}/`)}${apartado ? `#${apartado}` : ''}`;

/* ── el reparto de competencias, calculado ───────────────────────────────
   Sobre **todos** los exámenes de esta convocatoria, no sobre los ejercicios
   que la ruta cita.

   La primera versión sumaba los referenciados y daba 61,4 % donde la
   evaluación entera da 60,0 %: la ruta deja fuera dos ejercicios a propósito
   —la variante de exponencial y logaritmo, que no cae desde 2020-2021— y eso
   movía el dato. Un número que cambia según lo que la ruta decida recomendar
   no es una medición de lo que pide el examen: es exactamente la cuarta
   fuente de verdad que esta página existe para no crear (§10). */
const examenesTodos = await getCollection('examen');
const deLaConvocatoria = examenesTodos.filter(
  (x) => x.data.asignatura === asignatura.id && x.data.convocatoria === d.evaluacion,
);
const ficherosTodos = await getCollection('ejercicios');
const puntosPorId = new Map(
  ficherosTodos.flatMap((f) => f.data.ejercicios.map((e) => [e.id, e.puntos] as const)),
);

const suma = { comp1: 0, comp2: 0, comp4: 0 };
let conPuntos = 0;
for (const ex of deLaConvocatoria) {
  for (const { id } of ex.data.ejercicios) {
    const p = puntosPorId.get(id);
    if (!p) continue;
    suma.comp1 += p.comp1;
    suma.comp2 += p.comp2;
    suma.comp4 += p.comp4;
    conPuntos++;
  }
}
const total = suma.comp1 + suma.comp2 + suma.comp4;
const pct = (n: number) => ((100 * n) / total).toFixed(1).replace('.', ',');

/** Cuántos ejercicios de examen hay en esta evaluación, **con o sin reparto**.
 *
 *  Hace falta porque no todas las escuelas publican el reparto por
 *  competencia. Cálculo y Álgebra sí; **Mecánica de Fluidos no**: sus
 *  cuadernillos dan el porcentaje de cada ejercicio sobre el total y nada más,
 *  así que `puntos` va vacío en los 107 ejercicios de sus 16 convocatorias.
 *
 *  Y eso, hasta el 4 de septiembre de 2026, se publicaba así en la página de
 *  la ruta de Fluidos, en negrita y con la asignatura declarada terminada:
 *
 *      Medido sobre 16 convocatorias · 0 ejercicios · 0 puntos.
 *      El NaN % de la nota no es calcular; la explicación formal sola vale
 *      el NaN %.
 *      Esta ruta te lleva por 54 de esos 0 ejercicios.
 *
 *  Cero guardián lo vio: `verify.mjs` no lee texto, `humo.mjs` mira figuras y
 *  pestañas, y el suelo estaba en verde. Lo vio abrir la página (§16 punto 1),
 *  que es justo lo que llevaba semanas sin hacerse. */
const ejerciciosDeExamen = deLaConvocatoria
  .reduce((n, ex) => n + ex.data.ejercicios.length, 0);
const hayReparto = total > 0;

/** Cuántos de esos ejercicios están en la ruta, para poder decirlo sin
 *  presumir de cubrirlos todos.
 *
 *  Los ejercicios viven en DOS sitios desde que existe el escalón: en el
 *  `material` plano del bloque y en el `ejercicios` de cada escalón. Esta
 *  cuenta solo miraba el primero, y por eso cinco de las seis rutas publicaban
 *  «te lleva por 0 de esos N» siendo falso — las cinco que ya estaban
 *  convertidas a escalones. Medido el 26 de agosto de 2026: 1.ª, 3.ª, 4.ª, 5.ª
 *  y ordinaria decían cero; la 2.ª decía seis porque conserva un bloque con
 *  `material`. Es §10 incumplido en la capa compartida, no en el contenido. */
const citados = new Set(
  bloques.flatMap((b) => [
    ...b.material.filter((m) => m.tipo === 'ejercicio').map((m) => m.id),
    ...b.escalones.flatMap((es) => es.ejercicios.map((x) => x.id)),
  ]),
);
const deExamenCitados = deLaConvocatoria
  .flatMap((ex) => ex.data.ejercicios.map((e) => e.id))
  .filter((id) => citados.has(id)).length;

const ledeHtml = await mate(d.lede);
const ordenHtml = await mate(d.criterioDeOrden);
const bloquesHtml = await Promise.all(
  bloques.map(async (b) => ({
    ...b,
    pideHtml: await mate(b.pide),
    porqueHtml: await mate(b.porque),
    /* El dominio del BLOQUE cierra su tarjeta («lo tienes cuando:»). Hasta la
       fase 3 del rediseño el esquema lo exigía y la página lo tiraba sin
       pintarlo — la corrección de fondo del brief §6b. */
    dominioHtml: await mate(b.dominio),
    faltaHtml: await Promise.all(b.falta.map((f) => mate(f))),
    material: await Promise.all(
      b.material.map(async (m) => ({ ...m, notaHtml: m.nota ? await mate(m.nota) : null })),
    ),
    escalones: await Promise.all(
      b.escalones.map(async (es) => ({
        ...es,
        aprendesHtml: await mate(es.aprendes),
        dominioHtml: await mate(es.dominio),
        teoria: es.teoria
          ? { ...es.teoria, notaHtml: es.teoria.nota ? await mate(es.teoria.nota) : null }
          : null,
        ejercicios: await Promise.all(
          es.ejercicios.map(async (x) => ({
            ...x,
            notaHtml: x.nota ? await mate(x.nota) : null,
          })),
        ),
      })),
    ),
  })),
);

const crumb = `${asignatura.data.nombre} · preparar`;

/* Las falta[] de todos los bloques, juntas para la tarjeta del carril
   («Lo que falta, dicho en voz alta», brief §6b): la honestidad declarada
   hecha interfaz. Cada una lleva el nombre de su bloque. */
const faltas = bloquesHtml.flatMap((b) =>
  b.faltaHtml.map((html) => ({ bloque: b.titulo, html })),
);
---

<Base
  titulo={`${d.titulo} — ${asignatura.data.nombre}`}
  descripcion={d.lede.slice(0, 160)}
  acento={asignatura.data.acento}
  crumb={crumb}
>
  <Cabecera crumb={crumb} />

  <main id="principal" class="envoltorio">
    <div class="dos-columnas">
    <div class="camino-col">
    <p class="mano kicker">
      medido sobre {d.medidoSobre} convocatorias — nada por intuición
    </p>
    <h1>{d.titulo}</h1>
    <div class="lede prosa" set:html={ledeHtml} />

    {/* ── el camino de bloques (brief §6b): números en círculo unidos por
        una espina de tiza. El orden ES el contenido de una ruta, y la
        maqueta lo hace visible. El primero abre; los demás, al pulsarlos. */}
    <ol class="camino">
      {
        bloquesHtml.map((b, i) => (
          <li class="bloq">
            <span class="mano bnum" aria-hidden="true">{i + 1}</span>
            <details class="bcaja" open={i === 0} data-bloque>
              <summary>
                <h2 id={b.id}>{b.titulo}</h2>
                {b.apunte && (
                  <span class:list={['mano', 'apunte', `apunte--${b.apunte.tono}`]}>
                    {b.apunte.texto}
                  </span>
                )}
                <span class="bmeta rotulo">
                  {b.escalones.length > 0
                    ? `${b.escalones.length} ${b.escalones.length === 1 ? 'escalón' : 'escalones'}`
                    : `${b.material.length} referencias`}
                </span>
                <span class="bflecha" aria-hidden="true">▾</span>
              </summary>

              <div class="bcuerpo">
            {b.invariante && (
              <p class="frecuencia rotulo rotulo--flag">
                Cae {b.invariante.anios} de {d.medidoSobre} años
              </p>
            )}

            <div class="prosa pide" set:html={b.pideHtml} />
            <div class="prosa porque" set:html={b.porqueHtml} />

            {b.invariante && (
              <aside class="nota">
                <p class="rotulo">De dónde sale ese dato</p>
                <p>{b.invariante.fuente}</p>
              </aside>
            )}

            {b.escalones.map((es, k) => (
              <section class="escalon" data-escalon={es.id} data-total={es.ejercicios.length}>
                <div class="e-cab">
                  <span class="e-n rotulo" aria-hidden="true">{String(k + 1).padStart(2, '0')}</span>
                  <h3 id={`esc-${es.id}`}>{es.titulo}</h3>
                  <span class="e-cuenta rotulo" data-cuenta hidden />
                </div>

                <div class="prosa e-aprendes" set:html={es.aprendesHtml} />

                {es.teoria && (
                  <a class="e-leer" href={hrefTeoria(es.teoria.tema, es.teoria.apartado)}>
                    <span class="m-k rotulo">leer</span>
                    <span class="m-t">
                      {tituloApartado.get(`${es.teoria.tema}#${es.teoria.apartado}`)}
                    </span>
                  </a>
                )}
                {es.teoria?.notaHtml && (
                  <div class="prosa m-nota" set:html={es.teoria.notaHtml} />
                )}

                <ol class="material e-lista">
                  {es.ejercicios.map((x) => (
                    <li class={`m m--ejercicio m--${x.nivel}`} data-ej={x.id}>
                      <a
                        href={x.incrustado ? `#ej-${x.id}` : `${ruta(x.pagina)}#ej-${x.id}`}
                        class="m-ej"
                      >
                        <span class="m-k rotulo">
                          {x.nivel === 'ejemplo'
                            ? 'ejemplo'
                            : x.nivel === 'examen'
                              ? 'examen'
                              : 'práctica'}
                        </span>
                        <span class="m-t">{x.titulo}</span>
                        <span class="m-tick" data-tick aria-hidden="true">✓</span>
                      </a>
                      {x.notaHtml && <div class="prosa m-nota" set:html={x.notaHtml} />}
                    </li>
                  ))}
                </ol>

                {es.ejercicios
                  .filter((x) => x.incrustado)
                  .map((x) => <EjercicioGuiado id={x.id} />)}

                <div class="e-dominio">
                  <p class="rotulo">Lo tienes cuando</p>
                  <div class="prosa" set:html={es.dominioHtml} />
                </div>
              </section>
            ))}

            {b.escalones.length > 0 && (
              <aside class="nota progreso no-imprimir" data-progreso hidden>
                <p class="rotulo">Tu avance</p>
                <p>
                  Lo que vas resolviendo se marca aquí y se recuerda al volver.
                  Se guarda <strong>solo en este navegador</strong>: no es una
                  cuenta, no sale de tu ordenador, y desaparece si borras los
                  datos del sitio.
                </p>
                <button type="button" class="fantasma" data-borrar>Borrar mi avance</button>
              </aside>
            )}

            {b.material.length > 0 && (
            <ol class="material">
              {b.material.map((m) => (
                <li class={`m m--${m.tipo}`}>
                  {m.tipo === 'teoria' && (
                    <a href={hrefTeoria(m.tema, m.apartado)}>
                      <span class="m-k rotulo">leer</span>
                      <span class="m-t">
                        {(m.apartado && tituloApartado.get(`${m.tema}#${m.apartado}`)) ||
                          m.tituloTema}
                      </span>
                    </a>
                  )}

                  {m.tipo === 'examen' && (
                    <a href={ruta(`${asignatura.id}/examenes/${m.slug}/`)}>
                      <span class="m-k rotulo">examen</span>
                      <span class="m-t">{m.curso} · {m.fecha}</span>
                    </a>
                  )}

                  {m.tipo === 'ejercicio' && !m.incrustado && (
                    <a href={`${ruta(m.pagina)}#ej-${m.id}`} class="m-ej">
                      <span class="m-k rotulo">{m.puntos ? 'examen' : 'boletín'}</span>
                      <span class="m-t">{m.titulo}</span>
                      {m.puntos && (
                        <span class="m-pts rotulo">
                          {m.puntos.comp1 + m.puntos.comp2 + m.puntos.comp4} pts
                        </span>
                      )}
                    </a>
                  )}

                  {m.notaHtml && <div class="prosa m-nota" set:html={m.notaHtml} />}
                </li>
              ))}
            </ol>
            )}

            {b.material
              .filter((m) => m.tipo === 'ejercicio' && m.incrustado)
              .map((m) => <EjercicioGuiado id={m.id} />)}

            {/* El cierre del bloque: su criterio de dominio, SIEMPRE pintado
                (brief §6b — el esquema lo exigía y la página lo tiraba). */}
            <div class="b-dominio">
              <span class="mano bd-k">lo tienes cuando:</span>
              <div class="prosa" set:html={b.dominioHtml} />
            </div>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
    </div>

    {/* ── el carril derecho (brief §6b) ── */}
    <aside class="carril" aria-label="El porqué del orden y lo que falta">
      <div class="orden-caja">
        <p class="mano oc-tit">Por qué este orden</p>
        <div class="prosa oc-cuerpo" set:html={ordenHtml} />
      </div>

      <div class="eval-caja">
        <p class="rotulo ec-tit">Esta evaluación</p>
        {hayReparto ? (
          <>
            <p class="ec-dato">
              Medido sobre {d.medidoSobre} convocatorias · {conPuntos} ejercicios ·{' '}
              {total} puntos.
            </p>
            <Reparto puntos={suma} rotulo="Reparto de la nota por competencia" />
            <p class="ec-dato ec-dato--fuerte">
              El {pct(suma.comp1 + suma.comp4)} % de la nota no es calcular; la
              explicación formal sola vale el {pct(suma.comp4)} %.
            </p>
          </>
        ) : (
          <>
            <p class="ec-dato">
              Medido sobre {d.medidoSobre} convocatorias · {ejerciciosDeExamen}{' '}
              ejercicios transcritos.
            </p>
            <p class="ec-dato ec-dato--fuerte">
              Estos exámenes no publican el reparto por competencia — solo el
              peso de cada ejercicio sobre el total —, así que aquí no hay
              porcentaje que enseñar. Lo que no está medido no se estima.
            </p>
          </>
        )}
        <p class="ec-flojo">
          {deExamenCitados >= ejerciciosDeExamen
            ? `Esta ruta te lleva por los ${ejerciciosDeExamen}, sin dejarse ninguno.`
            : `Esta ruta te lleva por ${deExamenCitados} de esos ${ejerciciosDeExamen} ejercicios; los que faltan están nombrados con su motivo.`}{' '}
          Un bloque no se acaba: se domina — cada uno te dice cómo sabes que ya
          lo tienes.
        </p>
      </div>

      {faltas.length > 0 && (
        <div class="falta-caja">
          <p class="rotulo fc-tit">Lo que falta, dicho en voz alta</p>
          {faltas.map((f) => (
            <div class="fc-item">
              <p class="rotulo fc-bloque">{f.bloque}</p>
              <div class="prosa" set:html={f.html} />
            </div>
          ))}
          <p class="fc-lema">
            Un hueco declarado es información; uno escondido, una promesa
            incumplida.
          </p>
        </div>
      )}

      <p class="mano consejo">empieza por el bloque 1 aunque te sepas el tema</p>
    </aside>
    </div>
  </main>
</Base>

<script>
  /* ── el camino de bloques plegables ──────────────────────────────
     Tres deberes que un <details> no hace solo:
     1 · Un ancla dentro de un bloque cerrado (#esc-…, #ej-…, #bloque) no
         navega: el destino no tiene caja (§17). Se abre su bloque y se
         salta a mano — el mismo remedio que Tema y Examen.
     2 · Al imprimir se abren todos (el «modo completo» de esta página) y
         se devuelven a como estaban.
     3 · El contenido de un details cerrado no se ve, pero humo.mjs ya
         sabe abrirlos para medir (29-08-2026). */
  {
    const bloquesDet = [...document.querySelectorAll<HTMLDetailsElement>('details[data-bloque]')];

    const abreElAncla = () => {
      const destino = decodeURIComponent(location.hash.slice(1));
      if (!destino) return;
      const el = document.getElementById(destino);
      if (!el) return;
      const caja = el.closest('details');
      if (caja && !caja.open) caja.open = true;
      el.scrollIntoView({ block: 'start' });
    };

    abreElAncla();
    window.addEventListener('hashchange', abreElAncla);

    let abiertos: boolean[] = [];
    window.addEventListener('beforeprint', () => {
      abiertos = bloquesDet.map((x) => x.open);
      for (const x of bloquesDet) x.open = true;
    });
    window.addEventListener('afterprint', () => {
      bloquesDet.forEach((x, i) => (x.open = abiertos[i] ?? false));
    });
  }

  /* Las marcas de aprendizaje.
   *
   * Lo escribe `EjercicioGuiado` al completar un ejercicio, y aquí solo se
   * lee y se pinta. Todo lo que sigue es decorativo por diseño: sin
   * JavaScript, o con el almacenamiento bloqueado, la página se lee entera y
   * lo único que falta son las palomitas. Por eso el aviso nace `hidden` y
   * solo aparece si de verdad hay algo que contar. */
  const escalones = [...document.querySelectorAll<HTMLElement>('[data-escalon]')];

  if (escalones.length) {
    const aviso = document.querySelector<HTMLElement>('[data-progreso]');

    const lee = (): Record<string, boolean> => {
      try {
        return JSON.parse(localStorage.getItem('rti:hechos') ?? '{}');
      } catch {
        return {};
      }
    };

    function pinta() {
      const hechos = lee();
      for (const es of escalones) {
        const filas = [...es.querySelectorAll<HTMLElement>('[data-ej]')];
        let n = 0;
        for (const fila of filas) {
          const hecho = Boolean(hechos[fila.dataset.ej!]);
          fila.classList.toggle('m--hecho', hecho);
          if (hecho) n++;
        }
        const cuenta = es.querySelector<HTMLElement>('[data-cuenta]');
        if (cuenta) {
          cuenta.hidden = false;
          cuenta.textContent = n === filas.length ? 'escalón completo' : `${n} de ${filas.length}`;
          cuenta.classList.toggle('e-cuenta--lleno', n === filas.length);
        }
        es.classList.toggle('escalon--hecho', n === filas.length && filas.length > 0);
      }
      if (aviso) aviso.hidden = false;
    }

    pinta();
    /* Un ejercicio incrustado en esta misma página se marca en el momento. */
    document.addEventListener('rti:hecho', pinta);

    document.querySelector<HTMLButtonElement>('[data-borrar]')?.addEventListener('click', () => {
      try {
        localStorage.removeItem('rti:hechos');
      } catch {}
      pinta();
    });
  }
</script>

