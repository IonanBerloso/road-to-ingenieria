---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/ui/Cabecera.astro';
import Tema from '../../components/ui/Tema.astro';
import Lectura from '../../components/patrones/Lectura.astro';
import EjercicioGuiado from '../../components/patrones/EjercicioGuiado.astro';
import { ruta } from '../../lib/rutas';
import { SUFIJO_CONV } from '../../content.config';

/**
 * Una página por tema terminado. El cruce entre el catálogo y los temas
 * escritos se comprueba aquí: si el catálogo dice `hecho: true` y no existe
 * el index.mdx, **el build falla**. Los datos no se comprueban a ojo (§03).
 */
export async function getStaticPaths() {
  const catalogo = await getCollection('catalogo');

  /** Se piden solo las colecciones que hagan falta: pedir una vacía ensucia
   *  la salida del build con avisos que no significan nada.
   *
   *  La lista va aquí, en una constante con nombre, y no dispersa en un `if`.
   *  Cuando solo existían `calculo` y `fluidos` estaba escrita como
   *  `id !== 'calculo' && id !== 'fluidos'`, y al escribir el primer tema de
   *  Álgebra el build **no falló**: se saltó la asignatura entera en silencio
   *  y la página no se publicó. Es la misma forma exacta del fallo que tenía
   *  el guardián de convocatorias huérfanas de `verify.mjs`, y por eso se
   *  arregla aquí arriba y no con un `||` más (§01). */
  const CON_TEMAS = ['calculo', 'fluidos', 'algebra'] as const;
  type ConTemas = (typeof CON_TEMAS)[number];
  const tieneTemas = (id: string): id is ConTemas =>
    (CON_TEMAS as readonly string[]).includes(id);

  const cache = new Map<string, CollectionEntry<ConTemas>[]>();
  const coleccionDe = async (id: string) => {
    if (!cache.has(id)) {
      if (!tieneTemas(id)) return null;
      cache.set(id, await getCollection(id));
    }
    return cache.get(id) ?? null;
  };

  const rutas = [];

  for (const asignatura of catalogo) {
    const hechos = asignatura.data.temas.filter((t) => t.hecho);
    if (hechos.length === 0) continue;

    if (!tieneTemas(asignatura.id)) {
      throw new Error(
        `El catálogo de "${asignatura.id}" marca temas como hechos, pero esa asignatura ` +
          `no está en CON_TEMAS, unas líneas más arriba de este fichero. Añádela ahí y ` +
          `declara su colección en content.config.ts, o pon hecho: false.`,
      );
    }

    const coleccion = await coleccionDe(asignatura.id);
    if (!coleccion || coleccion.length === 0) {
      throw new Error(
        `El catálogo de "${asignatura.id}" marca temas como hechos, pero no hay ` +
          `colección src/content/${asignatura.id}/. O escribes los temas o pones hecho: false.`,
      );
    }

    for (const tema of hechos) {
      const entrada = coleccion.find((e) => e.id === tema.id || e.id.startsWith(`${tema.id}/`));
      if (!entrada) {
        throw new Error(
          `El catálogo dice que "${asignatura.id} · ${tema.id}" está hecho, pero no existe ` +
            `src/content/${asignatura.id}/${tema.id}/index.mdx.`,
        );
      }
      if (entrada.data.tema !== tema.n) {
        throw new Error(
          `Descuadre en "${asignatura.id} · ${tema.id}": el catálogo dice tema ${tema.n} y ` +
            `el index.mdx dice ${entrada.data.tema}.`,
        );
      }

      rutas.push({
        params: { asignatura: asignatura.id, tema: tema.id },
        props: { asignatura, entrada, ficha: tema },
      });
    }
  }

  return rutas;
}

const { asignatura, entrada, ficha } = Astro.props;
const { Content, headings } = await render(entrada);

/** Los ejercicios del tema salen de su `ejercicios.yaml`, no del MDX: añadir
 *  uno es escribir datos y aparece solo en la pestaña (§04). */
const ficheroEjercicios = (await getCollection('ejercicios')).find(
  (f) => f.id === `${asignatura.id}/${ficha.id}/ejercicios`,
);
const ejercicios = ficheroEjercicios?.data.ejercicios ?? [];

/** La tarjeta «practica lo que acabas de leer» (brief §6) enlaza al primer
 *  ejercicio de nivel ejemplo: el que puede hacer alguien que acaba de leer
 *  la teoría. Si el tema no tiene ninguno, la tarjeta no se dibuja — una
 *  invitación a practicar que aterriza en un ejercicio de examen sería la
 *  queja del escalón (§14) con otra cara. */
const primerEjemplo = ejercicios.find((e) => e.nivel === 'ejemplo');

/** A dónde se puede seguir desde este tema.
 *
 *  Hasta el 4 de septiembre de 2026 la respuesta era: **a la portada y nada
 *  más**. Contado sobre el sitio construido, una página de tema tenía un solo
 *  enlace de navegación —el del wordmark—, así que para pasar del tema 4 al 5
 *  había que volver al principio y entrar otra vez, y desde dentro de una
 *  asignatura no se llegaba ni a sus exámenes ni a su ruta. Cuarenta y una
 *  páginas así, en las tres asignaturas.
 *
 *  Lo cazó contar el grafo de enlaces, no un guardián: `verify.mjs` comprueba
 *  que ningún enlace esté roto, y nadie comprobaba lo contrario. */
const hechosDeLaAsignatura = asignatura.data.temas.filter((t) => t.hecho);
const donde = hechosDeLaAsignatura.findIndex((t) => t.id === ficha.id);
const enlaceTema = (t: (typeof hechosDeLaAsignatura)[number] | undefined) =>
  t ? { href: ruta(`${asignatura.id}/${t.id}`), titulo: t.titulo, n: t.n } : undefined;

const todasLasRutas = await getCollection('preparar');
const rutasDelTema = todasLasRutas
  .filter((r) => r.data.asignatura === asignatura.id && r.data.temas.includes(ficha.id))
  .map((r) => ({
    href: ruta(`${asignatura.id}/preparar/${SUFIJO_CONV[r.data.evaluacion]}`),
    titulo: r.data.titulo,
  }));

const convocatorias = (await getCollection('examen')).filter(
  (e) => e.data.asignatura === asignatura.id,
).length;

const navegacion = {
  anterior: enlaceTema(hechosDeLaAsignatura[donde - 1]),
  siguiente: enlaceTema(hechosDeLaAsignatura[donde + 1]),
  examenes: { href: ruta(`${asignatura.id}/examenes`), cuantos: convocatorias },
  rutas: rutasDelTema,
};
---

<Base
  titulo={`${entrada.data.titulo} — ${asignatura.data.nombre}`}
  descripcion={entrada.data.descripcion}
  acento={asignatura.data.acento}
  crumb={`${asignatura.data.nombre} · tema ${String(ficha.n).padStart(2, '0')}`}
>
  <Cabecera crumb={`${asignatura.data.nombre} · tema ${String(ficha.n).padStart(2, '0')}`}>
    {/* El conmutador guiado/completo, en la barra pizarra (brief §6). Nace
        oculto: lo enciende el script de Lectura cuando hay más de un
        apartado, exactamente igual que cuando vivía dentro de la columna. */}
    <div class="modos no-imprimir" role="group" aria-label="Modo de lectura" data-modos hidden>
      <button type="button" data-modo="guiado" aria-pressed="true">guiado</button>
      <button type="button" data-modo="completo" aria-pressed="false">completo</button>
      <span class="rotulo avance" data-avance></span>
    </div>
  </Cabecera>

  <main id="principal">
    <Tema
      eyebrow={`${asignatura.data.nombre} · tema ${String(ficha.n).padStart(2, '0')}`}
      titulo={entrada.data.titulo}
      descripcion={entrada.data.descripcion}
      headings={headings}
      ejercicios={ejercicios.map((e) => ({ id: e.id, titulo: e.titulo }))}
      fuente={entrada.data.fuente}
      competencias={entrada.data.competencias}
      navegacion={navegacion}
    >
      <Lectura slot="teoria">
        <Content />
        {primerEjemplo && (
          <div class="practica no-imprimir" data-practica>
            <p class="rotulo pr-k">Practica lo que acabas de leer</p>
            <p class="pr-tit">{primerEjemplo.titulo}</p>
            <p class="pr-sub">
              Ejemplo introductorio, para entrar de cero. Cada paso equivocado
              recibe su diagnóstico, no un «incorrecto».
            </p>
            <a class="pr-cta" href={`#ej-${primerEjemplo.id}`}>Hacer el ejercicio →</a>
          </div>
        )}
      </Lectura>

      <Fragment slot="ejercicios">
        {ejercicios.map((e) => <EjercicioGuiado id={e.id} />)}
      </Fragment>
    </Tema>
  </main>
</Base>

<style>
  /* La tarjeta «practica lo que acabas de leer» (brief §6). El tablero la
     pone en un carril derecho que la página de tema no tiene; aquí cierra
     la lectura, que es el momento en el que la invitación tiene sentido. */
  .practica {
    margin-top: 2.2rem;
    background: var(--panel);
    border: 1.5px solid var(--rule);
    border-radius: 12px;
    padding: 1rem 1.25rem 1.1rem;
    box-shadow: var(--shadow-1);
  }

  .pr-k { color: var(--live); margin-bottom: .4rem; }

  .pr-tit { font-size: .95rem; font-weight: 700; margin-bottom: .35rem; }

  .pr-sub {
    font-size: .82rem;
    color: var(--graphite);
    line-height: 1.5;
    margin-bottom: .8rem;
  }

  .pr-cta {
    display: inline-block;
    font-size: .82rem;
    font-weight: 700;
    color: var(--piz-medio);
    background: var(--tiza-amarilla);
    border-radius: 8px;
    padding: .5rem 1rem;
    text-decoration: none;
    transition: background .15s;
  }

  .pr-cta:hover { background: var(--tiza-amarilla-hover); }
</style>
