---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/ui/Cabecera.astro';
import EnlaceAsignatura from '../../components/ui/EnlaceAsignatura.astro';
import { escribe, type Columna } from '../../lib/tablas-vapor';
import { CABECERAS, ERRATAS, ERRATAS_PROBABLES } from '../../lib/anexo-vapor';
/* El diagrama lo escribe `scripts/figuras/termica-mollier.mjs`, con la misma
   formulación que las tablas, y va en línea: sus colores son las fichas del
   sitio, y en un <img> no se verían. */
import mollier from '../../content/tablas/vapor-de-agua-mollier.svg?raw';

/**
 * Las tablas del agua y su vapor de una asignatura, con la rejilla del anexo
 * del curso (fase F1 de la auditoría del 27 de septiembre de 2026). Hoy solo
 * las tiene Térmica.
 *
 * POR QUÉ EXISTE. El examen de Térmica se hace con el anexo de tablas delante,
 * y hasta esta fase el sitio nunca había hecho usarlo: los enunciados de vapor
 * traían los valores ya leídos, así que se aprendía a hacer la cuenta y no a
 * sacar el dato, que es donde se equivoca uno con el anexo (la columna, la
 * presión de al lado, la interpolación). Las tablas del anexo son de una
 * editorial y no se copian (§08): estas se calculan, con la misma rejilla.
 *
 * Los números los escribe `scripts/tablas-vapor.mjs` en
 * `src/content/tablas/`, con IAPWS-95, que es la formulación de la que sale
 * casi todo el anexo; aquí solo se pintan, con las cifras que dice cada
 * columna. Dónde se aparta del anexo, y sus erratas, lo cuenta la última
 * sección con los datos de `lib/anexo-vapor.ts`: el examen se hace con el
 * anexo, y quien practica aquí tiene que saber en qué celdas no son lo mismo.
 */
export async function getStaticPaths() {
  const catalogo = await getCollection('catalogo');
  const tablas = await getCollection('tablas');
  return tablas.flatMap((t) => {
    const asignatura = catalogo.find((c) => c.id === t.data.asignatura);
    return asignatura ? [{ params: { asignatura: asignatura.id }, props: { asignatura, tablas: t.data } }] : [];
  });
}

const { asignatura, tablas } = Astro.props;
const crumb = `${asignatura.data.nombre} · tablas`;

const celda = (x: number, c: Columna) => escribe(x, c.formato);
const NOMBRE_TABLA = { sobrecalentado: 'sobrecalentado', liquido: 'líquido' } as const;
const grados = (x: number) => escribe(x, { decimales: 2 });
const bar = (p: number) => escribe(p, { exacto: true });

---

<Base
  titulo={`Tablas del agua y su vapor — ${asignatura.data.nombre}`}
  descripcion={`Las tablas de vapor de ${asignatura.data.nombre} con la rejilla del anexo del curso: saturación por temperatura y por presión, vapor sobrecalentado y líquido comprimido.`}
  acento={asignatura.data.acento}
>
  <Cabecera crumb={crumb} />

  <main id="principal">
    <div class="envoltorio">
      <p class="rotulo rotulo--live eyebrow no-imprimir"><EnlaceAsignatura id={asignatura.id} nombre={asignatura.data.nombre} /></p>
      <h1>{tablas.titulo}</h1>
      <p class="lede">
        Las cuatro tablas del anexo del curso —saturación por temperatura y por
        presión, vapor sobrecalentado y líquido comprimido— con su misma rejilla:
        las mismas presiones y las mismas temperaturas, y por tanto los mismos
        huecos, que son los que obligan a interpolar. Los números no están
        copiados del anexo: salen de {tablas.formulacion}, y en la saturación y
        en el sobrecalentado hasta 1000 °C coinciden con los suyos en todas las
        cifras que imprime. Dónde se apartan, y las erratas del anexo, está al
        final: <a href="#anexo">en qué se aparta del anexo</a>.
      </p>

      <nav class="indice no-imprimir" aria-label="Las tablas de esta página">
        <a href="#saturacion-temperatura">Saturación, por temperatura</a>
        <a href="#saturacion-presion">Saturación, por presión</a>
        <a href="#sobrecalentado">Vapor sobrecalentado</a>
        <a href="#liquido">Líquido comprimido</a>
        <a href="#mollier">El diagrama de Mollier</a>
        <a href="#anexo">En qué se aparta del anexo</a>
      </nav>

      <section id="saturacion-temperatura" class="bloque">
        <h2>Agua y vapor saturados, por temperatura</h2>
        <p class="nota">
          De 0,01 °C, el punto triple, a 100 °C, de grado en grado. v′ y h′ son
          los del líquido saturado; v″ y h″, los del vapor.
        </p>
        <div class="caja caja--larga" tabindex="0" role="region" aria-label="tabla con desplazamiento">
          <table>
            <thead>
              <tr>{tablas.saturacionT.columnas.map((c) => <th scope="col"><span class="c-t">{c.titulo}</span><span class="c-u">{c.unidad}</span></th>)}</tr>
            </thead>
            <tbody>
              {tablas.saturacionT.filas.map((f) => (
                <tr>{f.map((x, i) => (i === 0 ? <th scope="row">{celda(x, tablas.saturacionT.columnas[i])}</th> : <td>{celda(x, tablas.saturacionT.columnas[i])}</td>))}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="saturacion-presion" class="bloque">
        <h2>Agua y vapor saturados, por presión</h2>
        <p class="nota">
          De 0,01 a 210 bar. Por encima, a 220,64 bar, está el punto crítico, y
          ya no hay campana.
        </p>
        <div class="caja caja--larga" tabindex="0" role="region" aria-label="tabla con desplazamiento">
          <table>
            <thead>
              <tr>{tablas.saturacionP.columnas.map((c) => <th scope="col"><span class="c-t">{c.titulo}</span><span class="c-u">{c.unidad}</span></th>)}</tr>
            </thead>
            <tbody>
              {tablas.saturacionP.filas.map((f) => (
                <tr>{f.map((x, i) => (i === 0 ? <th scope="row">{celda(x, tablas.saturacionP.columnas[i])}</th> : <td>{celda(x, tablas.saturacionP.columnas[i])}</td>))}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="sobrecalentado" class="bloque">
        <h2>Vapor sobrecalentado</h2>
        <p class="nota">
          Una tabla por presión. La primera fila, «Sat.», es el vapor saturado a
          esa presión; por encima de la presión crítica no la hay.
        </p>
        <div class="rejilla">
          {tablas.sobrecalentado.bloques.map((b) => (
            <div class="caja" id={`sobrecalentado-${bar(b.p).replace(',', '-')}`}>
              <table>
                <caption>
                  p = {bar(b.p)} bar{b.Tsat !== null && <span class="tsat"> · T<sub>sat</sub> = {escribe(b.Tsat, { cifras: 5 })} °C</span>}
                </caption>
                <thead>
                  <tr>{tablas.sobrecalentado.columnas.map((c) => <th scope="col"><span class="c-t">{c.titulo}</span><span class="c-u">{c.unidad}</span></th>)}</tr>
                </thead>
                <tbody>
                  {b.saturado && (
                    <tr class="sat">
                      <th scope="row">Sat.</th>
                      {b.saturado.map((x, i) => <td>{celda(x, tablas.sobrecalentado.columnas[i + 1])}</td>)}
                    </tr>
                  )}
                  {b.filas.map((f) => (
                    <tr>{f.map((x, i) => (i === 0 ? <th scope="row">{celda(x, tablas.sobrecalentado.columnas[i])}</th> : <td>{celda(x, tablas.sobrecalentado.columnas[i])}</td>))}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </section>

      <section id="liquido" class="bloque">
        <h2>Agua, líquido comprimido</h2>
        <p class="nota">
          Una tabla por presión. La fila «Sat.» es el líquido saturado a esa
          presión. Donde esta tabla no llega, h vale casi lo mismo que h' a la
          misma temperatura: la presión apenas mueve la entalpía de un líquido.
        </p>
        <div class="rejilla">
          {tablas.liquido.bloques.map((b) => (
            <div class="caja" id={`liquido-${bar(b.p)}`}>
              <table>
                <caption>
                  p = {bar(b.p)} bar{b.Tsat !== null && <span class="tsat"> · T<sub>sat</sub> = {escribe(b.Tsat, { cifras: 5 })} °C</span>}
                </caption>
                <thead>
                  <tr>{tablas.liquido.columnas.map((c) => <th scope="col"><span class="c-t">{c.titulo}</span><span class="c-u">{c.unidad}</span></th>)}</tr>
                </thead>
                <tbody>
                  {b.saturado && (
                    <tr class="sat">
                      <th scope="row">Sat.</th>
                      {b.saturado.map((x, i) => <td>{celda(x, tablas.liquido.columnas[i + 1])}</td>)}
                    </tr>
                  )}
                  {b.filas.map((f) => (
                    <tr>{f.map((x, i) => (i === 0 ? <th scope="row">{celda(x, tablas.liquido.columnas[i])}</th> : <td>{celda(x, tablas.liquido.columnas[i])}</td>))}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </section>

      <section id="mollier" class="bloque">
        <h2>El diagrama de Mollier</h2>
        <p class="nota">
          La entalpía frente a la entropía, con el recuadro del diagrama del anexo
          —s de 4 a 10 kJ/(kg·K), h de 1800 a 4000 kJ/kg— y calculado con la misma
          formulación que estas tablas: sus curvas pasan por las filas de arriba a
          menos de medio píxel. Una expansión isentrópica es una vertical, y por eso
          sirve para situar la salida de una turbina o de una tobera. Los volúmenes
          no están: el área de una tobera se saca de las tablas.
        </p>
        <div class="caja caja--figura" tabindex="0" role="region" aria-label="diagrama con desplazamiento">
          <Fragment set:html={mollier} />
        </div>
      </section>

      <section id="anexo" class="bloque prosa-anexo">
        <h2>En qué se aparta del anexo</h2>
        <p>
          El anexo no sale de una sola fuente. Casi todo es IAPWS-95 con cinco
          cifras significativas, y tres partes vienen de otra tabla. Contrastado
          celda a celda —3.989 celdas y 34 cabeceras—, esto es lo que hay.
        </p>

        <h3>Lo que coincide</h3>
        <p>
          Las dos tablas de saturación y el vapor sobrecalentado hasta 1000 °C:
          3.106 celdas, todas iguales a la cifra que imprime el anexo. Solo cambia
          una cosa de forma: donde la entropía pasa de 10, el anexo escribe cuatro
          decimales, el último de relleno —10,4060—, y aquí van las cinco cifras
          que tiene de verdad, 10,406.
        </p>

        <h3>Cuatro cabeceras erradas</h3>
        <p>
          En la tabla de sobrecalentado, la temperatura de saturación que encabeza
          cuatro isobaras está mal; la fila «Sat.» de debajo sí es la buena. La de
          8 bar es la que más muerde: quien interpole entre «Sat.» y 200 °C con la
          cabecera impresa se equivoca en varios grados, como en <a
            href="/road-to-ingenieria/ingenieria-termica/examenes/2022-2023-ext/#ej-exter2223-ext-1-la-tobera-y-el-volumen-que-el-mollier-no-dice"
          >la tobera de enero de 2023</a>.
        </p>
        <div class="caja">
          <table class="erratas">
            <thead>
              <tr>
                <th scope="col"><span class="c-t">isobara</span></th>
                <th scope="col"><span class="c-t">el anexo imprime</span></th>
                <th scope="col"><span class="c-t">debería decir</span></th>
                <th scope="col" class="izq"><span class="c-t">cómo se ve</span></th>
              </tr>
            </thead>
            <tbody>
              {CABECERAS.map((c) => (
                <tr>
                  <th scope="row">{bar(c.p)} bar</th>
                  <td>{grados(c.impreso)} °C</td>
                  <td>{grados(c.bueno)} °C</td>
                  <td class="izq">{c.como}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3>Tres partes de otra fuente</h3>
        <p>
          <strong>La fila de 0,01 °C.</strong> Su presión, v″, h″ y s″ no son de
          IAPWS-95: el anexo da 0,0061120 bar, 206,2 m³/kg, 2501,6 kJ/kg y
          9,1575 kJ/(kg·K), y aquí van 0,0061165, 205,99, 2500,9 y 9,1555. Es la
          única fila de la saturación que se aparta.
        </p>
        <p>
          <strong>Las filas de 1100, 1200 y 1300 °C del sobrecalentado.</strong> Vienen
          de otra formulación, y el propio anexo lo delata: entre 1000 y
          1100 °C deja de cumplirse ds = dh/T en 34 de sus 36 isobaras. Las de
          aquí son IAPWS-95 y quedan por encima: la entalpía, de 2,5 kJ/kg a
          baja presión y 1100 °C hasta 40 kJ/kg a 600 bar y 1300 °C.
        </p>
        <p>
          <strong>El líquido comprimido.</strong> Sale de una formulación
          anterior, y se ve en sus cabeceras: a 50, 100, 150 y 200 bar satura a
          263,99, 311,06, 342,24 y 365,81 °C, cuando la tabla de saturación del
          mismo anexo da 263,94, 311,00, 342,16 y 365,75. Las diferencias son
          pequeñas: 1,2 kJ/kg como mucho en la entalpía y dos milésimas en la
          entropía.
        </p>
        <p>
          En esas tres partes, un ejercicio hecho aquí puede dar un número algo
          distinto del que da el anexo. En el examen manda el anexo.
        </p>

        <h3>Las erratas de imprenta</h3>
        <p>
          En esas mismas partes el anexo tiene {ERRATAS.length} erratas seguras
          —una coma perdida, dos cifras traspuestas, un cero corrido— y {ERRATAS_PROBABLES}
          probables, de una o dos unidades en la última cifra,
          que no se distinguen de un redondeo y no se listan. Se descubren porque
          la fila deja de cumplir h = u + p·v, o la isobara ds = dh/T. El «debería
          decir» es lo que el anexo quiso imprimir, no el valor de estas tablas.
        </p>
        <details class="plegable">
          <summary><span class="rotulo">Las {ERRATAS.length} erratas, celda a celda</span></summary>
          <div class="caja">
            <table class="erratas">
              <thead>
                <tr>
                  <th scope="col" class="izq"><span class="c-t">tabla</span></th>
                  <th scope="col"><span class="c-t">p</span><span class="c-u">bar</span></th>
                  <th scope="col"><span class="c-t">T</span><span class="c-u">°C</span></th>
                  <th scope="col"><span class="c-t">columna</span></th>
                  <th scope="col"><span class="c-t">el anexo imprime</span></th>
                  <th scope="col"><span class="c-t">debería decir</span></th>
                  <th scope="col" class="izq"><span class="c-t">cómo se ve</span></th>
                </tr>
              </thead>
              <tbody>
                {ERRATAS.map((e) => (
                  <tr>
                    <th scope="row" class="izq">{NOMBRE_TABLA[e.tabla]}</th>
                    <td>{bar(e.p)}</td>
                    <td>{e.T === 'Sat' ? 'Sat.' : e.T}</td>
                    <td>{e.columna}</td>
                    <td>{e.impreso}</td>
                    <td>{e.bueno}</td>
                    <td class="izq">{e.como}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </section>
    </div>
  </main>
</Base>

<style>
  .envoltorio {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.2rem 4rem;
  }

  h1 { margin: .3rem 0 .6rem; }
  .lede { max-width: var(--measure); color: var(--graphite); }

  .indice {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem 1.2rem;
    margin: 1.6rem 0 2.4rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--rule);
    font-size: .9rem;
  }

  /* El margen de ancla del resto del sitio: sin él, el título de la sección
     a la que lleva el índice queda debajo de la cabecera, que es fija. */
  .bloque, .caja[id] { scroll-margin-top: 5rem; }
  .bloque { margin-bottom: 3rem; min-width: 0; }
  .bloque h2 { font-size: 1.15rem; margin: 0 0 .4rem; }
  .nota { max-width: var(--measure); font-size: .88rem; color: var(--graphite); margin: 0 0 1rem; }

  /* Cada tabla se desplaza en su propia caja: la página nunca se va de lado
     en un móvil, la tabla sí (§17, «un track 1fr tiene min-width: auto»). */
  .caja { overflow-x: auto; min-width: 0; }

  /* Las dos de saturación tienen cien filas: se desplazan también a lo alto
     dentro de su caja, y así la cabecera se queda arriba. Una cabecera
     `sticky` dentro de una caja que solo se desplaza de lado no se pega a
     nada: la caja es su contenedor de desplazamiento. */
  .caja--larga { max-height: 78vh; overflow-y: auto; }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.6rem 1.4rem;
  }

  /* La tabla del sitio (`base.css`) es para la prosa: bloque que se desplaza
     sola, margen amplio, rayas y cabecera en versalitas. Aquí la tabla vuelve
     a ser tabla, la desplaza su caja, y la cabecera no va en mayúsculas,
     porque «kJ» en mayúsculas es otra unidad. */
  table {
    display: table;
    max-width: none;
    overflow: visible;
    margin: 0;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-size: .8rem;
    line-height: 1.35;
    white-space: nowrap;
  }

  caption {
    text-align: left;
    font-weight: 600;
    font-size: .88rem;
    padding: 0 0 .4rem;
  }

  .tsat { font-weight: 400; color: var(--graphite); }

  th, td { padding: .2rem .5rem; text-align: right; border-bottom: 0; }
  thead th {
    font-family: inherit;
    text-transform: none;
    letter-spacing: 0;
    vertical-align: bottom;
    border-bottom: 1.5px solid var(--rule);
    position: sticky;
    top: 0;
    background: var(--paper);
  }
  .c-t { display: block; font-weight: 700; font-size: .82rem; color: var(--ink); }
  .c-u { display: block; font-weight: 400; font-size: .66rem; color: var(--faint); }
  tbody th { font-weight: 600; }
  tbody tr:nth-child(even) { background: var(--panel); }
  tr.sat { font-style: italic; }

  /* El diagrama no baja de 36rem: por debajo, sus rótulos de 10 px se quedan
     en cinco y no se leen. En un móvil se desplaza en su caja, como las
     tablas. */
  .caja--figura :global(svg) {
    display: block;
    width: 100%;
    min-width: 36rem;
    max-width: 42.5rem;
    height: auto;
  }

  /* La sección del anexo es prosa: se lee, y va a la medida de lectura. */
  .prosa-anexo > p, .prosa-anexo > h3 { max-width: var(--measure); }
  .prosa-anexo h3 { font-size: 1rem; margin: 1.6rem 0 .3rem; }
  .prosa-anexo p { margin: 0 0 .8rem; }
  .prosa-anexo .caja { margin: .4rem 0 1rem; }
  table.erratas { white-space: normal; }
  table.erratas td, table.erratas th { vertical-align: top; }
  table.erratas .izq { text-align: left; }
  table.erratas td.izq { min-width: 14rem; color: var(--graphite); }

  .plegable {
    margin: .4rem 0 0;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--panel);
  }
  .plegable summary {
    cursor: pointer;
    padding: .55rem .8rem;
    list-style: none;
  }
  .plegable summary::-webkit-details-marker { display: none; }
  .plegable summary::before { content: '▸ '; color: var(--faint); }
  .plegable[open] summary::before { content: '▾ '; }
  .plegable summary:hover .rotulo { color: var(--live); }
  .plegable .caja { margin: 0; padding: 0 .8rem .8rem; }
  .plegable table.erratas thead th { background: var(--panel); }
  .plegable table.erratas tbody tr:nth-child(even) { background: var(--paper); }

  @media print {
    .envoltorio { max-width: none; padding: 0; }
    .caja--larga { max-height: none; overflow: visible; }
    .rejilla { display: block; }
    .caja { break-inside: avoid; margin-bottom: .8rem; }
    table { font-size: .68rem; }
    thead th { position: static; }
    .plegable { border: 0; background: none; }
    .caja--figura :global(svg) { min-width: 0; }
    .plegable summary::before { content: none; }
  }
</style>
