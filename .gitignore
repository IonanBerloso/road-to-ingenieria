node_modules/
dist/
.astro/

# nada de artefactos de build versionados (CLAUDE.md §12)
# El diario se versiona en Markdown; el PDF y su vista previa se generan
# con `npm run diario`.
*.pdf
*.zip
diario/vistazo.png

# La excepción, y es la única: los enunciados de examen originales. No son
# artefactos de build, son la fuente que cita cada resolución, y por eso se
# versionan (§08, nota del 20 de agosto de 2026).
!public/examenes/**/*.pdf
.DS_Store
.env
.env.*
